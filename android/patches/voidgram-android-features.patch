+        items.add(UItem.asCheck(ID_WORD_SYNC, VoidGram.t("Подсветка по словам", "Word-by-word highlight")).setChecked(VoidGramLyrics.wordSync()));
+        items.add(UItem.asCheck(ID_MINI, VoidGram.t("Строка песни в мини-плеере", "Lyrics line in the mini player")).setChecked(VoidGramLyrics.isMiniEnabled()));
+        items.add(UItem.asButton(ID_NIGHT, VoidGram.t("Ночной режим плеера", "Player night look"), VoidGramNightLook.modeTitle(VoidGramNightLook.mode())));
+        items.add(UItem.asButton(ID_HAPTICS, VoidGram.t("Вибрация в такт", "Vibrate to the beat"), org.telegram.messenger.voidgram.VoidGramMusicHaptics.title(org.telegram.messenger.voidgram.VoidGramMusicHaptics.mode())));
+        items.add(UItem.asShadow(VoidGram.t("Телефон вибрирует на ударных загруженного трека. Микрофон не используется.", "The phone vibrates on the beats of the downloaded track. The microphone is not used.")));
+        items.add(UItem.asHeader(VoidGram.t("Эквалайзер", "Equalizer")));
+        boolean eq = VoidGramEqualizer.isEnabled();
+        items.add(UItem.asCheck(ID_EQ, VoidGram.t("Эквалайзер", "Equalizer")).setChecked(eq));
+        if (eq) {
+            String preset = VoidGramEqualizer.preset();
+            for (int i = 0; i < VoidGramEqualizer.PRESETS.length; i++) {
+                items.add(UItem.asRadio(ID_PRESET_BASE + i, VoidGramEqualizer.presetTitle(VoidGramEqualizer.PRESETS[i])).setChecked(VoidGramEqualizer.PRESETS[i].equals(preset)));
+            }
+            for (int band = 0; band < VoidGramEqualizer.BANDS; band++) {
+                final int b = band;
+                items.add(UItem.asHeader(VoidGramEqualizer.bandTitle(band)));
+                items.add(UItem.asIntSlideView(1, -12, VoidGramEqualizer.gain(band), 12, value -> (value > 0 ? "+" : "") + value + VoidGram.t(" дБ", " dB"), value -> VoidGramEqualizer.setGain(b, value)));
+            }
