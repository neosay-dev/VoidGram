+package org.telegram.messenger.voidgram;
+
+import android.app.Activity;
+import android.app.Dialog;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Build;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * The VoidGram user agreement, shown over everything before signing in (and once to people who were
+ * signed in when it appeared). "Accept" works only after the text has been scrolled to its very end.
+ */
+public final class VoidGramAgreement {
+    /** Bump when the text changes in substance: everyone accepts it again. */
+    public static final int VERSION = 1;
+    private static final String KEY = "license_accepted_version";
+    private static Dialog shown;
+
+    private VoidGramAgreement() {
+    }
+
+    public static boolean isAccepted() {
+        return VoidGram.prefs().getInt(KEY, 0) >= VERSION;
+    }
+
+    public static String text() {
+        return VoidGram.russian() ? TEXT_RU : TEXT_EN;
+    }
+
+    public static void showIfNeeded(Activity activity) {
+        if (isAccepted() || activity == null || activity.isFinishing() || (shown != null && shown.isShowing())) {
+            return;
+        }
+        final boolean ru = VoidGram.russian();
+        final int background = Theme.getColor(Theme.key_windowBackgroundWhite);
+        final int textColor = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText);
+        final int grayColor = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText);
+        final int accent = Theme.getColor(Theme.key_featuredStickers_addButton);
+
+        final Dialog dialog = new Dialog(activity, android.R.style.Theme_DeviceDefault_NoActionBar);
+        dialog.setCancelable(false);
+
+        LinearLayout root = new LinearLayout(activity);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(background);
+        root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(16) + AndroidUtilities.statusBarHeight, AndroidUtilities.dp(16), AndroidUtilities.dp(12));
+
+        TextView title = new TextView(activity);
+        title.setText(ru ? "Пользовательское соглашение" : "User Agreement");
+        title.setTextColor(textColor);
+        title.setTextSize(22);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setGravity(Gravity.CENTER);
+        root.addView(title, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        final ScrollView scroll = new ScrollView(activity);
+        GradientDrawable box = new GradientDrawable();
+        box.setColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        box.setCornerRadius(AndroidUtilities.dp(14));
+        scroll.setBackground(box);
+        TextView body = new TextView(activity);
+        body.setText(text());
+        body.setTextColor(textColor);
+        body.setTextSize(15);
+        body.setLineSpacing(AndroidUtilities.dp(2), 1f);
+        body.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(14), AndroidUtilities.dp(14), AndroidUtilities.dp(22));
+        scroll.addView(body, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        LinearLayout.LayoutParams scrollParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f);
+        scrollParams.topMargin = AndroidUtilities.dp(14);
+        root.addView(scroll, scrollParams);
+
+        final ProgressBar progress = new ProgressBar(activity, null, android.R.attr.progressBarStyleHorizontal);
+        progress.setMax(1000);
+        LinearLayout.LayoutParams progressParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(4));
+        progressParams.topMargin = AndroidUtilities.dp(10);
+        root.addView(progress, progressParams);
+
+        final TextView hint = new TextView(activity);
+        hint.setText(ru ? "Долистайте до самого конца, чтобы принять" : "Scroll to the very end to accept");
+        hint.setTextColor(grayColor);
+        hint.setTextSize(13);
+        hint.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams hintParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        hintParams.topMargin = AndroidUtilities.dp(8);
+        root.addView(hint, hintParams);
+
+        final TextView accept = new TextView(activity);
+        accept.setText(ru ? "Принимаю" : "Accept");
+        accept.setTextColor(Color.WHITE);
+        accept.setTextSize(16);
+        accept.setTypeface(AndroidUtilities.bold());
+        accept.setGravity(Gravity.CENTER);
+        final GradientDrawable acceptBackground = new GradientDrawable();
+        acceptBackground.setCornerRadius(AndroidUtilities.dp(12));
+        acceptBackground.setColor(0xFF9E9E9E);
+        accept.setBackground(acceptBackground);
+        accept.setEnabled(false);
+        LinearLayout.LayoutParams acceptParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(50));
+        acceptParams.topMargin = AndroidUtilities.dp(12);
+        root.addView(accept, acceptParams);
+
+        TextView decline = new TextView(activity);
+        decline.setText(ru ? "Не принимаю" : "Decline");
+        decline.setTextColor(grayColor);
+        decline.setTextSize(14);
+        decline.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams declineParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(40));
+        declineParams.topMargin = AndroidUtilities.dp(4);
+        root.addView(decline, declineParams);
+
+        final boolean[] reachedEnd = new boolean[1];
+        final Runnable check = () -> {
+            View child = scroll.getChildAt(0);
+            if (child == null || scroll.getHeight() == 0) {
+                return;
+            }
+            int max = Math.max(1, child.getHeight() - scroll.getHeight());
+            progress.setProgress(Math.min(1000, scroll.getScrollY() * 1000 / max));
+            // "The very end": the last line is fully visible (2 dp tolerance).
+            if (!reachedEnd[0] && scroll.getScrollY() + scroll.getHeight() >= child.getHeight() - AndroidUtilities.dp(2)) {
+                reachedEnd[0] = true;
+                progress.setProgress(1000);
+                accept.setEnabled(true);
+                acceptBackground.setColor(accent);
+                hint.setText(ru ? "Спасибо, что дочитали" : "Thank you for reading to the end");
+                try {
+                    scroll.performHapticFeedback(android.view.HapticFeedbackConstants.KEYBOARD_TAP);
+                } catch (Throwable ignore) {
+                }
+            }
+        };
+        scroll.setOnScrollChangeListener((v, x, y, oldX, oldY) -> check.run());
+        // The whole text may fit at once on a large screen: then there is nothing to scroll.
+        scroll.getViewTreeObserver().addOnGlobalLayoutListener(check::run);
+
+        accept.setOnClickListener(v -> {
+            if (!reachedEnd[0]) {
+                return;
+            }
+            VoidGram.prefs().edit().putInt(KEY, VERSION).apply();
+            try {
+                dialog.dismiss();
+            } catch (Throwable ignore) {
+            }
+            shown = null;
+        });
+        decline.setOnClickListener(v -> {
+            AlertDialog.Builder builder = new AlertDialog.Builder(activity);
+            builder.setTitle(ru ? "Без согласия нельзя" : "Agreement required");
+            builder.setMessage(ru ? "Пользоваться VoidGram можно только после принятия соглашения. Если вы не согласны, удалите приложение." : "VoidGram can be used only after accepting the agreement. If you do not agree, delete the app.");
+            builder.setPositiveButton("OK", null);
+            builder.show();
+        });
+
+        dialog.setContentView(root);
+        Window window = dialog.getWindow();
+        if (window != null) {
+            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+            window.setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(background));
+            if (Build.VERSION.SDK_INT >= 21) {
+                window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
+                window.setStatusBarColor(background);
+                window.setNavigationBarColor(background);
+            }
+        }
+        try {
+            dialog.show();
+            shown = dialog;
+        } catch (Throwable ignore) {
+        }
+    }
