+            builder.setItems(marks, (dialog, which) -> {
+                VoidGramHistory.setDeletedMark(marks[which]);
+                refresh();
+            });
+            showDialog(builder.create());
+            return;
+        } else if (id == ID_CLEAR) {
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+            builder.setTitle(VoidGram.t("Очистить историю?", "Clear history?"));
+            builder.setMessage(VoidGram.t("Метки удалённых исчезнут, история изменений сотрётся; сами сообщения останутся в чатах.", "The deleted marks go away and the edit history is erased; the messages themselves stay in the chats."));
