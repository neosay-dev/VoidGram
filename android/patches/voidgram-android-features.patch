+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.text.InputType;
+import android.widget.CheckBox;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MessageObject;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * VoidGram important posts, as on iOS: a muted channel (or chat) still notifies about posts with
+ * chosen keywords or of chosen kinds (photos, videos, files, links, polls). Kept on this device.
+ */
+public final class VoidGramImportantPosts {
+    public static final String[] TYPES = {"photo", "video", "file", "link", "poll"};
+
+    private VoidGramImportantPosts() {
+    }
+
+    private static String key(int account, long dialogId, String name) {
+        return "important_" + account + "_" + dialogId + "_" + name;
+    }
+
+    public static ArrayList<String> keywords(int account, long dialogId) {
+        ArrayList<String> result = new ArrayList<>();
+        for (String word : VoidGram.prefs().getString(key(account, dialogId, "keywords"), "").split(",")) {
+            String trimmed = word.trim();
+            if (trimmed.length() > 2) {
+                result.add(trimmed);
+            }
+        }
+        return result;
+    }
+
+    public static Set<String> types(int account, long dialogId) {
+        return new HashSet<>(VoidGram.prefs().getStringSet(key(account, dialogId, "types"), new HashSet<>()));
+    }
+
+    public static boolean hasRules(int account, long dialogId) {
+        return !keywords(account, dialogId).isEmpty() || !types(account, dialogId).isEmpty();
+    }
+
+    private static String normalize(String text) {
+        return text.toLowerCase(Locale.ROOT).replace('ё', 'е');
+    }
+
+    public static boolean isImportant(int account, long dialogId, MessageObject message) {
+        if (message == null || VoidGramDecoy.isActive()) {
+            return false;
+        }
+        Set<String> types = types(account, dialogId);
+        if (!types.isEmpty()) {
+            if (types.contains("photo") && message.isPhoto() || types.contains("video") && message.isVideo()
+                    || types.contains("file") && message.getDocument() != null && !message.isVideo() && !message.isMusic() && !message.isVoice() && !message.isSticker()
+                    || types.contains("poll") && message.isPoll()
+                    || types.contains("link") && message.messageOwner != null && message.messageOwner.media instanceof org.telegram.tgnet.TLRPC.TL_messageMediaWebPage) {
+                return true;
+            }
+        }
+        ArrayList<String> keywords = keywords(account, dialogId);
+        if (keywords.isEmpty() || message.messageOwner == null || message.messageOwner.message == null) {
+            return false;
+        }
+        String text = normalize(message.messageOwner.message);
+        for (String keyword : keywords) {
+            if (text.contains(normalize(keyword))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String typeTitle(String type) {
+        switch (type) {
+            case "photo": return VoidGram.t("Фото", "Photos");
+            case "video": return VoidGram.t("Видео", "Videos");
+            case "file": return VoidGram.t("Файлы", "Files");
+            case "link": return VoidGram.t("Ссылки", "Links");
+            default: return VoidGram.t("Опросы", "Polls");
+        }
+    }
+
+    /** The editor: keywords (comma-separated) and kinds of posts that still notify. */
+    public static void showEditor(Context context, int account, long dialogId) {
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(AndroidUtilities.dp(22), 0, AndroidUtilities.dp(22), 0);
+        EditText field = new EditText(context);
+        field.setHint(VoidGram.t("ключевые слова через запятую", "keywords, comma-separated"));
+        field.setText(VoidGram.prefs().getString(key(account, dialogId, "keywords"), ""));
+        field.setInputType(InputType.TYPE_CLASS_TEXT);
+        field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        layout.addView(field);
+        Set<String> types = types(account, dialogId);
+        CheckBox[] boxes = new CheckBox[TYPES.length];
+        for (int i = 0; i < TYPES.length; i++) {
+            CheckBox box = new CheckBox(context);
+            box.setText(typeTitle(TYPES[i]));
+            box.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+            box.setChecked(types.contains(TYPES[i]));
+            boxes[i] = box;
+            layout.addView(box);
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(VoidGram.t("Важные посты", "Important posts"));
+        builder.setMessage(VoidGram.t("Даже без звука придёт уведомление о постах с этими словами или такого вида.", "Even when muted, posts with these words or of these kinds still notify."));
+        builder.setView(layout);
+        builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (dialog, which) -> {
+            HashSet<String> chosen = new HashSet<>();
+            for (int i = 0; i < TYPES.length; i++) {
+                if (boxes[i].isChecked()) {
+                    chosen.add(TYPES[i]);
+                }
+            }
+            VoidGram.prefs().edit().putString(key(account, dialogId, "keywords"), field.getText().toString()).putStringSet(key(account, dialogId, "types"), chosen).apply();
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        builder.show();
+    }
+}
