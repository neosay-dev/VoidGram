+                list.addView(status, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+                return;
+            }
+            if (lyrics.isSynced()) {
+                for (int i = 0; i < lyrics.lines.size(); i++) {
+                    final VoidGramLyrics.Line line = lyrics.lines.get(i);
+                    TextView view = new TextView(activity);
