@@ -0,0 +1,152 @@
+package org.telegram.ui.voidgram;
+
+import android.os.Bundle;
+import android.view.View;
+import android.widget.EditText;
+
+import org.telegram.messenger.UserObject;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramHistory;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.text.DateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.Locale;
+
+/** Every saved deleted and edited message across chats, with search and filters, as on iOS. */
+public class VoidGramHistoryFeedActivity extends UniversalFragment {
+    private static final int ID_ALL = 1;
+    private static final int ID_DELETED = 2;
+    private static final int ID_EDITED = 3;
+    private static final int ID_SEARCH = 4;
+    private static final int ID_ENTRY_BASE = 1000;
+
+    private ArrayList<VoidGramHistory.FeedEntry> entries;
+    private final ArrayList<VoidGramHistory.FeedEntry> shown = new ArrayList<>();
+    private int filter = ID_ALL;
+    private String query = "";
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Удалённые и изменённые", "Deleted and edited");
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        VoidGramHistory.loadFeed(currentAccount, 500, result -> {
+            entries = result;
+            if (listView != null && listView.adapter != null) {
+                listView.adapter.update(true);
+            }
+        });
+        return super.onFragmentCreate();
+    }
+
+    private String chatTitle(long dialogId) {
+        if (dialogId > 0) {
+            TLRPC.User user = getMessagesController().getUser(dialogId);
+            return user != null ? UserObject.getUserName(user) : "#" + dialogId;
+        } else if (dialogId < 0) {
+            TLRPC.Chat chat = getMessagesController().getChat(-dialogId);
+            return chat != null ? chat.title : "#" + dialogId;
+        }
+        return "?";
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asRadio(ID_ALL, VoidGram.t("Все", "All")).setChecked(filter == ID_ALL));
+        items.add(UItem.asRadio(ID_DELETED, VoidGram.t("Удалённые", "Deleted")).setChecked(filter == ID_DELETED));
+        items.add(UItem.asRadio(ID_EDITED, VoidGram.t("Изменённые", "Edited")).setChecked(filter == ID_EDITED));
+        items.add(UItem.asButton(ID_SEARCH, org.telegram.messenger.R.drawable.msg_search, VoidGram.t("Поиск", "Search"), query.isEmpty() ? "" : query));
+        items.add(UItem.asShadow(null));
+        shown.clear();
+        if (entries == null) {
+            items.add(UItem.asShadow(VoidGram.t("Загрузка…", "Loading…")));
+            return;
+        }
+        String needle = query.toLowerCase(Locale.getDefault());
+        DateFormat format = DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.SHORT);
+        for (VoidGramHistory.FeedEntry entry : entries) {
+            if (filter == ID_DELETED && !entry.deleted || filter == ID_EDITED && entry.deleted) {
+                continue;
+            }
+            String text = entry.deleted ? entry.text : entry.previousText;
+            String chat = chatTitle(entry.dialogId != 0 ? entry.dialogId : entry.scope);
+            if (!needle.isEmpty() && (text == null || !text.toLowerCase(Locale.getDefault()).contains(needle)) && !chat.toLowerCase(Locale.getDefault()).contains(needle)) {
+                continue;
+            }
+            String body = text == null || text.isEmpty() ? VoidGram.t("[медиа]", "[media]") : text.replace('\n', ' ');
+            if (body.length() > 60) {
+                body = body.substring(0, 60) + "…";
+            }
+            shown.add(entry);
+            items.add(UItem.asButton(ID_ENTRY_BASE + shown.size() - 1, (entry.deleted ? "🗑 " : "✏️ ") + chat + ": " + body, format.format(new Date(entry.date * 1000L))));
+            if (shown.size() >= 300) {
+                break;
+            }
+        }
+        if (shown.isEmpty()) {
+            items.add(UItem.asShadow(VoidGram.t("Ничего нет. Удалённые сообщения и история изменений сохраняются, когда это включено в «Призрак и история».", "Nothing here. Deleted messages and edit history are kept when this is on in \"Ghost and history\".")));
+        } else {
+            items.add(UItem.asShadow(VoidGram.t("Нажмите, чтобы открыть сообщение в чате.", "Tap to open the message in its chat.")));
+        }
+    }
+
+    private void update() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_ALL || item.id == ID_DELETED || item.id == ID_EDITED) {
+            filter = item.id;
+            update();
+        } else if (item.id == ID_SEARCH) {
+            EditText field = new EditText(getContext());
+            field.setText(query);
+            field.setSingleLine(true);
+            field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+            builder.setTitle(VoidGram.t("Поиск", "Search"));
+            builder.setView(field);
+            builder.setPositiveButton("OK", (d, w) -> {
+                query = field.getText().toString().trim();
+                update();
+            });
+            builder.setNeutralButton(VoidGram.t("Сбросить", "Clear"), (d, w) -> {
+                query = "";
+                update();
+            });
+            showDialog(builder.create());
+        } else if (item.id >= ID_ENTRY_BASE && item.id - ID_ENTRY_BASE < shown.size()) {
+            VoidGramHistory.FeedEntry entry = shown.get(item.id - ID_ENTRY_BASE);
+            long dialogId = entry.dialogId != 0 ? entry.dialogId : entry.scope;
+            if (dialogId == 0) {
+                return;
+            }
+            Bundle args = new Bundle();
+            if (dialogId > 0) {
+                args.putLong("user_id", dialogId);
+            } else {
+                args.putLong("chat_id", -dialogId);
+            }
+            args.putInt("message_id", entry.mid);
+            presentFragment(new ChatActivity(args));
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
