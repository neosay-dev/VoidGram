+    public static void checkUrl(BaseFragment fragment, String url) {
+        String key = virusTotalKey();
+        if (key.isEmpty()) {
+            missingKey(fragment, "VirusTotal");
+            return;
+        }
+        String id = Base64.encodeToString(url.getBytes(java.nio.charset.StandardCharsets.UTF_8), Base64.NO_WRAP | Base64.URL_SAFE | Base64.NO_PADDING);
+        HashMap<String, String> headers = new HashMap<>();
+        headers.put("x-apikey", key);
+        http("GET", "https://www.virustotal.com/api/v3/urls/" + id, headers, null, (status, body) -> {
+            int[] s = status == 200 ? stats(body) : null;
+            if (s != null) {
+                present(fragment, "VirusTotal", url + "\n\n" + verdict(s));
+            } else if (status == 404) {
+                HashMap<String, String> submitHeaders = new HashMap<>(headers);
+                submitHeaders.put("Content-Type", "application/x-www-form-urlencoded");
+                String form;
+                try {
+                    form = "url=" + URLEncoder.encode(url, "UTF-8");
+                } catch (Exception e) {
+                    form = "url=" + url;
+                }
+                http("POST", "https://www.virustotal.com/api/v3/urls", submitHeaders, form, (submitStatus, submitBody) -> present(fragment, "VirusTotal", submitStatus == 200
+                        ? VoidGram.t("Ссылка отправлена на проверку. Повторите через минуту.", "The link was sent for analysis. Check again in a minute.")
+                        : VoidGram.t("VirusTotal не принял ссылку.", "VirusTotal did not accept the link.")));
+            } else {
+                present(fragment, "VirusTotal", status == 401 ? VoidGram.t("Неверный ключ API.", "Invalid API key.") : VoidGram.t("Не удалось проверить (код ", "The check failed (code ") + status + ").");
+            }
+        });
+    }
+
+    public static void checkFile(BaseFragment fragment, File file, String name) {
+        String key = virusTotalKey();
+        if (key.isEmpty()) {
+            missingKey(fragment, "VirusTotal");
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            String hash;
+            try (FileInputStream in = new FileInputStream(file)) {
+                MessageDigest digest = MessageDigest.getInstance("SHA-256");
+                byte[] buffer = new byte[65536];
+                int read;
+                while ((read = in.read(buffer)) > 0) {
+                    digest.update(buffer, 0, read);
+                }
+                StringBuilder builder = new StringBuilder();
+                for (byte b : digest.digest()) {
+                    builder.append(String.format("%02x", b & 0xff));
+                }
+                hash = builder.toString();
+            } catch (Throwable e) {
+                return;
+            }
+            HashMap<String, String> headers = new HashMap<>();
+            headers.put("x-apikey", key);
+            http("GET", "https://www.virustotal.com/api/v3/files/" + hash, headers, null, (status, body) -> {
+                int[] s = status == 200 ? stats(body) : null;
+                String message;
+                if (s != null) {
+                    message = name + "\n\n" + verdict(s);
+                } else if (status == 404) {
+                    message = name + "\n\n" + VoidGram.t("VirusTotal ещё не видел этот файл. VoidGram не загружает ваши файлы — проверить можно на virustotal.com вручную.", "VirusTotal has not seen this file. VoidGram never uploads your files; you can check it on virustotal.com yourself.");
+                } else if (status == 401) {
+                    message = VoidGram.t("Неверный ключ API.", "Invalid API key.");
+                } else {
+                    message = VoidGram.t("Не удалось проверить (код ", "The check failed (code ") + status + ").";
+                }
+                present(fragment, "VirusTotal", message);
+            });
+        });
+    }
