diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramAudioToVoice.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramAudioToVoice.java
new file mode 100644
index 0000000..b2d9d40
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramAudioToVoice.java
@@ -0,0 +1,96 @@
+package org.telegram.ui.voidgram;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.SharedConfig;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramTranscribe;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.io.File;
+
+/**
+ * "Audio → voice", as on iOS: a music or audio file is decoded, encoded with the voice
+ * recorder's Opus encoder and sent to this chat as a voice message with a waveform.
+ * Long files are cut at 10 minutes.
+ */
+public final class VoidGramAudioToVoice {
+    private VoidGramAudioToVoice() {
+    }
+
+    private static final int RATE = 48000;
+    private static final int MAX_SECONDS = 600;
+
+    public static boolean canConvert(MessageObject message) {
+        return message != null && message.getDocument() != null && (message.isMusic() || message.getDocument().mime_type != null && message.getDocument().mime_type.startsWith("audio/") && !message.isVoice());
+    }
+
+    public static void send(ChatActivity chat, MessageObject message) {
+        if (chat == null || chat.getParentActivity() == null || !canConvert(message)) {
+            return;
+        }
+        File source = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+        if (source == null || !source.exists()) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Сначала загрузите аудио.", "Download the audio first.")).show();
+            return;
+        }
+        final int account = chat.getCurrentAccount();
+        final long dialogId = chat.getDialogId();
+        AlertDialog progress = new AlertDialog(chat.getParentActivity(), AlertDialog.ALERT_TYPE_SPINNER);
+        progress.show();
+        Utilities.globalQueue.postRunnable(() -> {
+            byte[] pcm = VoidGramTranscribe.decodePcm(source, RATE, MAX_SECONDS);
+            TLRPC.TL_document document = null;
+            File target = null;
+            if (pcm != null && pcm.length > RATE / 5) {
+                document = new TLRPC.TL_document();
+                document.file_reference = new byte[0];
+                document.dc_id = Integer.MIN_VALUE;
+                document.id = SharedConfig.getLastLocalId();
+                document.user_id = UserConfig.getInstance(account).getClientUserId();
+                document.mime_type = "audio/ogg";
+                SharedConfig.saveConfig();
+                target = new File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_AUDIO), FileLoader.getAttachFileName(document));
+                if (!MediaController.getInstance().voidgramEncodeVoice(target.getAbsolutePath(), pcm)) {
+                    document = null;
+                } else {
+                    TLRPC.TL_documentAttributeAudio audio = new TLRPC.TL_documentAttributeAudio();
+                    audio.voice = true;
+                    audio.duration = pcm.length / 2.0 / RATE;
+                    audio.waveform = MediaController.getWaveform(target.getAbsolutePath());
+                    if (audio.waveform != null) {
+                        audio.flags |= 4;
+                    }
+                    document.attributes.add(audio);
+                    document.size = (int) target.length();
+                    document.date = ConnectionsManager.getInstance(account).getCurrentTime();
+                }
+            }
+            final TLRPC.TL_document finalDocument = document;
+            final File finalTarget = target;
+            AndroidUtilities.runOnUIThread(() -> {
+                try {
+                    progress.dismiss();
+                } catch (Throwable ignore) {
+                }
+                if (finalDocument == null) {
+                    BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Не удалось сделать голосовое из этого аудио.", "Couldn't turn this audio into a voice message.")).show();
+                    return;
+                }
+                SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(finalDocument, null, finalTarget.getAbsolutePath(), dialogId, null, null, null, null, null, null, true, 0, 0, 0, null, null, false);
+                SendMessagesHelper.getInstance(account).sendMessage(params);
+                BulletinFactory.of(chat).createSimpleBulletin(R.raw.voip_invite, VoidGram.t("Отправлено как голосовое", "Sent as a voice message")).show();
+            });
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramBlackHole.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramBlackHole.java
new file mode 100644
index 0000000..20a79be
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramBlackHole.java
@@ -0,0 +1,143 @@
+package org.telegram.ui.voidgram;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.animation.AccelerateInterpolator;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.util.Random;
+
+/**
+ * "Black hole" for clearing a chat, as on iOS: the visible messages are cut into pieces that
+ * spiral into a dark hole in the middle of the screen while the history is cleared.
+ */
+public final class VoidGramBlackHole {
+    private VoidGramBlackHole() {
+    }
+
+    public static boolean isEnabled() {
+        return VoidGram.prefs().getBoolean("black_hole", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("black_hole", value).apply();
+    }
+
+    /** Snapshots `source` and plays the animation over it inside `container`. */
+    public static void play(View source, ViewGroup container) {
+        if (!isEnabled() || source == null || container == null || source.getWidth() <= 0 || source.getHeight() <= 0) {
+            return;
+        }
+        if (android.provider.Settings.Global.getFloat(source.getContext().getContentResolver(), android.provider.Settings.Global.ANIMATOR_DURATION_SCALE, 1f) == 0f) {
+            return;
+        }
+        final Bitmap snapshot;
+        try {
+            snapshot = Bitmap.createBitmap(source.getWidth(), source.getHeight(), Bitmap.Config.ARGB_8888);
+            source.draw(new Canvas(snapshot));
+        } catch (Throwable e) {
+            return;
+        }
+        int[] sourceLocation = new int[2];
+        int[] containerLocation = new int[2];
+        source.getLocationInWindow(sourceLocation);
+        container.getLocationInWindow(containerLocation);
+        HoleView view = new HoleView(container.getContext(), snapshot, sourceLocation[0] - containerLocation[0], sourceLocation[1] - containerLocation[1]);
+        container.addView(view, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(1100);
+        animator.setInterpolator(new AccelerateInterpolator(1.4f));
+        animator.addUpdateListener(a -> {
+            view.progress = (float) a.getAnimatedValue();
+            view.invalidate();
+        });
+        animator.addListener(new android.animation.AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(android.animation.Animator animation) {
+                AndroidUtilities.removeFromParent(view);
+                snapshot.recycle();
+            }
+        });
+        animator.start();
+    }
+
+    private static final class HoleView extends View {
+        private static final int COLUMNS = 8;
+        private static final int ROWS = 14;
+
+        private final Bitmap snapshot;
+        private final int offsetX;
+        private final int offsetY;
+        private final float[] delays = new float[COLUMNS * ROWS];
+        private final float[] spins = new float[COLUMNS * ROWS];
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        private final Paint holePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Rect src = new Rect();
+        private final RectF dst = new RectF();
+        float progress;
+
+        HoleView(Context context, Bitmap snapshot, int offsetX, int offsetY) {
+            super(context);
+            this.snapshot = snapshot;
+            this.offsetX = offsetX;
+            this.offsetY = offsetY;
+            Random random = new Random(42);
+            for (int i = 0; i < delays.length; i++) {
+                delays[i] = random.nextFloat() * 0.35f;
+                spins[i] = (random.nextFloat() - 0.5f) * 720f;
+            }
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            int width = snapshot.getWidth();
+            int height = snapshot.getHeight();
+            float centerX = offsetX + width / 2f;
+            float centerY = offsetY + height / 2f;
+            float hole = AndroidUtilities.dp(24) + AndroidUtilities.dp(70) * (float) Math.sin(Math.PI * Math.min(1f, progress * 1.1f));
+            holePaint.setShader(new RadialGradient(centerX, centerY, Math.max(1f, hole * 2.2f), new int[]{0xFF000000, 0xCC000000, 0x00000000}, new float[]{0f, 0.45f, 1f}, Shader.TileMode.CLAMP));
+            canvas.drawCircle(centerX, centerY, hole * 2.2f, holePaint);
+            float tileW = width / (float) COLUMNS;
+            float tileH = height / (float) ROWS;
+            for (int row = 0; row < ROWS; row++) {
+                for (int column = 0; column < COLUMNS; column++) {
+                    int index = row * COLUMNS + column;
+                    float t = Math.max(0f, Math.min(1f, (progress - delays[index]) / (1f - delays[index])));
+                    if (t >= 1f) {
+                        continue;
+                    }
+                    float x = offsetX + column * tileW;
+                    float y = offsetY + row * tileH;
+                    float tileCenterX = x + tileW / 2f;
+                    float tileCenterY = y + tileH / 2f;
+                    double dx = tileCenterX - centerX;
+                    double dy = tileCenterY - centerY;
+                    double radius = Math.hypot(dx, dy) * (1f - t);
+                    double angle = Math.atan2(dy, dx) + t * t * Math.PI * 1.6;
+                    float px = (float) (centerX + Math.cos(angle) * radius);
+                    float py = (float) (centerY + Math.sin(angle) * radius);
+                    float scale = 1f - t * 0.92f;
+                    src.set((int) (column * tileW), (int) (row * tileH), (int) ((column + 1) * tileW), (int) ((row + 1) * tileH));
+                    dst.set(px - tileW * scale / 2f, py - tileH * scale / 2f, px + tileW * scale / 2f, py + tileH * scale / 2f);
+                    paint.setAlpha((int) (255 * (1f - t * t)));
+                    canvas.save();
+                    canvas.rotate(spins[index] * t, px, py);
+                    canvas.drawBitmap(snapshot, src, dst, paint);
+                    canvas.restore();
+                }
+            }
+        }
+    }
+}
