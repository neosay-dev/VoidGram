+package org.telegram.ui.voidgram;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramHiddenChats;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.util.HashSet;
+
+/**
+ * A chat locked with the fingerprint, face or screen lock, as on iOS: its content stays covered
+ * until the owner confirms; it locks again when the app goes to the background.
+ */
+public final class VoidGramChatLock {
+    private VoidGramChatLock() {
+    }
+
+    private static final HashSet<String> unlocked = new HashSet<>();
+
+    private static String key(int account, long dialogId) {
+        return account + ":" + dialogId;
+    }
+
+    public static boolean isLocked(int account, long dialogId) {
+        return VoidGram.prefs().getBoolean("chat_lock_" + key(account, dialogId), false);
+    }
+
+    public static void setLocked(int account, long dialogId, boolean locked) {
+        VoidGram.prefs().edit().putBoolean("chat_lock_" + key(account, dialogId), locked).apply();
+        if (locked) {
+            unlocked.add(key(account, dialogId));
+        }
+    }
+
+    /** LaunchActivity.onPause: every locked chat locks again. */
+    public static void lockAll() {
+        unlocked.clear();
+    }
+
+    /** ChatActivity.createView: covers the chat until the owner confirms. */
+    public static void attach(int account, long dialogId, View fragmentView) {
+        if (!(fragmentView instanceof ViewGroup) || !isLocked(account, dialogId) || unlocked.contains(key(account, dialogId))) {
+            return;
+        }
+        Context context = fragmentView.getContext();
+        FrameLayout cover = new FrameLayout(context);
+        cover.setBackgroundColor(0xF2101418);
+        cover.setClickable(true);
+        cover.setFocusable(true);
+        LinearLayout column = new LinearLayout(context);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER_HORIZONTAL);
+        TextView lock = new TextView(context);
+        lock.setText("🔒");
+        lock.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 48);
+        lock.setGravity(Gravity.CENTER);
+        column.addView(lock, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL));
+        TextView title = new TextView(context);
+        title.setText(VoidGram.t("Чат заблокирован", "Chat locked"));
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setGravity(Gravity.CENTER);
+        column.addView(title, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL, 0, 12, 0, 0));
+        TextView button = new TextView(context);
+        button.setText(VoidGram.t("Разблокировать", "Unlock"));
+        button.setTextColor(Color.WHITE);
+        button.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        button.setGravity(Gravity.CENTER);
+        button.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(10), AndroidUtilities.dp(24), AndroidUtilities.dp(10));
+        android.graphics.drawable.GradientDrawable background = new android.graphics.drawable.GradientDrawable();
+        background.setCornerRadius(AndroidUtilities.dp(20));
+        background.setColor(0xFF3A7BFF);
+        button.setBackground(background);
+        column.addView(button, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL, 0, 20, 0, 0));
+        cover.addView(column, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER));
+        Runnable open = () -> VoidGramHiddenChats.authenticateFresh(() -> {
+            unlocked.add(key(account, dialogId));
+            AndroidUtilities.removeFromParent(cover);
+        });
+        button.setOnClickListener(v -> open.run());
+        ((ViewGroup) fragmentView).addView(cover, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        AndroidUtilities.runOnUIThread(open, 350);
+    }
+}
