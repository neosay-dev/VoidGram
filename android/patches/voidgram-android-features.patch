+package org.telegram.ui.voidgram;
+
+import android.view.View;
+
+import org.telegram.messenger.LiteMode;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramPowerSaving;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+import java.util.Set;
+
+/** VoidGram → Power saving: a profile for a phone, a tablet and a laptop. */
+public class VoidGramPowerSavingActivity extends UniversalFragment {
+    private static final int ID_KIND_BASE = 1;
+    private static final int ID_MODE_BASE = 10;
+    private static final int ID_SYSTEM = 20;
+    private static final int ID_BATTERY = 21;
+    private static final int ID_LIMIT_BASE = 30;
+    private static final int ID_RESET = 50;
+
+    private int kind = VoidGramPowerSaving.currentKind();
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Энергосбережение", "Power saving");
+    }
+
+    private void refresh() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        int current = VoidGramPowerSaving.currentKind();
+        items.add(UItem.asHeader(VoidGram.t("Профиль устройства", "Device profile")));
+        for (int k = VoidGramPowerSaving.KIND_PHONE; k <= VoidGramPowerSaving.KIND_LAPTOP; k++) {
+            String title = VoidGramPowerSaving.kindTitle(k) + (k == current ? VoidGram.t(" (это)", " (this)") : "");
+            items.add(UItem.asRadio(ID_KIND_BASE + k, title).setChecked(k == kind));
+        }
+        String status;
+        if (kind != current) {
+            status = VoidGram.t("Этот профиль сработает на другом типе устройства..", "This profile applies on another kind of device.");
+        } else {
+            Boolean saving = VoidGramPowerSaving.isSavingNow(LiteMode.getBatteryLevel());
+            if (saving == null) {
+                status = VoidGram.t("Сейчас решают настройки Telegram (Энергосбережение в Настройках).", "Telegram's own Power Saving settings decide now.");
+            } else {
+                status = saving ? VoidGram.t("Сейчас экономия включена.", "Saving power now.") : VoidGram.t("Сейчас экономия выключена.", "Not saving power now.");
+            }
+            int level = LiteMode.getBatteryLevel();
+            if (level >= 0) {
+                status += VoidGram.t(" Заряд: ", " Battery: ") + level + "%" + (VoidGramPowerSaving.plugged ? VoidGram.t(", заряжается.", ", charging.") : ".");
+            }
+        }
+        items.add(UItem.asShadow(status));
+
+        int mode = VoidGramPowerSaving.mode(kind);
+        items.add(UItem.asHeader(VoidGram.t("Когда экономить", "When to save power")));
+        for (int m = VoidGramPowerSaving.MODE_TELEGRAM; m <= VoidGramPowerSaving.MODE_ALWAYS; m++) {
+            items.add(UItem.asRadio(ID_MODE_BASE + m, VoidGramPowerSaving.modeTitle(m)).setChecked(m == mode));
+        }
+        items.add(UItem.asShadow(VoidGram.t("«Как в Telegram» оставляет обычный экран энергосбережения. Остальные режимы заменяют его на этом устройстве.", "\"Telegram's setting\" keeps Telegram's own Power Saving screen. The other modes replace it on this device.")));
+        if (mode == VoidGramPowerSaving.MODE_TELEGRAM) {
+            items.add(UItem.asButton(ID_RESET, VoidGram.t("Сбросить профиль", "Reset profile")).red());
+            items.add(UItem.asShadow(null));
+            return;
+        }
+        if (mode == VoidGramPowerSaving.MODE_BATTERY) {
+            items.add(UItem.asHeader(VoidGram.t("Порог заряда", "Battery level")));
+            final int profileKind = kind;
+            items.add(UItem.asIntSlideView(1, 5, VoidGramPowerSaving.threshold(kind), 95, value -> value + "%", value -> VoidGramPowerSaving.setThreshold(profileKind, value)));
+        }
+        items.add(UItem.asCheck(ID_SYSTEM, VoidGram.t("При системной экономии энергии", "With system battery saver")).setChecked(VoidGramPowerSaving.followSystem(kind)));
+        items.add(UItem.asCheck(ID_BATTERY, VoidGram.t("Всегда без зарядки", "Whenever not charging")).setChecked(VoidGramPowerSaving.onBattery(kind)));
+        items.add(UItem.asShadow(VoidGram.t("«Всегда без зарядки» удобно для ноутбука: экономия включается, как только вы отключаете питание.", "\"Whenever not charging\" suits a laptop: saving starts as soon as you unplug it.")));
+
+        items.add(UItem.asHeader(VoidGram.t("Что оставить во время экономии", "Keep while saving power")));
+        Set<String> limits = VoidGramPowerSaving.limits(kind);
+        for (int i = 0; i < VoidGramPowerSaving.LIMITS.length; i++) {
+            String limit = VoidGramPowerSaving.LIMITS[i];
+            items.add(UItem.asCheck(ID_LIMIT_BASE + i, VoidGramPowerSaving.limitTitle(limit)).setChecked(!limits.contains(limit)));
+        }
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asButton(ID_RESET, VoidGram.t("Сбросить профиль", "Reset profile")).red());
+        items.add(UItem.asShadow(null));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int id = item.id;
+        if (id >= ID_KIND_BASE && id <= ID_KIND_BASE + VoidGramPowerSaving.KIND_LAPTOP) {
+            kind = id - ID_KIND_BASE;
+        } else if (id >= ID_MODE_BASE && id <= ID_MODE_BASE + VoidGramPowerSaving.MODE_ALWAYS) {
+            VoidGramPowerSaving.setMode(kind, id - ID_MODE_BASE);
+        } else if (id == ID_SYSTEM) {
+            VoidGramPowerSaving.setFollowSystem(kind, !VoidGramPowerSaving.followSystem(kind));
+        } else if (id == ID_BATTERY) {
+            VoidGramPowerSaving.setOnBattery(kind, !VoidGramPowerSaving.onBattery(kind));
+        } else if (id >= ID_LIMIT_BASE && id < ID_LIMIT_BASE + VoidGramPowerSaving.LIMITS.length) {
+            String limit = VoidGramPowerSaving.LIMITS[id - ID_LIMIT_BASE];
+            VoidGramPowerSaving.setLimit(kind, limit, !VoidGramPowerSaving.limits(kind).contains(limit));
+        } else if (id == ID_RESET) {
+            VoidGramPowerSaving.reset(kind);
+        } else {
+            return;
+        }
+        refresh();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
