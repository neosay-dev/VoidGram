@@ -0,0 +1,196 @@
+package org.telegram.messenger.voidgram;
+
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** VoidGram → Interface: the switches of iOS "Interface" and "Privacy & extras". */
+public final class VoidGramInterface {
+    private VoidGramInterface() {
+    }
+
+    private static boolean get(String key) {
+        return VoidGram.prefs().getBoolean(key, false);
+    }
+
+    private static void set(String key, boolean value) {
+        VoidGram.prefs().edit().putBoolean(key, value).apply();
+    }
+
+    public static final String HIDE_STORIES = "ui_hide_stories";
+    public static final String NO_LINK_WARNING = "ui_no_link_warning";
+    public static final String NO_GREETING_STICKER = "ui_no_greeting_sticker";
+    public static final String NO_NEXT_CHANNEL = "ui_no_next_channel";
+    public static final String HIDE_KEYBOARD_ON_SCROLL = "ui_hide_keyboard_on_scroll";
+    public static final String HIDE_PHONE = "ui_hide_phone";
+    public static final String CLEAN_LINKS = "ui_clean_links";
+    public static final String COMMA_AFTER_MENTION = "ui_comma_after_mention";
+    public static final String BUBBLE_OUTLINE = "ui_bubble_outline";
+    public static final String HIDE_CONTACTS_TAB = "ui_hide_contacts_tab";
+
+    public static boolean is(String key) {
+        return get(key);
+    }
+
+    public static void toggle(String key) {
+        set(key, !get(key));
+    }
+
+    public static boolean hideStories() {
+        return get(HIDE_STORIES);
+    }
+
+    public static boolean noLinkWarning() {
+        return get(NO_LINK_WARNING);
+    }
+
+    public static boolean noGreetingSticker() {
+        return get(NO_GREETING_STICKER);
+    }
+
+    public static boolean noNextChannel() {
+        return get(NO_NEXT_CHANNEL);
+    }
+
+    public static boolean hideKeyboardOnScroll() {
+        return get(HIDE_KEYBOARD_ON_SCROLL);
+    }
+
+    public static boolean hidePhone() {
+        return get(HIDE_PHONE);
+    }
+
+    /** "@name, " at the start of a message, "@name " elsewhere. */
+    public static String mentionSuffix(int start) {
+        return start == 0 && get(COMMA_AFTER_MENTION) ? ", " : " ";
+    }
+
+    // ---- Clean links: tracking parameters are removed from links in sent messages. ----
+
+    private static final HashSet<String> EXACT = new HashSet<>(Arrays.asList(
+            "fbclid", "gclid", "gclsrc", "dclid", "msclkid", "yclid", "ysclid", "twclid", "ttclid",
+            "igsh", "igshid", "si", "mc_cid", "mc_eid", "_hsenc", "_hsmi", "mkt_tok", "vero_id",
+            "oly_anon_id", "oly_enc_id", "rb_clickid", "s_cid", "wickedid", "ref_src", "ref_url",
+            "share_id", "sharer_id", "xmt", "_openstat", "srsltid"));
+    private static final String[] PREFIXES = {"utm_", "pk_", "mtm_", "hsa_", "ga_"};
+    private static final Pattern LINK = Pattern.compile("https?://[^\\s<>\"«»]+", Pattern.CASE_INSENSITIVE);
+
+    public static String cleanLink(String link) {
+        if (link == null) {
+            return null;
+        }
+        int question = link.indexOf('?');
+        if (question < 0) {
+            return link;
+        }
+        String base = link.substring(0, question);
+        String rest = link.substring(question + 1);
+        String fragment = "";
+        int hash = rest.indexOf('#');
+        if (hash >= 0) {
+            fragment = rest.substring(hash);
+            rest = rest.substring(0, hash);
+        }
+        String[] parameters = rest.split("&");
+        ArrayList<String> kept = new ArrayList<>();
+        int total = 0;
+        for (String parameter : parameters) {
+            if (parameter.isEmpty()) {
+                continue;
+            }
+            total++;
+            int eq = parameter.indexOf('=');
+            String name = (eq >= 0 ? parameter.substring(0, eq) : parameter).toLowerCase(Locale.ROOT);
+            boolean drop = EXACT.contains(name);
+            for (String prefix : PREFIXES) {
+                if (name.startsWith(prefix)) {
+                    drop = true;
+                }
+            }
+            if (!drop) {
+                kept.add(parameter);
+            }
+        }
+        if (kept.size() == total) {
+            return link;
+        }
+        return base + (kept.isEmpty() ? "" : "?" + String.join("&", kept)) + fragment;
+    }
+
+    /** Cleans the text and moves the formatting so it stays on the same characters. */
+    public static void cleanOutgoing(SendMessagesHelper.SendMessageParams params) {
+        if (params == null || !get(CLEAN_LINKS)) {
+            return;
+        }
+        try {
+            if (params.entities != null) {
+                for (TLRPC.MessageEntity entity : params.entities) {
+                    if (entity instanceof TLRPC.TL_messageEntityTextUrl && entity.url != null) {
+                        entity.url = cleanLink(entity.url);
+                    }
+                }
+            }
+            String text = params.message;
+            if (text == null || text.indexOf('?') < 0) {
+                return;
+            }
+            Matcher matcher = LINK.matcher(text);
+            StringBuilder result = new StringBuilder();
+            int last = 0;
+            int shift = 0;
+            while (matcher.find()) {
+                String link = matcher.group();
+                int end = link.length();
+                while (end > 0 && ".,!?;:)]".indexOf(link.charAt(end - 1)) >= 0) {
+                    end--;
+                }
+                String bare = link.substring(0, end);
+                String cleaned = cleanLink(bare);
+                if (cleaned.equals(bare)) {
+                    continue;
+                }
+                int start = matcher.start();
+                result.append(text, last, start).append(cleaned);
+                last = start + bare.length();
+                int delta = cleaned.length() - bare.length();
+                if (params.entities != null) {
+                    // Positions in the new text: the link starts at start + shift.
+                    int from = start + shift;
+                    int to = from + bare.length();
+                    for (TLRPC.MessageEntity entity : params.entities) {
+                        int entityStart = entity.offset;
+                        int entityEnd = entity.offset + entity.length;
+                        if (entityStart >= to) {
+                            entity.offset += delta;
+                        } else if (entityEnd > from) {
+                            int newEnd = entityEnd >= to ? entityEnd + delta : Math.min(entityEnd, from + cleaned.length());
+                            int newStart = Math.min(entityStart, from + cleaned.length());
+                            entity.offset = newStart;
+                            entity.length = Math.max(0, newEnd - newStart);
+                        }
+                    }
+                }
+                shift += delta;
+            }
+            if (last == 0) {
+                return;
+            }
+            result.append(text, last, text.length());
+            params.message = result.toString();
+            if (params.entities != null) {
+                for (int i = params.entities.size() - 1; i >= 0; i--) {
+                    if (params.entities.get(i).length <= 0) {
+                        params.entities.remove(i);
+                    }
+                }
+            }
+        } catch (Throwable ignore) {
+        }
+    }
+}
