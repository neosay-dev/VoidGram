@@ -0,0 +1,125 @@
+package org.telegram.messenger.voidgram;
+
+import android.view.Window;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.HashSet;
+import java.util.Locale;
+
+/** Sleep timer, streamer mode and the name guard, as on iOS. */
+public final class VoidGramExtras {
+    private VoidGramExtras() {
+    }
+
+    // ---- Sleep timer: pauses the player after the chosen time, even with the player closed. ----
+
+    private static Runnable sleepRunnable;
+    private static long sleepAt;
+
+    public static final int[] SLEEP_MINUTES = {5, 10, 15, 30, 45, 60, 90, 120};
+
+    public static void startSleepTimer(int minutes) {
+        cancelSleepTimer();
+        sleepAt = System.currentTimeMillis() + minutes * 60_000L;
+        sleepRunnable = () -> {
+            sleepRunnable = null;
+            sleepAt = 0;
+            MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+            if (playing != null && !MediaController.getInstance().isMessagePaused()) {
+                MediaController.getInstance().pauseMessage(playing);
+            }
+        };
+        AndroidUtilities.runOnUIThread(sleepRunnable, minutes * 60_000L);
+    }
+
+    public static void cancelSleepTimer() {
+        if (sleepRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(sleepRunnable);
+            sleepRunnable = null;
+        }
+        sleepAt = 0;
+    }
+
+    /** Minutes left, or 0 without a timer. */
+    public static int sleepMinutesLeft() {
+        if (sleepRunnable == null || sleepAt == 0) {
+            return 0;
+        }
+        long left = sleepAt - System.currentTimeMillis();
+        return left <= 0 ? 0 : (int) Math.max(1, (left + 59_999) / 60_000);
+    }
+
+    // ---- Streamer mode: the app is left out of screenshots, recordings and screen sharing. ----
+
+    public static boolean streamerMode() {
+        return VoidGram.prefs().getBoolean("streamer_mode", false);
+    }
+
+    public static void setStreamerMode(boolean value) {
+        VoidGram.prefs().edit().putBoolean("streamer_mode", value).apply();
+    }
+
+    public static void applyStreamerMode(Window window) {
+        org.telegram.messenger.FlagSecureReason.refreshWindow(window);
+    }
+
+    // ---- Name guard: a non-contact posing as staff, or mixing alphabets, gets one warning. ----
+
+    private static final HashSet<Long> warned = new HashSet<>();
+    private static final String[] IMPERSONATED = {"telegram", "телеграм", "support", "поддержк", "durov", "дуров", "admin", "админ", "модератор", "moderator", "security", "безопасност", "ayugram", "voidgram"};
+
+    public static boolean nameGuardEnabled() {
+        return VoidGram.prefs().getBoolean("name_guard", true);
+    }
+
+    public static void setNameGuardEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("name_guard", value).apply();
+    }
+
+    /** A warning for this chat partner, at most once per chat and launch, or null. */
+    public static String nameWarning(TLRPC.User user) {
+        if (user == null || !nameGuardEnabled() || VoidGramDecoy.isActive() || user.bot || user.contact || user.self || user.id == 777000 || warned.contains(user.id)) {
+            return null;
+        }
+        StringBuilder reasons = new StringBuilder();
+        String name = ((user.first_name != null ? user.first_name : "") + " " + (user.last_name != null ? user.last_name : "")).trim();
+        for (String word : name.split("[ _\\-]")) {
+            boolean latin = false;
+            boolean cyrillic = false;
+            for (int i = 0; i < word.length(); i++) {
+                char c = word.charAt(i);
+                if (c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z') {
+                    latin = true;
+                }
+                if (c >= 0x0400 && c <= 0x04FF) {
+                    cyrillic = true;
+                }
+            }
+            if (latin && cyrillic) {
+                reasons.append(VoidGram.t("в имени смешаны латинские и русские буквы", "the name mixes Latin and Cyrillic letters"));
+                break;
+            }
+        }
+        String lowered = name.toLowerCase(Locale.ROOT);
+        if (!user.verified) {
+            for (String word : IMPERSONATED) {
+                if (lowered.contains(word)) {
+                    if (reasons.length() > 0) {
+                        reasons.append("; ");
+                    }
+                    reasons.append(VoidGram.t("имя похоже на официальную поддержку — настоящая поддержка Telegram не пишет первой", "the name looks like official support, and real Telegram support never writes first"));
+                    break;
+                }
+            }
+        }
+        if (reasons.length() == 0) {
+            return null;
+        }
+        warned.add(user.id);
+        return VoidGram.t("Осторожно: ", "Careful: ") + reasons + ".";
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramFilters.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramFilters.java
