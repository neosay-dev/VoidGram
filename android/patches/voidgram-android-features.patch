+                cancel[0].run();
+            }
+        });
+        progress.setCanceledOnTouchOutside(false);
+        progress.setCancelable(false);
+        fragment.showDialog(progress);
+        cancel[0] = VoidGramChatExport.start(account, dialogId, media, new VoidGramChatExport.Listener() {
+            @Override
+            public void onProgress(int messages, long mediaBytes) {
+                progress.setMessage(VoidGram.t("Сообщений: ", "Messages: ") + messages + (mediaBytes > 0 ? "\n" + VoidGram.t("Медиа: ", "Media: ") + AndroidUtilities.formatFileSize(mediaBytes) : ""));
+            }
+
+            @Override
+            public void onDone(File file, String error) {
+                try {
+                    progress.dismiss();
+                } catch (Throwable ignore) {
+                }
