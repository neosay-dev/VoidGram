+                    BulletinFactory.of(fragment).createErrorBulletin(error != null ? error : VoidGram.t("Экспорт не удался", "Export failed")).show();
+                    return;
+                }
+                share(fragment, file);
+            }
+        });
+    }
+
+    private static void share(BaseFragment fragment, File file) {
+        try {
+            Uri uri = androidx.core.content.FileProvider.getUriForFile(fragment.getParentActivity(), ApplicationLoader.getApplicationId() + ".provider", file);
+            Intent intent = new Intent(Intent.ACTION_SEND);
+            intent.setType("application/zip");
+            intent.putExtra(Intent.EXTRA_STREAM, uri);
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
