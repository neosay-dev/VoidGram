@@ -0,0 +1,107 @@
+package org.telegram.messenger.voidgram;
+
+import java.nio.ByteBuffer;
+
+/**
+ * Voice changer for voice messages, as on iOS: the microphone samples are changed before they are
+ * encoded. Pitch moves with two crossfaded read heads on a delay line, so the duration stays the
+ * same; "Robot" is a ring modulator.
+ */
+public final class VoidGramVoiceChanger {
+    public static final String[] VOICES = {"off", "high", "low", "robot"};
+
+    private static VoidGramVoiceChanger current;
+
+    private final double pitch;
+    private final boolean robot;
+    private final double sampleRate;
+    private final double window;
+    private final float[] buffer;
+    private int writeIndex;
+    private double phase;
+    private double robotPhase;
+
+    private VoidGramVoiceChanger(String voice, int sampleRate) {
+        this.pitch = "high".equals(voice) ? 1.45 : "low".equals(voice) ? 0.72 : 1.0;
+        this.robot = "robot".equals(voice);
+        this.sampleRate = sampleRate;
+        this.window = 960.0 * sampleRate / 16000.0;
+        this.buffer = new float[Math.max(4096, (int) (4096L * sampleRate / 16000))];
+    }
+
+    public static String voice() {
+        return VoidGram.prefs().getString("voice_changer", "off");
+    }
+
+    public static void setVoice(String value) {
+        VoidGram.prefs().edit().putString("voice_changer", value).apply();
+    }
+
+    public static String title(String voice) {
+        switch (voice) {
+            case "high": return VoidGram.t("Высокий голос", "High voice");
+            case "low": return VoidGram.t("Низкий голос", "Low voice");
+            case "robot": return VoidGram.t("Робот", "Robot");
+            default: return VoidGram.t("Выключен", "Off");
+        }
+    }
+
+    /** MediaController: a new recording starts. */
+    public static void reset(int sampleRate) {
+        String voice = voice();
+        current = "off".equals(voice) || VoidGramDecoy.isActive() ? null : new VoidGramVoiceChanger(voice, sampleRate);
+    }
+
+    /** MediaController: 16-bit samples of the microphone, changed in place. */
+    public static void process(ByteBuffer samples, int bytes) {
+        VoidGramVoiceChanger changer = current;
+        if (changer == null || samples == null) {
+            return;
+        }
+        int count = bytes / 2;
+        for (int i = 0; i < count; i++) {
+            short value = samples.getShort(i * 2);
+            samples.putShort(i * 2, changer.next(value));
+        }
+    }
+
+    private float read(double delay) {
+        int size = buffer.length;
+        double position = writeIndex - delay;
+        while (position < 0) {
+            position += size;
+        }
+        int index = ((int) position) % size;
+        int next = (index + 1) % size;
+        float fraction = (float) (position - (int) position);
+        return buffer[index] * (1f - fraction) + buffer[next] * fraction;
+    }
+
+    private short next(short sample) {
+        float input = sample / 32768f;
+        buffer[writeIndex] = input;
+        float output;
+        if (robot) {
+            output = (float) (input * Math.sin(robotPhase) * 1.6);
+            robotPhase += 2.0 * Math.PI * 70.0 / sampleRate;
+            if (robotPhase > 2.0 * Math.PI) {
+                robotPhase -= 2.0 * Math.PI;
+            }
+        } else {
+            double firstPhase = phase;
+            double secondPhase = phase + 0.5;
+            if (secondPhase >= 1.0) {
+                secondPhase -= 1.0;
+            }
+            float first = read(firstPhase * window + 1.0);
+            float second = read(secondPhase * window + 1.0);
+            float firstGain = (float) (Math.sin(Math.PI * firstPhase) * Math.sin(Math.PI * firstPhase));
+            float secondGain = (float) (Math.sin(Math.PI * secondPhase) * Math.sin(Math.PI * secondPhase));
+            output = first * firstGain + second * secondGain;
+            phase += (1.0 - pitch) / window;
+            phase -= Math.floor(phase);
+        }
+        writeIndex = (writeIndex + 1) % buffer.length;
+        return (short) Math.max(-32768f, Math.min(32767f, output * 32767f));
+    }
+}
