+package org.telegram.ui.voidgram;
+
+import android.app.Dialog;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.util.Base64;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.HashMap;
+
+/**
+ * Visual quote, compatible with iOS: a reply points at a part of a photo. The region rides on
+ * the reply as an invisible character with a link entity ("VQ1" + kind + six floats), so it
+ * reaches every client; VoidGram on iOS and Android show the highlighted part.
+ */
+public final class VoidGramVisualQuote {
+    private VoidGramVisualQuote() {
+    }
+
+    private static final String MARKER = "​";
+    private static final String PREFIX = "https://example.com/visual-quote#";
+
+    /** dialog id → {reply message id, region}. */
+    private static final HashMap<Long, Object[]> pending = new HashMap<>();
+
+    public static final class Region {
+        public boolean object;
+        public float pointX;
+        public float pointY;
+        public RectF rect = new RectF();
+    }
+
+    public static String encode(Region region) {
+        ByteBuffer buffer = ByteBuffer.allocate(3 + 1 + 6 * 4).order(ByteOrder.LITTLE_ENDIAN);
+        buffer.put((byte) 0x56).put((byte) 0x51).put((byte) 0x31);
+        buffer.put((byte) (region.object ? 1 : 0));
+        buffer.putFloat(region.pointX).putFloat(region.pointY);
+        buffer.putFloat(region.rect.left).putFloat(region.rect.top).putFloat(region.rect.width()).putFloat(region.rect.height());
+        return PREFIX + Base64.encodeToString(buffer.array(), Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
+    }
+
+    public static Region decode(String url) {
+        if (url == null || !url.startsWith(PREFIX)) {
+            return null;
+        }
+        try {
+            byte[] data = Base64.decode(url.substring(PREFIX.length()), Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
+            if (data.length != 28 || data[0] != 0x56 || data[1] != 0x51 || data[2] != 0x31) {
+                return null;
+            }
+            ByteBuffer buffer = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN);
+            buffer.position(3);
+            Region region = new Region();
+            region.object = buffer.get() == 1;
+            region.pointX = buffer.getFloat();
+            region.pointY = buffer.getFloat();
+            float x = buffer.getFloat();
+            float y = buffer.getFloat();
+            float w = buffer.getFloat();
+            float h = buffer.getFloat();
+            region.rect.set(x, y, x + w, y + h);
+            return region;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    /** The region a message carries, or null. */
+    public static Region regionOf(MessageObject message) {
+        if (message == null || message.messageOwner == null || message.messageOwner.entities == null) {
+            return null;
+        }
+        for (TLRPC.MessageEntity entity : message.messageOwner.entities) {
+            if (entity instanceof TLRPC.TL_messageEntityTextUrl && entity.offset == 0) {
+                Region region = decode(entity.url);
+                if (region != null) {
+                    return region;
+                }
+            }
+        }
+        return null;
+    }
+
+    public static boolean canQuote(MessageObject message) {
+        return message != null && message.isPhoto() && message.getId() > 0 && !message.needDrawBluredPreview();
+    }
+
+    private static Bitmap bitmap(MessageObject message) {
+        try {
+            File file = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+            if (file == null || !file.exists()) {
+                TLRPC.PhotoSize size = org.telegram.messenger.FileLoader.getClosestPhotoSizeWithSize(message.photoThumbs, AndroidUtilities.getPhotoSize());
+                file = size != null ? FileLoader.getInstance(message.currentAccount).getPathToAttach(size, true) : null;
+            }
+            return file != null && file.exists() ? BitmapFactory.decodeFile(file.getAbsolutePath()) : null;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    /** Message menu → "Quote a part": tap the photo, then the reply goes to that part. */
+    public static void pick(ChatActivity chat, MessageObject message) {
+        Bitmap image = bitmap(message);
+        if (image == null) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Сначала загрузите фото.", "Download the photo first.")).show();
+            return;
+        }
+        show(chat, image, null, region -> {
+            pending.put(chat.getDialogId(), new Object[]{message.getId(), region});
+            chat.showFieldPanelForReply(message);
+            BulletinFactory.of(chat).createSimpleBulletin(org.telegram.messenger.R.raw.contact_check, VoidGram.t("Ответ на выделенную часть фото", "Replying to the marked part of the photo")).show();
+        });
+    }
+
+    /** Message menu → "Show the quoted part" on a reply that carries a region. */
+    public static void showQuoted(ChatActivity chat, MessageObject reply) {
+        Region region = regionOf(reply);
+        MessageObject photo = reply.replyMessageObject;
+        if (region == null || photo == null) {
+            return;
+        }
+        Bitmap image = bitmap(photo);
+        if (image == null) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Фото ещё не загружено.", "The photo is not downloaded yet.")).show();
+            return;
+        }
+        show(chat, image, region, null);
+    }
+
+    private interface Picked {
+        void run(Region region);
+    }
+
+    private static void show(ChatActivity chat, Bitmap image, Region shown, Picked picked) {
+        Dialog dialog = new Dialog(chat.getParentActivity(), android.R.style.Theme_Black_NoTitleBar_Fullscreen);
+        FrameLayout frame = new FrameLayout(chat.getParentActivity());
+        frame.setBackgroundColor(Color.BLACK);
+        final Region[] current = {shown};
+        View canvasView = new View(chat.getParentActivity()) {
+            private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+            private final Paint dim = new Paint();
+            private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+            final RectF imageRect = new RectF();
+
+            {
+                dim.setColor(0x99000000);
+                stroke.setStyle(Paint.Style.STROKE);
+                stroke.setStrokeWidth(AndroidUtilities.dp(2.5f));
+                stroke.setColor(0xFF4FA3FF);
+            }
+
+            @Override
+            protected void onDraw(Canvas canvas) {
+                float scale = Math.min(getWidth() / (float) image.getWidth(), getHeight() / (float) image.getHeight());
+                float w = image.getWidth() * scale;
+                float h = image.getHeight() * scale;
+                imageRect.set((getWidth() - w) / 2f, (getHeight() - h) / 2f, (getWidth() + w) / 2f, (getHeight() + h) / 2f);
+                canvas.drawBitmap(image, null, imageRect, paint);
+                Region region = current[0];
+                if (region != null) {
+                    RectF r = new RectF(imageRect.left + region.rect.left * w, imageRect.top + region.rect.top * h, imageRect.left + region.rect.right * w, imageRect.top + region.rect.bottom * h);
+                    canvas.drawRect(imageRect.left, imageRect.top, imageRect.right, r.top, dim);
+                    canvas.drawRect(imageRect.left, r.bottom, imageRect.right, imageRect.bottom, dim);
+                    canvas.drawRect(imageRect.left, r.top, r.left, r.bottom, dim);
+                    canvas.drawRect(r.right, r.top, imageRect.right, r.bottom, dim);
+                    canvas.drawRoundRect(r, AndroidUtilities.dp(10), AndroidUtilities.dp(10), stroke);
+                }
+            }
+
+            @Override
+            public boolean onTouchEvent(MotionEvent event) {
+                if (picked == null || event.getAction() != MotionEvent.ACTION_UP || imageRect.width() <= 0) {
+                    return picked != null;
+                }
+                float nx = (event.getX() - imageRect.left) / imageRect.width();
+                float ny = (event.getY() - imageRect.top) / imageRect.height();
+                if (nx < 0 || ny < 0 || nx > 1 || ny > 1) {
+                    return true;
+                }
+                Region region = new Region();
+                region.pointX = nx;
+                region.pointY = ny;
+                float half = 0.15f;
+                region.rect.set(Math.max(0, nx - half), Math.max(0, ny - half), Math.min(1, nx + half), Math.min(1, ny + half));
+                current[0] = region;
+                invalidate();
+                return true;
+            }
+        };
+        frame.addView(canvasView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        TextView hint = new TextView(chat.getParentActivity());
+        hint.setTextColor(Color.WHITE);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        hint.setGravity(Gravity.CENTER);
+        hint.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(12), AndroidUtilities.dp(16), AndroidUtilities.dp(12));
+        hint.setBackgroundColor(0x99000000);
+        hint.setText(picked != null ? VoidGram.t("Нажмите на часть фото, затем «Ответить»", "Tap a part of the photo, then \"Reply\"") : VoidGram.t("Ответ на эту часть фото", "The reply points at this part"));
+        frame.addView(hint, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP, 0, 24, 0, 0));
+        TextView done = new TextView(chat.getParentActivity());
+        done.setTextColor(Color.WHITE);
+        done.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        done.setGravity(Gravity.CENTER);
+        done.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(12), AndroidUtilities.dp(24), AndroidUtilities.dp(12));
+        android.graphics.drawable.GradientDrawable background = new android.graphics.drawable.GradientDrawable();
+        background.setCornerRadius(AndroidUtilities.dp(22));
+        background.setColor(0xFF3A7BFF);
+        done.setBackground(background);
+        done.setText(picked != null ? VoidGram.t("Ответить", "Reply") : VoidGram.t("Закрыть", "Close"));
+        done.setOnClickListener(v -> {
+            if (picked != null) {
+                if (current[0] == null) {
+                    return;
+                }
+                picked.run(current[0]);
+            }
+            dialog.dismiss();
+        });
+        frame.addView(done, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL, 0, 0, 0, 40));
+        dialog.setContentView(frame, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        dialog.show();
+    }
+
+    /** SendMessagesHelper: the pending region goes onto the reply to its photo. */
+    public static void applyToOutgoing(SendMessagesHelper.SendMessageParams params) {
+        if (params == null || params.message == null || params.replyToMsg == null) {
+            return;
+        }
+        Object[] entry = pending.get(params.peer);
+        if (entry == null || (int) entry[0] != params.replyToMsg.getId()) {
+            return;
+        }
+        pending.remove(params.peer);
+        Region region = (Region) entry[1];
+        if (params.entities == null) {
+            params.entities = new java.util.ArrayList<>();
+        }
+        for (TLRPC.MessageEntity entity : params.entities) {
+            entity.offset += MARKER.length();
+        }
+        TLRPC.TL_messageEntityTextUrl link = new TLRPC.TL_messageEntityTextUrl();
+        link.offset = 0;
+        link.length = MARKER.length();
+        link.url = encode(region);
+        params.entities.add(0, link);
+        params.message = MARKER + params.message;
+        params.searchLinks = false;
+    }
+}
