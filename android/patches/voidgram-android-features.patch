+            case ID_SHORTCUTS:
+                presentFragment(new VoidGramShortcutsActivity());
+                break;
+            case ID_SMART_FOLDERS:
+                VoidGramSmartFolders.show(this);
+                break;
+            case ID_VT_KEY:
+                askText(VoidGram.t("Ключ VirusTotal", "VirusTotal key"), VoidGramOnlineTools.virusTotalKey(), "x-apikey", true, value -> { VoidGramOnlineTools.setVirusTotalKey(value); update(); });
+                break;
+            case ID_AI_KEY:
+                askText(VoidGram.t("Ключ ИИ", "AI key"), VoidGramOnlineTools.aiKey(), "sk-…", true, value -> { VoidGramOnlineTools.setAiKey(value); update(); });
+                break;
+            case ID_AI_ENDPOINT:
+                askText(VoidGram.t("Адрес ИИ", "AI address"), VoidGramOnlineTools.aiEndpoint(), VoidGramOnlineTools.DEFAULT_AI_ENDPOINT, false, value -> { VoidGramOnlineTools.setAiEndpoint(value); update(); });
+                break;
+            case ID_AI_MODEL:
+                askText(VoidGram.t("Модель ИИ", "AI model"), VoidGramOnlineTools.aiModel(), VoidGramOnlineTools.DEFAULT_AI_MODEL, false, value -> { VoidGramOnlineTools.setAiModel(value); update(); });
+                break;
+            case ID_VIDEO:
+                VoidGramVideoDownloader.setEnabled(!VoidGramVideoDownloader.isEnabled());
+                update();
+                break;
+            case ID_COBALT:
+                askText(VoidGram.t("Сервер cobalt", "cobalt server"), VoidGramVideoDownloader.cobaltServer(), "https://cobalt.example.com", false, value -> {
+                    VoidGramVideoDownloader.setCobaltServer(value);
+                    update();
+                });
+                break;
+            case ID_COBALT_KEY:
+                askText(VoidGram.t("Ключ cobalt", "cobalt key"), VoidGramVideoDownloader.cobaltKey(), "Api-Key", true, value -> {
+                    VoidGramVideoDownloader.setCobaltKey(value);
+                    update();
+                });
+                break;
+            case ID_TRANSCRIBE:
+                if (android.os.Build.VERSION.SDK_INT >= 33) {
+                    org.telegram.messenger.voidgram.VoidGramTranscribe.setEnabled(!org.telegram.messenger.voidgram.VoidGramTranscribe.isEnabled());
+                    update();
+                }
+                break;
+            case ID_SPOILERS:
+                VoidGramPremium.setRevealSpoilers(!VoidGramPremium.revealSpoilers());
+                update();
+                break;
+            case ID_NUMBERS:
+                VoidGramPremium.setFullNumbers(!VoidGramPremium.fullNumbers());
+                update();
+                break;
+            default:
+                break;
+        }
+    }
+
+    private EditText field(Context context, String hint, boolean password) {
+        EditText field = new EditText(context);
+        field.setHint(hint);
+        field.setSingleLine(true);
+        field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        field.setHintTextColor(Theme.getColor(Theme.key_dialogTextGray3));
+        field.setInputType(password ? InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD : InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        return field;
+    }
+
+    private void askText(String title, String value, String hint, boolean secret, org.telegram.messenger.Utilities.Callback<String> done) {
+        EditText input = field(getContext(), hint, secret);
+        input.setText(value);
+        LinearLayout layout = new LinearLayout(getContext());
+        layout.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(4), AndroidUtilities.dp(20), 0);
+        layout.addView(input, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(title);
+        builder.setView(layout);
+        builder.setPositiveButton("OK", (d, w) -> done.run(input.getText().toString()));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    private void connectLastFm() {
+        Context context = getContext();
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(4), AndroidUtilities.dp(20), 0);
+        EditText apiKey = field(context, "API key", false);
+        EditText secret = field(context, "Shared secret", false);
+        EditText username = field(context, VoidGram.t("Логин Last.fm", "Last.fm username"), false);
+        EditText password = field(context, VoidGram.t("Пароль", "Password"), true);
+        layout.addView(apiKey);
+        layout.addView(secret);
+        layout.addView(username);
+        layout.addView(password);
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle("Last.fm");
+        builder.setView(layout);
+        builder.setPositiveButton(VoidGram.t("Войти", "Sign in"), (d, w) -> {
+            String a = apiKey.getText().toString(), s = secret.getText().toString(), u = username.getText().toString(), p = password.getText().toString();
+            if (a.trim().isEmpty() || s.trim().isEmpty() || u.trim().isEmpty() || p.isEmpty()) {
+                BulletinFactory.of(this).createErrorBulletin(VoidGram.t("Заполните все поля", "Fill in every field")).show();
+                return;
+            }
+            VoidGramLastFm.connect(a, s, u, p, error -> {
+                if (error == null) {
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.done, VoidGram.t("Last.fm подключён", "Last.fm connected")).show();
+                } else {
+                    VoidGramLastFm.disconnect();
+                    BulletinFactory.of(this).createErrorBulletin("Last.fm: " + error).show();
+                }
+                update();
+            });
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
