+        }
+        items.add(UItem.asShadow(VoidGram.t("Мой бейдж — после вашего имени в Настройках. Бейдж чату: меню чата (⋮) → «Бейдж чата». Нажмите, чтобы изменить.", "My badge shows after your name in Settings. A chat badge: chat menu (⋮) → \"Chat badge\". Tap one to change it.")));
+        items.add(UItem.asButton(ID_RESET, R.drawable.msg_reset, VoidGram.t("Сбросить кастомизацию", "Reset customization")).red());
+        items.add(UItem.asShadow(null));
+    }
+
+    private void update() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_MY_BADGE || item.id >= ID_BADGE_BASE && item.id - ID_BADGE_BASE < badged.size()) {
+            final boolean mineBadge = item.id == ID_MY_BADGE;
+            final long dialogId = mineBadge ? 0 : badged.get(item.id - ID_BADGE_BASE);
+            EditText field = new EditText(getContext());
+            field.setText(mineBadge ? VoidGramCustomization.myBadge() : VoidGramCustomization.badge(dialogId));
+            field.setSingleLine(true);
+            field.setHint(VoidGram.t("до 16 символов", "up to 16 characters"));
+            field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+            builder.setTitle(mineBadge ? VoidGram.t("Мой бейдж", "My badge") : VoidGram.t("Бейдж чата", "Chat badge"));
+            builder.setView(field);
+            builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (d, w) -> {
+                if (mineBadge) {
+                    VoidGramCustomization.setMyBadge(field.getText().toString());
+                } else {
+                    VoidGramCustomization.setBadge(dialogId, field.getText().toString());
+                }
+                update();
+            });
+            builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+            showDialog(builder.create());
+            return;
+        }
+        if (item.id == ID_RESET) {
+            VoidGramCustomization.reset();
+            update();
+        } else if (item.id >= ID_PRESET_BASE && item.id - ID_PRESET_BASE < VoidGramCustomization.PRESETS.length) {
+            VoidGramCustomization.apply(VoidGramCustomization.PRESETS[item.id - ID_PRESET_BASE]);
+            update();
+        } else if (item.id >= ID_COLOR_BASE && item.id - ID_COLOR_BASE < VoidGramCustomization.COLORS.length) {
+            String color = VoidGramCustomization.COLORS[item.id - ID_COLOR_BASE];
+            EditText field = new EditText(getContext());
+            String hex = VoidGramCustomization.hex(color);
+            field.setText(hex != null ? hex : "");
+            field.setHint("#8E5CF7");
+            field.setSingleLine(true);
+            field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+            builder.setTitle(VoidGramCustomization.title(color));
+            builder.setView(field);
+            builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (d, w) -> {
+                VoidGramCustomization.set(color, field.getText().toString());
+                update();
+            });
+            builder.setNeutralButton(VoidGram.t("Как в теме", "Theme colour"), (d, w) -> {
+                VoidGramCustomization.set(color, null);
+                update();
+            });
+            builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+            showDialog(builder.create());
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
