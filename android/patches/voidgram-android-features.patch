+    private static String yearText(int account, int year, int start, ArrayList<TLRPC.Message> messages) {
+        if (messages.isEmpty()) {
+            return VoidGram.t("За этот год в этом чате нет сообщений.", "No messages in this chat this year.");
+        }
+        HashMap<String, Integer> authors = new HashMap<>();
+        HashMap<String, Integer> words = new HashMap<>();
+        HashMap<String, Integer> emoji = new HashMap<>();
+        HashMap<Integer, Integer> days = new HashMap<>();
+        int[] months = new int[12];
+        int media = 0;
+        int voice = 0;
+        int mine = 0;
+        Calendar calendar = Calendar.getInstance();
+        for (TLRPC.Message message : messages) {
+            String name = authorName(account, message);
+            authors.put(name, (authors.containsKey(name) ? authors.get(name) : 0) + 1);
+            calendar.setTimeInMillis(message.date * 1000L);
+            months[calendar.get(Calendar.MONTH)]++;
+            int day = calendar.get(Calendar.DAY_OF_YEAR);
+            days.put(day, (days.containsKey(day) ? days.get(day) : 0) + 1);
+            if (message.out) {
+                mine++;
+            }
+            if (message.media != null && !(message.media instanceof TLRPC.TL_messageMediaEmpty) && !(message.media instanceof TLRPC.TL_messageMediaWebPage)) {
+                if (MessageObject.isVoiceMessage(message) || MessageObject.isRoundVideoMessage(message)) {
+                    voice++;
+                } else {
+                    media++;
+                }
+            }
+            String text = message.message == null ? "" : message.message;
+            for (String word : text.toLowerCase(Locale.getDefault()).split("[^\\p{L}]+")) {
+                if (word.length() >= 4) {
+                    words.put(word, (words.containsKey(word) ? words.get(word) : 0) + 1);
+                }
+            }
+            for (int i = 0; i < text.length(); ) {
+                int code = text.codePointAt(i);
+                int length = Character.charCount(code);
+                if (code >= 0x1F300 && code <= 0x1FAFF || code >= 0x2600 && code <= 0x27BF) {
+                    String symbol = new String(Character.toChars(code));
+                    emoji.put(symbol, (emoji.containsKey(symbol) ? emoji.get(symbol) : 0) + 1);
+                }
+                i += length;
+            }
+        }
+        int busiestMonth = 0;
+        for (int i = 1; i < 12; i++) {
+            if (months[i] > months[busiestMonth]) {
+                busiestMonth = i;
+            }
+        }
+        int busiestDay = 0;
+        int busiestCount = 0;
+        for (Map.Entry<Integer, Integer> entry : days.entrySet()) {
+            if (entry.getValue() > busiestCount) {
+                busiestCount = entry.getValue();
+                busiestDay = entry.getKey();
+            }
+        }
+        calendar.setTimeInMillis(start * 1000L);
+        calendar.set(Calendar.DAY_OF_YEAR, Math.max(1, busiestDay));
+        String busiestDayText = DateFormat.getDateInstance(DateFormat.MEDIUM).format(calendar.getTime());
+        String[] monthNames = VoidGram.russian()
+                ? new String[]{"январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь"}
+                : new java.text.DateFormatSymbols(Locale.ENGLISH).getMonths();
+        String topAuthors = top(authors, 3, " — ");
+        StringBuilder topWords = new StringBuilder();
+        for (String line : top(words, 5, "\t").split("\n")) {
+            if (line.isEmpty()) continue;
+            if (topWords.length() > 0) topWords.append(", ");
+            topWords.append(line.substring(0, line.indexOf('\t')));
+        }
+        StringBuilder topEmoji = new StringBuilder();
+        for (String line : top(emoji, 5, "\t").split("\n")) {
+            if (line.isEmpty()) continue;
+            topEmoji.append(line.substring(0, line.indexOf('\t')));
+        }
+        String wordsText = topWords.length() == 0 ? "—" : topWords.toString();
+        String emojiText = topEmoji.length() == 0 ? "—" : topEmoji.toString();
+        return VoidGram.russian()
+                ? year + ": " + messages.size() + " сообщений, из них ваших " + mine + ".\n\nБольше всех писали:\n" + topAuthors + "\n\nСамый активный месяц: " + monthNames[busiestMonth] + "\nСамый активный день: " + busiestDayText + " (" + busiestCount + ")\nМедиа: " + media + ", голосовых и кружков: " + voice + "\nЧастые слова: " + wordsText + "\nЛюбимые эмодзи: " + emojiText
+                : year + ": " + messages.size() + " messages, " + mine + " of them yours.\n\nMost active:\n" + topAuthors + "\n\nBusiest month: " + monthNames[busiestMonth] + "\nBusiest day: " + busiestDayText + " (" + busiestCount + ")\nMedia: " + media + ", voice and video messages: " + voice + "\nFrequent words: " + wordsText + "\nFavourite emoji: " + emojiText;
+    }
