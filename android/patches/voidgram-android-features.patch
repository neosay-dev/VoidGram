+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static int rgb(String color) {
+        return parse(hex(color));
+    }
+
+    private static Integer[] colors() {
+        if (cachedRevision == revision && cached != null) {
+            return cached;
+        }
+        Integer[] result = new Integer[COLORS.length];
+        boolean active = !VoidGramDecoy.isActive();
+        for (int i = 0; i < COLORS.length; i++) {
+            int value = active ? rgb(COLORS[i]) : -1;
+            result[i] = value < 0 ? null : 0xFF000000 | value;
+        }
+        cached = result;
+        cachedRevision = revision;
+        return result;
+    }
