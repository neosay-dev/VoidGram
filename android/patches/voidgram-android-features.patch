+        items.add(UItem.asShadow(VoidGram.t("Цвет в формате #RRGGBB. Пустое поле — как в теме Telegram. Обновлённый фон чата виден, когда чат открыт заново.", "A colour as #RRGGBB. Empty keeps the Telegram theme's colour. A new chat background shows when the chat is opened again.")));
+        items.add(UItem.asHeader(VoidGram.t("Бейджи", "Badges")));
+        String mine = VoidGramCustomization.myBadge();
+        items.add(UItem.asButton(ID_MY_BADGE, VoidGram.t("Мой бейдж", "My badge"), mine.isEmpty() ? VoidGram.t("нет", "none") : mine));
+        badged = VoidGramCustomization.badgedDialogs();
+        for (int i = 0; i < badged.size(); i++) {
+            long id = badged.get(i);
+            String name;
+            if (id > 0) {
+                org.telegram.tgnet.TLRPC.User user = getMessagesController().getUser(id);
