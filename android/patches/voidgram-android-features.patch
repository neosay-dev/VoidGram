@@ -0,0 +1,238 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.os.PowerManager;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.LiteMode;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * VoidGram power saving, as on iOS: one profile per kind of device (phone, tablet, laptop — a
+ * Chromebook or an Android desktop), each choosing when saving turns on and what it turns off. A
+ * profile left on "Telegram" keeps Telegram's own Power Saving screen in charge.
+ */
+public final class VoidGramPowerSaving {
+    public static final int KIND_PHONE = 0;
+    public static final int KIND_TABLET = 1;
+    public static final int KIND_LAPTOP = 2;
+
+    public static final int MODE_TELEGRAM = 0;
+    public static final int MODE_OFF = 1;
+    public static final int MODE_BATTERY = 2;
+    public static final int MODE_ALWAYS = 3;
+
+    public static final String[] LIMITS = {"autoplayVideo", "autoplayGif", "stickers", "emoji", "blur", "animations", "background"};
+
+    /** Last battery state from LiteMode's receiver. */
+    public static volatile boolean plugged;
+
+    private VoidGramPowerSaving() {
+    }
+
+    public static int currentKind() {
+        try {
+            PackageManager pm = ApplicationLoader.applicationContext.getPackageManager();
+            if (pm.hasSystemFeature("org.chromium.arc.device_management") || pm.hasSystemFeature("android.hardware.type.pc")) {
+                return KIND_LAPTOP;
+            }
+        } catch (Throwable ignore) {
+        }
+        return AndroidUtilities.isTablet() ? KIND_TABLET : KIND_PHONE;
+    }
+
+    public static String kindTitle(int kind) {
+        switch (kind) {
+            case KIND_TABLET: return VoidGram.t("Планшет", "Tablet");
+            case KIND_LAPTOP: return VoidGram.t("Ноутбук (Chromebook, ПК)", "Laptop (Chromebook, PC)");
+            default: return VoidGram.t("Телефон", "Phone");
+        }
+    }
+
+    public static String modeTitle(int mode) {
+        switch (mode) {
+            case MODE_OFF: return VoidGram.t("Никогда", "Never");
+            case MODE_BATTERY: return VoidGram.t("При низком заряде", "When battery is low");
+            case MODE_ALWAYS: return VoidGram.t("Всегда", "Always");
+            default: return VoidGram.t("Как в Telegram", "Telegram's setting");
+        }
+    }
+
+    public static String limitTitle(String limit) {
+        switch (limit) {
+            case "autoplayVideo": return VoidGram.t("Автовоспроизведение видео", "Autoplay videos");
+            case "autoplayGif": return VoidGram.t("Автовоспроизведение GIF", "Autoplay GIFs");
+            case "stickers": return VoidGram.t("Анимация стикеров", "Animated stickers");
+            case "emoji": return VoidGram.t("Анимация эмодзи", "Animated emoji");
+            case "blur": return VoidGram.t("Размытие и стекло", "Blur and glass");
+            case "animations": return VoidGram.t("Анимации интерфейса", "Interface animations");
+            default: return VoidGram.t("Фон чатов", "Chat backgrounds");
+        }
+    }
+
+    private static int limitFlags(String limit) {
+        switch (limit) {
+            case "autoplayVideo": return LiteMode.FLAG_AUTOPLAY_VIDEOS;
+            case "autoplayGif": return LiteMode.FLAG_AUTOPLAY_GIFS;
+            case "stickers": return LiteMode.FLAGS_ANIMATED_STICKERS;
+            case "emoji": return LiteMode.FLAGS_ANIMATED_EMOJI;
+            case "blur": return LiteMode.FLAG_CHAT_BLUR | LiteMode.FLAG_LIQUID_GLASS;
+            case "animations": return LiteMode.FLAG_CALLS_ANIMATIONS | LiteMode.FLAG_PARTICLES | LiteMode.FLAG_CHAT_SCALE | LiteMode.FLAG_CHAT_THANOS | LiteMode.FLAG_CHAT_SPOILER;
+            default: return LiteMode.FLAG_CHAT_BACKGROUND;
+        }
+    }
+
+    private static String key(int kind, String name) {
+        return "power_" + kind + "_" + name;
+    }
+
+    public static int mode(int kind) {
+        return VoidGram.prefs().getInt(key(kind, "mode"), MODE_TELEGRAM);
+    }
+
+    public static int threshold(int kind) {
+        return Math.max(5, Math.min(95, VoidGram.prefs().getInt(key(kind, "threshold"), kind == KIND_TABLET ? 15 : 20)));
+    }
+
+    public static boolean followSystem(int kind) {
+        return VoidGram.prefs().getBoolean(key(kind, "system"), true);
+    }
+
+    public static boolean onBattery(int kind) {
+        return VoidGram.prefs().getBoolean(key(kind, "battery"), kind == KIND_LAPTOP);
+    }
+
+    public static Set<String> limits(int kind) {
+        Set<String> defaults = new HashSet<>();
+        for (String limit : LIMITS) {
+            if (kind == KIND_PHONE || !"background".equals(limit) && !"stickers".equals(limit)) {
+                defaults.add(limit);
+            }
+        }
+        return new HashSet<>(VoidGram.prefs().getStringSet(key(kind, "limits"), defaults));
+    }
+
+    public static void setMode(int kind, int mode) {
+        VoidGram.prefs().edit().putInt(key(kind, "mode"), mode).apply();
+        changed();
+    }
+
+    public static void setThreshold(int kind, int value) {
+        VoidGram.prefs().edit().putInt(key(kind, "threshold"), Math.max(5, Math.min(95, value))).apply();
+        changed();
+    }
+
+    public static void setFollowSystem(int kind, boolean value) {
+        VoidGram.prefs().edit().putBoolean(key(kind, "system"), value).apply();
+        changed();
+    }
+
+    public static void setOnBattery(int kind, boolean value) {
+        VoidGram.prefs().edit().putBoolean(key(kind, "battery"), value).apply();
+        changed();
+    }
+
+    public static void setLimit(int kind, String limit, boolean limited) {
+        Set<String> set = limits(kind);
+        if (limited) {
+            set.add(limit);
+        } else {
+            set.remove(limit);
+        }
+        VoidGram.prefs().edit().putStringSet(key(kind, "limits"), set).apply();
+        changed();
+    }
+
+    public static void reset(int kind) {
+        SharedPreferences.Editor editor = VoidGram.prefs().edit();
+        for (String name : new String[]{"mode", "threshold", "system", "battery", "limits"}) {
+            editor.remove(key(kind, name));
+        }
+        editor.apply();
+        changed();
+    }
+
+    private static void changed() {
+        snapshotValid = false;
+        systemCheckedAt = 0;
+        AndroidUtilities.runOnUIThread(() -> LiteMode.getValue(false));
+    }
+
+    private static boolean systemSaver() {
+        try {
+            PowerManager pm = (PowerManager) ApplicationLoader.applicationContext.getSystemService(Context.POWER_SERVICE);
+            return pm != null && pm.isPowerSaveMode();
+        } catch (Throwable ignore) {
+            return false;
+        }
+    }
+
+    // LiteMode asks on every frame: the profile is read once and refreshed when it changes, the
+    // system saver state at most every few seconds.
+    private static volatile boolean snapshotValid;
+    private static int snapKind = -1, snapMode, snapThreshold, snapMask;
+    private static boolean snapSystem, snapBattery;
+    private static volatile long systemCheckedAt;
+    private static volatile boolean systemSaverOn;
+
+    private static void snapshot() {
+        if (snapshotValid) {
+            return;
+        }
+        if (snapKind < 0) {
+            snapKind = currentKind();
+        }
+        snapMode = mode(snapKind);
+        snapThreshold = threshold(snapKind);
+        snapSystem = followSystem(snapKind);
+        snapBattery = onBattery(snapKind);
+        int mask = 0;
+        for (String limit : limits(snapKind)) {
+            mask |= limitFlags(limit);
+        }
+        snapMask = mask;
+        snapshotValid = true;
+    }
+
+    private static boolean systemSaverCached() {
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (now - systemCheckedAt > 5000) {
+            systemCheckedAt = now;
+            systemSaverOn = systemSaver();
+        }
+        return systemSaverOn;
+    }
+
+    /** Whether this device's profile saves power now; null when Telegram's own setting decides. */
+    public static Boolean isSavingNow(int batteryLevel) {
+        snapshot();
+        if (snapMode == MODE_TELEGRAM) {
+            return null;
+        }
+        if (snapSystem && systemSaverCached()) {
+            return true;
+        }
+        if (snapBattery && !plugged) {
+            return true;
+        }
+        switch (snapMode) {
+            case MODE_ALWAYS:
+                return true;
+            case MODE_BATTERY:
+                return !plugged && batteryLevel >= 0 && batteryLevel <= snapThreshold;
+            default:
+                return false;
+        }
+    }
+
+    /** LiteMode flags this device's profile turns off while saving. */
+    public static int limitsMask() {
+        snapshot();
+        return snapMask;
+    }
+}
