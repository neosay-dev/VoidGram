+/** Full-screen lyrics for the playing track: the current line lights up, a tap on a line seeks there. */
+public final class VoidGramLyricsScreen {
+    private VoidGramLyricsScreen() {
+    }
+
+    private static TextView button(Activity activity, String text) {
+        TextView view = new TextView(activity);
+        view.setText(text);
+        view.setTextColor(0xFFFFFFFF);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        view.setTypeface(AndroidUtilities.bold());
+        view.setGravity(Gravity.CENTER);
