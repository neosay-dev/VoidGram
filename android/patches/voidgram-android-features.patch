+package org.telegram.ui.voidgram;
+
+import android.os.Bundle;
+import android.view.View;
+
+import org.telegram.messenger.UserObject;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramHiddenChats;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+/** VoidGram → Hidden chats (opened after fingerprint, face or the screen lock). */
+public class VoidGramHiddenChatsActivity extends UniversalFragment {
+    private static final int ID_BASE = 100;
+    private ArrayList<Long> ids = new ArrayList<>();
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Скрытые чаты", "Hidden chats");
+    }
+
+    private String title(long dialogId) {
+        if (dialogId > 0) {
+            TLRPC.User user = getMessagesController().getUser(dialogId);
+            return user != null ? UserObject.getUserName(user) : "#" + dialogId;
+        }
+        TLRPC.Chat chat = getMessagesController().getChat(-dialogId);
+        return chat != null ? chat.title : "#" + dialogId;
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        ids = VoidGramHiddenChats.list(currentAccount);
+        for (int i = 0; i < ids.size(); i++) {
+            items.add(UItem.asButton(ID_BASE + i, title(ids.get(i))));
+        }
+        items.add(UItem.asShadow(ids.isEmpty()
+                ? VoidGram.t("Скрытых чатов нет. Скрыть чат: меню чата (⋮) → «Скрыть чат».", "No hidden chats. To hide one: chat menu (⋮) → \"Hide chat\".")
+                : VoidGram.t("Эти чаты не видны в списке чатов, пересылке и «Поделиться». Нажмите, чтобы открыть или вернуть в список.", "These chats are left out of the chat list, forwarding and sharing. Tap to open one or put it back.")));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int index = item.id - ID_BASE;
+        if (index < 0 || index >= ids.size()) {
+            return;
+        }
+        long dialogId = ids.get(index);
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(title(dialogId));
+        builder.setItems(new CharSequence[]{VoidGram.t("Открыть чат", "Open the chat"), VoidGram.t("Показать в списке чатов", "Show in the chat list")}, (d, which) -> {
+            if (which == 0) {
+                Bundle args = new Bundle();
+                if (dialogId > 0) {
+                    args.putLong("user_id", dialogId);
+                } else {
+                    args.putLong("chat_id", -dialogId);
+                }
+                presentFragment(new ChatActivity(args));
+            } else {
+                VoidGramHiddenChats.setHidden(currentAccount, dialogId, false);
+                if (listView != null && listView.adapter != null) {
+                    listView.adapter.update(true);
+                }
+            }
+        });
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramHistoryFeedActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramHistoryFeedActivity.java
