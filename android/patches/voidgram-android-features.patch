+package org.telegram.ui.voidgram;
+
+import android.content.Intent;
+import android.net.Uri;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramChatExport;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.io.File;
+
+/** Chat menu → Export chat: choose media, show progress, share the ZIP. */
+public final class VoidGramChatExportSheet {
+    private VoidGramChatExportSheet() {
+    }
+
+    public static void show(BaseFragment fragment, int account, long dialogId) {
+        if (fragment == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        if (!VoidGramChatExport.canExport(account, dialogId)) {
+            BulletinFactory.of(fragment).createErrorBulletin(VoidGram.t("Этот чат нельзя экспортировать", "This chat cannot be exported")).show();
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(VoidGram.t("Экспорт чата", "Export chat"));
+        builder.setMessage(VoidGram.t(
+                "Вся история чата будет сохранена в ZIP: result.json (формат Telegram Desktop), messages.html и медиа, которые уже загружены на устройство (до 1 ГБ). Защищённые и исчезающие сообщения не сохраняются.",
+                "The whole chat history goes into a ZIP: result.json (Telegram Desktop format), messages.html and media already on this device (up to 1 GB). Protected and disappearing messages are not saved."));
+        builder.setPositiveButton(VoidGram.t("С медиа", "With media"), (d, w) -> run(fragment, account, dialogId, true));
+        builder.setNeutralButton(VoidGram.t("Только текст", "Text only"), (d, w) -> run(fragment, account, dialogId, false));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        fragment.showDialog(builder.create());
+    }
+
+    private static void run(BaseFragment fragment, int account, long dialogId, boolean media) {
+        AlertDialog progress = new AlertDialog(fragment.getParentActivity(), AlertDialog.ALERT_TYPE_MESSAGE);
+        progress.setTitle(VoidGram.t("Экспорт чата", "Export chat"));
+        progress.setMessage(VoidGram.t("Подготовка…", "Preparing…"));
+        final Runnable[] cancel = new Runnable[1];
+        progress.setNegativeButton(VoidGram.t("Отмена", "Cancel"), (d, w) -> {
