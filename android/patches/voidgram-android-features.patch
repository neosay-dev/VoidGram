+            oldest = Math.min(oldest, message.messageOwner.date);
+        }
+        int busiest = 0;
+        for (int i = 1; i < 24; i++) {
+            if (hours[i] > hours[busiest]) {
+                busiest = i;
+            }
+        }
+        String since = DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT).format(new Date(oldest * 1000L));
+        String top = top(authors, 5, ": ");
+        present(fragment, title, VoidGram.russian()
+                ? "По последним " + messages.size() + " сообщениям (с " + since + "):\n\n" + top + "\n\nСамый активный час: " + busiest + ":00\nСимволов: " + characters
+                : "Over the last " + messages.size() + " messages (since " + since + "):\n\n" + top + "\n\nBusiest hour: " + busiest + ":00\nCharacters: " + characters);
