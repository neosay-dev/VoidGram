+    private static final int ID_OPTION_BASE = 10;
+    private static final int ID_EXCEPTIONS_CLEAR = 20;
+    private static final int ID_DELETED = 30;
+    private static final int ID_EDITS = 31;
+    private static final int ID_MARK = 32;
+    private static final int ID_CLEAR = 33;
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Призрак и история", "Ghost and history");
+    }
+
+    private void refresh() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        boolean ghost = VoidGramGhost.isEnabled(currentAccount);
+        items.add(UItem.asHeader(VoidGram.t("Режим призрака", "Ghost Mode")));
+        items.add(UItem.asCheck(ID_GHOST, VoidGram.t("Режим призрака", "Ghost Mode")).setChecked(ghost));
+        if (ghost) {
+            for (int i = 0; i < VoidGramGhost.OPTIONS.length; i++) {
+                String option = VoidGramGhost.OPTIONS[i];
+                items.add(UItem.asCheck(ID_OPTION_BASE + i, VoidGramGhost.optionTitle(option)).setChecked(VoidGramGhost.option(currentAccount, option)));
+            }
+            int exceptions = VoidGramGhost.exceptions(currentAccount).size();
+            if (exceptions > 0) {
+                items.add(UItem.asButton(ID_EXCEPTIONS_CLEAR, VoidGram.t("Сбросить исключения", "Clear exceptions"), String.valueOf(exceptions)));
+            }
+        }
+        items.add(UItem.asShadow(VoidGram.t("Для этого аккаунта. В чате: ⋮ → «Призрак в этом чате» исключает чат. Секретные чаты, прослушивание голосовых и просмотр историй работают как обычно. Это не полная невидимость: отправленные запросы не отменить, а новое прочтение после выключения может отметить и старые сообщения. Режим противоречит правилам Telegram API — на ваш риск.", "For this account. In a chat: ⋮ → \"Ghost in this chat\" excludes it. Secret chats, voice listening and story views behave as usual. Not absolute invisibility: requests that went out cannot be taken back, and a new read after turning it off can acknowledge older messages too. The mode conflicts with Telegram's API terms — at your own risk.")));
+
+        items.add(UItem.asHeader(VoidGram.t("История сообщений", "Message history")));
+        items.add(UItem.asCheck(ID_DELETED, VoidGram.t("Сохранять удалённые сообщения", "Keep deleted messages")).setChecked(VoidGramHistory.saveDeleted()));
+        items.add(UItem.asCheck(ID_EDITS, VoidGram.t("Сохранять историю изменений", "Keep edit history")).setChecked(VoidGramHistory.saveEdits()));
+        items.add(UItem.asButton(ID_MARK, VoidGram.t("Метка удалённого", "Deleted mark"), VoidGramHistory.deletedMark()));
+        items.add(UItem.asShadow(VoidGram.t("Сообщения, которые удалили другие, остаются в чате с меткой. У изменённых в меню сообщения появляется «История изменений». Всё хранится только на этом устройстве.", "Messages other people delete stay in the chat with a mark. Edited ones get \"Edit history\" in the message menu. Everything stays on this device only.")));
+        items.add(UItem.asButton(ID_CLEAR, VoidGram.t("Очистить сохранённую историю", "Clear kept history")).red());
+        items.add(UItem.asShadow(null));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int id = item.id;
+        if (id == ID_GHOST) {
+            VoidGramGhost.setEnabled(currentAccount, !VoidGramGhost.isEnabled(currentAccount));
+        } else if (id >= ID_OPTION_BASE && id < ID_OPTION_BASE + VoidGramGhost.OPTIONS.length) {
+            String option = VoidGramGhost.OPTIONS[id - ID_OPTION_BASE];
+            VoidGramGhost.setOption(currentAccount, option, !VoidGramGhost.option(currentAccount, option));
+        } else if (id == ID_EXCEPTIONS_CLEAR) {
+            for (String dialog : VoidGramGhost.exceptions(currentAccount)) {
