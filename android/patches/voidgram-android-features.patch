+package org.telegram.messenger.voidgram;
+
+import android.text.format.DateFormat;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.LocaleController;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/** VoidGram chat and interface options (Settings → VoidGram → Chats). */
+public final class VoidGramChats {
+    private VoidGramChats() {
+    }
+
+    public static boolean timeSeconds() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("chats_time_seconds", false);
+    }
+
+    public static void setTimeSeconds(boolean value) {
+        VoidGram.prefs().edit().putBoolean("chats_time_seconds", value).apply();
+        secondsFormat = null;
+    }
+
+    public static boolean hideAds() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("chats_hide_ads", true);
+    }
+
+    public static void setHideAds(boolean value) {
+        VoidGram.prefs().edit().putBoolean("chats_hide_ads", value).apply();
+    }
+
+    public static boolean allowScreenshots() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("chats_allow_screenshots", false);
+    }
+
+    public static void setAllowScreenshots(boolean value) {
+        VoidGram.prefs().edit().putBoolean("chats_allow_screenshots", value).apply();
+    }
+
+    public static boolean showIds() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("chats_show_ids", true);
+    }
+
+    public static void setShowIds(boolean value) {
+        VoidGram.prefs().edit().putBoolean("chats_show_ids", value).apply();
+    }
+
+    private static SimpleDateFormat secondsFormat;
+
+    /** A message time, with seconds when asked for. */
+    public static String formatMessageTime(long millis) {
+        if (!timeSeconds()) {
+            return LocaleController.getInstance().getFormatterDay().format(millis);
+        }
+        SimpleDateFormat format = secondsFormat;
+        if (format == null) {
+            boolean is24 = DateFormat.is24HourFormat(ApplicationLoader.applicationContext);
+            format = new SimpleDateFormat(is24 ? "HH:mm:ss" : "h:mm:ss a", Locale.getDefault());
+            secondsFormat = format;
+        }
+        synchronized (format) {
+            return format.format(new Date(millis));
+        }
+    }
+}
