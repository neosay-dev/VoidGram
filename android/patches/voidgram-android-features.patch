@@ -0,0 +1,123 @@
+package org.telegram.messenger.voidgram;
+
+import android.graphics.Color;
+
+import java.util.Calendar;
+
+/**
+ * The music player's night look, as on iOS: a darker, optionally warm player that glares less at
+ * night. Scheduled (hours may cross midnight), always, or off completely.
+ */
+public final class VoidGramNightLook {
+    public static final int MODE_SCHEDULED = 0;
+    public static final int MODE_ALWAYS = 1;
+    public static final int MODE_OFF = 2;
+
+    public static final int STRENGTH_SOFT = 0;
+    public static final int STRENGTH_MEDIUM = 1;
+    public static final int STRENGTH_STRONG = 2;
+
+    private VoidGramNightLook() {
+    }
+
+    public static int mode() {
+        return VoidGram.prefs().getInt("night_mode", MODE_SCHEDULED);
+    }
+
+    public static void setMode(int mode) {
+        VoidGram.prefs().edit().putInt("night_mode", mode).apply();
+    }
+
+    public static int startHour() {
+        return Math.max(0, Math.min(23, VoidGram.prefs().getInt("night_start", 22)));
+    }
+
+    public static void setStartHour(int hour) {
+        VoidGram.prefs().edit().putInt("night_start", Math.max(0, Math.min(23, hour))).apply();
+    }
+
+    public static int endHour() {
+        return Math.max(0, Math.min(23, VoidGram.prefs().getInt("night_end", 7)));
+    }
+
+    public static void setEndHour(int hour) {
+        VoidGram.prefs().edit().putInt("night_end", Math.max(0, Math.min(23, hour))).apply();
+    }
+
+    public static int strength() {
+        return VoidGram.prefs().getInt("night_strength", STRENGTH_MEDIUM);
+    }
+
+    public static void setStrength(int value) {
+        VoidGram.prefs().edit().putInt("night_strength", value).apply();
+    }
+
+    public static boolean isWarm() {
+        return VoidGram.prefs().getBoolean("night_warm", true);
+    }
+
+    public static void setWarm(boolean value) {
+        VoidGram.prefs().edit().putBoolean("night_warm", value).apply();
+    }
+
+    public static void reset() {
+        VoidGram.prefs().edit().remove("night_start").remove("night_end").remove("night_strength").remove("night_warm").apply();
+    }
+
+    /** Equal hours mean the whole day; the window may cross midnight. */
+    public static boolean isNightHour(int hour) {
+        int start = startHour(), end = endHour();
+        if (start == end) {
+            return true;
+        } else if (start < end) {
+            return hour >= start && hour < end;
+        } else {
+            return hour >= start || hour < end;
+        }
+    }
+
+    public static boolean isActiveNow() {
+        switch (mode()) {
+            case MODE_ALWAYS:
+                return true;
+            case MODE_OFF:
+                return false;
+            default:
+                return isNightHour(Calendar.getInstance().get(Calendar.HOUR_OF_DAY));
+        }
+    }
+
+    /** The overlay colour for the player, transparent when the night look is not active. */
+    public static int overlayColor() {
+        if (!isActiveNow()) {
+            return Color.TRANSPARENT;
+        }
+        int alpha;
+        switch (strength()) {
+            case STRENGTH_SOFT: alpha = 0x40; break;
+            case STRENGTH_STRONG: alpha = 0x99; break;
+            default: alpha = 0x6B;
+        }
+        return isWarm() ? Color.argb(alpha, 0x29, 0x14, 0x05) : Color.argb(alpha, 0x00, 0x02, 0x08);
+    }
+
+    public static String hourText(int hour) {
+        return String.format(java.util.Locale.US, "%02d:00", hour);
+    }
+
+    public static String modeTitle(int mode) {
+        switch (mode) {
+            case MODE_ALWAYS: return VoidGram.t("Всегда", "Always");
+            case MODE_OFF: return VoidGram.t("Выключен полностью", "Off completely");
+            default: return VoidGram.t("По расписанию ", "Scheduled ") + hourText(startHour()) + "–" + hourText(endHour());
+        }
+    }
+
+    public static String strengthTitle(int strength) {
+        switch (strength) {
+            case STRENGTH_SOFT: return VoidGram.t("Слабо", "Soft");
+            case STRENGTH_STRONG: return VoidGram.t("Сильно", "Strong");
+            default: return VoidGram.t("Средне", "Medium");
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramPeerArchive.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramPeerArchive.java
new file mode 100644
index 0000000..dc79878
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramPeerArchive.java
@@ -0,0 +1,136 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.ContactsController;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.UserObject;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * VoidGram peer archive, as on iOS: every opened chat's id, name and username are kept, so a saved
+ * id still resolves to a name after the account or channel is deleted.
+ */
+public final class VoidGramPeerArchive {
+    public static final class Entry {
+        public final long dialogId;
+        public final String title;
+        public final String username;
+        public final int seen;
+
+        Entry(long dialogId, String title, String username, int seen) {
+            this.dialogId = dialogId;
+            this.title = title;
+            this.username = username;
+            this.seen = seen;
+        }
+    }
+
+    private static final class Db extends SQLiteOpenHelper {
+        Db(Context context, int account) {
+            super(context, "voidgram_peers_" + account + ".db", null, 1);
+        }
+
+        @Override
+        public void onCreate(SQLiteDatabase db) {
+            db.execSQL("CREATE TABLE peers (dialog INTEGER PRIMARY KEY, title TEXT, username TEXT, seen INTEGER)");
+        }
+
+        @Override
+        public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+        }
+    }
+
+    private static final Db[] databases = new Db[UserConfig.MAX_ACCOUNT_COUNT];
+
+    private VoidGramPeerArchive() {
+    }
+
+    private static synchronized Db db(int account) {
+        if (databases[account] == null) {
+            databases[account] = new Db(ApplicationLoader.applicationContext, account);
+        }
+        return databases[account];
+    }
+
+    public static void record(int account, TLRPC.User user, TLRPC.Chat chat) {
+        final long dialogId;
+        final String title;
+        final String username;
+        if (user != null) {
+            if (UserObject.isDeleted(user)) {
+                return;
+            }
+            dialogId = user.id;
+            title = ContactsController.formatName(user.first_name, user.last_name);
+            username = UserObject.getPublicUsername(user);
+        } else if (chat != null) {
+            dialogId = -chat.id;
+            title = chat.title;
+            username = org.telegram.messenger.ChatObject.getPublicUsername(chat);
+        } else {
+            return;
+        }
+        final int now = (int) (System.currentTimeMillis() / 1000);
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                ContentValues values = new ContentValues();
+                values.put("dialog", dialogId);
+                values.put("title", title);
+                values.put("username", username);
+                values.put("seen", now);
+                db(account).getWritableDatabase().insertWithOnConflict("peers", null, values, SQLiteDatabase.CONFLICT_REPLACE);
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        });
+    }
+
+    /** Entries whose name, username or id contain `query` (all of them for an empty query), newest first. */
+    public static ArrayList<Entry> search(int account, String query, int limit) {
+        ArrayList<Entry> result = new ArrayList<>();
+        Cursor cursor = null;
+        try {
+            String q = query == null ? "" : query.trim().replace("@", "");
+            String like = "%" + q.replace("%", "").replace("_", "") + "%";
+            cursor = db(account).getReadableDatabase().rawQuery("SELECT dialog, title, username, seen FROM peers WHERE ? = '' OR title LIKE ? OR username LIKE ? OR CAST(dialog AS TEXT) LIKE ? ORDER BY seen DESC LIMIT " + limit, new String[]{q, like, like, like});
+            while (cursor.moveToNext()) {
+                result.add(new Entry(cursor.getLong(0), cursor.getString(1), cursor.getString(2), cursor.getInt(3)));
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+        }
+        return result;
+    }
+
+    public static boolean isEnabled() {
