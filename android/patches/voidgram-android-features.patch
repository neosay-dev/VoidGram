+package org.telegram.messenger.voidgram;
+
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.FileLog;
+import org.telegram.tgnet.ConnectionsManager;
+
+/**
+ * VoidGram → Bypass blocking: DPI tricks on the first packet of every connection to Telegram (and,
+ * optionally, to a proxy), as ByeDPI does, without root. Presets for countries plus full manual
+ * settings. Where Telegram's addresses are blocked outright (China, Iran), a proxy is still needed:
+ * the tricks then hide the proxy connection itself.
+ */
+public final class VoidGramDpi {
+    public static final int METHOD_OFF = 0;
+    public static final int METHOD_SPLIT = 1;
+    public static final int METHOD_DISORDER = 2;
+    public static final int METHOD_SPLIT_OOB = 3;
+    public static final int METHOD_DISORDER_OOB = 4;
+
+    public static final String PRESET_RUSSIA = "ru";
+    public static final String PRESET_IRAN = "ir";
+    public static final String PRESET_CHINA = "cn";
+    public static final String PRESET_TURKMENISTAN = "tm";
+    public static final String PRESET_CUSTOM = "custom";
+    public static final String[] PRESETS = {PRESET_RUSSIA, PRESET_IRAN, PRESET_CHINA, PRESET_TURKMENISTAN, PRESET_CUSTOM};
+
+    private VoidGramDpi() {
+    }
+
+    private static SharedPreferences prefs() {
+        return VoidGram.prefs();
+    }
+
+    public static boolean isEnabled() {
+        return prefs().getBoolean("dpi_enabled", false);
+    }
+
+    public static String preset() {
+        return prefs().getString("dpi_preset", PRESET_RUSSIA);
+    }
+
+    public static int method() {
+        return prefs().getInt("dpi_method", METHOD_DISORDER_OOB);
+    }
+
+    public static int splitPosition() {
+        return prefs().getInt("dpi_split_position", 1);
+    }
+
+    public static int splitCount() {
+        return prefs().getInt("dpi_split_count", 1);
+    }
+
+    public static int delayMs() {
+        return prefs().getInt("dpi_delay", 0);
+    }
+
+    public static boolean viaProxy() {
+        return prefs().getBoolean("dpi_via_proxy", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        prefs().edit().putBoolean("dpi_enabled", value).apply();
+        apply();
+    }
+
+    /** A preset fills the manual settings; changing any of them switches to "custom". */
+    public static void setPreset(String preset) {
+        SharedPreferences.Editor editor = prefs().edit().putString("dpi_preset", preset);
+        switch (preset) {
+            case PRESET_RUSSIA:
+                editor.putInt("dpi_method", METHOD_DISORDER_OOB).putInt("dpi_split_position", 1).putInt("dpi_split_count", 1).putInt("dpi_delay", 0);
+                break;
+            case PRESET_IRAN:
+                editor.putInt("dpi_method", METHOD_SPLIT).putInt("dpi_split_position", 3).putInt("dpi_split_count", 4).putInt("dpi_delay", 10);
+                break;
+            case PRESET_CHINA:
+                editor.putInt("dpi_method", METHOD_DISORDER).putInt("dpi_split_position", 1).putInt("dpi_split_count", 2).putInt("dpi_delay", 5);
+                break;
+            case PRESET_TURKMENISTAN:
+                editor.putInt("dpi_method", METHOD_SPLIT_OOB).putInt("dpi_split_position", 2).putInt("dpi_split_count", 2).putInt("dpi_delay", 0);
+                break;
+            default:
+                break;
+        }
+        editor.apply();
+        apply();
+    }
+
+    private static void setCustom(String key, int value) {
+        prefs().edit().putInt(key, value).putString("dpi_preset", PRESET_CUSTOM).apply();
+        apply();
+    }
+
+    public static void setMethod(int value) {
+        setCustom("dpi_method", value);
+    }
+
+    public static void setSplitPosition(int value) {
+        setCustom("dpi_split_position", Math.max(1, Math.min(256, value)));
+    }
+
+    public static void setSplitCount(int value) {
+        setCustom("dpi_split_count", Math.max(1, Math.min(16, value)));
+    }
+
+    public static void setDelayMs(int value) {
+        setCustom("dpi_delay", Math.max(0, Math.min(100, value)));
+    }
+
+    public static void setViaProxy(boolean value) {
+        prefs().edit().putBoolean("dpi_via_proxy", value).apply();
+        apply();
+    }
+
+    public static void reset() {
+        prefs().edit().remove("dpi_preset").remove("dpi_method").remove("dpi_split_position").remove("dpi_split_count").remove("dpi_delay").remove("dpi_via_proxy").apply();
+        apply();
+    }
+
+    /** Hands the settings to the native network layer; they apply to every new connection. */
+    public static void apply() {
+        try {
+            ConnectionsManager.native_setVoidGramDpi(isEnabled() ? method() : METHOD_OFF, splitPosition(), splitCount(), delayMs(), viaProxy());
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    public static String presetTitle(String preset) {
+        switch (preset) {
+            case PRESET_RUSSIA: return VoidGram.t("Россия", "Russia");
+            case PRESET_IRAN: return VoidGram.t("Иран", "Iran");
+            case PRESET_CHINA: return VoidGram.t("Китай", "China");
+            case PRESET_TURKMENISTAN: return VoidGram.t("Туркменистан, Беларусь и др.", "Turkmenistan, Belarus and others");
+            default: return VoidGram.t("Свои настройки", "Custom");
+        }
+    }
+
+    public static String presetInfo(String preset) {
+        switch (preset) {
+            case PRESET_RUSSIA: return VoidGram.t("Против замедления и блокировки по сигнатуре: первая часть уходит «вне очереди», плюс OOB-байт.", "Against throttling and signature blocking: the first part goes out of order, plus an OOB byte.");
+            case PRESET_IRAN: return VoidGram.t("Мелкое дробление первого пакета с паузами. Адреса Telegram в Иране закрыты — включите прокси (MTProto с fake-TLS).", "Fine splitting of the first packet with pauses. Telegram's addresses are blocked in Iran: use a proxy (MTProto with fake-TLS).");
+            case PRESET_CHINA: return VoidGram.t("Великий файрвол блокирует адреса Telegram целиком: без прокси не обойтись. Приёмы скрывают само подключение к прокси.", "The Great Firewall blocks Telegram's addresses outright: a proxy is required. The tricks hide the proxy connection itself.");
+            case PRESET_TURKMENISTAN: return VoidGram.t("Дробление с OOB-байтом. Если не помогает — попробуйте другой способ или прокси.", "Splitting with an OOB byte. If it does not help, try another method or a proxy.");
+            default: return VoidGram.t("Подберите способ и параметры сами.", "Pick the method and parameters yourself.");
+        }
+    }
+
+    public static String methodTitle(int method) {
+        switch (method) {
+            case METHOD_SPLIT: return VoidGram.t("Разбиение (split)", "Split");
+            case METHOD_DISORDER: return VoidGram.t("Перестановка (disorder)", "Disorder");
+            case METHOD_SPLIT_OOB: return VoidGram.t("Разбиение + OOB", "Split + OOB");
+            case METHOD_DISORDER_OOB: return VoidGram.t("Перестановка + OOB", "Disorder + OOB");
+            default: return VoidGram.t("Выключено", "Off");
+        }
+    }
+}
