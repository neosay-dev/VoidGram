+                    view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 26);
+                    view.setTypeface(AndroidUtilities.bold());
+                    view.setPadding(0, AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8));
+                    view.setOnClickListener(v -> {
+                        MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+                        if (playing != null && playing.getDuration() > 0) {
+                            MediaController.getInstance().seekToProgress(playing, (float) Math.max(0, Math.min(1, line.time / playing.getDuration())));
+                            userScrollUntil[0] = 0;
+                        }
+                    });
+                    list.addView(view, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+                    lineViews.add(view);
+                }
+            } else {
+                TextView view = new TextView(activity);
+                view.setText(lyrics.plain);
+                view.setTextColor(0xD9FFFFFF);
+                view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22);
+                view.setTypeface(AndroidUtilities.bold());
+                view.setLineSpacing(AndroidUtilities.dp(6), 1f);
+                list.addView(view, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+            }
+        };
+
+        final Runnable[] tick = new Runnable[1];
+        tick[0] = () -> {
+            if (!dialog.isShowing()) {
+                return;
+            }
+            night.setBackgroundColor(VoidGramNightLook.overlayColor());
+            rebuild.run();
+            MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+            VoidGramLyrics.Lyrics lyrics = shown[0];
+            if (playing != null && lyrics != null && lyrics.isSynced() && VoidGramLyrics.key(playing).equals(VoidGramLyrics.key(track))) {
