@@ -0,0 +1,76 @@
+package org.telegram.messenger.voidgram;
+
+import android.media.MediaMetadataRetriever;
+
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+
+import java.io.File;
+import java.util.HashMap;
+
+/**
+ * Identifies the playing track from the file itself when Telegram's audio attributes are missing
+ * or useless, as on iOS: the embedded ID3 / MP4 tags. Results are remembered per file, so the
+ * player, lyrics and Last.fm use them from then on.
+ */
+public final class VoidGramTrackTags {
+    private VoidGramTrackTags() {
+    }
+
+    private static final HashMap<String, String[]> cache = new HashMap<>();
+
+    private static boolean useless(String value, MessageObject message) {
+        if (value == null) {
+            return true;
+        }
+        String trimmed = value.trim();
+        if (trimmed.isEmpty()) {
+            return true;
+        }
+        try {
+            if (trimmed.equals(LocaleController.getString(R.string.AudioUnknownArtist)) || trimmed.equals(LocaleController.getString(R.string.AudioUnknownTitle))) {
+                return true;
+            }
+        } catch (Throwable ignore) {
+        }
+        String name = message.getDocument() != null ? FileLoader.getDocumentFileName(message.getDocument()) : null;
+        return name != null && (trimmed.equals(name) || name.startsWith(trimmed + "."));
+    }
+
+    /** {title, artist} with tags filling in what Telegram does not know. */
+    public static String[] resolve(MessageObject message, String title, String artist) {
+        if (message == null || !useless(title, message) && !useless(artist, message)) {
+            return new String[]{title, artist};
+        }
+        File file = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+        if (file == null || !file.exists()) {
+            return new String[]{title, artist};
+        }
+        String key = file.getAbsolutePath();
+        String[] tags = cache.get(key);
+        if (tags == null) {
+            tags = new String[]{null, null};
+            MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+            try {
+                retriever.setDataSource(key);
+                tags[0] = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_TITLE);
+                tags[1] = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_ARTIST);
+                if (tags[1] == null || tags[1].trim().isEmpty()) {
+                    tags[1] = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_ALBUMARTIST);
+                }
+            } catch (Throwable ignore) {
+            } finally {
+                try {
+                    retriever.release();
+                } catch (Throwable ignore) {
+                }
+            }
+            cache.put(key, tags);
+        }
+        String resolvedTitle = useless(title, message) && tags[0] != null && !tags[0].trim().isEmpty() ? tags[0].trim() : title;
+        String resolvedArtist = useless(artist, message) && tags[1] != null && !tags[1].trim().isEmpty() ? tags[1].trim() : artist;
+        return new String[]{resolvedTitle, resolvedArtist};
+    }
+}
