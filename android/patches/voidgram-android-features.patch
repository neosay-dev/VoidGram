+    }
+
+    private static final class Chat {
+        final String title;
+        final int colorTop;
+        final int colorBottom;
+        final ArrayList<Message> messages = new ArrayList<>();
+        final int unread;
+        final boolean muted;
+        final boolean channel;
+
+        Chat(String title, int colorTop, int colorBottom, int unread, boolean muted, boolean channel) {
+            this.title = title;
+            this.colorTop = colorTop;
+            this.colorBottom = colorBottom;
+            this.unread = unread;
+            this.muted = muted;
+            this.channel = channel;
+        }
+
+        Chat add(String text, boolean out, String time) {
+            messages.add(new Message(text, out, time));
+            return this;
+        }
+    }
+
+    private static ArrayList<Chat> chats;
+
+    private VoidGramStandIn() {
+    }
+
+    private static ArrayList<Chat> chats() {
+        if (chats == null) {
+            chats = new ArrayList<>();
+            chats.add(new Chat("Мама", 0xFFFF885E, 0xFFFF516A, 1, false, false).add("Ты покушал?", false, "12:41").add("Да, всё хорошо", true, "12:44").add("Не забудь вечером позвонить бабушке ❤️", false, "18:02"));
+            chats.add(new Chat("Избранное", 0xFF3FA5F5, 0xFF2A7AE0, 0, false, false).add("Список покупок: молоко, хлеб, яйца, сыр", true, "09:15"));
+            chats.add(new Chat("Работа", 0xFF72D5FD, 0xFF2A9EF1, 0, true, false).add("Созвон перенесли на 15:00", false, "10:20").add("Ок, буду", true, "10:22").add("Отчёт скинул в общую папку", false, "16:48"));
+            chats.add(new Chat("Саша", 0xFFA0DE7E, 0xFF54CB68, 0, false, false).add("Го в субботу в кино?", false, "Вчера").add("Давай, на что?", true, "Вчера").add("Посмотрим что идёт 🍿", false, "Вчера"));
+            chats.add(new Chat("Новости", 0xFFE0A2F3, 0xFFD669ED, 3, true, true).add("Погода на выходные: солнечно, до +18. Самое время выбраться за город.", false, "Вчера"));
+            chats.add(new Chat("Семья 🏡", 0xFFFFCD6A, 0xFFFCA20A, 0, false, false).add("Кто заберёт посылку?", false, "Пн").add("Я заберу после учёбы", true, "Пн"));
+            chats.add(new Chat("Telegram", 0xFF3FA5F5, 0xFF2A7AE0, 0, false, false).add("Код для входа в Telegram: •••••. Никому не давайте этот код.", false, "Вс"));
+        }
+        return chats;
+    }
+
+    static Dialog create(Activity activity) {
+        final Dialog dialog = new Dialog(activity, android.R.style.Theme_DeviceDefault_Light_NoActionBar);
+        dialog.setCancelable(false);
+        final FrameLayout root = new FrameLayout(activity);
+        root.setBackgroundColor(Color.WHITE);
+        showList(activity, root);
+        dialog.setContentView(root);
+        dialog.setOnKeyListener((d, keyCode, event) -> {
+            if (keyCode == KeyEvent.KEYCODE_BACK && event.getAction() == KeyEvent.ACTION_UP && root.getTag() != null) {
+                showList(activity, root);
+                return true;
+            }
+            return keyCode == KeyEvent.KEYCODE_BACK;
+        });
+        Window window = dialog.getWindow();
+        if (window != null) {
+            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+            window.setBackgroundDrawable(new ColorDrawable(Color.WHITE));
+            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
+            window.setStatusBarColor(0xFF517DA2);
+            window.setNavigationBarColor(Color.WHITE);
+            window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+        }
+        return dialog;
+    }
+
+    private static TextView header(Activity activity, String text) {
+        TextView view = new TextView(activity);
+        view.setText(text);
+        view.setTextColor(Color.WHITE);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20);
+        view.setTypeface(AndroidUtilities.bold());
+        view.setGravity(Gravity.CENTER_VERTICAL);
+        view.setPadding(AndroidUtilities.dp(18), AndroidUtilities.statusBarHeight, AndroidUtilities.dp(18), 0);
