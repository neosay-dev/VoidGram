+                    VoidGramOverlayEffects.setAmount(VoidGramOverlayEffects.STEPS[index]);
+                } else {
+                    VoidGramOverlayEffects.setSpeed(VoidGramOverlayEffects.STEPS[index]);
+                }
+                VoidGramOverlayEffects.attach(getParentActivity());
+                listView.adapter.update(true);
+            });
+            showDialog(builder.create());
+            return;
+        }
+        if (item.id == ID_BLACK_HOLE) {
+            VoidGramBlackHole.setEnabled(!VoidGramBlackHole.isEnabled());
+            listView.adapter.update(true);
+            return;
+        }
+        if (item.id == ID_NAME_GUARD) {
+            org.telegram.messenger.voidgram.VoidGramExtras.setNameGuardEnabled(!org.telegram.messenger.voidgram.VoidGramExtras.nameGuardEnabled());
+            listView.adapter.update(true);
+            return;
+        }
+        int index = item.id - 1;
+        if (index >= 0 && index < KEYS.length) {
+            VoidGramInterface.toggle(KEYS[index]);
+            if (listView != null && listView.adapter != null) {
+                listView.adapter.update(true);
+            }
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
