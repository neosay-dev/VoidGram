+/**
+ * Code plugins on Android, compatible with the iOS ones: JavaScript files with a "// @key value"
+ * header, each in its own QuickJS context on one private thread, with the same ayu.* API (the
+ * iOS prelude runs unchanged on top of a small bridge). A plugin that throws stays inside its
+ * context; one that does not answer a hook in time is turned off.
+ */
+public final class VoidGramPlugins {
+    private VoidGramPlugins() {
+    }
+
+    public static final class Plugin {
+        public String id;
+        public String name;
+        public String author;
+        public String version;
+        public String description;
+        public String language;
+        public HashSet<String> permissions = new HashSet<>();
+        public ArrayList<String> connect = new ArrayList<>();
+        public boolean enabled;
+        public String disabledReason;
+    }
+
+    private static final class Runtime {
+        Plugin plugin;
+        QuickJSContext context;
+        final HashSet<String> hooks = new HashSet<>();
+        final HashMap<Integer, Runnable> timers = new HashMap<>();
+        boolean stopped;
+    }
+
+    private static HandlerThread thread;
+    private static Handler handler;
+    private static boolean engineFailed;
+    private static final LinkedHashMap<String, Runtime> running = new LinkedHashMap<>();
+    private static final ArrayList<String> console = new ArrayList<>();
+    private static final int CONSOLE_LIMIT = 400;
+
+    // ---- Files and metadata ----
+
+    private static File directory() {
+        File dir = new File(ApplicationLoader.applicationContext.getFilesDir(), "voidgram_plugins");
+        dir.mkdirs();
+        return dir;
+    }
+
+    private static SharedPreferences state() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("voidgram_plugins", Context.MODE_PRIVATE);
+    }
+
+    private static SharedPreferences storage() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("voidgram_plugins_storage", Context.MODE_PRIVATE);
+    }
+
+    private static String read(File file) {
+        try (InputStream in = new FileInputStream(file)) {
+            return readAll(in);
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    private static String readAll(InputStream in) throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buffer = new byte[16384];
+        int count;
+        while ((count = in.read(buffer)) > 0) {
+            out.write(buffer, 0, count);
+        }
+        return out.toString("UTF-8");
+    }
+
+    /** The "// @key value" header, read without running anything. */
+    public static Plugin preview(String source, String filename) {
+        if (source == null || source.length() > 512 * 1024 || source.indexOf('\0') >= 0) {
+            return null;
+        }
+        String lower = filename == null ? "" : filename.toLowerCase(Locale.ROOT);
+        String language = lower.endsWith(".py") || lower.endsWith(".ayupy") ? "python" : lower.endsWith(".lua") || lower.endsWith(".ayulua") ? "lua" : "js";
+        String prefix = "python".equals(language) ? "#" : "lua".equals(language) ? "--" : "//";
+        HashMap<String, String> fields = new HashMap<>();
+        String[] lines = source.split("\n");
+        for (int i = 0; i < Math.min(80, lines.length); i++) {
+            String trimmed = lines[i].trim();
+            if (!trimmed.startsWith(prefix)) {
+                continue;
+            }
+            String body = trimmed.substring(prefix.length()).trim();
+            if (!body.startsWith("@")) {
+                continue;
+            }
+            String[] parts = body.substring(1).split("\\s+", 2);
+            if (parts.length > 0 && !parts[0].isEmpty()) {
+                fields.put(parts[0].toLowerCase(Locale.ROOT), parts.length > 1 ? parts[1].trim() : "");
+            }
+        }
+        String base = filename == null ? "plugin" : filename.replaceAll("\\.[^.]*$", "");
+        StringBuilder fallback = new StringBuilder();
+        for (char c : base.toLowerCase(Locale.ROOT).toCharArray()) {
+            fallback.append(c < 128 && Character.isLetterOrDigit(c) || c == '-' || c == '_' ? c : '-');
+        }
+        String lang2 = VoidGram.russian() ? "ru" : "en";
+        Plugin plugin = new Plugin();
+        plugin.id = (fields.containsKey("id") ? fields.get("id") : fallback.toString()).toLowerCase(Locale.ROOT);
+        String name = fields.containsKey("name:" + lang2) ? fields.get("name:" + lang2) : fields.get("name");
+        plugin.name = cut(name != null ? name : base, 64);
+        String description = fields.containsKey("description:" + lang2) ? fields.get("description:" + lang2) : fields.get("description");
+        plugin.description = cut(description != null ? description : "", 1024);
+        plugin.author = cut(fields.containsKey("author") ? fields.get("author") : "", 128);
+        plugin.version = cut(fields.containsKey("version") ? fields.get("version") : "1.0", 32);
+        plugin.language = language;
+        String permissions = fields.get("permissions");
+        if (permissions != null) {
+            for (String part : permissions.split("[,\\s]+")) {
+                if (!part.isEmpty()) {
+                    plugin.permissions.add(part.toLowerCase(Locale.ROOT));
+                }
+            }
+        }
+        String connect = fields.get("connect");
+        if (connect != null) {
+            for (String part : connect.split("[,\\s]+")) {
+                if (!part.isEmpty()) {
+                    plugin.connect.add(part.toLowerCase(Locale.ROOT));
+                }
+            }
+        }
+        return plugin;
+    }
+
+    private static String cut(String value, int limit) {
+        return value.length() > limit ? value.substring(0, limit) : value;
+    }
+
+    public static ArrayList<Plugin> list() {
+        ArrayList<Plugin> result = new ArrayList<>();
+        File[] files = directory().listFiles();
+        if (files == null) {
+            return result;
+        }
+        java.util.Arrays.sort(files, (a, b) -> a.getName().compareTo(b.getName()));
+        for (File file : files) {
+            if (!file.getName().endsWith(".js")) {
+                continue;
+            }
+            Plugin plugin = preview(read(file), file.getName());
+            if (plugin == null) {
+                continue;
+            }
+            plugin.id = file.getName().substring(0, file.getName().length() - 3);
+            plugin.enabled = state().getBoolean("enabled_" + plugin.id, false);
+            plugin.disabledReason = state().getString("reason_" + plugin.id, null);
+            result.add(plugin);
+        }
+        return result;
+    }
+
+    public static Plugin get(String id) {
+        for (Plugin plugin : list()) {
+            if (plugin.id.equals(id)) {
+                return plugin;
+            }
+        }
+        return null;
+    }
+
+    /** Installs (or updates) a plugin; null on success, else a readable reason. */
+    public static String install(String source, String filename) {
+        Plugin plugin = preview(source, filename);
+        if (plugin == null) {
+            return VoidGram.t("Это не плагин VoidGram (или файл больше 512 КБ).", "This is not a VoidGram plugin (or the file is over 512 KB).");
+        }
+        if (!"js".equals(plugin.language)) {
+            return VoidGram.t("На Android пока работают только плагины на JavaScript.", "Only JavaScript plugins run on Android so far.");
+        }
+        if (!plugin.id.matches("[a-z0-9._-]{1,64}")) {
+            return VoidGram.t("Неверный @id плагина.", "Invalid plugin @id.");
+        }
+        try (OutputStream out = new FileOutputStream(new File(directory(), plugin.id + ".js"))) {
+            out.write(source.getBytes("UTF-8"));
+        } catch (Throwable e) {
+            return VoidGram.t("Не удалось сохранить плагин.", "The plugin could not be saved.");
+        }
+        state().edit().remove("reason_" + plugin.id).apply();
+        if (state().getBoolean("enabled_" + plugin.id, false)) {
+            restart(plugin.id);
+        }
+        return null;
+    }
+
+    public static void setEnabled(String id, boolean enabled) {
+        state().edit().putBoolean("enabled_" + id, enabled).remove("reason_" + id).apply();
+        if (enabled) {
+            restart(id);
+        } else {
+            post(() -> stop(id, null));
+        }
+    }
+
+    public static void delete(String id) {
+        setEnabled(id, false);
+        new File(directory(), id + ".js").delete();
+        SharedPreferences.Editor editor = storage().edit();
+        for (String key : storage().getAll().keySet()) {
+            if (key.startsWith(id + "\u0001")) {
+                editor.remove(key);
+            }
+        }
+        editor.apply();
+    }
+
+    public static String source(String id) {
+        return read(new File(directory(), id + ".js"));
+    }
+
+    // ---- Console ----
+
+    private static void log(String id, String level, String message) {
+        String line = new java.text.SimpleDateFormat("HH:mm:ss", Locale.US).format(new java.util.Date()) + " [" + id + "] " + ("info".equals(level) ? "" : level.toUpperCase(Locale.ROOT) + ": ") + message;
+        synchronized (console) {
+            console.add(line);
+            while (console.size() > CONSOLE_LIMIT) {
+                console.remove(0);
+            }
+        }
+    }
+
+    public static String consoleText() {
+        synchronized (console) {
+            StringBuilder builder = new StringBuilder();
+            for (String line : console) {
+                builder.append(line).append('\n');
+            }
+            return builder.toString();
+        }
+    }
+
+    public static void clearConsole() {
+        synchronized (console) {
+            console.clear();
+        }
+    }
+
+    // ---- Runtime ----
+
+    private static synchronized void post(Runnable runnable) {
+        if (thread == null) {
+            thread = new HandlerThread("VoidGramPlugins");
+            thread.start();
+            handler = new Handler(thread.getLooper());
+        }
+        handler.post(runnable);
+    }
+
+    private static void postDelayed(Runnable runnable, long delay) {
+        post(() -> handler.postDelayed(runnable, delay));
+    }
+
+    /** ApplicationLoader / LaunchActivity: starts every enabled plugin once. */
+    public static void startAll() {
+        if (VoidGramDecoy.isActive()) {
+            return;
+        }
+        for (Plugin plugin : list()) {
+            if (plugin.enabled && !running.containsKey(plugin.id)) {
+                restart(plugin.id);
+            }
+        }
+    }
+
+    private static void restart(String id) {
+        post(() -> {
+            stop(id, null);
+            start(id);
+        });
+    }
+
+    private static String raw(int resource) {
+        try (InputStream in = ApplicationLoader.applicationContext.getResources().openRawResource(resource)) {
+            return readAll(in);
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    private static void start(String id) {
+        Plugin plugin = get(id);
+        String code = source(id);
+        if (plugin == null || code == null) {
+            return;
+        }
+        if (engineFailed) {
+            disable(id, VoidGram.t("Движок JavaScript недоступен на этом устройстве.", "The JavaScript engine is not available on this device."));
+            return;
+        }
+        Runtime runtime = new Runtime();
+        runtime.plugin = plugin;
+        try {
+            QuickJSLoader.init();
+            runtime.context = QuickJSContext.create();
+            runtime.context.setMaxStackSize(1024 * 1024);
+            runtime.context.setMemoryLimit(64 * 1024 * 1024);
+        } catch (Throwable e) {
+            engineFailed = true;
+            disable(id, VoidGram.t("Движок JavaScript недоступен на этом устройстве.", "The JavaScript engine is not available on this device."));
+            return;
+        }
+        running.put(id, runtime);
+        try {
+            JSObject global = runtime.context.getGlobalObject();
+            JSObject bridge = runtime.context.createNewJSObject();
+            bridge.setProperty("pluginId", (JSCallFunction) args -> id);
+            bridge.setProperty("call", (JSCallFunction) args -> call(runtime, str(args, 0), str(args, 1)));
+            bridge.setProperty("log", (JSCallFunction) args -> {
+                log(id, str(args, 0), str(args, 1));
+                return null;
+            });
+            bridge.setProperty("toast", (JSCallFunction) args -> {
+                String text = str(args, 0);
+                AndroidUtilities.runOnUIThread(() -> Toast.makeText(ApplicationLoader.applicationContext, text, Toast.LENGTH_SHORT).show());
+                return null;
+            });
+            bridge.setProperty("hookRegistered", (JSCallFunction) args -> {
+                runtime.hooks.add(str(args, 0) + "|" + str(args, 1));
+                return null;
+            });
+            bridge.setProperty("setTimer", (JSCallFunction) args -> {
+                int timer = ((Number) args[0]).intValue();
+                long ms = Math.max(0, ((Number) args[1]).longValue());
+                boolean repeats = Boolean.TRUE.equals(args[2]);
+                schedule(runtime, timer, ms, repeats);
+                return null;
+            });
+            bridge.setProperty("clearTimer", (JSCallFunction) args -> {
+                Runnable timer = runtime.timers.remove(((Number) args[0]).intValue());
+                if (timer != null) {
+                    handler.removeCallbacks(timer);
+                }
+                return null;
+            });
+            bridge.setProperty("storageGet", (JSCallFunction) args -> storage().getString(id + "\u0001" + str(args, 0), null));
+            bridge.setProperty("storageSet", (JSCallFunction) args -> {
+                String key = id + "\u0001" + str(args, 0);
+                if (args.length < 2 || args[1] == null) {
+                    storage().edit().remove(key).apply();
+                } else {
+                    storage().edit().putString(key, String.valueOf(args[1])).apply();
+                }
+                return true;
+            });
+            bridge.setProperty("settingGet", (JSCallFunction) args -> settingJson(id, str(args, 0)));
+            bridge.setProperty("settingsDeclare", (JSCallFunction) args -> {
+                state().edit().putString("settings_" + id, str(args, 0)).apply();
+                return true;
+            });
