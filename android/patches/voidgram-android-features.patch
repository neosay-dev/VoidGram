+package org.telegram.ui.voidgram;
+
+import android.app.Activity;
+import android.widget.Toast;
+
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramExtras;
+import org.telegram.ui.ActionBar.AlertDialog;
+
+/** Player menu → Sleep timer. */
+public final class VoidGramSleepTimerSheet {
+    private VoidGramSleepTimerSheet() {
+    }
+
+    public static void show(Activity activity) {
+        if (activity == null) {
+            return;
+        }
+        int left = VoidGramExtras.sleepMinutesLeft();
+        int count = VoidGramExtras.SLEEP_MINUTES.length;
+        CharSequence[] items = new CharSequence[count + (left > 0 ? 1 : 0)];
+        for (int i = 0; i < count; i++) {
+            int minutes = VoidGramExtras.SLEEP_MINUTES[i];
+            items[i] = minutes < 60 ? minutes + VoidGram.t(" мин", " min") : (minutes / 60) + VoidGram.t(" ч", " h") + (minutes % 60 != 0 ? " " + (minutes % 60) + VoidGram.t(" мин", " min") : "");
+        }
+        if (left > 0) {
+            items[count] = VoidGram.t("Выключить таймер", "Turn the timer off");
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(activity);
+        builder.setTitle(left > 0 ? VoidGram.t("Таймер сна: осталось ", "Sleep timer: ") + left + VoidGram.t(" мин", " min left") : VoidGram.t("Таймер сна", "Sleep timer"));
+        builder.setItems(items, (dialog, which) -> {
+            if (which < count) {
+                VoidGramExtras.startSleepTimer(VoidGramExtras.SLEEP_MINUTES[which]);
+                Toast.makeText(activity, VoidGram.t("Музыка остановится через ", "Music stops in ") + items[which], Toast.LENGTH_SHORT).show();
+            } else {
+                VoidGramExtras.cancelSleepTimer();
+            }
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        builder.show();
+    }
+}
