+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramShortcuts.java
@@ -0,0 +1,136 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.SendMessagesHelper;
+
+import java.text.DateFormat;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * Text shortcuts and templates, as on iOS: a message that is exactly ";adr" becomes the saved
+ * text; {date}, {time}, {weekday} and {clipboard} are filled in messages that contain them.
+ */
+public final class VoidGramShortcuts {
+    private VoidGramShortcuts() {
+    }
+
+    public static final class Shortcut {
+        public final String trigger;
+        public final String text;
+
+        public Shortcut(String trigger, String text) {
+            this.trigger = trigger;
+            this.text = text;
+        }
+    }
+
+    public static ArrayList<Shortcut> list() {
+        ArrayList<Shortcut> result = new ArrayList<>();
+        try {
+            JSONArray array = new JSONArray(VoidGram.prefs().getString("shortcuts", "[]"));
+            for (int i = 0; i < array.length(); i++) {
+                JSONObject item = array.getJSONObject(i);
+                result.add(new Shortcut(item.getString("trigger"), item.getString("text")));
+            }
+        } catch (Throwable ignore) {
+        }
+        return result;
+    }
+
+    private static void save(ArrayList<Shortcut> items) {
+        JSONArray array = new JSONArray();
+        try {
+            for (int i = 0; i < Math.min(100, items.size()); i++) {
+                array.put(new JSONObject().put("trigger", items.get(i).trigger).put("text", items.get(i).text));
+            }
+        } catch (Throwable ignore) {
+        }
+        VoidGram.prefs().edit().putString("shortcuts", array.toString()).apply();
+    }
+
+    public static void put(String trigger, String text) {
+        ArrayList<Shortcut> items = list();
+        for (int i = items.size() - 1; i >= 0; i--) {
+            if (items.get(i).trigger.equals(trigger)) {
+                items.remove(i);
+            }
+        }
+        items.add(new Shortcut(trigger, text));
+        save(items);
+    }
+
+    public static void remove(String trigger) {
+        ArrayList<Shortcut> items = list();
+        for (int i = items.size() - 1; i >= 0; i--) {
+            if (items.get(i).trigger.equals(trigger)) {
+                items.remove(i);
+            }
+        }
+        save(items);
+    }
+
+    public static boolean variablesEnabled() {
+        return VoidGram.prefs().getBoolean("shortcut_variables", false);
+    }
+
+    public static void setVariablesEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("shortcut_variables", value).apply();
+    }
+
+    /** The text to send instead, or null to keep it. */
+    public static String apply(String text) {
+        if (text == null || VoidGramDecoy.isActive()) {
+            return null;
+        }
+        String result = text;
+        String trimmed = text.trim();
+        for (Shortcut shortcut : list()) {
+            if (shortcut.trigger.equals(trimmed)) {
+                result = shortcut.text;
+                break;
+            }
+        }
+        if ((variablesEnabled() || !result.equals(text)) && result.contains("{")) {
+            Date now = new Date();
+            result = result.replace("{date}", DateFormat.getDateInstance(DateFormat.MEDIUM).format(now));
+            result = result.replace("{time}", DateFormat.getTimeInstance(DateFormat.SHORT).format(now));
+            result = result.replace("{weekday}", new SimpleDateFormat("EEEE", Locale.getDefault()).format(now));
+            if (result.contains("{clipboard}")) {
+                String clip = "";
+                try {
+                    ClipboardManager clipboard = (ClipboardManager) ApplicationLoader.applicationContext.getSystemService(Context.CLIPBOARD_SERVICE);
+                    ClipData data = clipboard != null ? clipboard.getPrimaryClip() : null;
+                    if (data != null && data.getItemCount() > 0 && data.getItemAt(0).getText() != null) {
+                        clip = data.getItemAt(0).getText().toString();
+                    }
+                } catch (Throwable ignore) {
+                }
+                result = result.replace("{clipboard}", clip);
+            }
+        }
+        return result.equals(text) ? null : result;
+    }
+
+    /** SendMessagesHelper: plain text messages only; formatting is dropped when the text changes. */
+    public static void applyToOutgoing(SendMessagesHelper.SendMessageParams params) {
+        if (params == null || params.message == null || params.document != null || params.photo != null) {
+            return;
+        }
+        String replacement = apply(params.message);
+        if (replacement != null && !replacement.isEmpty()) {
+            params.message = replacement;
+            if (params.entities != null) {
+                params.entities.clear();
+            }
+        }
+    }
+}
