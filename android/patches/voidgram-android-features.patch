+package org.telegram.ui.voidgram;
+
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+import android.widget.PopupWindow;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ImageLocation;
+import org.telegram.messenger.MediaDataController;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramDecoy;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.BackupImageView;
+import org.telegram.ui.Components.LayoutHelper;
+
+import java.util.ArrayList;
+
+/**
+ * VoidGram Quick Sticker, as on iOS: hold the sticker button and the favourite and recent stickers
+ * fan out above it; a tap sends one without opening the panel.
+ */
+public final class VoidGramQuickSticker {
+    public interface Sender {
+        void send(TLRPC.Document sticker);
+    }
+
+    private VoidGramQuickSticker() {
+    }
+
+    public static boolean isEnabled() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("quick_sticker", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("quick_sticker", value).apply();
+    }
+
+    /** Shows the row above `anchor`; returns false when there is nothing to offer. */
+    public static boolean show(View anchor, int account, Sender sender) {
+        if (!isEnabled() || anchor == null) {
+            return false;
+        }
+        MediaDataController data = MediaDataController.getInstance(account);
+        ArrayList<TLRPC.Document> stickers = new ArrayList<>();
+        for (TLRPC.Document document : data.getRecentStickers(MediaDataController.TYPE_FAVE)) {
+            if (stickers.size() < 12 && !stickers.contains(document)) {
+                stickers.add(document);
+            }
+        }
+        for (TLRPC.Document document : data.getRecentStickers(MediaDataController.TYPE_IMAGE)) {
+            if (stickers.size() < 12 && !stickers.contains(document)) {
+                stickers.add(document);
+            }
+        }
+        if (stickers.isEmpty()) {
+            return false;
+        }
+        LinearLayout row = new LinearLayout(anchor.getContext());
+        row.setPadding(AndroidUtilities.dp(6), AndroidUtilities.dp(6), AndroidUtilities.dp(6), AndroidUtilities.dp(6));
+        HorizontalScrollView scroll = new HorizontalScrollView(anchor.getContext());
+        scroll.setHorizontalScrollBarEnabled(false);
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(AndroidUtilities.dp(18));
+        background.setColor(Theme.getColor(Theme.key_actionBarDefaultSubmenuBackground));
+        scroll.setBackground(background);
+        scroll.addView(row);
+        final PopupWindow popup = new PopupWindow(scroll, ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, true);
+        popup.setOutsideTouchable(true);
+        popup.setElevation(AndroidUtilities.dp(6));
+        for (final TLRPC.Document sticker : stickers) {
+            BackupImageView image = new BackupImageView(anchor.getContext());
+            image.setImage(ImageLocation.getForDocument(sticker), "66_66", null, null, 0, sticker);
+            image.setOnClickListener(v -> {
+                popup.dismiss();
+                sender.send(sticker);
+            });
+            image.setScaleX(0.4f);
+            image.setScaleY(0.4f);
+            image.setAlpha(0f);
+            image.animate().scaleX(1f).scaleY(1f).alpha(1f).setStartDelay(row.getChildCount() * 18L).setDuration(220).start();
+            row.addView(image, LayoutHelper.createLinear(56, 56, 2, 0, 2, 0));
+        }
+        try {
+            anchor.performHapticFeedback(android.view.HapticFeedbackConstants.LONG_PRESS);
+            popup.showAsDropDown(anchor, 0, -AndroidUtilities.dp(56 + 12 + 12) - anchor.getHeight(), Gravity.START);
+        } catch (Throwable ignore) {
+            return false;
+        }
+        return true;
+    }
+}
