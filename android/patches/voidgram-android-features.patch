+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+
+import org.telegram.ui.ActionBar.AlertDialog;
+
+/**
+ * VoidGram sending options, as on iOS: confirm sticker and GIF sends, and show a preview of a
+ * voice message before it goes out. All off by default.
+ */
+public final class VoidGramSending {
+    /** Set while a confirmed send runs, so the confirmation is not asked again. */
+    public static boolean confirmed;
+
+    private VoidGramSending() {
+    }
+
+    public static boolean confirmStickers() {
+        return VoidGram.prefs().getBoolean("send_confirm_stickers", false);
+    }
+
+    public static void setConfirmStickers(boolean value) {
+        VoidGram.prefs().edit().putBoolean("send_confirm_stickers", value).apply();
+    }
+
+    public static boolean confirmGifs() {
+        return VoidGram.prefs().getBoolean("send_confirm_gifs", false);
+    }
+
+    public static void setConfirmGifs(boolean value) {
+        VoidGram.prefs().edit().putBoolean("send_confirm_gifs", value).apply();
+    }
+
+    public static boolean previewVoice() {
+        return VoidGram.prefs().getBoolean("send_preview_voice", false);
+    }
+
+    public static void setPreviewVoice(boolean value) {
+        VoidGram.prefs().edit().putBoolean("send_preview_voice", value).apply();
+    }
+
+    /** Asks before a send; `send` runs (with `confirmed` set) when the user agrees. */
+    public static void confirm(Context context, String question, Runnable send) {
+        if (context == null) {
+            send.run();
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(question);
+        builder.setPositiveButton(VoidGram.t("Отправить", "Send"), (dialog, which) -> {
+            confirmed = true;
+            try {
+                send.run();
+            } finally {
+                confirmed = false;
+            }
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        builder.show();
+    }
+}
