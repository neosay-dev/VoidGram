+
+import java.util.ArrayList;
+
+/** VoidGram → Player night look: master switch, schedule, strength, tint. */
+public class VoidGramNightLookActivity extends UniversalFragment {
+    private static final int ID_ENABLED = 1;
+    private static final int ID_ALWAYS = 2;
+    private static final int ID_WARM = 3;
+    private static final int ID_STRENGTH_BASE = 10;
+    private static final int ID_RESET = 20;
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Ночной режим плеера", "Player night look");
+    }
+
+    private void refresh() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        int mode = VoidGramNightLook.mode();
+        boolean enabled = mode != VoidGramNightLook.MODE_OFF;
+        items.add(UItem.asHeader(VoidGram.t("Ночной режим плеера", "Player night look")));
+        items.add(UItem.asCheck(ID_ENABLED, VoidGram.t("Ночной режим", "Night look")).setChecked(enabled));
+        if (enabled) {
+            items.add(UItem.asCheck(ID_ALWAYS, VoidGram.t("Всегда, без расписания", "Always, no schedule")).setChecked(mode == VoidGramNightLook.MODE_ALWAYS));
+        }
+        String status;
+        if (!enabled) {
+            status = VoidGram.t("Ночной режим выключен полностью: плеер всегда выглядит как днём.", "The night look is off completely: the player always looks as in the daytime.");
+        } else {
+            status = VoidGramNightLook.isActiveNow() ? VoidGram.t("Сейчас ночной режим включён.", "The night look is on now.") : VoidGram.t("Сейчас ночной режим не действует.", "The night look is not active now.");
+        }
+        items.add(UItem.asShadow(status));
+        if (!enabled) {
+            return;
+        }
+        if (mode == VoidGramNightLook.MODE_SCHEDULED) {
+            items.add(UItem.asHeader(VoidGram.t("Начало", "Starts")));
+            items.add(UItem.asIntSlideView(1, 0, VoidGramNightLook.startHour(), 23, VoidGramNightLook::hourText, value -> {
+                VoidGramNightLook.setStartHour(value);
+            }));
+            items.add(UItem.asHeader(VoidGram.t("Конец", "Ends")));
+            items.add(UItem.asIntSlideView(1, 0, VoidGramNightLook.endHour(), 23, VoidGramNightLook::hourText, value -> {
+                VoidGramNightLook.setEndHour(value);
+            }));
+            items.add(UItem.asShadow(VoidGram.t("Время по часам устройства. Окно может переходить через полночь (22:00–07:00). Одинаковые часы — весь день.", "Device clock time. The window may cross midnight (22:00–07:00). Equal hours mean the whole day.")));
+        }
+        items.add(UItem.asHeader(VoidGram.t("Сила затемнения", "Dimming")));
+        for (int strength = VoidGramNightLook.STRENGTH_SOFT; strength <= VoidGramNightLook.STRENGTH_STRONG; strength++) {
+            items.add(UItem.asRadio(ID_STRENGTH_BASE + strength, VoidGramNightLook.strengthTitle(strength)).setChecked(VoidGramNightLook.strength() == strength));
+        }
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asCheck(ID_WARM, VoidGram.t("Тёплый оттенок", "Warm tint")).setChecked(VoidGramNightLook.isWarm()));
+        items.add(UItem.asShadow(VoidGram.t("Выключите для нейтрального тёмного.", "Off for a neutral dark one.")));
+        items.add(UItem.asButton(ID_RESET, VoidGram.t("Сбросить вид и время", "Reset look and schedule")).red());
+        items.add(UItem.asShadow(null));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_ENABLED) {
+            VoidGramNightLook.setMode(VoidGramNightLook.mode() == VoidGramNightLook.MODE_OFF ? VoidGramNightLook.MODE_SCHEDULED : VoidGramNightLook.MODE_OFF);
+        } else if (item.id == ID_ALWAYS) {
+            VoidGramNightLook.setMode(VoidGramNightLook.mode() == VoidGramNightLook.MODE_ALWAYS ? VoidGramNightLook.MODE_SCHEDULED : VoidGramNightLook.MODE_ALWAYS);
+        } else if (item.id == ID_WARM) {
+            VoidGramNightLook.setWarm(!VoidGramNightLook.isWarm());
+        } else if (item.id >= ID_STRENGTH_BASE && item.id <= ID_STRENGTH_BASE + VoidGramNightLook.STRENGTH_STRONG) {
+            VoidGramNightLook.setStrength(item.id - ID_STRENGTH_BASE);
+        } else if (item.id == ID_RESET) {
+            VoidGramNightLook.reset();
+        } else {
+            return;
+        }
+        refresh();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
