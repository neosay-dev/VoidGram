+                boolean looking = lyrics == null && VoidGramLyrics.isLoading(track);
+                status.setText(looking ? VoidGram.t("Ищем слова…", "Looking for lyrics…") : VoidGram.t("Слова для этого трека не найдены\n\nНажмите, чтобы добавить свой текст", "No lyrics found for this track\n\nTap to add your own text"));
+                status.setTextColor(0x99FFFFFF);
+                status.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17);
+                status.setGravity(Gravity.CENTER);
+                if (!looking) {
+                    status.setOnClickListener(v -> edit.performClick());
