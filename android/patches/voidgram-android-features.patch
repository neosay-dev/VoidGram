+            setFocusable(false);
+            setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+            textPaint.setTextAlign(Paint.Align.CENTER);
+        }
+
+        void configure(String effect, String shape, float amount, float speed) {
+            boolean changed = !effect.equals(this.effect) || !shape.equals(this.shape) || Math.abs(this.speed - speed) > 0.01f;
+            this.effect = effect;
+            this.shape = shape;
+            this.speed = speed;
+            int base = "rain".equals(effect) ? 90 : "stars".equals(effect) ? 60 : "confetti".equals(effect) ? 70 : "leaves".equals(effect) ? 18 : 55;
+            int count = Math.max(4, Math.min(300, (int) (base * amount)));
+            if (changed || count != x.length) {
+                x = new float[count];
+                y = new float[count];
+                size = new float[count];
+                drift = new float[count];
+                velocity = new float[count];
+                phase = new float[count];
+                color = new int[count];
+                for (int i = 0; i < count; i++) {
+                    reset(i, true);
+                }
+            }
+            invalidate();
+        }
+
+        private static final int[] CONFETTI = {0xFFFF2D55, 0xFFFFCC00, 0xFF34C759, 0xFF0A84FF, 0xFFBF5AF2, 0xFFFF9500};
+
+        private void reset(int i, boolean anywhere) {
+            int width = Math.max(1, getWidth() > 0 ? getWidth() : AndroidUtilities.displaySize.x);
+            int height = Math.max(1, getHeight() > 0 ? getHeight() : AndroidUtilities.displaySize.y);
+            x[i] = random.nextFloat() * width;
+            y[i] = anywhere ? random.nextFloat() * height : -AndroidUtilities.dp(20);
+            phase[i] = random.nextFloat() * 6.28f;
+            drift[i] = (random.nextFloat() - 0.5f) * AndroidUtilities.dp(30);
+            color[i] = CONFETTI[random.nextInt(CONFETTI.length)];
+            switch (effect) {
+                case "rain":
+                    size[i] = AndroidUtilities.dp(10 + random.nextInt(14));
+                    velocity[i] = AndroidUtilities.dp(700 + random.nextInt(400));
+                    break;
+                case "stars":
+                    size[i] = AndroidUtilities.dp(1) + random.nextFloat() * AndroidUtilities.dp(2.5f);
+                    velocity[i] = 0;
+                    break;
+                case "leaves":
+                    size[i] = AndroidUtilities.dp(14 + random.nextInt(10));
+                    velocity[i] = AndroidUtilities.dp(40 + random.nextInt(50));
+                    break;
+                case "confetti":
+                    size[i] = AndroidUtilities.dp(4 + random.nextInt(5));
+                    velocity[i] = AndroidUtilities.dp(90 + random.nextInt(110));
+                    break;
+                default:
+                    size[i] = "dots".equals(shape) ? AndroidUtilities.dp(1.5f) + random.nextFloat() * AndroidUtilities.dp(2.5f) : AndroidUtilities.dp(9 + random.nextInt(9));
+                    velocity[i] = AndroidUtilities.dp(30 + random.nextInt(60));
+                    break;
+            }
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            long now = System.currentTimeMillis();
+            float dt = lastFrame == 0 ? 0 : Math.min(0.05f, (now - lastFrame) / 1000f);
+            lastFrame = now;
+            int height = getHeight();
+            float t = now / 1000f;
+            for (int i = 0; i < x.length; i++) {
+                y[i] += velocity[i] * speed * dt;
+                if (y[i] > height + AndroidUtilities.dp(30)) {
+                    reset(i, false);
+                }
+                float px = x[i] + (float) Math.sin(t * 0.8f * speed + phase[i]) * drift[i];
+                switch (effect) {
+                    case "rain":
+                        paint.setColor(0x669FC4FF);
+                        paint.setStrokeWidth(AndroidUtilities.dp(1.2f));
+                        canvas.drawLine(x[i], y[i], x[i] - size[i] * 0.15f, y[i] + size[i], paint);
+                        break;
+                    case "stars": {
+                        float alpha = 0.35f + 0.65f * (0.5f + 0.5f * (float) Math.sin(t * 2f * speed + phase[i]));
+                        paint.setColor(0xFFFFFFFF);
+                        paint.setAlpha((int) (alpha * 200));
+                        canvas.drawCircle(x[i], y[i], size[i], paint);
+                        break;
+                    }
+                    case "leaves":
+                        textPaint.setTextSize(size[i]);
+                        canvas.save();
+                        canvas.rotate((float) Math.sin(t * speed + phase[i]) * 40f, px, y[i]);
+                        canvas.drawText(i % 2 == 0 ? "🍂" : "🍁", px, y[i], textPaint);
+                        canvas.restore();
+                        break;
+                    case "confetti":
+                        paint.setColor(color[i]);
+                        canvas.save();
+                        canvas.rotate(t * 180f * speed + phase[i] * 57f, px, y[i]);
+                        canvas.drawRect(px - size[i] / 2f, y[i] - size[i] / 4f, px + size[i] / 2f, y[i] + size[i] / 4f, paint);
+                        canvas.restore();
+                        break;
+                    default:
+                        if ("dots".equals(shape)) {
+                            paint.setColor(0xCCFFFFFF);
+                            canvas.drawCircle(px, y[i], size[i], paint);
+                        } else {
+                            textPaint.setTextSize(size[i]);
+                            textPaint.setColor(0xDDFFFFFF);
+                            canvas.drawText("voidgram".equals(shape) ? "✦" : "❄", px, y[i], textPaint);
+                        }
+                        break;
+                }
+            }
+            postInvalidateOnAnimation();
+        }
+
+        @Override
+        protected void onDetachedFromWindow() {
+            super.onDetachedFromWindow();
+            lastFrame = 0;
+        }
+    }
+}
