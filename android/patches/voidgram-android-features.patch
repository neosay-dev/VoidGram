@@ -0,0 +1,115 @@
+package org.telegram.ui.voidgram;
+
+import android.view.View;
+
+import org.telegram.messenger.SharedConfig;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramDpi;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+import org.telegram.ui.ProxyListActivity;
+
+import java.util.ArrayList;
+
+/** VoidGram → Bypass blocking: DPI tricks with country presets and full manual settings. */
+public class VoidGramDpiActivity extends UniversalFragment {
+    private static final int ID_ENABLED = 1;
+    private static final int ID_PRESET_BASE = 10;
+    private static final int ID_METHOD_BASE = 20;
+    private static final int ID_VIA_PROXY = 30;
+    private static final int ID_PROXY = 31;
+    private static final int ID_RECONNECT = 32;
+    private static final int ID_RESET = 33;
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Обход блокировок", "Bypass blocking");
+    }
+
+    private void refresh() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        boolean enabled = VoidGramDpi.isEnabled();
+        items.add(UItem.asHeader(VoidGram.t("Обход DPI", "DPI bypass")));
+        items.add(UItem.asCheck(ID_ENABLED, VoidGram.t("Обходить блокировки", "Bypass blocking")).setChecked(enabled));
+        items.add(UItem.asShadow(VoidGram.t("Первый пакет каждого соединения с Telegram уходит так, чтобы система фильтрации (DPI) его не распознала. Root не нужен. Применяется к новым соединениям; кнопка «Переподключиться» применяет сразу.", "The first packet of every connection to Telegram is sent so that the filtering system (DPI) does not recognise it. No root needed. Applies to new connections; \"Reconnect now\" applies it at once.")));
+        if (!enabled) {
+            items.add(UItem.asButton(ID_PROXY, VoidGram.t("Прокси (MTProto, SOCKS5)", "Proxy (MTProto, SOCKS5)")));
+            items.add(UItem.asShadow(null));
+            return;
+        }
+
+        String preset = VoidGramDpi.preset();
+        items.add(UItem.asHeader(VoidGram.t("Страна", "Country")));
+        for (int i = 0; i < VoidGramDpi.PRESETS.length; i++) {
+            items.add(UItem.asRadio(ID_PRESET_BASE + i, VoidGramDpi.presetTitle(VoidGramDpi.PRESETS[i])).setChecked(VoidGramDpi.PRESETS[i].equals(preset)));
+        }
+        items.add(UItem.asShadow(VoidGramDpi.presetInfo(preset)));
+
+        int method = VoidGramDpi.method();
+        items.add(UItem.asHeader(VoidGram.t("Способ", "Method")));
+        for (int m = VoidGramDpi.METHOD_SPLIT; m <= VoidGramDpi.METHOD_DISORDER_OOB; m++) {
+            items.add(UItem.asRadio(ID_METHOD_BASE + m, VoidGramDpi.methodTitle(m)).setChecked(m == method));
+        }
+        items.add(UItem.asShadow(VoidGram.t("Разбиение режет первый пакет на части. Перестановка отправляет первую часть так, что она приходит позже остальных. OOB добавляет срочный байт, который сервер отбрасывает, а фильтр — нет.", "Split cuts the first packet into parts. Disorder sends the first part so that it arrives after the rest. OOB adds an urgent byte the server drops and the filter does not.")));
+
+        items.add(UItem.asHeader(VoidGram.t("Размер части, байт", "Part size, bytes")));
+        items.add(UItem.asIntSlideView(1, 1, Math.min(64, VoidGramDpi.splitPosition()), 64, value -> value + VoidGram.t(" Б", " B"), value -> VoidGramDpi.setSplitPosition(value)));
+        items.add(UItem.asHeader(VoidGram.t("Количество частей", "Number of parts")));
+        items.add(UItem.asIntSlideView(1, 1, VoidGramDpi.splitCount(), 16, value -> String.valueOf(value), value -> VoidGramDpi.setSplitCount(value)));
+        items.add(UItem.asHeader(VoidGram.t("Пауза между частями, мс", "Pause between parts, ms")));
+        items.add(UItem.asIntSlideView(1, 0, VoidGramDpi.delayMs(), 100, value -> value + VoidGram.t(" мс", " ms"), value -> VoidGramDpi.setDelayMs(value)));
+        items.add(UItem.asShadow(VoidGram.t("Любое изменение переключает страну на «Свои настройки».", "Any change switches the country to \"Custom\".")));
+
+        items.add(UItem.asCheck(ID_VIA_PROXY, VoidGram.t("Применять и к прокси", "Also for proxies")).setChecked(VoidGramDpi.viaProxy()));
+        items.add(UItem.asButton(ID_PROXY, VoidGram.t("Прокси (MTProto, SOCKS5)", "Proxy (MTProto, SOCKS5)")));
+        items.add(UItem.asShadow(VoidGram.t("Где адреса Telegram закрыты целиком (Китай, Иран), нужен прокси — лучше MTProto с fake-TLS. Тогда приёмы прячут само подключение к прокси.", "Where Telegram's addresses are blocked outright (China, Iran), a proxy is needed — best MTProto with fake-TLS. The tricks then hide the proxy connection itself.")));
+        items.add(UItem.asButton(ID_RECONNECT, VoidGram.t("Переподключиться сейчас", "Reconnect now")).accent());
+        items.add(UItem.asButton(ID_RESET, VoidGram.t("Сбросить настройки обхода", "Reset bypass settings")).red());
+        items.add(UItem.asShadow(null));
+    }
+
+    private void reconnect() {
+        ConnectionsManager.setProxySettings(SharedConfig.isProxyEnabled(), SharedConfig.currentProxy != null ? SharedConfig.currentProxy.settings : null);
+        BulletinFactory.of(this).createSimpleBulletin(org.telegram.messenger.R.raw.done, VoidGram.t("Соединения перезапущены", "Connections restarted")).show();
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int id = item.id;
+        if (id == ID_ENABLED) {
+            VoidGramDpi.setEnabled(!VoidGramDpi.isEnabled());
+            reconnect();
+        } else if (id >= ID_PRESET_BASE && id < ID_PRESET_BASE + VoidGramDpi.PRESETS.length) {
+            VoidGramDpi.setPreset(VoidGramDpi.PRESETS[id - ID_PRESET_BASE]);
+        } else if (id >= ID_METHOD_BASE && id <= ID_METHOD_BASE + VoidGramDpi.METHOD_DISORDER_OOB) {
+            VoidGramDpi.setMethod(id - ID_METHOD_BASE);
+        } else if (id == ID_VIA_PROXY) {
+            VoidGramDpi.setViaProxy(!VoidGramDpi.viaProxy());
+        } else if (id == ID_PROXY) {
+            presentFragment(new ProxyListActivity());
+            return;
+        } else if (id == ID_RECONNECT) {
+            reconnect();
+            return;
+        } else if (id == ID_RESET) {
+            VoidGramDpi.reset();
+        } else {
+            return;
+        }
+        refresh();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
