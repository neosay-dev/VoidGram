+    /**
+     * VoidGram "Audio → voice": 48 kHz mono 16-bit PCM into an Ogg Opus voice file, with the same
+     * encoder as the microphone recorder. Not while a recording runs.
+     */
+    public boolean voidgramEncodeVoice(String path, byte[] pcm) {
+        if (pcm == null || path == null || audioRecorder != null || audioRecorderV2Active || fileEncodingQueue == null) {
+            return false;
+        }
+        final boolean[] ok = new boolean[1];
+        final java.util.concurrent.CountDownLatch latch = new java.util.concurrent.CountDownLatch(1);
+        fileEncodingQueue.postRunnable(() -> {
+            try {
+                if (startRecord(path, 48000) == 0) {
+                    return;
+                }
+                ByteBuffer frame = ByteBuffer.allocateDirect(1920);
+                frame.order(ByteOrder.nativeOrder());
+                int offset = 0;
+                while (offset < pcm.length) {
+                    int count = Math.min(1920, pcm.length - offset);
+                    frame.clear();
+                    frame.put(pcm, offset, count);
+                    frame.flip();
+                    writeFrame(frame, count);
+                    offset += count;
+                }
+                stopRecord();
+                ok[0] = true;
+            } catch (Throwable e) {
+                FileLog.e(e);
+            } finally {
+                latch.countDown();
+            }
+        });
+        try {
+            latch.await(5, java.util.concurrent.TimeUnit.MINUTES);
+        } catch (InterruptedException ignore) {
+        }
+        return ok[0];
+    }
