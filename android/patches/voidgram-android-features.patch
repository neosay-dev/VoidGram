+package org.telegram.messenger.voidgram;
+
+import android.os.Build;
+import android.util.Base64;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.security.KeyFactory;
+import java.security.PublicKey;
+import java.security.Signature;
+import java.security.spec.X509EncodedKeySpec;
+import java.util.HashMap;
+
+/**
+ * VoidGram badges, as on iOS: the signed registry from the VoidGram badge server
+ * (badge.vinx.best). A registry is accepted only when the server's Ed25519 signature matches the
+ * key built into the app and it is no older than the one in use. A badge shows in the emoji status
+ * place next to the name, for people who wear no status of their own, and only in VoidGram.
+ */
+public final class VoidGramBadges {
+    private static final String URL_REGISTRY = "https://badge.vinx.best/badges.json";
+    private static final String PUBLIC_KEY = "jZQXVmhMI6elJzj4lH4iIKPuCHfyctUKqL76PUda3TA=";
+    /** DER prefix of an Ed25519 SubjectPublicKeyInfo; the raw 32-byte key follows. */
+    private static final byte[] X509_PREFIX = {0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00};
+
+    private static volatile HashMap<Long, Long> badges = new HashMap<>();
+    private static volatile HashMap<Long, String> labels = new HashMap<>();
+    private static double issuedAt;
+    private static boolean started;
+
+    private VoidGramBadges() {
+    }
+
+    public static boolean isEnabled() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("badges_enabled", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("badges_enabled", value).apply();
+    }
+
+    public static Long badgeFor(long userId) {
+        return isEnabled() ? badges.get(userId) : null;
+    }
+
+    public static String labelFor(long userId) {
+        return isEnabled() ? labels.get(userId) : null;
+    }
+
+    /** Puts the VoidGram badge into the status place of a user who has none. */
+    public static void decorate(TLRPC.User user) {
+        if (user == null) {
+            return;
+        }
+        Long documentId = badgeFor(user.id);
+        if (documentId == null) {
+            return;
+        }
+        if (user.emoji_status != null && !(user.emoji_status instanceof TLRPC.TL_emojiStatusEmpty)) {
+            return;
+        }
+        TLRPC.TL_emojiStatus status = new TLRPC.TL_emojiStatus();
+        status.document_id = documentId;
+        user.emoji_status = status;
+    }
+
+    private static File cacheFile() {
+        return new File(ApplicationLoader.applicationContext.getFilesDir(), "voidgram_badges.json");
+    }
+
+    /** Loads the last signed copy, then re-reads the server now and every 15 minutes. */
+    public static synchronized void start() {
+        if (started) {
+            return;
+        }
+        started = true;
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                File file = cacheFile();
+                File sig = new File(file.getPath() + ".sig");
+                if (file.exists() && sig.exists()) {
+                    accept(read(new FileInputStream(file)), new String(read(new FileInputStream(sig)), "UTF-8"), false);
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            refreshLoop();
+        });
+    }
+
+    private static void refreshLoop() {
+        Utilities.globalQueue.postRunnable(() -> {
+            refresh();
+            AndroidUtilities.runOnUIThread(VoidGramBadges::refreshLoop, 15 * 60 * 1000);
+        });
+    }
+
+    private static void refresh() {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(URL_REGISTRY).openConnection();
+            connection.setConnectTimeout(15000);
+            connection.setReadTimeout(15000);
+            connection.setUseCaches(false);
+            if (connection.getResponseCode() != 200) {
+                return;
+            }
+            String signature = connection.getHeaderField("X-VoidGram-Signature");
+            byte[] data = read(connection.getInputStream());
+            if (signature != null) {
+                accept(data, signature, true);
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    private static byte[] read(InputStream input) throws Exception {
+        try (InputStream in = input) {
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int count;
+            while ((count = in.read(buffer)) > 0 && output.size() < 8 * 1024 * 1024) {
+                output.write(buffer, 0, count);
+            }
+            return output.toByteArray();
+        }
+    }
+
+    private static boolean verify(byte[] data, String signature) {
+        // Ed25519 is in the platform from Android 13; older versions keep showing no badges.
+        if (Build.VERSION.SDK_INT < 33) {
+            return false;
+        }
+        try {
+            byte[] raw = Base64.decode(PUBLIC_KEY, Base64.DEFAULT);
+            byte[] der = new byte[X509_PREFIX.length + raw.length];
+            System.arraycopy(X509_PREFIX, 0, der, 0, X509_PREFIX.length);
+            System.arraycopy(raw, 0, der, X509_PREFIX.length, raw.length);
+            PublicKey key = KeyFactory.getInstance("Ed25519").generatePublic(new X509EncodedKeySpec(der));
+            Signature verifier = Signature.getInstance("Ed25519");
+            verifier.initVerify(key);
+            verifier.update(data);
+            return verifier.verify(Base64.decode(signature.trim(), Base64.DEFAULT));
+        } catch (Throwable e) {
+            FileLog.e(e);
+            return false;
+        }
+    }
+
+    private static void accept(byte[] data, String signature, boolean save) {
+        try {
+            if (!verify(data, signature)) {
+                return;
+            }
+            JSONObject json = new JSONObject(new String(data, "UTF-8"));
+            if (!"voidgram-badges".equals(json.optString("format"))) {
+                return;
+            }
+            double issued = json.optDouble("issuedAt", 0);
+            if (issued < issuedAt) {
+                return;
+            }
+            JSONArray array = json.optJSONArray("badges");
+            HashMap<Long, Long> parsedBadges = new HashMap<>();
+            HashMap<Long, String> parsedLabels = new HashMap<>();
+            double now = System.currentTimeMillis() / 1000.0;
+            if (array != null) {
+                for (int i = 0; i < array.length(); i++) {
+                    JSONObject badge = array.getJSONObject(i);
+                    long id = badge.optLong("id", 0);
+                    if (id == 0) {
+                        continue;
+                    }
+                    double expires = badge.optDouble("expiresAt", 0);
+                    if (expires > 0 && expires < now) {
+                        continue;
+                    }
+                    long documentId = badge.optLong("documentId", 0);
+                    if (documentId != 0) {
+                        parsedBadges.put(id, documentId);
+                    }
+                    String title = badge.optString("title", "");
+                    JSONObject label = badge.optJSONObject("label");
+                    if (label != null && !label.optString("text", "").isEmpty()) {
+                        title = label.optString("text");
+                    }
+                    if (!title.isEmpty()) {
+                        parsedLabels.put(id, title.length() > 160 ? title.substring(0, 160) : title);
+                    }
+                }
+            }
+            issuedAt = issued;
+            badges = parsedBadges;
+            labels = parsedLabels;
+            if (save) {
+                try (FileOutputStream out = new FileOutputStream(cacheFile())) {
+                    out.write(data);
+                }
+                try (FileOutputStream out = new FileOutputStream(cacheFile().getPath() + ".sig")) {
+                    out.write(signature.getBytes("UTF-8"));
+                }
+            }
+            AndroidUtilities.runOnUIThread(VoidGramBadges::applyToLoadedUsers);
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    private static void applyToLoadedUsers() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (!UserConfig.getInstance(a).isClientActivated()) {
+                continue;
+            }
+            for (Long id : badges.keySet()) {
+                TLRPC.User user = MessagesController.getInstance(a).getUser(id);
+                decorate(user);
+            }
+            NotificationCenter.getInstance(a).postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_EMOJI_STATUS);
+        }
+    }
+}
