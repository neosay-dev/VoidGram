+        LinearLayout list = new LinearLayout(activity);
+        list.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(list);
+        for (final Chat chat : chats()) {
+            LinearLayout row = new LinearLayout(activity);
+            row.setOrientation(LinearLayout.HORIZONTAL);
+            row.setGravity(Gravity.CENTER_VERTICAL);
+            row.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(8));
+            int size = AndroidUtilities.dp(54);
+            row.addView(avatar(activity, chat, size), new LinearLayout.LayoutParams(size, size));
+            LinearLayout texts = new LinearLayout(activity);
+            texts.setOrientation(LinearLayout.VERTICAL);
+            texts.setPadding(AndroidUtilities.dp(12), 0, 0, 0);
+            LinearLayout top = new LinearLayout(activity);
+            TextView title = new TextView(activity);
+            title.setText(chat.title);
+            title.setTextColor(0xFF222222);
+            title.setTypeface(AndroidUtilities.bold());
+            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+            title.setSingleLine(true);
+            top.addView(title, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+            Message last = chat.messages.get(chat.messages.size() - 1);
+            TextView time = new TextView(activity);
+            time.setText(last.time);
+            time.setTextColor(0xFF8E8E93);
+            time.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+            top.addView(time);
+            texts.addView(top);
+            LinearLayout bottom = new LinearLayout(activity);
+            TextView preview = new TextView(activity);
+            preview.setText((last.out ? "Вы: " : "") + last.text);
+            preview.setTextColor(0xFF8E8E93);
+            preview.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+            preview.setSingleLine(true);
+            bottom.addView(preview, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+            if (chat.unread > 0) {
+                TextView badge = new TextView(activity);
+                badge.setText(String.valueOf(chat.unread));
+                badge.setTextColor(Color.WHITE);
+                badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+                badge.setGravity(Gravity.CENTER);
+                GradientDrawable badgeBackground = new GradientDrawable();
+                badgeBackground.setCornerRadius(AndroidUtilities.dp(11));
+                badgeBackground.setColor(chat.muted ? 0xFFC4C9CC : 0xFF4FAE4E);
+                badge.setBackground(badgeBackground);
+                badge.setMinWidth(AndroidUtilities.dp(22));
+                bottom.addView(badge, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(22)));
+            }
+            texts.addView(bottom);
+            row.addView(texts, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+            row.setOnClickListener(v -> showChat(activity, root, chat));
+            list.addView(row);
+        }
+        column.addView(scroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        root.addView(column);
+    }
+
+    private static void showChat(Activity activity, FrameLayout root, Chat chat) {
+        root.removeAllViews();
+        root.setTag(chat);
+        LinearLayout column = new LinearLayout(activity);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setBackgroundColor(0xFFD2DEBF);
+        TextView title = header(activity, "←  " + chat.title);
+        title.setOnClickListener(v -> showList(activity, root));
+        column.addView(title, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56) + AndroidUtilities.statusBarHeight));
+        final ScrollView scroll = new ScrollView(activity);
+        final LinearLayout list = new LinearLayout(activity);
+        list.setOrientation(LinearLayout.VERTICAL);
+        list.setPadding(0, AndroidUtilities.dp(6), 0, AndroidUtilities.dp(6));
+        scroll.addView(list);
+        for (Message message : chat.messages) {
+            list.addView(bubble(activity, message));
+        }
+        column.addView(scroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        final EditText input = new EditText(activity);
+        input.setHint(chat.channel ? "Без звука" : "Сообщение");
+        input.setEnabled(!chat.channel);
+        input.setBackgroundColor(Color.WHITE);
+        input.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(12), AndroidUtilities.dp(14), AndroidUtilities.dp(12));
+        input.setImeOptions(EditorInfo.IME_ACTION_SEND);
+        input.setSingleLine(true);
+        input.setOnEditorActionListener((v, actionId, event) -> {
+            String text = input.getText().toString().trim();
+            if (text.isEmpty()) {
+                return true;
+            }
+            Message message = new Message(text, true, new SimpleDateFormat("HH:mm", Locale.getDefault()).format(new Date()));
+            chat.messages.add(message);
+            list.addView(bubble(activity, message));
+            input.setText("");
+            scroll.post(() -> scroll.fullScroll(View.FOCUS_DOWN));
+            return true;
+        });
+        column.addView(input, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        root.addView(column);
+        scroll.post(() -> scroll.fullScroll(View.FOCUS_DOWN));
+    }
+
+    private static View bubble(Activity activity, Message message) {
+        FrameLayout wrap = new FrameLayout(activity);
+        wrap.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(3), AndroidUtilities.dp(10), AndroidUtilities.dp(3));
+        TextView view = new TextView(activity);
+        view.setText(message.text + "   " + message.time + (message.out ? " ✓✓" : ""));
+        view.setTextColor(0xFF000000);
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        view.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(8), AndroidUtilities.dp(12), AndroidUtilities.dp(8));
+        view.setMaxWidth((int) (AndroidUtilities.displaySize.x * 0.75f));
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(AndroidUtilities.dp(16));
+        background.setColor(message.out ? 0xFFEFFEDD : Color.WHITE);
+        view.setBackground(background);
+        wrap.addView(view, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, message.out ? Gravity.END : Gravity.START));
+        return wrap;
+    }
+}
