+package org.telegram.ui.voidgram;
+
+import android.content.Context;
+import android.text.Editable;
+import android.text.InputType;
+import android.text.TextWatcher;
+import android.util.TypedValue;
+import android.view.View;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.Utilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramPeerArchive;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** VoidGram → Find channels and people: @username, t.me links, ids, and the archive of opened chats. */
+public class VoidGramPeerSearchActivity extends UniversalFragment {
+    private static final int ID_OPEN_USERNAME = 1;
+    private static final int ID_OPEN_ID = 2;
+    private static final int ID_ARCHIVE = 3;
+    private static final int ID_CLEAR = 4;
+    private static final int ID_ENTRY_BASE = 1000;
+    private static final Pattern LINK = Pattern.compile("(?:https?://)?(?:t\\.me|telegram\\.me)/([A-Za-z0-9_]{4,32})", Pattern.CASE_INSENSITIVE);
+
+    private FrameLayout fieldRow;
+    private EditText field;
+    private String query = "";
+    private ArrayList<VoidGramPeerArchive.Entry> entries = new ArrayList<>();
+    private int searchGeneration;
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Поиск каналов и людей", "Find channels and people");
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        reload();
+        return super.onFragmentCreate();
+    }
+
+    private View fieldRow() {
+        if (fieldRow != null) {
+            AndroidUtilities.removeFromParent(fieldRow);
+            return fieldRow;
+        }
+        Context context = getContext();
+        fieldRow = new FrameLayout(context);
+        fieldRow.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+        field = new EditText(context);
+        field.setHint(VoidGram.t("@username, ссылка t.me, ID или имя", "@username, t.me link, ID or name"));
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        field.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        field.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText));
+        field.setSingleLine(true);
+        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        field.addTextChangedListener(new TextWatcher() {
+            @Override
+            public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+            }
+
+            @Override
+            public void onTextChanged(CharSequence s, int start, int before, int count) {
+            }
+
+            @Override
+            public void afterTextChanged(Editable s) {
+                query = s.toString().trim();
+                reload();
+            }
+        });
+        fieldRow.addView(field, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 16, 6, 16, 6));
+        return fieldRow;
+    }
+
+    private void reload() {
+        final int generation = ++searchGeneration;
+        final String q = query;
+        Utilities.globalQueue.postRunnable(() -> {
+            ArrayList<VoidGramPeerArchive.Entry> found = VoidGramPeerArchive.search(currentAccount, q, 100);
+            AndroidUtilities.runOnUIThread(() -> {
+                if (generation != searchGeneration) {
+                    return;
+                }
+                entries = found;
+                if (listView != null && listView.adapter != null) {
+                    listView.adapter.update(true);
+                }
+            });
+        });
+    }
+
+    private String username() {
+        Matcher matcher = LINK.matcher(query);
+        if (matcher.find()) {
+            return matcher.group(1);
+        }
+        String value = query.startsWith("@") ? query.substring(1) : query;
+        return value.matches("[A-Za-z][A-Za-z0-9_]{3,31}") ? value : null;
+    }
+
+    private Long numericId() {
+        try {
+            return query.matches("-?\\d{4,20}") ? Long.parseLong(query) : null;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asCustom(fieldRow()));
+        String username = username();
+        Long id = numericId();
+        if (username != null) {
+            items.add(UItem.asButton(ID_OPEN_USERNAME, VoidGram.t("Открыть @", "Open @") + username).accent());
+        }
+        if (id != null) {
+            items.add(UItem.asButton(ID_OPEN_ID, VoidGram.t("Открыть по ID ", "Open by ID ") + id).accent());
+        }
+        items.add(UItem.asShadow(VoidGram.t("Ссылки t.me и @username открываются напрямую. ID открывается, если чат уже встречался.", "t.me links and @usernames open directly. An ID opens when the chat has been seen before.")));
+        items.add(UItem.asHeader(VoidGram.t("Архив открытых чатов", "Archive of opened chats")));
+        for (int i = 0; i < entries.size(); i++) {
+            VoidGramPeerArchive.Entry entry = entries.get(i);
+            String value = entry.username != null && !entry.username.isEmpty() ? "@" + entry.username : String.valueOf(entry.dialogId);
+            items.add(UItem.asButton(ID_ENTRY_BASE + i, entry.title == null ? String.valueOf(entry.dialogId) : entry.title, value));
+        }
+        if (entries.isEmpty()) {
+            items.add(UItem.asShadow(VoidGram.t("Пока пусто: сюда попадают чаты, которые вы открываете.", "Empty for now: chats you open land here.")));
+        } else {
+            items.add(UItem.asShadow(null));
+        }
+        items.add(UItem.asCheck(ID_ARCHIVE, VoidGram.t("Вести архив", "Keep the archive")).setChecked(VoidGramPeerArchive.isEnabled()));
+        items.add(UItem.asButton(ID_CLEAR, VoidGram.t("Очистить архив", "Clear the archive")).red());
+        items.add(UItem.asShadow(VoidGram.t("Хранится только на этом устройстве. Имя удалённого аккаунта или канала остаётся по его ID.", "Stored on this device only. A deleted account's or channel's name stays under its ID.")));
+    }
+
+    private void openDialog(long dialogId, String fallbackTitle) {
+        MessagesController controller = getMessagesController();
+        boolean known = dialogId > 0 ? controller.getUser(dialogId) != null : controller.getChat(-dialogId) != null;
+        if (known) {
+            presentFragment(ChatActivity.of(dialogId));
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(fallbackTitle != null ? fallbackTitle : String.valueOf(dialogId));
+        builder.setMessage(VoidGram.t("Этот чат сейчас недоступен (удалён, скрыт или ещё не загружен). ID: ", "This chat is not available now (deleted, hidden or not loaded yet). ID: ") + dialogId);
+        builder.setPositiveButton(VoidGram.t("Скопировать ID", "Copy ID"), (dialog, which) -> {
+            AndroidUtilities.addToClipboard(String.valueOf(dialogId));
+            BulletinFactory.of(this).createCopyBulletin(VoidGram.t("ID скопирован", "ID copied")).show();
+        });
+        builder.setNegativeButton("OK", null);
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int id = item.id;
+        if (id == ID_OPEN_USERNAME) {
+            String username = username();
+            if (username != null) {
+                getMessagesController().openByUserName(username, this, 0);
+            }
+        } else if (id == ID_OPEN_ID) {
+            Long dialogId = numericId();
+            if (dialogId != null) {
+                openDialog(dialogId, null);
+            }
+        } else if (id == ID_ARCHIVE) {
+            VoidGramPeerArchive.setEnabled(!VoidGramPeerArchive.isEnabled());
+            listView.adapter.update(true);
+        } else if (id == ID_CLEAR) {
+            VoidGramPeerArchive.clear(currentAccount);
+            entries = new ArrayList<>();
+            listView.adapter.update(true);
+        } else if (id >= ID_ENTRY_BASE && id < ID_ENTRY_BASE + entries.size()) {
+            VoidGramPeerArchive.Entry entry = entries.get(id - ID_ENTRY_BASE);
+            openDialog(entry.dialogId, entry.title);
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
