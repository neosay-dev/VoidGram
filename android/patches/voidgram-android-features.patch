+    private void edit(VoidGramShortcuts.Shortcut existing) {
+        Context context = getContext();
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(4), AndroidUtilities.dp(20), 0);
+        EditText trigger = field(context, VoidGram.t(";адр", ";adr"), existing != null ? existing.trigger : "", false);
+        EditText text = field(context, VoidGram.t("Текст", "Text"), existing != null ? existing.text : "", true);
+        layout.addView(trigger);
+        layout.addView(text);
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(existing != null ? VoidGram.t("Сокращение", "Shortcut") : VoidGram.t("Новое сокращение", "New shortcut"));
+        builder.setView(layout);
+        builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (d, w) -> {
+            String t = trigger.getText().toString().trim();
+            String body = text.getText().toString();
+            if (t.isEmpty() || body.isEmpty()) {
+                return;
+            }
+            if (existing != null && !existing.trigger.equals(t)) {
+                VoidGramShortcuts.remove(existing.trigger);
+            }
+            VoidGramShortcuts.put(t, body);
+            update();
+        });
+        if (existing != null) {
+            builder.setNeutralButton(VoidGram.t("Удалить", "Delete"), (d, w) -> {
+                VoidGramShortcuts.remove(existing.trigger);
