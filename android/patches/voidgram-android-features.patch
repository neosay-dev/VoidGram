+package org.telegram.messenger.voidgram;
+
+import android.Manifest;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.media.AudioFormat;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.ParcelFileDescriptor;
+import android.speech.RecognitionListener;
+import android.speech.RecognizerIntent;
+import android.speech.SpeechRecognizer;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.RequestDelegate;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * →A without Premium, as on iOS: the voice or round message already on the device is decoded and
+ * read by the system speech recognizer (on the device when it can). Android 13+.
+ * The result goes back through Telegram's own transcription path, so the button and text look
+ * the same as a server transcription.
+ */
+public final class VoidGramTranscribe {
+    private VoidGramTranscribe() {
+    }
+
+    private static final int SAMPLE_RATE = 16000;
+    private static final Map<TLObject, MessageObject> pending = Collections.synchronizedMap(new WeakHashMap<>());
+
+    public static boolean isEnabled() {
+        return Build.VERSION.SDK_INT >= 33 && VoidGram.prefs().getBoolean("local_transcribe", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("local_transcribe", value).apply();
+    }
+
+    public static boolean isSupported() {
+        return Build.VERSION.SDK_INT >= 33 && SpeechRecognizer.isRecognitionAvailable(ApplicationLoader.applicationContext);
+    }
+
+    /** TranscribeButton: remembers which message a transcription request belongs to. */
+    public static void bind(TLObject request, MessageObject messageObject) {
+        if (isEnabled() && request != null && messageObject != null) {
+            pending.put(request, messageObject);
+        }
+    }
+
+    /** ConnectionsManager: answers a bound transcription request on the device. */
+    public static boolean intercept(TLObject object, RequestDelegate onComplete) {
+        if (!(object instanceof TLRPC.TL_messages_transcribeAudio) || onComplete == null) {
+            return false;
+        }
+        MessageObject messageObject = pending.remove(object);
+        if (messageObject == null || !isEnabled()) {
+            return false;
+        }
+        AndroidUtilities.runOnUIThread(() -> transcribe(messageObject, (text, error) -> {
+            if (error != null) {
+                Toast.makeText(ApplicationLoader.applicationContext, error, Toast.LENGTH_LONG).show();
+                TLRPC.TL_error tlError = new TLRPC.TL_error();
+                tlError.code = 400;
+                tlError.text = "VOIDGRAM_LOCAL_TRANSCRIBE";
+                onComplete.run(null, tlError);
+                return;
+            }
+            TLRPC.TL_messages_transcribedAudio result = new TLRPC.TL_messages_transcribedAudio();
+            result.pending = false;
+            result.text = text;
+            result.transcription_id = -Math.abs(Utilities.random.nextLong() >>> 1) - 1;
+            onComplete.run(result, null);
+        }));
+        return true;
+    }
+
+    public interface Result {
+        void run(String text, String error);
+    }
+
+    public static void transcribe(MessageObject messageObject, Result result) {
+        if (Build.VERSION.SDK_INT < 33) {
+            result.run(null, VoidGram.t("Распознавание на устройстве — с Android 13.", "On-device recognition needs Android 13."));
+            return;
+        }
+        if (!SpeechRecognizer.isRecognitionAvailable(ApplicationLoader.applicationContext)) {
+            result.run(null, VoidGram.t("На устройстве нет службы распознавания речи.", "There is no speech recognition service on this device."));
+            return;
+        }
+        if (ApplicationLoader.applicationContext.checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            try {
+                org.telegram.ui.ActionBar.BaseFragment fragment = org.telegram.ui.LaunchActivity.getLastFragment();
+                if (fragment != null && fragment.getParentActivity() != null) {
+                    fragment.getParentActivity().requestPermissions(new String[]{Manifest.permission.RECORD_AUDIO}, 3);
+                }
+            } catch (Throwable ignore) {
+            }
+            result.run(null, VoidGram.t("Разрешите микрофон для распознавания речи и нажмите ещё раз.", "Allow the microphone for speech recognition and tap again."));
+            return;
+        }
+        File file = FileLoader.getInstance(messageObject.currentAccount).getPathToMessage(messageObject.messageOwner);
+        if (file == null || !file.exists()) {
+            result.run(null, VoidGram.t("Сначала загрузите сообщение.", "Download the message first."));
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            byte[] pcm = decodePcm(file, SAMPLE_RATE, 20 * 60);
+            AndroidUtilities.runOnUIThread(() -> {
+                if (pcm == null || pcm.length == 0) {
+                    result.run(null, VoidGram.t("Не удалось подготовить аудио.", "The audio could not be prepared."));
+                } else {
+                    recognize(pcm, result);
+                }
+            });
+        });
+    }
+
+    /** First audio track → mono 16-bit little-endian PCM at targetRate, at most maxSeconds long. */
+    public static byte[] decodePcm(File file, int targetRate, int maxSeconds) {
+        MediaExtractor extractor = new MediaExtractor();
+        MediaCodec codec = null;
+        try {
+            extractor.setDataSource(file.getAbsolutePath());
+            int track = -1;
+            MediaFormat format = null;
+            for (int i = 0; i < extractor.getTrackCount(); i++) {
+                MediaFormat candidate = extractor.getTrackFormat(i);
+                String mime = candidate.getString(MediaFormat.KEY_MIME);
+                if (mime != null && mime.startsWith("audio/")) {
+                    track = i;
+                    format = candidate;
+                    break;
+                }
+            }
+            if (track < 0) {
+                return null;
+            }
+            extractor.selectTrack(track);
+            codec = MediaCodec.createDecoderByType(format.getString(MediaFormat.KEY_MIME));
+            codec.configure(format, null, null, 0);
+            codec.start();
+            int sampleRate = format.containsKey(MediaFormat.KEY_SAMPLE_RATE) ? format.getInteger(MediaFormat.KEY_SAMPLE_RATE) : 48000;
+            int channels = format.containsKey(MediaFormat.KEY_CHANNEL_COUNT) ? format.getInteger(MediaFormat.KEY_CHANNEL_COUNT) : 1;
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+            boolean inputDone = false;
+            boolean outputDone = false;
+            double position = 0;
+            long limit = (long) maxSeconds * targetRate * 2;
+            while (!outputDone && out.size() < limit) {
+                if (!inputDone) {
+                    int inputIndex = codec.dequeueInputBuffer(10000);
+                    if (inputIndex >= 0) {
+                        ByteBuffer input = codec.getInputBuffer(inputIndex);
+                        int size = extractor.readSampleData(input, 0);
+                        if (size < 0) {
+                            codec.queueInputBuffer(inputIndex, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                            inputDone = true;
+                        } else {
+                            codec.queueInputBuffer(inputIndex, 0, size, extractor.getSampleTime(), 0);
+                            extractor.advance();
+                        }
+                    }
+                }
+                int outputIndex = codec.dequeueOutputBuffer(info, 10000);
+                if (outputIndex == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    MediaFormat outputFormat = codec.getOutputFormat();
+                    if (outputFormat.containsKey(MediaFormat.KEY_SAMPLE_RATE)) {
+                        sampleRate = outputFormat.getInteger(MediaFormat.KEY_SAMPLE_RATE);
+                    }
+                    if (outputFormat.containsKey(MediaFormat.KEY_CHANNEL_COUNT)) {
+                        channels = outputFormat.getInteger(MediaFormat.KEY_CHANNEL_COUNT);
+                    }
+                } else if (outputIndex >= 0) {
+                    ByteBuffer output = codec.getOutputBuffer(outputIndex);
+                    if (output != null && info.size > 0) {
+                        output.position(info.offset);
+                        output.limit(info.offset + info.size);
+                        java.nio.ShortBuffer samples = output.order(ByteOrder.LITTLE_ENDIAN).asShortBuffer();
+                        int frames = samples.remaining() / Math.max(1, channels);
+                        double step = sampleRate / (double) targetRate;
+                        // Mono mix, then nearest-sample resampling to 16 kHz.
+                        while (position < frames) {
+                            int frame = (int) position;
+                            int sum = 0;
+                            for (int c = 0; c < channels; c++) {
+                                sum += samples.get(frame * channels + c);
+                            }
+                            short value = (short) (sum / Math.max(1, channels));
+                            out.write(value & 0xff);
+                            out.write((value >> 8) & 0xff);
+                            position += step;
+                        }
+                        position -= frames;
+                    }
+                    codec.releaseOutputBuffer(outputIndex, false);
+                    if ((info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
+                        outputDone = true;
+                    }
+                }
+            }
+            return out.toByteArray();
+        } catch (Throwable e) {
+            return null;
+        } finally {
+            try {
+                if (codec != null) {
+                    codec.stop();
+                    codec.release();
+                }
+            } catch (Throwable ignore) {
+            }
+            extractor.release();
+        }
+    }
+
+    private static String languageTag() {
+        try {
+            java.util.Locale locale = LocaleController.getInstance().getCurrentLocale();
+            if (locale != null) {
+                return locale.toLanguageTag();
+            }
+        } catch (Throwable ignore) {
+        }
+        return java.util.Locale.getDefault().toLanguageTag();
+    }
+
+    @androidx.annotation.RequiresApi(33)
+    private static void recognize(byte[] pcm, Result result) {
+        final SpeechRecognizer recognizer;
+        try {
+            if (Build.VERSION.SDK_INT >= 31 && SpeechRecognizer.isOnDeviceRecognitionAvailable(ApplicationLoader.applicationContext)) {
+                recognizer = SpeechRecognizer.createOnDeviceSpeechRecognizer(ApplicationLoader.applicationContext);
+            } else {
+                recognizer = SpeechRecognizer.createSpeechRecognizer(ApplicationLoader.applicationContext);
+            }
+        } catch (Throwable e) {
+            result.run(null, VoidGram.t("Служба распознавания недоступна.", "The recognition service is not available."));
+            return;
+        }
+        final ParcelFileDescriptor[] pipe;
+        try {
+            pipe = ParcelFileDescriptor.createPipe();
+        } catch (Throwable e) {
+            recognizer.destroy();
+            result.run(null, VoidGram.t("Не удалось подготовить аудио.", "The audio could not be prepared."));
+            return;
+        }
+        final StringBuilder text = new StringBuilder();
+        final boolean[] done = new boolean[1];
+        final Runnable finish = () -> {
+            if (done[0]) {
+                return;
+            }
+            done[0] = true;
+            try {
+                recognizer.destroy();
+            } catch (Throwable ignore) {
+            }
+            try {
+                pipe[0].close();
+            } catch (Throwable ignore) {
+            }
+            result.run(text.toString().trim(), null);
+        };
+        recognizer.setRecognitionListener(new RecognitionListener() {
+            @Override public void onReadyForSpeech(Bundle params) { }
+            @Override public void onBeginningOfSpeech() { }
+            @Override public void onRmsChanged(float rmsdB) { }
+            @Override public void onBufferReceived(byte[] buffer) { }
+            @Override public void onEndOfSpeech() { }
+            @Override public void onPartialResults(Bundle partialResults) { }
+            @Override public void onEvent(int eventType, Bundle params) { }
+
+            private void append(Bundle bundle) {
+                ArrayList<String> list = bundle != null ? bundle.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION) : null;
+                if (list != null && !list.isEmpty() && list.get(0) != null && !list.get(0).trim().isEmpty()) {
+                    if (text.length() > 0) {
+                        text.append(' ');
+                    }
+                    text.append(list.get(0).trim());
+                }
+            }
+
+            @Override
+            public void onSegmentResults(Bundle segmentResults) {
+                append(segmentResults);
+            }
+
+            @Override
+            public void onEndOfSegmentedSession() {
+                finish.run();
+            }
+
+            @Override
+            public void onResults(Bundle results) {
+                append(results);
+                finish.run();
+            }
+
+            @Override
+            public void onError(int error) {
+                if (done[0]) {
+                    return;
+                }
+                if (text.length() > 0 || error == SpeechRecognizer.ERROR_NO_MATCH || error == SpeechRecognizer.ERROR_SPEECH_TIMEOUT) {
+                    finish.run();
+                    return;
+                }
+                done[0] = true;
+                try {
+                    recognizer.destroy();
+                } catch (Throwable ignore) {
+                }
+                String reason = error == SpeechRecognizer.ERROR_LANGUAGE_NOT_SUPPORTED || error == SpeechRecognizer.ERROR_LANGUAGE_UNAVAILABLE
+                        ? VoidGram.t("Этот язык не поддерживается распознаванием на устройстве.", "This language is not supported by on-device recognition.")
+                        : error == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS
+                        ? VoidGram.t("Разрешите микрофон для распознавания речи.", "Allow the microphone for speech recognition.")
+                        : VoidGram.t("Не удалось распознать (код ", "Recognition failed (code ") + error + ")";
+                result.run(null, reason);
+            }
+        });
+        Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, languageTag());
+        intent.putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true);
+        intent.putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE, pipe[0]);
+        intent.putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_CHANNEL_COUNT, 1);
+        intent.putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_ENCODING, AudioFormat.ENCODING_PCM_16BIT);
+        intent.putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_SAMPLING_RATE, SAMPLE_RATE);
+        intent.putExtra(RecognizerIntent.EXTRA_SEGMENTED_SESSION, RecognizerIntent.EXTRA_AUDIO_SOURCE);
+        try {
+            recognizer.startListening(intent);
+        } catch (Throwable e) {
+            finish.run();
+            return;
+        }
+        new Thread(() -> {
+            try (FileOutputStream out = new ParcelFileDescriptor.AutoCloseOutputStream(pipe[1])) {
+                int offset = 0;
+                while (offset < pcm.length) {
+                    int count = Math.min(8192, pcm.length - offset);
+                    out.write(pcm, offset, count);
+                    offset += count;
+                }
+                // A second of silence lets the recognizer close the last segment.
+                out.write(new byte[SAMPLE_RATE * 2]);
+            } catch (Throwable ignore) {
+            }
+        }, "VoidGramTranscribe").start();
+        // Recognizers that never end a segmented session still return what they heard.
+        AndroidUtilities.runOnUIThread(finish, Math.max(30_000L, pcm.length / (SAMPLE_RATE * 2L) * 2000L + 15_000L));
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramTranslate.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramTranslate.java
new file mode 100644
index 0000000..5266ca5
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramTranslate.java
@@ -0,0 +1,161 @@
+package org.telegram.messenger.voidgram;
+
+import android.net.Uri;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.RequestDelegate;
+import org.telegram.tgnet.RequestDelegateTimestamp;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+
+/**
+ * VoidGram translation provider, as on iOS: Telegram's own translation (Premium on the server), or
+ * Google Translate / a LibreTranslate server, for every place the app translates. Formatting of
+ * translated text is plain.
+ */
+public final class VoidGramTranslate {
+    public static final String[] PROVIDERS = {"telegram", "google", "libre"};
+
+    private VoidGramTranslate() {
+    }
+
+    public static String provider() {
+        return VoidGramDecoy.isActive() ? "telegram" : VoidGram.prefs().getString("translate_provider", "telegram");
+    }
+
+    public static void setProvider(String value) {
+        VoidGram.prefs().edit().putString("translate_provider", value).apply();
+    }
+
+    public static String libreUrl() {
+        return VoidGram.prefs().getString("translate_libre_url", "https://libretranslate.com");
+    }
+
+    public static void setLibreUrl(String value) {
+        VoidGram.prefs().edit().putString("translate_libre_url", value == null ? "" : value.trim()).apply();
+    }
+
+    public static String providerTitle(String provider) {
+        switch (provider) {
+            case "google": return "Google Translate";
+            case "libre": return "LibreTranslate";
+            default: return VoidGram.t("Telegram (как обычно)", "Telegram (as usual)");
+        }
+    }
+
+    /** Answers `messages.translateText` itself when another provider is chosen; false: send as usual. */
+    public static boolean intercept(TLObject object, RequestDelegate onComplete, RequestDelegateTimestamp onCompleteTimestamp) {
+        if (!(object instanceof TLRPC.TL_messages_translateText) || "telegram".equals(provider())) {
+            return false;
+        }
+        final TLRPC.TL_messages_translateText req = (TLRPC.TL_messages_translateText) object;
+        final int account = UserConfig.selectedAccount;
+        Utilities.globalQueue.postRunnable(() -> {
+            TLRPC.TL_messages_translateResult result = new TLRPC.TL_messages_translateResult();
+            TLRPC.TL_error error = null;
+            try {
+                if (req.text != null && !req.text.isEmpty()) {
+                    for (TLRPC.TL_textWithEntities text : req.text) {
+                        result.result.add(plain(translate(text.text, req.to_lang)));
+                    }
+                } else if (req.id != null && !req.id.isEmpty() && req.peer != null) {
+                    long dialogId = DialogObject.getPeerDialogId(req.peer);
+                    for (Integer id : req.id) {
+                        TLRPC.Message message = MessagesStorage.getInstance(account).getMessage(dialogId, id);
+                        result.result.add(plain(translate(message != null && message.message != null ? message.message : "", req.to_lang)));
+                    }
+                }
+            } catch (Throwable e) {
+                error = new TLRPC.TL_error();
+                error.code = 400;
+                error.text = "TRANSLATION_FAILED";
+            }
+            final TLObject response = error == null ? result : null;
+            final TLRPC.TL_error finalError = error;
+            Utilities.stageQueue.postRunnable(() -> {
+                if (onComplete != null) {
+                    onComplete.run(response, finalError);
+                }
+                if (onCompleteTimestamp != null) {
+                    onCompleteTimestamp.run(response, finalError, System.currentTimeMillis());
+                }
+            });
+        });
+        return true;
+    }
+
+    private static TLRPC.TL_textWithEntities plain(String text) {
+        TLRPC.TL_textWithEntities result = new TLRPC.TL_textWithEntities();
+        result.text = text == null ? "" : text;
+        return result;
+    }
+
+    private static String translate(String text, String to) throws Exception {
+        if (text == null || text.trim().isEmpty()) {
+            return text;
+        }
+        String target = to == null || to.isEmpty() ? "en" : to;
+        if ("libre".equals(provider())) {
+            String base = libreUrl().endsWith("/") ? libreUrl().substring(0, libreUrl().length() - 1) : libreUrl();
+            JSONObject body = new JSONObject();
+            body.put("q", text);
+            body.put("source", "auto");
+            body.put("target", target);
+            body.put("format", "text");
+            JSONObject json = new JSONObject(request(base + "/translate", body.toString()));
+            return json.optString("translatedText", text);
+        }
+        String url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&dt=t&tl=" + Uri.encode(target) + "&q=" + Uri.encode(text);
+        JSONArray parts = new JSONArray(request(url, null)).getJSONArray(0);
+        StringBuilder builder = new StringBuilder();
+        for (int i = 0; i < parts.length(); i++) {
+            JSONArray part = parts.optJSONArray(i);
+            if (part != null && !part.isNull(0)) {
+                builder.append(part.getString(0));
+            }
+        }
+        return builder.toString();
+    }
+
+    private static String request(String url, String postJson) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
+        try {
+            connection.setConnectTimeout(10000);
+            connection.setReadTimeout(15000);
+            connection.setRequestProperty("User-Agent", "Mozilla/5.0 VoidGram");
+            if (postJson != null) {
+                connection.setRequestMethod("POST");
+                connection.setDoOutput(true);
+                connection.setRequestProperty("Content-Type", "application/json");
+                try (OutputStream out = connection.getOutputStream()) {
+                    out.write(postJson.getBytes("UTF-8"));
+                }
+            }
+            if (connection.getResponseCode() != 200) {
+                throw new Exception("HTTP " + connection.getResponseCode());
+            }
+            try (InputStream in = connection.getInputStream()) {
+                ByteArrayOutputStream output = new ByteArrayOutputStream();
+                byte[] buffer = new byte[16384];
+                int count;
+                while ((count = in.read(buffer)) > 0) {
+                    output.write(buffer, 0, count);
+                }
+                return output.toString("UTF-8");
+            }
+        } finally {
+            connection.disconnect();
+        }
+    }
+}
