+package org.telegram.ui.voidgram;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.view.View;
+import android.widget.EditText;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.R;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voidgram.VoidGramPlugins;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.util.ArrayList;
+
+/** VoidGram → Plugins: JavaScript plugins compatible with VoidGram for iOS. */
+public class VoidGramPluginsActivity extends UniversalFragment {
+    private static final int ID_INSTALL = 1;
+    private static final int ID_CONSOLE = 2;
+    private static final int ID_PLUGIN_BASE = 100;
+    private static final int REQUEST_PLUGIN = 9302;
+
+    private ArrayList<VoidGramPlugins.Plugin> plugins = new ArrayList<>();
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Плагины", "Plugins");
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        plugins = VoidGramPlugins.list();
+        items.add(UItem.asHeader(VoidGram.t("Установленные", "Installed")));
+        for (int i = 0; i < plugins.size(); i++) {
+            VoidGramPlugins.Plugin plugin = plugins.get(i);
+            String subtitle = plugin.disabledReason != null ? "⚠️" : plugin.version;
+            items.add(UItem.asCheck(ID_PLUGIN_BASE + i, plugin.name + " · " + subtitle).setChecked(plugin.enabled));
+        }
+        if (plugins.isEmpty()) {
+            items.add(UItem.asShadow(VoidGram.t("Плагинов пока нет.", "No plugins yet.")));
+        }
+        items.add(UItem.asButton(ID_INSTALL, R.drawable.msg_add, VoidGram.t("Установить из файла", "Install from a file")));
+        items.add(UItem.asButton(ID_CONSOLE, R.drawable.msg_log, VoidGram.t("Консоль плагинов", "Plugin console")));
+        items.add(UItem.asShadow(VoidGram.t("Плагины на JavaScript (.js) с тем же API ayu.*, что и в VoidGram для iOS: изменение исходящих сообщений, команды через точку, диалоги, хранилище, таймеры и сеть только к хостам из @connect. Каждый работает отдельно; зависший плагин выключается. Нажмите, чтобы включить или выключить; удерживайте — настройки и подробности. Устанавливайте только то, чему доверяете.", "JavaScript plugins (.js) with the same ayu.* API as VoidGram for iOS: change outgoing messages, dot commands, dialogs, storage, timers and network only to hosts from @connect. Each runs apart; a plugin that hangs is turned off. Tap to turn one on or off; hold for settings and details. Install only what you trust.")));
+    }
+
+    private void update() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_INSTALL) {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType("*/*");
+            startActivityForResult(intent, REQUEST_PLUGIN);
+        } else if (item.id == ID_CONSOLE) {
+            showConsole();
+        } else if (item.id >= ID_PLUGIN_BASE && item.id - ID_PLUGIN_BASE < plugins.size()) {
+            VoidGramPlugins.Plugin plugin = plugins.get(item.id - ID_PLUGIN_BASE);
+            if (!plugin.enabled) {
+                confirmEnable(plugin);
+            } else {
+                VoidGramPlugins.setEnabled(plugin.id, false);
+                update();
+            }
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        if (item.id >= ID_PLUGIN_BASE && item.id - ID_PLUGIN_BASE < plugins.size()) {
+            showDetails(plugins.get(item.id - ID_PLUGIN_BASE));
+            return true;
+        }
+        return false;
+    }
+
+    private String describe(VoidGramPlugins.Plugin plugin) {
+        StringBuilder text = new StringBuilder();
+        if (!plugin.description.isEmpty()) {
+            text.append(plugin.description).append("\n\n");
+        }
+        text.append(VoidGram.t("Версия: ", "Version: ")).append(plugin.version);
+        if (!plugin.author.isEmpty()) {
+            text.append('\n').append(VoidGram.t("Автор: ", "Author: ")).append(plugin.author);
+        }
+        text.append('\n').append("ID: ").append(plugin.id);
+        if (!plugin.permissions.isEmpty()) {
+            text.append('\n').append(VoidGram.t("Разрешения: ", "Permissions: ")).append(android.text.TextUtils.join(", ", plugin.permissions));
+        }
+        if (!plugin.connect.isEmpty()) {
+            text.append('\n').append(VoidGram.t("Сеть: ", "Network: ")).append(android.text.TextUtils.join(", ", plugin.connect));
+        }
+        if (plugin.disabledReason != null) {
+            text.append("\n\n⚠️ ").append(plugin.disabledReason);
+        }
+        return text.toString();
+    }
+
+    private void confirmEnable(VoidGramPlugins.Plugin plugin) {
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(plugin.name);
+        builder.setMessage(describe(plugin) + "\n\n" + VoidGram.t("Плагин видит текст, который ему передают хуки, и может менять ваши исходящие сообщения. Включить?", "The plugin sees the text its hooks receive and can change your outgoing messages. Turn it on?"));
+        builder.setPositiveButton(VoidGram.t("Включить", "Turn on"), (d, w) -> {
+            VoidGramPlugins.setEnabled(plugin.id, true);
+            AndroidUtilities.runOnUIThread(this::update, 300);
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    private void showDetails(VoidGramPlugins.Plugin plugin) {
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(plugin.name);
+        builder.setMessage(describe(plugin));
+        JSONArray settings = VoidGramPlugins.declaredSettings(plugin.id);
+        if (settings.length() > 0) {
+            builder.setPositiveButton(VoidGram.t("Настройки", "Settings"), (d, w) -> showSettings(plugin, settings));
+        } else {
+            builder.setPositiveButton("OK", null);
+        }
+        builder.setNeutralButton(VoidGram.t("Удалить", "Delete"), (d, w) -> {
+            VoidGramPlugins.delete(plugin.id);
+            update();
+        });
+        AlertDialog dialog = builder.create();
+        showDialog(dialog);
+        android.widget.TextView delete = (android.widget.TextView) dialog.getButton(android.content.DialogInterface.BUTTON_NEUTRAL);
+        if (delete != null) {
+            delete.setTextColor(Theme.getColor(Theme.key_text_RedBold));
+        }
+    }
+
+    private void showSettings(VoidGramPlugins.Plugin plugin, JSONArray settings) {
+        int count = settings.length();
+        CharSequence[] titles = new CharSequence[count];
+        for (int i = 0; i < count; i++) {
+            JSONObject item = settings.optJSONObject(i);
+            if (item == null) {
+                titles[i] = "?";
+                continue;
+            }
+            Object value = VoidGramPlugins.settingValue(plugin.id, item.optString("key"));
+            String shown = value == null ? "" : value instanceof Boolean ? ((Boolean) value ? VoidGram.t("вкл.", "on") : VoidGram.t("выкл.", "off")) : String.valueOf(value);
+            titles[i] = item.optString("title", item.optString("key")) + (shown.isEmpty() ? "" : ": " + shown);
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(plugin.name);
+        builder.setItems(titles, (d, which) -> editSetting(plugin, settings, settings.optJSONObject(which)));
+        builder.setNegativeButton(VoidGram.t("Закрыть", "Close"), null);
+        showDialog(builder.create());
+    }
+
+    private void editSetting(VoidGramPlugins.Plugin plugin, JSONArray settings, JSONObject item) {
+        if (item == null) {
+            return;
+        }
+        String key = item.optString("key");
+        String type = item.optString("type", "text");
+        Object value = VoidGramPlugins.settingValue(plugin.id, key);
+        if ("toggle".equals(type) || "switch".equals(type) || "bool".equals(type)) {
+            VoidGramPlugins.setSetting(plugin.id, key, !(value instanceof Boolean && (Boolean) value));
+            showSettings(plugin, settings);
+            return;
+        }
+        JSONArray options = item.optJSONArray("options");
+        if (options != null && options.length() > 0) {
+            CharSequence[] titles = new CharSequence[options.length()];
+            for (int i = 0; i < titles.length; i++) {
+                Object option = options.opt(i);
+                titles[i] = option instanceof JSONObject ? ((JSONObject) option).optString("title", ((JSONObject) option).optString("value")) : String.valueOf(option);
+            }
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+            builder.setTitle(item.optString("title", key));
+            builder.setItems(titles, (d, which) -> {
+                Object option = options.opt(which);
+                VoidGramPlugins.setSetting(plugin.id, key, option instanceof JSONObject ? ((JSONObject) option).opt("value") : option);
+                showSettings(plugin, settings);
+            });
+            showDialog(builder.create());
+            return;
+        }
+        EditText field = new EditText(getContext());
+        field.setText(value == null ? "" : String.valueOf(value));
+        field.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(item.optString("title", key));
+        builder.setView(field);
+        builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (d, w) -> {
+            String text = field.getText().toString();
+            Object stored = text;
+            if ("number".equals(type)) {
+                try {
+                    stored = Double.parseDouble(text);
+                } catch (NumberFormatException ignore) {
+                }
+            }
+            VoidGramPlugins.setSetting(plugin.id, key, stored);
+            showSettings(plugin, settings);
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    private void showConsole() {
+        String text = VoidGramPlugins.consoleText();
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(VoidGram.t("Консоль плагинов", "Plugin console"));
+        builder.setMessage(text.isEmpty() ? VoidGram.t("Пусто", "Empty") : text);
+        builder.setPositiveButton("OK", null);
+        builder.setNeutralButton(VoidGram.t("Очистить", "Clear"), (d, w) -> VoidGramPlugins.clearConsole());
+        builder.setNegativeButton(VoidGram.t("Копировать", "Copy"), (d, w) -> AndroidUtilities.addToClipboard(text));
+        showDialog(builder.create());
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != REQUEST_PLUGIN || resultCode != Activity.RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        Uri uri = data.getData();
+        String name = "plugin.js";
+        try (android.database.Cursor cursor = getParentActivity().getContentResolver().query(uri, new String[]{android.provider.OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                name = cursor.getString(0);
+            }
+        } catch (Throwable ignore) {
+        }
+        String source;
+        try (InputStream in = getParentActivity().getContentResolver().openInputStream(uri)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int count;
+            while (in != null && (count = in.read(buffer)) > 0) {
+                out.write(buffer, 0, count);
+                if (out.size() > 512 * 1024) {
+                    break;
+                }
+            }
+            source = out.toString("UTF-8");
+        } catch (Throwable e) {
+            BulletinFactory.of(this).createErrorBulletin(VoidGram.t("Не удалось прочитать файл", "The file could not be read")).show();
+            return;
+        }
+        String error = VoidGramPlugins.install(source, name);
+        if (error != null) {
+            BulletinFactory.of(this).createErrorBulletin(error).show();
+        } else {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.done, VoidGram.t("Плагин установлен. Включите его в списке.", "Plugin installed. Turn it on in the list.")).show();
+        }
+        update();
+    }
+}
