+        artist.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        artist.setSingleLine(true);
+        titles.addView(title);
+        titles.addView(artist);
+        header.addView(titles, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        TextView edit = button(activity, VoidGram.t("Изменить", "Edit"));
+        header.addView(edit, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(32)));
+        TextView close = button(activity, "✕");
+        LinearLayout.LayoutParams closeParams = new LinearLayout.LayoutParams(AndroidUtilities.dp(32), AndroidUtilities.dp(32));
+        closeParams.leftMargin = AndroidUtilities.dp(8);
+        header.addView(close, closeParams);
+        root.addView(header);
+
+        final ScrollView scroll = new ScrollView(activity);
+        scroll.setVerticalScrollBarEnabled(false);
+        final LinearLayout list = new LinearLayout(activity);
+        list.setOrientation(LinearLayout.VERTICAL);
+        list.setPadding(0, AndroidUtilities.dp(120), 0, AndroidUtilities.dp(240));
+        scroll.addView(list);
+        LinearLayout.LayoutParams scrollParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f);
+        scrollParams.topMargin = AndroidUtilities.dp(12);
+        root.addView(scroll, scrollParams);
+
+        final ArrayList<TextView> lineViews = new ArrayList<>();
+        final VoidGramLyrics.Lyrics[] shown = new VoidGramLyrics.Lyrics[1];
+        final int[] current = {-2};
+        final long[] userScrollUntil = {0};
+        scroll.setOnTouchListener((v, event) -> {
