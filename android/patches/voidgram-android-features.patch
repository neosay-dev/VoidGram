+package org.telegram.messenger.voidgram;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+import android.text.TextUtils;
+
+import androidx.collection.LongSparseArray;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.tgnet.NativeByteBuffer;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+
+/**
+ * VoidGram message history, as on iOS: messages other people delete stay in the chat with a 🗑
+ * mark, and the earlier texts of edited messages are kept and can be looked at ("Edit history").
+ * Everything stays on this device, per account.
+ */
+public final class VoidGramHistory {
+    private static final class Db extends SQLiteOpenHelper {
+        Db(Context context, int account) {
+            super(context, "voidgram_history_" + account + ".db", null, 1);
+        }
+
+        @Override
+        public void onCreate(SQLiteDatabase db) {
+            db.execSQL("CREATE TABLE deleted (dialog INTEGER, mid INTEGER, date INTEGER, PRIMARY KEY (dialog, mid))");
+            db.execSQL("CREATE TABLE edits (dialog INTEGER, mid INTEGER, date INTEGER, text TEXT)");
+            db.execSQL("CREATE INDEX edits_message ON edits (dialog, mid)");
+        }
+
+        @Override
+        public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+        }
+    }
+
+    private static final Db[] databases = new Db[UserConfig.MAX_ACCOUNT_COUNT];
+    @SuppressWarnings("unchecked")
+    private static final HashSet<Long>[] deletedKeys = new HashSet[UserConfig.MAX_ACCOUNT_COUNT];
+    @SuppressWarnings("unchecked")
+    private static final HashSet<Long>[] editedKeys = new HashSet[UserConfig.MAX_ACCOUNT_COUNT];
+
+    private VoidGramHistory() {
+    }
+
+    // MARK: settings
+
+    public static boolean saveDeleted() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("history_deleted", true);
+    }
+
+    public static void setSaveDeleted(boolean value) {
+        VoidGram.prefs().edit().putBoolean("history_deleted", value).apply();
+    }
+
+    public static boolean saveEdits() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("history_edits", true);
+    }
+
+    public static void setSaveEdits(boolean value) {
+        VoidGram.prefs().edit().putBoolean("history_edits", value).apply();
+    }
+
+    public static String deletedMark() {
+        String mark = VoidGram.prefs().getString("history_deleted_mark", "");
+        return TextUtils.isEmpty(mark) ? "🗑" : mark;
+    }
+
+    public static void setDeletedMark(String value) {
+        VoidGram.prefs().edit().putString("history_deleted_mark", value == null ? "" : value.trim()).apply();
+    }
+
+    // MARK: storage
+
+    private static synchronized Db db(int account) {
+        if (databases[account] == null) {
+            databases[account] = new Db(ApplicationLoader.applicationContext, account);
+        }
+        return databases[account];
+    }
+
+    private static boolean isChannelMessage(MessageObject messageObject) {
+        return messageObject.messageOwner != null && messageObject.messageOwner.peer_id != null && messageObject.messageOwner.peer_id.channel_id != 0;
+    }
+
+    private static long key(long scope, int mid) {
+        return scope * 31 + mid;
+    }
+
+    private static synchronized HashSet<Long> loadKeys(int account, boolean deleted) {
+        HashSet<Long>[] cache = deleted ? deletedKeys : editedKeys;
+        if (cache[account] != null) {
+            return cache[account];
+        }
+        HashSet<Long> keys = new HashSet<>();
+        Cursor cursor = null;
+        try {
+            cursor = db(account).getReadableDatabase().rawQuery(deleted ? "SELECT dialog, mid FROM deleted" : "SELECT DISTINCT dialog, mid FROM edits", null);
+            while (cursor.moveToNext()) {
+                keys.add(key(cursor.getLong(0), cursor.getInt(1)));
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+        }
+        cache[account] = keys;
+        return keys;
+    }
+
+    public static boolean isDeleted(MessageObject messageObject) {
+        if (messageObject == null || messageObject.getId() <= 0 || VoidGramDecoy.isActive()) {
+            return false;
+        }
+        HashSet<Long> keys = loadKeys(messageObject.currentAccount, true);
+        if (keys.isEmpty()) {
+            return false;
+        }
+        long dialogId = messageObject.getDialogId();
+        return keys.contains(key(DialogObject.isChatDialog(dialogId) && isChannelMessage(messageObject) ? dialogId : 0, messageObject.getId()));
+    }
+
+    public static boolean hasEdits(int account, MessageObject messageObject) {
+        if (messageObject == null || messageObject.getId() <= 0) {
+            return false;
+        }
+        HashSet<Long> keys = loadKeys(account, false);
+        long dialogId = messageObject.getDialogId();
+        return !keys.isEmpty() && keys.contains(key(DialogObject.isChatDialog(dialogId) && isChannelMessage(messageObject) ? dialogId : 0, messageObject.getId()));
+    }
+
+    /**
+     * Called with the deletions an update batch carries (key 0: private chats and groups, otherwise
+     * a channel's dialog id). When deleted messages are kept, they are recorded and taken out of the
+     * batch, so neither the database nor open chats drop them.
+     */
+    public static void interceptDeleted(int account, LongSparseArray<ArrayList<Integer>> deletedMessages) {
+        if (deletedMessages == null || deletedMessages.size() == 0 || !saveDeleted()) {
+            return;
+        }
+        final int now = (int) (System.currentTimeMillis() / 1000);
+        final ArrayList<long[]> rows = new ArrayList<>();
+        HashSet<Long> keys = loadKeys(account, true);
+        for (int i = deletedMessages.size() - 1; i >= 0; i--) {
+            long dialogId = deletedMessages.keyAt(i);
+            ArrayList<Integer> ids = deletedMessages.valueAt(i);
+            if (ids != null) {
+                for (Integer id : ids) {
+                    if (id != null && id > 0) {
+                        rows.add(new long[]{dialogId, id});
+                        synchronized (VoidGramHistory.class) {
+                            keys.add(key(dialogId, id));
+                        }
+                    }
+                }
+            }
+            deletedMessages.removeAt(i);
+        }
+        if (rows.isEmpty()) {
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                SQLiteDatabase database = db(account).getWritableDatabase();
+                database.beginTransaction();
+                try {
+                    for (long[] row : rows) {
+                        ContentValues values = new ContentValues();
+                        values.put("dialog", row[0]);
+                        values.put("mid", (int) row[1]);
+                        values.put("date", now);
+                        database.insertWithOnConflict("deleted", null, values, SQLiteDatabase.CONFLICT_IGNORE);
+                    }
+                    database.setTransactionSuccessful();
+                } finally {
+                    database.endTransaction();
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        });
+        // Open chats redraw their messages so the 🗑 mark shows at once.
+        AndroidUtilities.runOnUIThread(VoidGramHistory::notifyChanged);
+    }
+
+    /**
+     * Called before edited messages are written to the database: the text they had so far is read
+     * on the storage queue (ahead of the write) and kept when it changed.
+     */
+    public static void captureEdits(int account, long dialogId, ArrayList<MessageObject> edited) {
+        if (!saveEdits() || edited == null || edited.isEmpty()) {
+            return;
+        }
+        final ArrayList<TLRPC.Message> messages = new ArrayList<>();
+        for (MessageObject object : edited) {
+            if (object != null && object.messageOwner != null && object.getId() > 0) {
+                messages.add(object.messageOwner);
+            }
+        }
+        if (messages.isEmpty()) {
+            return;
+        }
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        storage.getStorageQueue().postRunnable(() -> {
+            for (TLRPC.Message message : messages) {
+                String oldText = null;
+                SQLiteCursor cursor = null;
+                try {
+                    cursor = storage.getDatabase().queryFinalized("SELECT data FROM messages_v2 WHERE uid = " + dialogId + " AND mid = " + message.id + " LIMIT 1");
+                    if (cursor.next()) {
+                        NativeByteBuffer data = cursor.byteBufferValue(0);
+                        if (data != null) {
+                            TLRPC.Message old = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                            data.reuse();
+                            if (old != null) {
+                                oldText = old.message;
+                            }
+                        }
+                    }
+                } catch (Throwable e) {
+                    FileLog.e(e);
+                } finally {
+                    if (cursor != null) {
+                        cursor.dispose();
+                    }
+                }
+                if (oldText == null || TextUtils.equals(oldText, message.message)) {
+                    continue;
+                }
+                final String previous = oldText;
+                final long scope = message.peer_id != null && message.peer_id.channel_id != 0 ? -message.peer_id.channel_id : 0;
+                final int date = message.edit_date != 0 ? message.edit_date : (int) (System.currentTimeMillis() / 1000);
+                Utilities.globalQueue.postRunnable(() -> {
+                    try {
+                        ContentValues values = new ContentValues();
+                        values.put("dialog", scope);
+                        values.put("mid", message.id);
+                        values.put("date", date);
+                        values.put("text", previous);
+                        db(account).getWritableDatabase().insert("edits", null, values);
+                        synchronized (VoidGramHistory.class) {
+                            loadKeys(account, false).add(key(scope, message.id));
+                        }
+                    } catch (Throwable e) {
+                        FileLog.e(e);
+                    }
+                });
+            }
+        });
+    }
+
+    /** One row of the history feed: a deleted message, or an earlier text of an edited one. */
+    public static final class FeedEntry {
+        public long scope;
+        public int mid;
+        public int date;
+        public boolean deleted;
+        public String previousText;
+        public long dialogId;
+        public String text;
+    }
+
+    /**
+     * The newest deleted and edited messages across chats, with the chat and text found in
+     * Telegram's own database. Runs on the storage queue; done gets the list on the UI thread.
+     */
+    public static void loadFeed(int account, int limit, org.telegram.messenger.Utilities.Callback<ArrayList<FeedEntry>> done) {
+        Utilities.globalQueue.postRunnable(() -> {
+            final ArrayList<FeedEntry> entries = new ArrayList<>();
+            try {
+                SQLiteDatabase database = db(account).getReadableDatabase();
+                for (int table = 0; table < 2; table++) {
+                    android.database.Cursor cursor = table == 0
+                            ? database.rawQuery("SELECT dialog, mid, date, NULL FROM deleted ORDER BY date DESC LIMIT " + limit, null)
+                            : database.rawQuery("SELECT dialog, mid, date, text FROM edits ORDER BY date DESC LIMIT " + limit, null);
+                    try {
+                        while (cursor.moveToNext()) {
+                            FeedEntry entry = new FeedEntry();
+                            entry.scope = cursor.getLong(0);
+                            entry.mid = cursor.getInt(1);
+                            entry.date = cursor.getInt(2);
+                            entry.deleted = table == 0;
+                            entry.previousText = cursor.isNull(3) ? null : cursor.getString(3);
+                            entries.add(entry);
+                        }
+                    } finally {
+                        cursor.close();
+                    }
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            java.util.Collections.sort(entries, (a, b) -> Integer.compare(b.date, a.date));
+            while (entries.size() > limit) {
+                entries.remove(entries.size() - 1);
+            }
+            final MessagesStorage storage = MessagesStorage.getInstance(account);
+            storage.getStorageQueue().postRunnable(() -> {
+                for (FeedEntry entry : entries) {
+                    SQLiteCursor cursor = null;
+                    try {
+                        String where = entry.scope != 0 ? "uid = " + entry.scope + " AND mid = " + entry.mid : "mid = " + entry.mid;
+                        cursor = storage.getDatabase().queryFinalized("SELECT uid, data FROM messages_v2 WHERE " + where + " LIMIT 8");
+                        while (cursor.next()) {
+                            long uid = cursor.longValue(0);
+                            // Private chats and basic groups share one message counter; channels have their own.
+                            if (entry.scope == 0 && uid < 0 && org.telegram.messenger.ChatObject.isChannel(org.telegram.messenger.MessagesController.getInstance(account).getChat(-uid))) {
+                                continue;
+                            }
+                            entry.dialogId = uid;
+                            NativeByteBuffer data = cursor.byteBufferValue(1);
+                            if (data != null) {
+                                TLRPC.Message message = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                                data.reuse();
+                                if (message != null) {
+                                    entry.text = message.message;
+                                }
+                            }
+                            break;
+                        }
+                    } catch (Throwable e) {
+                        FileLog.e(e);
+                    } finally {
+                        if (cursor != null) {
+                            cursor.dispose();
+                        }
+                    }
+                }
+                AndroidUtilities.runOnUIThread(() -> done.run(entries));
+            });
+        });
+    }
+
+    /** The "Edit history" sheet: every earlier text, oldest first, then the current one. */
+    public static void showEdits(BaseFragment fragment, MessageObject messageObject) {
+        if (fragment == null || fragment.getParentActivity() == null || messageObject == null) {
+            return;
+        }
+        final int account = messageObject.currentAccount;
+        final long dialogId = messageObject.getDialogId();
+        final long scope = DialogObject.isChatDialog(dialogId) && isChannelMessage(messageObject) ? dialogId : 0;
+        final int mid = messageObject.getId();
+        Utilities.globalQueue.postRunnable(() -> {
+            StringBuilder builder = new StringBuilder();
+            Cursor cursor = null;
+            try {
+                cursor = db(account).getReadableDatabase().rawQuery("SELECT date, text FROM edits WHERE dialog = ? AND mid = ? ORDER BY date ASC", new String[]{String.valueOf(scope), String.valueOf(mid)});
+                while (cursor.moveToNext()) {
+                    builder.append(LocaleController.getInstance().getFormatterStats().format(new Date(cursor.getLong(0) * 1000L))).append('\n');
+                    builder.append(cursor.getString(1)).append("\n\n");
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            } finally {
+                if (cursor != null) {
+                    cursor.close();
+                }
+            }
+            builder.append(VoidGram.t("Сейчас:", "Now:")).append('\n').append(messageObject.messageOwner != null ? messageObject.messageOwner.message : "");
+            final String text = builder.toString();
+            AndroidUtilities.runOnUIThread(() -> {
+                if (fragment.getParentActivity() == null) {
+                    return;
+                }
+                AlertDialog.Builder dialog = new AlertDialog.Builder(fragment.getParentActivity());
+                dialog.setTitle(VoidGram.t("История изменений", "Edit history"));
+                dialog.setMessage(text);
+                dialog.setPositiveButton("OK", null);
+                fragment.showDialog(dialog.create());
+            });
+        });
+    }
+
+    private static final ArrayList<Runnable> listeners = new ArrayList<>();
+
+    public static void addListener(Runnable listener) {
+        if (!listeners.contains(listener)) {
+            listeners.add(listener);
+        }
+    }
+
+    public static void removeListener(Runnable listener) {
+        listeners.remove(listener);
+    }
+
+    private static void notifyChanged() {
+        for (Runnable listener : new ArrayList<>(listeners)) {
+            listener.run();
+        }
+    }
+
+    /** Clears everything kept for an account. */
+    public static void clear(int account) {
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                SQLiteDatabase database = db(account).getWritableDatabase();
+                database.delete("deleted", null, null);
+                database.delete("edits", null, null);
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            synchronized (VoidGramHistory.class) {
+                deletedKeys[account] = null;
+                editedKeys[account] = null;
+            }
+        });
+    }
+}
