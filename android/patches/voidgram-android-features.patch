+        } else if (id == ID_EDITS) {
+            VoidGramHistory.setSaveEdits(!VoidGramHistory.saveEdits());
+        } else if (id == ID_MARK) {
+            final String[] marks = {"🗑", "❌", "🚫", "👻", VoidGram.t("удалено", "deleted")};
+            AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
