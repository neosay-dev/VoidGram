+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramMusicHaptics.java
@@ -0,0 +1,202 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.os.Build;
+import android.os.VibrationEffect;
+import android.os.Vibrator;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.Utilities;
+
+import java.io.File;
+import java.util.ArrayList;
+
+/**
+ * Music haptics, as on iOS: the cached track is decoded apart from playback (the microphone is
+ * never used), energy attacks become beats, and the phone vibrates on them in time with the
+ * player's clock. Missed beats after pauses, seeks and stalls are dropped.
+ */
+public final class VoidGramMusicHaptics {
+    private VoidGramMusicHaptics() {
+    }
+
+    public static final String[] MODES = {"off", "light", "normal", "strong"};
+
+    private static final int RATE = 8000;
+    private static float[] beatTimes;
+    private static float[] beatIntensity;
+    private static int cursor;
+    private static double lastTime = -1;
+    private static String currentKey;
+    private static int generation;
+
+    public static String mode() {
+        return VoidGram.prefs().getString("music_haptics", "off");
+    }
+
+    public static void setMode(String value) {
+        VoidGram.prefs().edit().putString("music_haptics", value).apply();
+        if ("off".equals(value)) {
+            reset();
+        }
+    }
+
+    public static String title(String mode) {
+        switch (mode) {
+            case "light": return VoidGram.t("Еле-еле", "Barely");
+            case "normal": return VoidGram.t("Нормально", "Normal");
+            case "strong": return VoidGram.t("Со всей дури", "Full blast");
+            default: return VoidGram.t("Выключено", "Off");
+        }
+    }
+
+    private static void reset() {
+        beatTimes = null;
+        beatIntensity = null;
+        currentKey = null;
+        cursor = 0;
+        lastTime = -1;
+        generation++;
+    }
+
+    /** MediaController: a music track started. */
+    public static void trackChanged(MessageObject message) {
+        if ("off".equals(mode()) || message == null || !message.isMusic()) {
+            reset();
+            return;
+        }
+        File file = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+        String key = file != null ? file.getAbsolutePath() : null;
+        if (key != null && key.equals(currentKey)) {
+            return;
+        }
+        reset();
+        currentKey = key;
+        if (file == null || !file.exists()) {
+            return;
+        }
+        final int token = generation;
+        Utilities.globalQueue.postRunnable(() -> {
+            byte[] pcm = VoidGramTranscribe.decodePcm(file, RATE, 1200);
+            if (pcm == null) {
+                return;
+            }
+            int window = (int) (RATE * 0.023);
+            int frames = pcm.length / 2;
+            float[] energies = new float[frames / window];
+            for (int w = 0; w < energies.length; w++) {
+                double sum = 0;
+                for (int i = w * window; i < (w + 1) * window; i++) {
+                    short value = (short) ((pcm[i * 2] & 0xff) | (pcm[i * 2 + 1] << 8));
+                    double v = value / 32768.0;
+                    sum += v * v;
+                }
+                energies[w] = (float) Math.sqrt(sum / window);
+            }
+            double step = window / (double) RATE;
+            ArrayList<float[]> beats = new ArrayList<>();
+            double last = -1;
+            for (int i = 1; i < energies.length - 1; i++) {
+                float energy = energies[i];
+                if (energy <= 0.012f || energy <= energies[i - 1] || energy < energies[i + 1]) {
+                    continue;
+                }
+                int start = Math.max(0, i - 16);
+                int end = Math.min(energies.length, i + 17);
+                float mean = 0;
+                for (int j = start; j < end; j++) {
+                    mean += Math.max(0f, energies[j]);
+                }
+                mean /= (end - start);
+                double time = i * step;
+                if (energy <= mean * 1.45f + 0.008f || time - last < 0.16) {
+                    continue;
+                }
+                beats.add(new float[]{(float) time, Math.min(1f, Math.max(0.25f, (energy - mean) / energy))});
+                last = time;
+            }
+            float[] times = new float[beats.size()];
+            float[] intensity = new float[beats.size()];
+            for (int i = 0; i < beats.size(); i++) {
+                times[i] = beats.get(i)[0];
+                intensity[i] = beats.get(i)[1];
+            }
+            org.telegram.messenger.AndroidUtilities.runOnUIThread(() -> {
+                if (token == generation) {
+                    beatTimes = times;
+                    beatIntensity = intensity;
+                    cursor = 0;
+                    lastTime = -1;
+                }
+            });
+        });
+    }
+
+    private static void seek(double time) {
+        int low = 0;
+        int high = beatTimes.length;
+        while (low < high) {
+            int middle = (low + high) / 2;
+            if (beatTimes[middle] <= time) {
+                low = middle + 1;
+            } else {
+                high = middle;
+            }
+        }
+        cursor = low;
+    }
+
+    /** MediaController progress timer (UI thread). */
+    public static void progress(double time, boolean playing) {
+        float[] times = beatTimes;
+        if (times == null || times.length == 0) {
+            return;
+        }
+        if (!playing || lastTime < 0 || time < lastTime || time - lastTime > 0.35) {
+            seek(time);
+            lastTime = playing ? time : -1;
+            return;
+        }
+        lastTime = time;
+        float strength = -1;
+        while (cursor < times.length && times[cursor] <= time) {
+            if (time - times[cursor] <= 0.08) {
+                strength = Math.max(strength, beatIntensity[cursor]);
+            }
+            cursor++;
+        }
+        if (strength > 0) {
+            vibrate(strength);
+        }
+    }
+
+    private static void vibrate(float strength) {
+        try {
+            Vibrator vibrator = (Vibrator) ApplicationLoader.applicationContext.getSystemService(Context.VIBRATOR_SERVICE);
+            if (vibrator == null || !vibrator.hasVibrator()) {
+                return;
+            }
+            String mode = mode();
+            float amplitude;
+            long duration;
+            if ("strong".equals(mode)) {
+                amplitude = Math.min(1f, 0.7f + strength * 0.3f);
+                duration = 40;
+            } else if ("light".equals(mode)) {
+                amplitude = Math.max(0.05f, strength * 0.22f);
+                duration = 15;
+            } else {
+                amplitude = strength * 0.75f;
+                duration = 25;
+            }
+            if (Build.VERSION.SDK_INT >= 26) {
+                vibrator.vibrate(VibrationEffect.createOneShot(duration, Math.max(1, Math.min(255, (int) (amplitude * 255)))));
+            } else {
+                vibrator.vibrate(duration);
+            }
+        } catch (Throwable ignore) {
+        }
+    }
+}
