+package org.telegram.ui.voidgram;
+
+import android.graphics.Color;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.messenger.voip.VoIPService;
+import org.telegram.ui.Components.LayoutHelper;
+
+/**
+ * In-call statistics, as on iOS: while a call runs, the engine's debug line (bitrate, latency,
+ * loss) is shown at the top of the screen and refreshed every two seconds.
+ */
+public final class VoidGramCallStats {
+    private VoidGramCallStats() {
+    }
+
+    public static boolean isEnabled() {
+        return VoidGram.prefs().getBoolean("call_stats", false);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("call_stats", value).apply();
+    }
+
+    /** VoIPFragment.createView: adds the line to the call screen when turned on. */
+    public static void attach(ViewGroup root) {
+        if (root == null || !isEnabled()) {
+            return;
+        }
+        TextView label = new TextView(root.getContext());
+        label.setTextColor(Color.WHITE);
+        label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10);
+        label.setTypeface(android.graphics.Typeface.MONOSPACE);
+        label.setBackgroundColor(0x88000000);
+        label.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(4), AndroidUtilities.dp(8), AndroidUtilities.dp(4));
+        label.setClickable(false);
+        label.setFocusable(false);
+        root.addView(label, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP, 0, 0, 0, 0));
+        label.setPadding(AndroidUtilities.dp(8), AndroidUtilities.statusBarHeight + AndroidUtilities.dp(4), AndroidUtilities.dp(8), AndroidUtilities.dp(4));
+        Runnable[] tick = new Runnable[1];
+        tick[0] = () -> {
+            if (label.getParent() == null) {
+                return;
+            }
+            VoIPService service = VoIPService.getSharedInstance();
+            String text = null;
+            try {
+                text = service != null ? service.getDebugString() : null;
+            } catch (Throwable ignore) {
+            }
+            label.setText(text == null || text.isEmpty() ? VoidGram.t("Статистика звонка появится после соединения", "Call statistics appear once connected") : text.trim());
+            if (service != null) {
+                AndroidUtilities.runOnUIThread(tick[0], 2000);
+            }
+        };
+        tick[0].run();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramChatExportSheet.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramChatExportSheet.java
