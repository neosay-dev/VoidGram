+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.text.TextUtils;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.Utilities;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Lyrics for the music player, as on iOS: the user's own text for a song (typed or corrected, LRC
+ * time stamps keep it in sync) wins; otherwise LRCLIB is asked (only title, artist and length are
+ * sent). The current line also feeds the mini player.
+ */
+public final class VoidGramLyrics {
+    public static final class Line {
+        public final double time;
+        public final String text;
+        /** Enhanced LRC: where each timed word starts in `text`, and when; null without word times. */
+        public int[] wordStarts;
+        public double[] wordTimes;
+
+        Line(double time, String text) {
+            this.time = time;
+            this.text = text;
+        }
+    }
+
+    private static final Pattern WORD_TIME = Pattern.compile("<(\\d{1,3}):(\\d{1,2})(?:[.:](\\d{1,3}))?>");
+
+    /** A line's text without word tags, with the word times kept. */
+    private static Line wordLine(double time, String raw) {
+        Matcher matcher = WORD_TIME.matcher(raw);
+        StringBuilder text = new StringBuilder();
+        ArrayList<Integer> starts = new ArrayList<>();
+        ArrayList<Double> times = new ArrayList<>();
+        int cursor = 0;
+        while (matcher.find()) {
+            text.append(raw, cursor, matcher.start());
+            double value = Integer.parseInt(matcher.group(1)) * 60 + Integer.parseInt(matcher.group(2));
+            if (matcher.group(3) != null) {
+                value += Integer.parseInt(matcher.group(3)) / Math.pow(10, matcher.group(3).length());
+            }
+            starts.add(text.length());
+            times.add(value);
+            cursor = matcher.end();
+        }
+        text.append(raw.substring(cursor));
+        Line line = new Line(time, text.toString().trim());
+        if (!starts.isEmpty()) {
+            int shift = text.length() - text.toString().replaceAll("^\\s+", "").length();
+            line.wordStarts = new int[starts.size()];
+            line.wordTimes = new double[times.size()];
+            for (int i = 0; i < starts.size(); i++) {
+                line.wordStarts[i] = Math.max(0, Math.min(line.text.length(), starts.get(i) - shift));
+                line.wordTimes[i] = times.get(i);
+            }
+        }
+        return line;
+    }
+
+    /**
+     * How many characters of `line` are sung at `position`: from the word times when the lyrics
+     * have them, otherwise spread over the line by word length until the next line starts.
+     */
+    public static int sungLength(Lyrics lyrics, int index, double position) {
+        if (lyrics == null || !lyrics.isSynced() || index < 0 || index >= lyrics.lines.size()) {
+            return 0;
+        }
+        Line line = lyrics.lines.get(index);
+        if (line.text.isEmpty() || position < line.time) {
+            return 0;
+        }
+        if (line.wordTimes != null) {
+            int sung = 0;
+            for (int i = 0; i < line.wordTimes.length; i++) {
+                if (line.wordTimes[i] <= position) {
+                    sung = i + 1 < line.wordStarts.length ? line.wordStarts[i + 1] : line.text.length();
+                }
+            }
+            return Math.min(line.text.length(), sung);
+        }
+        double end = index + 1 < lyrics.lines.size() ? lyrics.lines.get(index + 1).time : line.time + Math.max(2.0, line.text.length() * 0.12);
+        double duration = Math.max(0.5, Math.min(end - line.time, line.text.length() * 0.35 + 1.0));
+        double progress = Math.max(0, Math.min(1, (position - line.time) / duration));
+        int sung = (int) Math.round(progress * line.text.length());
+        // Whole words only.
+        while (sung > 0 && sung < line.text.length() && !Character.isWhitespace(line.text.charAt(sung))) {
+            sung++;
+        }
+        return Math.min(line.text.length(), sung);
+    }
+
+    public static final class Lyrics {
+        public final ArrayList<Line> lines;
+        public final String plain;
+        public final boolean custom;
+
+        Lyrics(ArrayList<Line> lines, String plain, boolean custom) {
+            this.lines = lines;
+            this.plain = plain;
+            this.custom = custom;
+        }
+
+        public boolean isSynced() {
+            return lines != null && !lines.isEmpty();
+        }
+
+        public boolean isEmpty() {
+            return !isSynced() && TextUtils.isEmpty(plain);
+        }
+    }
+
+    private static final Lyrics NOT_FOUND = new Lyrics(null, null, false);
+    private static final HashMap<String, Lyrics> cache = new HashMap<>();
+    private static final HashSet<String> loading = new HashSet<>();
+    private static final ArrayList<Runnable> listeners = new ArrayList<>();
+    private static final Pattern TIME = Pattern.compile("\\[(\\d{1,3}):(\\d{1,2})(?:[.:,](\\d{1,3}))?]");
+
+    private VoidGramLyrics() {
+    }
+
+    private static SharedPreferences store() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("voidgram_lyrics", Context.MODE_PRIVATE);
+    }
+
+    public static String title(MessageObject messageObject) {
+        if (messageObject == null) {
+            return "";
+        }
+        // Tags of the file fill in a missing title (VoidGramTrackTags).
+        String value = VoidGramTrackTags.resolve(messageObject, messageObject.getMusicTitle(), messageObject.getMusicAuthor())[0];
+        return value != null ? value.trim() : "";
+    }
+
+    public static String artist(MessageObject messageObject) {
+        if (messageObject == null) {
+            return "";
+        }
+        String value = VoidGramTrackTags.resolve(messageObject, messageObject.getMusicTitle(), messageObject.getMusicAuthor())[1];
+        return value != null ? value.trim() : "";
+    }
+
+    public static String key(MessageObject messageObject) {
+        return (title(messageObject) + "\u0000" + artist(messageObject)).toLowerCase(Locale.ROOT);
+    }
+
+    // MARK: custom text
+
+    public static String customSource(MessageObject messageObject) {
+        return store().getString("custom_" + Utilities.MD5(key(messageObject)), null);
+    }
+
+    public static boolean hasCustom(MessageObject messageObject) {
+        return customSource(messageObject) != null;
+    }
+
+    /** Saves the user's text for this song; an empty text goes back to the found one. */
+    public static void saveCustom(MessageObject messageObject, String text) {
+        String key = key(messageObject);
+        if (text == null || text.trim().isEmpty()) {
+            store().edit().remove("custom_" + Utilities.MD5(key)).apply();
+            cache.remove(key);
+            request(messageObject);
+        } else {
+            store().edit().putString("custom_" + Utilities.MD5(key), text.trim()).apply();
+            cache.put(key, parse(text.trim(), true));
+        }
+        notifyChanged();
+    }
+
+    /** Editable text for lyrics on screen: timed lines become LRC so the timing survives an edit. */
+    public static String editableText(MessageObject messageObject) {
+        String custom = customSource(messageObject);
+        if (custom != null) {
+            return custom;
+        }
+        Lyrics lyrics = get(messageObject);
+        if (lyrics == null || lyrics.isEmpty()) {
+            return "";
+        }
+        if (!lyrics.isSynced()) {
+            return lyrics.plain;
+        }
+        StringBuilder builder = new StringBuilder();
+        for (Line line : lyrics.lines) {
+            int minutes = (int) (line.time / 60);
+            double seconds = line.time - minutes * 60;
+            builder.append(String.format(Locale.US, "[%02d:%05.2f] ", minutes, seconds)).append(line.text).append('\n');
+        }
+        return builder.toString().trim();
+    }
+
+    public static Lyrics parse(String source, boolean custom) {
+        ArrayList<Line> lines = new ArrayList<>();
+        for (String raw : source.split("\n")) {
+            Matcher matcher = TIME.matcher(raw);
+            ArrayList<Double> times = new ArrayList<>();
+            int end = 0;
+            while (matcher.find() && matcher.start() == end) {
+                double time = Integer.parseInt(matcher.group(1)) * 60 + Integer.parseInt(matcher.group(2));
+                if (matcher.group(3) != null) {
+                    String fraction = matcher.group(3);
+                    time += Integer.parseInt(fraction) / Math.pow(10, fraction.length());
+                }
+                times.add(time);
+                end = matcher.end();
+            }
+            if (!times.isEmpty()) {
+                String text = raw.substring(end);
+                for (double time : times) {
+                    lines.add(wordLine(time, text));
+                }
+            }
+        }
+        if (!lines.isEmpty()) {
+            java.util.Collections.sort(lines, (a, b) -> Double.compare(a.time, b.time));
+            return new Lyrics(lines, null, custom);
+        }
+        return new Lyrics(null, source, custom);
+    }
+
+    // MARK: lookup
+
+    /** Lyrics already known for the track, or null while unknown (call request). */
+    public static Lyrics get(MessageObject messageObject) {
+        if (messageObject == null) {
+            return null;
+        }
+        String key = key(messageObject);
+        Lyrics cached = cache.get(key);
+        if (cached != null) {
+            return cached;
+        }
+        String custom = customSource(messageObject);
+        if (custom != null) {
+            Lyrics lyrics = parse(custom, true);
+            cache.put(key, lyrics);
+            return lyrics;
+        }
+        return null;
+    }
+
+    public static boolean isLoading(MessageObject messageObject) {
+        return messageObject != null && loading.contains(key(messageObject));
+    }
+
+    /** Starts a lookup unless the lyrics are known or being looked up. UI thread. */
+    public static void request(MessageObject messageObject) {
+        if (messageObject == null || !messageObject.isMusic() || get(messageObject) != null) {
+            return;
+        }
+        final String key = key(messageObject);
+        final String title = title(messageObject);
+        final String artist = artist(messageObject);
+        final int duration = (int) Math.round(messageObject.getDuration());
+        if (title.isEmpty() || !loading.add(key)) {
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            Lyrics result = fetch(title, artist, duration);
+            AndroidUtilities.runOnUIThread(() -> {
+                loading.remove(key);
+                if (!cache.containsKey(key)) {
+                    cache.put(key, result != null ? result : NOT_FOUND);
+                }
+                notifyChanged();
+            });
+        });
+    }
+
+    // MARK: sources
+
+    public static final String[] SOURCES = {"lrclib", "netease", "lyricsovh"};
+
+    public static boolean sourceEnabled(String source) {
+        return VoidGram.prefs().getBoolean("lyrics_source_" + source, true);
+    }
+
+    public static void setSourceEnabled(String source, boolean value) {
+        VoidGram.prefs().edit().putBoolean("lyrics_source_" + source, value).apply();
+    }
+
+    public static String sourceTitle(String source) {
+        switch (source) {
+            case "netease": return "NetEase";
+            case "lyricsovh": return "lyrics.ovh";
+            default: return "LRCLIB";
+        }
+    }
+
+    /** An LRCLIB-compatible server of the user's own instead of lrclib.net (empty: lrclib.net). */
+    public static String lrclibBase() {
+        String base = VoidGram.prefs().getString("lyrics_lrclib_base", "").trim();
+        if (base.isEmpty()) {
+            return "https://lrclib.net";
+        }
+        return base.endsWith("/") ? base.substring(0, base.length() - 1) : base;
+    }
+
+    public static void setLrclibBase(String value) {
+        VoidGram.prefs().edit().putString("lyrics_lrclib_base", value == null ? "" : value.trim()).apply();
+    }
+
+    private static Lyrics fetch(String title, String artist, int duration) {
+        Lyrics plain = null;
+        if (sourceEnabled("lrclib")) {
+            Lyrics lyrics = fetchLrclib(title, artist, duration);
+            if (lyrics != null && lyrics.isSynced()) {
+                return lyrics;
+            }
+            plain = lyrics;
+        }
+        if (sourceEnabled("netease")) {
+            Lyrics lyrics = fetchNetease(title, artist);
+            if (lyrics != null && lyrics.isSynced()) {
+                return lyrics;
+            }
+            if (plain == null) {
+                plain = lyrics;
+            }
+        }
+        if (plain == null && sourceEnabled("lyricsovh") && !artist.isEmpty()) {
+            try {
+                String body = load("https://api.lyrics.ovh/v1/" + Uri.encode(artist) + "/" + Uri.encode(title));
+                if (body != null) {
+                    String text = new JSONObject(body).optString("lyrics", "").trim();
+                    if (!text.isEmpty()) {
+                        plain = new Lyrics(null, text, false);
+                    }
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        }
+        return plain;
+    }
+
+    private static Lyrics fetchNetease(String title, String artist) {
+        try {
+            String body = load("https://music.163.com/api/search/get?type=1&limit=5&s=" + Uri.encode((artist + " " + title).trim()));
+            if (body == null) {
+                return null;
+            }
+            JSONObject result = new JSONObject(body).optJSONObject("result");
+            JSONArray songs = result != null ? result.optJSONArray("songs") : null;
+            if (songs == null) {
+                return null;
+            }
+            for (int i = 0; i < songs.length(); i++) {
+                JSONObject song = songs.getJSONObject(i);
+                String name = song.optString("name", "");
+                if (!name.toLowerCase(Locale.ROOT).contains(title.toLowerCase(Locale.ROOT)) && !title.toLowerCase(Locale.ROOT).contains(name.toLowerCase(Locale.ROOT))) {
+                    continue;
+                }
+                String lyricBody = load("https://music.163.com/api/song/lyric?lv=1&kv=1&tv=-1&id=" + song.optLong("id"));
+                if (lyricBody == null) {
+                    continue;
+                }
+                JSONObject lrc = new JSONObject(lyricBody).optJSONObject("lrc");
+                String text = lrc != null ? lrc.optString("lyric", "") : "";
+                if (!text.trim().isEmpty()) {
+                    return parse(text, false);
+                }
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return null;
+    }
+
+    private static Lyrics fetchLrclib(String title, String artist, int duration) {
+        try {
+            if (!artist.isEmpty()) {
+                Uri.Builder get = Uri.parse(lrclibBase() + "/api/get").buildUpon()
+                        .appendQueryParameter("track_name", title)
+                        .appendQueryParameter("artist_name", artist);
+                if (duration > 0) {
+                    get.appendQueryParameter("duration", String.valueOf(duration));
+                }
+                String body = load(get.build().toString());
+                if (body != null) {
+                    Lyrics lyrics = fromRecord(new JSONObject(body), duration);
+                    if (lyrics != null) {
+                        return lyrics;
+                    }
+                }
+            }
+            Uri.Builder search = Uri.parse(lrclibBase() + "/api/search").buildUpon().appendQueryParameter("track_name", title);
+            if (!artist.isEmpty()) {
+                search.appendQueryParameter("artist_name", artist);
+            }
+            String body = load(search.build().toString());
+            if (body != null) {
+                JSONArray array = new JSONArray(body);
+                Lyrics plainFallback = null;
+                for (int i = 0; i < Math.min(array.length(), 10); i++) {
+                    Lyrics lyrics = fromRecord(array.getJSONObject(i), duration);
+                    if (lyrics != null && lyrics.isSynced()) {
+                        return lyrics;
+                    }
+                    if (lyrics != null && plainFallback == null) {
+                        plainFallback = lyrics;
+                    }
+                }
+                return plainFallback;
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return null;
+    }
+
+    private static Lyrics fromRecord(JSONObject record, int duration) {
+        String synced = record.optString("syncedLyrics", "");
+        String plain = record.optString("plainLyrics", "");
+        double recordDuration = record.optDouble("duration", 0);
+        boolean sameRecording = duration <= 0 || recordDuration <= 0 || Math.abs(recordDuration - duration) <= 3;
+        if (!TextUtils.isEmpty(synced) && !"null".equals(synced) && sameRecording) {
+            Lyrics lyrics = parse(synced, false);
+            if (lyrics.isSynced()) {
+                return lyrics;
+            }
+        }
+        if (!TextUtils.isEmpty(plain) && !"null".equals(plain)) {
+            return new Lyrics(null, plain, false);
+        }
+        return null;
+    }
+
+    private static String load(String url) {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setConnectTimeout(8000);
+            connection.setReadTimeout(8000);
+            connection.setRequestProperty("User-Agent", "VoidGram Android (https://github.com/neosay-dev/VoidGram)");
+            if (connection.getResponseCode() != 200) {
+                return null;
+            }
+            InputStream input = connection.getInputStream();
+            ByteArrayOutputStream output = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int read;
+            while ((read = input.read(buffer)) > 0 && output.size() < 4 * 1024 * 1024) {
+                output.write(buffer, 0, read);
+            }
+            return output.toString("UTF-8");
+        } catch (Throwable e) {
+            return null;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    // MARK: playback
+
+    /** Index of the line being sung at `seconds`, or -1. */
+    public static int lineIndex(Lyrics lyrics, double seconds) {
+        if (lyrics == null || !lyrics.isSynced()) {
+            return -1;
+        }
+        int low = 0, high = lyrics.lines.size();
+        while (low < high) {
+            int middle = (low + high) >>> 1;
+            if (lyrics.lines.get(middle).time <= seconds) {
+                low = middle + 1;
+            } else {
+                high = middle;
+            }
+        }
+        return low - 1;
+    }
+
+    public static double position(MessageObject messageObject) {
+        if (messageObject == null) {
+            return 0;
+        }
+        return messageObject.audioProgress * messageObject.getDuration();
+    }
+
+    // MARK: mini player
+
+    private static final String MINI_KEY = "mini_lyrics";
+
+    /** Word-by-word highlighting on the lyrics screen. */
+    public static boolean wordSync() {
+        return VoidGram.prefs().getBoolean("lyrics_word_sync", true);
+    }
+
+    public static void setWordSync(boolean value) {
+        VoidGram.prefs().edit().putBoolean("lyrics_word_sync", value).apply();
+    }
+
+    public static boolean isMiniEnabled() {
+        return VoidGram.prefs().getBoolean(MINI_KEY, true);
+    }
+
+    public static void setMiniEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean(MINI_KEY, value).apply();
+        notifyChanged();
+    }
+
+    /** The line for the mini player, or null (off, no timed lyrics, before the first line, a gap). */
+    public static String miniLine(MessageObject messageObject) {
+        if (!isMiniEnabled() || messageObject == null || !messageObject.isMusic()) {
+            return null;
+        }
+        request(messageObject);
+        Lyrics lyrics = get(messageObject);
+        int index = lineIndex(lyrics, position(messageObject));
+        if (index < 0) {
+            return null;
+        }
+        String text = lyrics.lines.get(index).text.trim();
+        return text.isEmpty() ? null : text;
+    }
+
+    // MARK: listeners
+
+    public static void addListener(Runnable listener) {
+        if (!listeners.contains(listener)) {
+            listeners.add(listener);
+        }
+    }
+
+    public static void removeListener(Runnable listener) {
+        listeners.remove(listener);
+    }
+
+    private static void notifyChanged() {
+        for (Runnable listener : new ArrayList<>(listeners)) {
+            listener.run();
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramMusicHaptics.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramMusicHaptics.java
