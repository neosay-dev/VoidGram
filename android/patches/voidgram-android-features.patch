+            runtime.context.evaluate(raw(R.raw.voidgram_plugin_bridge), "bridge.js");
+            runtime.context.evaluate(raw(R.raw.voidgram_plugin_prelude), "prelude.js");
+            runtime.context.evaluate(code, id + ".js");
+            log(id, "info", VoidGram.t("запущен", "started"));
+        } catch (Throwable e) {
+            log(id, "error", String.valueOf(e.getMessage()));
+            stop(id, VoidGram.t("Ошибка при запуске: ", "Failed to start: ") + e.getMessage());
+            state().edit().putBoolean("enabled_" + id, false).apply();
+        }
+    }
+
+    private static void disable(String id, String reason) {
+        state().edit().putBoolean("enabled_" + id, false).putString("reason_" + id, reason).apply();
+        log(id, "error", reason);
+    }
+
+    private static void stop(String id, String reason) {
+        Runtime runtime = running.remove(id);
+        if (runtime == null) {
+            if (reason != null) {
+                disable(id, reason);
+            }
+            return;
+        }
+        runtime.stopped = true;
+        for (Runnable timer : runtime.timers.values()) {
+            handler.removeCallbacks(timer);
+        }
+        runtime.timers.clear();
+        try {
+            runtime.context.evaluate("typeof __ayuDispatchEvent === 'function' && __ayuDispatchEvent('unload', null)");
+        } catch (Throwable ignore) {
+        }
+        try {
+            runtime.context.destroy();
+        } catch (Throwable ignore) {
+        }
+        if (reason != null) {
+            disable(id, reason);
+        }
+    }
+
+    private static void schedule(Runtime runtime, int timer, long ms, boolean repeats) {
+        Runnable[] task = new Runnable[1];
+        task[0] = () -> {
+            if (runtime.stopped || !runtime.timers.containsKey(timer)) {
+                return;
+            }
+            if (!repeats) {
+                runtime.timers.remove(timer);
+            }
+            evaluate(runtime, "__ayuDispatchTimer(" + timer + ")");
+            if (repeats && !runtime.stopped && runtime.timers.containsKey(timer)) {
+                handler.postDelayed(task[0], Math.max(16, ms));
+            }
+        };
+        runtime.timers.put(timer, task[0]);
+        handler.postDelayed(task[0], ms);
+    }
+
+    private static Object evaluate(Runtime runtime, String script) {
+        if (runtime.stopped) {
+            return null;
+        }
+        try {
+            return runtime.context.evaluate(script);
+        } catch (Throwable e) {
+            log(runtime.plugin.id, "error", String.valueOf(e.getMessage()));
+            return null;
+        }
+    }
+
+    private static String str(Object[] args, int index) {
+        return args != null && args.length > index && args[index] != null ? String.valueOf(args[index]) : "";
+    }
+
+    private static String quote(String value) {
+        return value == null ? "null" : JSONObject.quote(value);
+    }
+
+    /** Java → JS event for one plugin, on the plugin thread. */
+    private static void emit(Runtime runtime, String event, Object payload) {
+        post(() -> evaluate(runtime, "__ayuDispatchEvent(" + quote(event) + ", " + quote(payload == null ? null : payload.toString()) + ")"));
+    }
+
+    private static void answer(Runtime runtime, String requestId, Object choice) {
+        try {
+            JSONObject payload = new JSONObject();
+            payload.put("requestId", requestId);
+            payload.put("choice", choice == null ? JSONObject.NULL : choice);
+            emit(runtime, "uiResult", payload);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    // ---- Settings declared by plugins ----
+
+    public static JSONArray declaredSettings(String id) {
+        try {
+            return new JSONArray(state().getString("settings_" + id, "[]"));
+        } catch (Throwable e) {
+            return new JSONArray();
+        }
+    }
+
+    private static String settingJson(String id, String key) {
+        String stored = state().getString("setting_" + id + "_" + key, null);
+        if (stored != null) {
+            return stored;
+        }
+        JSONArray items = declaredSettings(id);
+        for (int i = 0; i < items.length(); i++) {
+            JSONObject item = items.optJSONObject(i);
+            if (item != null && key.equals(item.optString("key")) && item.has("default")) {
+                Object value = item.opt("default");
+                return value instanceof String ? JSONObject.quote((String) value) : String.valueOf(value);
+            }
+        }
+        return null;
+    }
+
+    public static Object settingValue(String id, String key) {
+        String json = settingJson(id, key);
+        if (json == null) {
+            return null;
+        }
+        try {
+            return new JSONArray("[" + json + "]").get(0);
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    public static void setSetting(String id, String key, Object value) {
+        String json = value instanceof String ? JSONObject.quote((String) value) : String.valueOf(value);
+        state().edit().putString("setting_" + id + "_" + key, json).apply();
+        Runtime runtime = running.get(id);
+        if (runtime != null) {
+            try {
+                emit(runtime, "settingChanged", new JSONObject().put("key", key).put("value", value));
+            } catch (Throwable ignore) {
+            }
+        }
+    }
+
+    // ---- Host operations ----
+
+    private static String call(Runtime runtime, String op, String argsJson) {
+        JSONObject args;
+        try {
+            args = new JSONObject(argsJson == null || argsJson.isEmpty() ? "{}" : argsJson);
+        } catch (Throwable e) {
+            args = new JSONObject();
+        }
+        String id = runtime.plugin.id;
+        try {
+            switch (op) {
+                case "feature":
+                    return "true";
+                case "i18n.language":
+                    return new JSONObject().put("language", VoidGram.russian() ? "ru" : "en").toString();
+                case "commands.register": {
+                    String name = args.optString("name").replaceAll("^\\.+", "").toLowerCase(Locale.ROOT);
+                    if (!name.matches("[a-z0-9_]{1,32}")) {
+                        return "false";
+                    }
+                    log(id, "info", VoidGram.t("команда .", "command .") + name);
+                    return new JSONObject().put("name", "." + name).toString();
+                }
+                case "permissions.has":
+                    return runtime.plugin.permissions.contains(args.optString("permission").toLowerCase(Locale.ROOT)) ? "true" : "false";
+                case "ui.alert":
+                case "ui.sheet":
+                    alert(runtime, op, args);
+                    return "true";
+                case "net.fetch":
+                    return fetch(runtime, args) ? "true" : "false";
+                case "secrets.get": {
+                    String value = state().getString("secret_" + id + "_" + args.optString("key"), null);
+                    return value == null ? "null" : new JSONObject().put("value", value).toString();
+                }
+                case "secrets.set":
+                    if (args.isNull("value")) {
+                        state().edit().remove("secret_" + id + "_" + args.optString("key")).apply();
+                    } else {
+                        state().edit().putString("secret_" + id + "_" + args.optString("key"), args.optString("value")).apply();
+                    }
+                    return "true";
+                case "bus.emit": {
+                    JSONObject payload = new JSONObject().put("topic", args.optString("topic")).put("data", args.opt("data")).put("from", id);
+                    for (Runtime other : running.values()) {
+                        if (other != runtime) {
+                            emit(other, "busMessage", payload);
+                        }
+                    }
+                    return "true";
+                }
+                case "player.control": {
+                    String action = args.optString("action");
+                    AndroidUtilities.runOnUIThread(() -> {
+                        MediaController media = MediaController.getInstance();
+                        MessageObject playing = media.getPlayingMessageObject();
+                        if (playing == null) {
+                            return;
+                        }
+                        switch (action) {
+                            case "play": media.playMessage(playing); break;
+                            case "pause": media.pauseMessage(playing); break;
+                            case "next": media.playNextMessage(); break;
+                            case "previous": media.playPreviousMessage(); break;
+                            default: break;
+                        }
+                    });
+                    return "true";
+                }
+                case "player.state": {
+                    MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+                    JSONObject state = new JSONObject();
+                    if (playing != null) {
+                        state.put("title", VoidGramLyrics.title(playing));
+                        state.put("artist", VoidGramLyrics.artist(playing));
+                        state.put("playing", !MediaController.getInstance().isMessagePaused());
+                        state.put("position", playing.audioProgressSec);
+                        state.put("duration", playing.getDuration());
+                    }
+                    return state.toString();
+                }
+                case "clipboard.get":
+                case "clipboard.set":
+                    if (!runtime.plugin.permissions.contains("clipboard")) {
+                        return "false";
+                    }
+                    if ("clipboard.set".equals(op)) {
+                        String text = args.optString("text");
+                        AndroidUtilities.runOnUIThread(() -> AndroidUtilities.addToClipboard(text));
+                        return "true";
+                    }
+                    return "false";
+                default:
+                    if (state().getBoolean("missing_" + id + "_" + op, false)) {
+                        return "false";
+                    }
+                    state().edit().putBoolean("missing_" + id + "_" + op, true).apply();
+                    log(id, "warning", op + VoidGram.t(" пока работает только на iOS", " only works on iOS so far"));
+                    return "false";
+            }
+        } catch (Throwable e) {
+            log(id, "error", op + ": " + e.getMessage());
+            return "false";
+        }
+    }
+
+    private static void alert(Runtime runtime, String op, JSONObject args) {
+        String requestId = args.optString("requestId");
+        AndroidUtilities.runOnUIThread(() -> {
+            org.telegram.ui.ActionBar.BaseFragment fragment = org.telegram.ui.LaunchActivity.getLastFragment();
+            if (fragment == null || fragment.getParentActivity() == null) {
+                answer(runtime, requestId, null);
+                return;
+            }
+            org.telegram.ui.ActionBar.AlertDialog.Builder builder = new org.telegram.ui.ActionBar.AlertDialog.Builder(fragment.getParentActivity());
+            builder.setTitle(args.optString("title", runtime.plugin.name));
+            if (args.has("message")) {
+                builder.setMessage(args.optString("message"));
+            }
+            JSONArray buttons = args.optJSONArray("ui.sheet".equals(op) ? "items" : "buttons");
+            if (buttons == null) {
+                buttons = args.optJSONArray("actions");
+            }
+            final boolean[] answered = new boolean[1];
+            if ("ui.sheet".equals(op) && buttons != null) {
+                CharSequence[] titles = new CharSequence[buttons.length()];
+                for (int i = 0; i < titles.length; i++) {
+                    Object item = buttons.opt(i);
+                    titles[i] = item instanceof JSONObject ? ((JSONObject) item).optString("title") : String.valueOf(item);
+                }
+                builder.setItems(titles, (d, which) -> {
+                    answered[0] = true;
+                    Object item = args.optJSONArray("items").opt(which);
+                    answer(runtime, requestId, item instanceof JSONObject && ((JSONObject) item).has("id") ? ((JSONObject) item).opt("id") : which);
+                });
+            } else if (buttons != null && buttons.length() > 0) {
+                final JSONArray list = buttons;
+                for (int i = 0; i < Math.min(3, list.length()); i++) {
+                    final int index = i;
+                    Object item = list.opt(i);
+                    String title = item instanceof JSONObject ? ((JSONObject) item).optString("title") : String.valueOf(item);
+                    Object value = item instanceof JSONObject && ((JSONObject) item).has("id") ? ((JSONObject) item).opt("id") : index;
+                    org.telegram.ui.ActionBar.AlertDialog.OnButtonClickListener listener = (d, w) -> {
+                        answered[0] = true;
+                        answer(runtime, requestId, value);
+                    };
+                    if (i == 0) {
+                        builder.setPositiveButton(title, listener);
+                    } else if (i == 1) {
+                        builder.setNegativeButton(title, listener);
+                    } else {
+                        builder.setNeutralButton(title, listener);
+                    }
+                }
+            } else {
+                builder.setPositiveButton("OK", (d, w) -> {
+                    answered[0] = true;
+                    answer(runtime, requestId, 0);
+                });
+            }
+            org.telegram.ui.ActionBar.AlertDialog dialog = builder.create();
+            dialog.setOnDismissListener(d -> {
+                if (!answered[0]) {
+                    answer(runtime, requestId, null);
+                }
+            });
+            fragment.showDialog(dialog);
+        });
+    }
+
+    private static boolean hostAllowed(Plugin plugin, String host) {
+        for (String pattern : plugin.connect) {
+            if (pattern.equals(host) || pattern.startsWith("*.") && (host.endsWith(pattern.substring(1)) || host.equals(pattern.substring(2)))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean fetch(Runtime runtime, JSONObject args) {
+        String requestId = args.optString("requestId");
+        String url = args.optString("url");
+        String host;
+        try {
+            URL parsed = new URL(url);
+            if (!"https".equals(parsed.getProtocol())) {
+                return false;
+            }
+            host = parsed.getHost().toLowerCase(Locale.ROOT);
+        } catch (Throwable e) {
+            return false;
+        }
+        if (!hostAllowed(runtime.plugin, host)) {
+            log(runtime.plugin.id, "error", "net.fetch: " + host + VoidGram.t(" нет в @connect", " is not in @connect"));
+            return false;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            JSONObject result = new JSONObject();
+            HttpURLConnection connection = null;
+            try {
+                connection = (HttpURLConnection) new URL(url).openConnection();
+                connection.setConnectTimeout(20000);
+                connection.setReadTimeout(30000);
+                connection.setRequestMethod(args.optString("method", "GET").toUpperCase(Locale.ROOT));
+                JSONObject headers = args.optJSONObject("headers");
+                if (headers != null) {
+                    Iterator<String> keys = headers.keys();
+                    while (keys.hasNext()) {
+                        String key = keys.next();
+                        connection.setRequestProperty(key, headers.optString(key));
+                    }
+                }
+                if (args.has("body") && !args.isNull("body")) {
+                    connection.setDoOutput(true);
+                    try (OutputStream out = connection.getOutputStream()) {
+                        out.write(args.optString("body").getBytes("UTF-8"));
+                    }
+                }
+                int status = connection.getResponseCode();
+                InputStream in = status < 400 ? connection.getInputStream() : connection.getErrorStream();
+                String text = in != null ? readAll(in) : "";
+                if (text.length() > 2 * 1024 * 1024) {
+                    text = text.substring(0, 2 * 1024 * 1024);
+                }
+                JSONObject responseHeaders = new JSONObject();
+                for (java.util.Map.Entry<String, java.util.List<String>> entry : connection.getHeaderFields().entrySet()) {
+                    if (entry.getKey() != null && !entry.getValue().isEmpty()) {
+                        responseHeaders.put(entry.getKey().toLowerCase(Locale.ROOT), entry.getValue().get(0));
+                    }
+                }
+                result.put("status", status).put("headers", responseHeaders).put("text", text);
+            } catch (Throwable e) {
+                try {
+                    result.put("error", String.valueOf(e.getMessage()));
+                } catch (Throwable ignore) {
+                }
+            } finally {
+                if (connection != null) {
+                    connection.disconnect();
+                }
+            }
+            answer(runtime, requestId, result);
+        });
+        return true;
+    }
+
+    // ---- Hooks ----
+
+    /** SendMessagesHelper: plugins' outgoing-text hooks and dot commands. False cancels the send. */
+    public static boolean applyOutgoing(int account, SendMessagesHelper.SendMessageParams params) {
+        if (params == null || params.message == null || params.document != null || params.photo != null || running.isEmpty() || VoidGramDecoy.isActive()) {
+            return true;
+        }
+        String text = params.message;
+        for (Runtime runtime : new ArrayList<>(running.values())) {
+            boolean any = false;
+            for (String mode : new String[]{"before", "replace", "after"}) {
+                if (runtime.hooks.contains("message.outgoing.text|" + mode)) {
+                    any = true;
+                }
+            }
+            if (!any) {
+                continue;
+            }
+            final String value = text;
+            final Object[] result = new Object[1];
+            final CountDownLatch latch = new CountDownLatch(1);
+            String context;
+            try {
+                context = new JSONObject().put("peerId", String.valueOf(params.peer)).put("account", account).toString();
+            } catch (Throwable e) {
+                context = "{}";
+            }
+            final String finalContext = context;
+            post(() -> {
+                try {
+                    for (String mode : new String[]{"before", "replace", "after"}) {
+                        if (!runtime.hooks.contains("message.outgoing.text|" + mode)) {
+                            continue;
+                        }
+                        String current = result[0] instanceof String ? (String) result[0] : value;
+                        Object answer = evaluate(runtime, "__ayuDispatchHook('message.outgoing.text', " + quote(mode) + ", " + quote(current) + ", " + quote(finalContext) + ")");
+                        if ("\u0000".equals(answer)) {
+                            result[0] = "\u0000";
+                            break;
+                        }
+                        if (answer instanceof String) {
+                            result[0] = answer;
+                        }
+                    }
+                } finally {
+                    latch.countDown();
+                }
+            });
+            boolean answered;
+            try {
+                answered = latch.await(1500, TimeUnit.MILLISECONDS);
+            } catch (InterruptedException e) {
+                answered = false;
+            }
+            if (!answered) {
+                String id = runtime.plugin.id;
+                post(() -> stop(id, VoidGram.t("Плагин не ответил вовремя и выключен.", "The plugin did not answer in time and was turned off.")));
+                continue;
+            }
+            if ("\u0000".equals(result[0])) {
+                return false;
+            }
+            if (result[0] instanceof String) {
+                text = (String) result[0];
+            }
+        }
+        if (!text.equals(params.message)) {
+            params.message = text;
+            if (params.entities != null) {
+                params.entities.clear();
+            }
+        }
+        return true;
+    }
+}
