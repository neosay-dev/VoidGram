+        LinearLayout root = new LinearLayout(activity);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(background);
+        root.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(14) + AndroidUtilities.statusBarHeight, AndroidUtilities.dp(16), AndroidUtilities.dp(14));
+
+        LinearLayout header = new LinearLayout(activity);
+        header.setGravity(Gravity.CENTER_VERTICAL);
+        TextView cancel = button(activity, VoidGram.t("Отмена", "Cancel"));
+        TextView title = new TextView(activity);
+        title.setText(VoidGramLyrics.title(track));
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setGravity(Gravity.CENTER);
+        title.setSingleLine(true);
+        TextView save = button(activity, VoidGram.t("Сохранить", "Save"));
+        header.addView(cancel, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(32)));
+        header.addView(title, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        header.addView(save, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(32)));
+        root.addView(header);
+
+        TextView hint = new TextView(activity);
+        hint.setText(VoidGram.t("Каждая строка — отдельная строка песни. Чтобы текст шёл синхронно, оставьте или добавьте время в начале строки: [01:23.45] Текст строки. Пустой текст вернёт найденный.", "One line per line of the song. To keep the text in sync, keep or add a time at the start of a line: [01:23.45] Line text. An empty text restores the found one."));
+        hint.setTextColor(0x99FFFFFF);
+        hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+        LinearLayout.LayoutParams hintParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        hintParams.topMargin = AndroidUtilities.dp(12);
+        root.addView(hint, hintParams);
+
+        final EditText field = new EditText(activity);
+        field.setText(VoidGramLyrics.editableText(track));
+        field.setTextColor(Color.WHITE);
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        field.setGravity(Gravity.TOP | Gravity.START);
+        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        field.setPadding(AndroidUtilities.dp(12), AndroidUtilities.dp(12), AndroidUtilities.dp(12), AndroidUtilities.dp(12));
+        GradientDrawable box = new GradientDrawable();
+        box.setColor(0x14FFFFFF);
+        box.setCornerRadius(AndroidUtilities.dp(12));
+        field.setBackground(box);
+        LinearLayout.LayoutParams fieldParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f);
+        fieldParams.topMargin = AndroidUtilities.dp(12);
+        root.addView(field, fieldParams);
+
+        cancel.setOnClickListener(v -> dialog.dismiss());
+        save.setOnClickListener(v -> {
+            VoidGramLyrics.saveCustom(track, field.getText().toString());
+            dialog.dismiss();
+            if (done != null) {
+                done.run();
+            }
+        });
+        dialog.setContentView(root);
+        fullscreen(dialog, background);
+        Window window = dialog.getWindow();
+        if (window != null) {
+            window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+        }
+        dialog.show();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramMessageShot.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramMessageShot.java
