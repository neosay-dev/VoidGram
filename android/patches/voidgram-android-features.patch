+
+        dialog.setContentView(frame);
+        fullscreen(dialog, background);
+        dialog.show();
+        tick[0].run();
+    }
+
+    /** A full-screen editor for this song's text; `done` runs after saving. */
+    public static void showEditor(Activity activity, MessageObject track, Runnable done) {
+        if (activity == null || track == null) {
+            return;
+        }
+        final int background = 0xFF141418;
