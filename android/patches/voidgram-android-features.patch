@@ -0,0 +1,130 @@
+package org.telegram.messenger.voidgram;
+
+import android.media.audiofx.Equalizer;
+
+import org.telegram.messenger.FileLog;
+
+/**
+ * VoidGram music equalizer, as on iOS: presets and per-band gains applied to the music player's
+ * audio session. Off by default.
+ */
+public final class VoidGramEqualizer {
+    public static final String[] PRESETS = {"flat", "bass", "vocal", "treble", "rock", "custom"};
+    /** Gains in dB for five bands (low to high) per preset; others interpolate. */
+    private static final int[][] PRESET_GAINS = {
+        {0, 0, 0, 0, 0},
+        {6, 4, 0, 0, 0},
+        {-2, 0, 4, 3, 0},
+        {0, 0, 0, 3, 6},
+        {4, 2, -1, 2, 4},
+    };
+
+    private static Equalizer equalizer;
+    private static int sessionId;
+
+    private VoidGramEqualizer() {
+    }
+
+    public static boolean isEnabled() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("eq_enabled", false);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("eq_enabled", value).apply();
+        apply();
+    }
+
+    public static String preset() {
+        return VoidGram.prefs().getString("eq_preset", "flat");
+    }
+
+    public static void setPreset(String preset) {
+        VoidGram.prefs().edit().putString("eq_preset", preset).apply();
+        apply();
+    }
+
+    public static String presetTitle(String preset) {
+        switch (preset) {
+            case "bass": return VoidGram.t("Бас", "Bass");
+            case "vocal": return VoidGram.t("Голос", "Vocal");
+            case "treble": return VoidGram.t("Высокие", "Treble");
+            case "rock": return VoidGram.t("Рок", "Rock");
+            case "custom": return VoidGram.t("Свой", "Custom");
+            default: return VoidGram.t("Ровный", "Flat");
+        }
+    }
+
+    public static final int BANDS = 5;
+
+    public static String bandTitle(int band) {
+        String[] titles = {"60 Hz", "230 Hz", "910 Hz", "3.6 kHz", "14 kHz"};
+        return titles[Math.max(0, Math.min(BANDS - 1, band))];
+    }
+
+    /** Gain of a band (dB, -12…12) for the current preset. */
+    public static int gain(int band) {
+        String preset = preset();
+        for (int i = 0; i < PRESET_GAINS.length; i++) {
+            if (PRESETS[i].equals(preset)) {
+                return PRESET_GAINS[i][band];
+            }
+        }
+        return VoidGram.prefs().getInt("eq_band_" + band, 0);
+    }
+
+    public static void setGain(int band, int db) {
+        VoidGram.prefs().edit().putInt("eq_band_" + band, Math.max(-12, Math.min(12, db))).putString("eq_preset", "custom").apply();
+        apply();
+    }
+
+    /** Called when the music player starts a track. */
+    public static void attach(int audioSessionId) {
+        if (audioSessionId <= 0) {
+            return;
+        }
+        if (audioSessionId != sessionId) {
+            release();
+            sessionId = audioSessionId;
+        }
+        apply();
+    }
+
+    private static void release() {
+        if (equalizer != null) {
+            try {
+                equalizer.release();
+            } catch (Throwable ignore) {
+            }
+            equalizer = null;
+        }
+    }
+
+    private static void apply() {
+        if (sessionId <= 0) {
+            return;
+        }
+        try {
+            if (!isEnabled()) {
+                if (equalizer != null) {
+                    equalizer.setEnabled(false);
+                }
+                return;
+            }
+            if (equalizer == null) {
+                equalizer = new Equalizer(0, sessionId);
+            }
+            short bands = equalizer.getNumberOfBands();
+            short[] range = equalizer.getBandLevelRange();
+            for (short band = 0; band < bands; band++) {
+                // Map the device's bands onto the five VoidGram bands by position.
+                int index = bands <= 1 ? 0 : Math.round(band * (BANDS - 1) / (float) (bands - 1));
+                int level = gain(index) * 100;
+                level = Math.max(range[0], Math.min(range[1], level));
+                equalizer.setBandLevel(band, (short) level);
+            }
+            equalizer.setEnabled(true);
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+}
