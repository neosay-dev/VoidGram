+                        spannable.setSpan(new android.text.style.ForegroundColorSpan(0x80FFFFFF), sung, line.text.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+                        lineViews.get(index).setText(spannable);
