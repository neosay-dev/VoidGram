+            try {
+                java.io.File file = new java.io.File(getParentActivity().getCacheDir(), "voidgram_import.voidgram");
+                try (java.io.InputStream in = getParentActivity().getContentResolver().openInputStream(uri); java.io.FileOutputStream out = new java.io.FileOutputStream(file)) {
+                    byte[] buffer = new byte[16384];
