@@ -0,0 +1,163 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.ApplicationLoader;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.security.SecureRandom;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.Set;
+
+import javax.crypto.Cipher;
+import javax.crypto.SecretKeyFactory;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.PBEKeySpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * VoidGram settings backup, as on iOS: every VoidGram setting (decoy codes excepted) in one file,
+ * sealed with AES-GCM under a key derived from the user's password.
+ */
+public final class VoidGramBackup {
+    private static final byte[] MAGIC = "VGBK1".getBytes();
+
+    private VoidGramBackup() {
+    }
+
+    private static SharedPreferences[] stores() {
+        Context context = ApplicationLoader.applicationContext;
+        return new SharedPreferences[]{context.getSharedPreferences("voidgram", Context.MODE_PRIVATE), context.getSharedPreferences("voidgram_lyrics", Context.MODE_PRIVATE)};
+    }
+
+    private static final String[] NAMES = {"voidgram", "voidgram_lyrics"};
+
+    private static byte[] key(String password, byte[] salt) throws Exception {
+        SecretKeyFactory factory = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256");
+        return factory.generateSecret(new PBEKeySpec(password.toCharArray(), salt, 120000, 256)).getEncoded();
+    }
+
+    /** Writes the backup into the app's cache and returns the file, or null. */
+    public static File export(String password) {
+        try {
+            JSONObject root = new JSONObject();
+            SharedPreferences[] stores = stores();
+            for (int i = 0; i < stores.length; i++) {
+                JSONObject values = new JSONObject();
+                for (Map.Entry<String, ?> entry : stores[i].getAll().entrySet()) {
+                    Object value = entry.getValue();
+                    if (value instanceof Set) {
+                        JSONArray array = new JSONArray();
+                        for (Object item : (Set<?>) value) {
+                            array.put(item);
+                        }
+                        JSONObject wrapped = new JSONObject();
+                        wrapped.put("set", array);
+                        values.put(entry.getKey(), wrapped);
+                    } else {
+                        JSONObject wrapped = new JSONObject();
+                        wrapped.put(value instanceof Boolean ? "b" : value instanceof Integer ? "i" : value instanceof Long ? "l" : value instanceof Float ? "f" : "s", value);
+                        values.put(entry.getKey(), wrapped);
+                    }
+                }
+                root.put(NAMES[i], values);
+            }
+            byte[] plain = root.toString().getBytes("UTF-8");
+            SecureRandom random = new SecureRandom();
+            byte[] salt = new byte[16];
+            byte[] iv = new byte[12];
+            random.nextBytes(salt);
+            random.nextBytes(iv);
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(key(password, salt), "AES"), new GCMParameterSpec(128, iv));
+            byte[] sealed = cipher.doFinal(plain);
+            File directory = new File(ApplicationLoader.applicationContext.getFilesDir(), "cache");
+            directory.mkdirs();
+            File file = new File(directory, "VoidGram-settings.voidgram");
+            try (FileOutputStream out = new FileOutputStream(file)) {
+                out.write(MAGIC);
+                out.write(salt);
+                out.write(iv);
+                out.write(sealed);
+            }
+            return file;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    /** Restores a backup; false on a wrong password or a damaged file. */
+    public static boolean restore(File file, String password) {
+        try {
+            byte[] data = new byte[(int) file.length()];
+            try (FileInputStream in = new FileInputStream(file)) {
+                int read = 0;
+                while (read < data.length) {
+                    int count = in.read(data, read, data.length - read);
+                    if (count < 0) {
+                        break;
+                    }
+                    read += count;
+                }
+            }
+            if (data.length < MAGIC.length + 28) {
+                return false;
+            }
+            for (int i = 0; i < MAGIC.length; i++) {
+                if (data[i] != MAGIC[i]) {
+                    return false;
+                }
+            }
+            byte[] salt = new byte[16];
+            byte[] iv = new byte[12];
+            System.arraycopy(data, MAGIC.length, salt, 0, 16);
+            System.arraycopy(data, MAGIC.length + 16, iv, 0, 12);
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(key(password, salt), "AES"), new GCMParameterSpec(128, iv));
+            byte[] plain = cipher.doFinal(data, MAGIC.length + 28, data.length - MAGIC.length - 28);
+            JSONObject root = new JSONObject(new String(plain, "UTF-8"));
+            SharedPreferences[] stores = stores();
+            for (int i = 0; i < stores.length; i++) {
+                JSONObject values = root.optJSONObject(NAMES[i]);
+                if (values == null) {
+                    continue;
+                }
+                SharedPreferences.Editor editor = stores[i].edit();
+                Iterator<String> keys = values.keys();
+                while (keys.hasNext()) {
+                    String name = keys.next();
+                    JSONObject wrapped = values.getJSONObject(name);
+                    if (wrapped.has("set")) {
+                        JSONArray array = wrapped.getJSONArray("set");
+                        HashSet<String> set = new HashSet<>();
+                        for (int j = 0; j < array.length(); j++) {
+                            set.add(array.getString(j));
+                        }
+                        editor.putStringSet(name, set);
+                    } else if (wrapped.has("b")) {
+                        editor.putBoolean(name, wrapped.getBoolean("b"));
+                    } else if (wrapped.has("i")) {
+                        editor.putInt(name, wrapped.getInt("i"));
+                    } else if (wrapped.has("l")) {
+                        editor.putLong(name, wrapped.getLong("l"));
+                    } else if (wrapped.has("f")) {
+                        editor.putFloat(name, (float) wrapped.getDouble("f"));
+                    } else if (wrapped.has("s")) {
+                        editor.putString(name, wrapped.getString("s"));
+                    }
+                }
+                editor.apply();
+            }
+            return true;
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+}
