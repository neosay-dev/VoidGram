+    private static void yearInReview(BaseFragment fragment, int account, long dialogId) {
+        String title = VoidGram.t("Итоги года", "Year in review");
+        Calendar calendar = Calendar.getInstance();
+        int year = calendar.get(Calendar.YEAR);
+        calendar.set(year, Calendar.JANUARY, 1, 0, 0, 0);
+        final int start = (int) (calendar.getTimeInMillis() / 1000);
+        AlertDialog progress = new AlertDialog(fragment.getParentActivity(), AlertDialog.ALERT_TYPE_SPINNER);
+        progress.show();
+        ArrayList<TLRPC.Message> collected = new ArrayList<>();
+        final TLRPC.InputPeer peer = MessagesController.getInstance(account).getInputPeer(dialogId);
+        final int[] offset = {0};
+        final Runnable[] page = new Runnable[1];
+        page[0] = () -> {
+            TLRPC.TL_messages_getHistory req = new TLRPC.TL_messages_getHistory();
+            req.peer = peer;
+            req.offset_id = offset[0];
+            req.limit = 100;
+            ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+                boolean done = true;
+                if (response instanceof TLRPC.messages_Messages) {
+                    TLRPC.messages_Messages result = (TLRPC.messages_Messages) response;
+                    MessagesController.getInstance(account).putUsers(result.users, false);
+                    MessagesController.getInstance(account).putChats(result.chats, false);
+                    int next = Integer.MAX_VALUE;
+                    for (TLRPC.Message message : result.messages) {
+                        if (message.id > 0) {
+                            next = Math.min(next, message.id);
+                        }
+                        if (message.date >= start && !(message instanceof TLRPC.TL_messageService) && !(message instanceof TLRPC.TL_messageEmpty)) {
+                            collected.add(message);
+                        }
+                    }
+                    boolean older = false;
+                    for (TLRPC.Message message : result.messages) {
+                        if (message.date < start) {
+                            older = true;
+                            break;
+                        }
+                    }
+                    if (!result.messages.isEmpty() && !older && collected.size() < 20000 && next != Integer.MAX_VALUE && (offset[0] == 0 || next < offset[0])) {
+                        offset[0] = next;
+                        done = false;
+                        AndroidUtilities.runOnUIThread(page[0], 300);
+                    }
+                }
+                if (done) {
+                    try {
+                        progress.dismiss();
+                    } catch (Throwable ignore) {
+                    }
+                    present(fragment, title, yearText(account, year, start, collected));
+                }
+            }));
+        };
+        page[0].run();
+    }
