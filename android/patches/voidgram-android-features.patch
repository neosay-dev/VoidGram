+
+// MARK: VoidGram DPI bypass
+
+static std::atomic<int32_t> voidgramDpiMethod(0);
+static std::atomic<int32_t> voidgramDpiSplitPosition(2);
+static std::atomic<int32_t> voidgramDpiSplitCount(1);
+static std::atomic<int32_t> voidgramDpiDelayMs(0);
+static std::atomic<bool> voidgramDpiViaProxy(true);
+
+void voidgramSetDpi(int32_t method, int32_t splitPosition, int32_t splitCount, int32_t delayMs, bool viaProxy) {
+    voidgramDpiMethod = std::max(0, std::min(4, method));
+    voidgramDpiSplitPosition = std::max(1, std::min(256, splitPosition));
+    voidgramDpiSplitCount = std::max(1, std::min(16, splitCount));
+    voidgramDpiDelayMs = std::max(0, std::min(100, delayMs));
+    voidgramDpiViaProxy = viaProxy;
+}
+
+static void voidgramSetTtl(int fd, int ttl) {
+    setsockopt(fd, IPPROTO_IP, IP_TTL, &ttl, sizeof(ttl));
+    setsockopt(fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, &ttl, sizeof(ttl));
+}
+
+/**
+ * Sends the first payload in parts so that DPI which does not reassemble TCP misses the signature.
+ * Returns the bytes accepted by the kernel (the caller discards them), or -1 on a socket error.
+ */
+ssize_t ConnectionSocket::voidgramDpiSend(const uint8_t *data, size_t length) {
+    const int32_t method = voidgramDpiMethod;
+    const bool disorder = method == 2 || method == 4;
+    const bool oob = method == 3 || method == 4;
+    const size_t position = (size_t) voidgramDpiSplitPosition.load();
+    const int32_t count = voidgramDpiSplitCount;
+    const int32_t delay = voidgramDpiDelayMs;
+    size_t offset = 0;
+    int defaultTtl = 64;
+    socklen_t ttlLength = sizeof(defaultTtl);
+    if (disorder && getsockopt(socketFd, IPPROTO_IP, IP_TTL, &defaultTtl, &ttlLength) != 0) {
+        ttlLength = sizeof(defaultTtl);
+        if (getsockopt(socketFd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, &defaultTtl, &ttlLength) != 0 || defaultTtl <= 0) {
+            defaultTtl = 64;
+        }
+    }
+    for (int32_t part = 0; part < count && offset + 1 < length; part++) {
+        size_t chunk = std::min(position, length - 1 - offset);
+        if (disorder && part == 0) {
+            voidgramSetTtl(socketFd, 1);
+        }
+        ssize_t sent = send(socketFd, data + offset, chunk, 0);
+        if (disorder && part == 0) {
+            voidgramSetTtl(socketFd, defaultTtl);
+        }
+        if (sent < 0) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) {
+                return (ssize_t) offset;
+            }
+            return -1;
+        }
+        offset += (size_t) sent;
+        if ((size_t) sent < chunk) {
+            return (ssize_t) offset;
+        }
+        if (oob) {
+            // One urgent byte: the server's kernel keeps it out of the stream, a naive DPI does not.
+            uint8_t junk = 0;
+            send(socketFd, &junk, 1, MSG_OOB);
+        }
+        if (delay > 0) {
+            usleep((useconds_t) delay * 1000);
+        }
+    }
+    ssize_t sent = send(socketFd, data + offset, length - offset, 0);
+    if (sent < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            return (ssize_t) offset;
+        }
+        return offset > 0 ? (ssize_t) offset : -1;
+    }
+    return (ssize_t) (offset + (size_t) sent);
+}
 
