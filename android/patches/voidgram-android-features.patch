+package org.telegram.messenger.voidgram;
+
+import android.content.SharedPreferences;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * VoidGram Ghost Mode, as on iOS: per account, hide read receipts, the online status and the
+ * typing / recording / upload indicators. Every option is off by default. Chats can be excluded
+ * (the ghost button in a chat header toggles that chat only). Secret chats, voice/video
+ * consumption and story views keep Telegram's behaviour. Not absolute invisibility: requests that
+ * already went out cannot be taken back, and a later read can acknowledge earlier messages.
+ */
+public final class VoidGramGhost {
+    private VoidGramGhost() {
+    }
+
+    private static String key(int account, String name) {
+        return "ghost_" + account + "_" + name;
+    }
+
+    private static SharedPreferences prefs() {
+        return VoidGram.prefs();
+    }
+
+    public static boolean isEnabled(int account) {
+        return !VoidGramDecoy.isActive() && prefs().getBoolean(key(account, "enabled"), false);
+    }
+
+    public static void setEnabled(int account, boolean value) {
+        prefs().edit().putBoolean(key(account, "enabled"), value).apply();
+    }
+
+    public static boolean option(int account, String name) {
+        return prefs().getBoolean(key(account, name), true);
+    }
+
+    public static void setOption(int account, String name, boolean value) {
+        prefs().edit().putBoolean(key(account, name), value).apply();
+    }
+
+    public static final String READ = "read";
+    public static final String ONLINE = "online";
+    public static final String TYPING = "typing";
+    public static final String[] OPTIONS = {READ, ONLINE, TYPING};
+
+    public static String optionTitle(String option) {
+        switch (option) {
+            case READ: return VoidGram.t("Не отправлять «прочитано»", "Don't send read receipts");
+            case ONLINE: return VoidGram.t("Скрывать «в сети»", "Hide online status");
+            default: return VoidGram.t("Скрывать «печатает» и загрузку", "Hide typing and upload status");
+        }
+    }
+
+    // MARK: exceptions
+
+    public static Set<String> exceptions(int account) {
+        return new HashSet<>(prefs().getStringSet(key(account, "exceptions"), new HashSet<>()));
+    }
+
+    public static boolean isException(int account, long dialogId) {
+        return exceptions(account).contains(String.valueOf(dialogId));
+    }
+
+    /** The ghost button in a chat header: the chat is excluded from (or returned to) Ghost Mode. */
+    public static void toggleException(int account, long dialogId) {
+        Set<String> set = exceptions(account);
+        String value = String.valueOf(dialogId);
+        if (!set.remove(value)) {
+            set.add(value);
+        }
+        prefs().edit().putStringSet(key(account, "exceptions"), set).apply();
+    }
+
+    private static boolean active(int account, long dialogId, String option) {
+        return isEnabled(account) && option(account, option) && (dialogId == 0 || !isException(account, dialogId));
+    }
+
+    public static boolean hideRead(int account, long dialogId) {
+        return active(account, dialogId, READ);
+    }
+
+    public static boolean hideOnline(int account) {
+        return active(account, 0, ONLINE);
+    }
+
+    public static boolean hideTyping(int account, long dialogId) {
+        return active(account, dialogId, TYPING);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramGroupMentions.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramGroupMentions.java
new file mode 100644
index 0000000..be165b6
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramGroupMentions.java
@@ -0,0 +1,232 @@
+package org.telegram.messenger.voidgram;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.SendMessagesHelper;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Group mentions, as on iOS: a command such as "@team" in an outgoing message becomes
+ * "@alice @bob @carol". Up to 5 groups of up to 7 usernames; inserted mentions are never read as
+ * commands again, and each command expands once a minute per chat.
+ */
+public final class VoidGramGroupMentions {
+    private VoidGramGroupMentions() {
+    }
+
+    public static final int MAX_GROUPS = 5;
+    public static final int MAX_USERNAMES = 7;
+
+    public static final class Group {
+        public final String command;
+        public final ArrayList<String> usernames;
+
+        public Group(String command, ArrayList<String> usernames) {
+            this.command = command;
+            this.usernames = usernames;
+        }
+    }
+
+    private static final HashMap<String, Long> cooldown = new HashMap<>();
+
+    public static boolean enabledPrivate() {
+        return VoidGram.prefs().getBoolean("mentions_private", true);
+    }
+
+    public static void setEnabledPrivate(boolean value) {
+        VoidGram.prefs().edit().putBoolean("mentions_private", value).apply();
+    }
+
+    public static boolean enabledGroups() {
+        return VoidGram.prefs().getBoolean("mentions_groups", true);
+    }
+
+    public static void setEnabledGroups(boolean value) {
+        VoidGram.prefs().edit().putBoolean("mentions_groups", value).apply();
+    }
+
+    public static boolean caseSensitive() {
+        return VoidGram.prefs().getBoolean("mentions_case", false);
+    }
+
+    public static void setCaseSensitive(boolean value) {
+        VoidGram.prefs().edit().putBoolean("mentions_case", value).apply();
+    }
+
+    /** Usernames from free text: letters, digits and _, up to 32 characters, without repeats. */
+    public static ArrayList<String> parseUsernames(String input) {
+        ArrayList<String> result = new ArrayList<>();
+        LinkedHashSet<String> seen = new LinkedHashSet<>();
+        if (input == null) {
+            return result;
+        }
+        for (String token : input.split("[\\s,;]+")) {
+            String value = token.replaceAll("^[@.,;]+|[@.,;]+$", "");
+            if (value.isEmpty() || value.length() > 32 || !value.matches("[A-Za-z0-9_]+")) {
+                continue;
+            }
+            if (seen.add(value.toLowerCase(Locale.ROOT)) && result.size() < MAX_USERNAMES) {
+                result.add(value);
+            }
+        }
+        return result;
+    }
+
+    public static ArrayList<Group> list() {
+        ArrayList<Group> result = new ArrayList<>();
+        try {
+            JSONArray array = new JSONArray(VoidGram.prefs().getString("mention_groups", "[]"));
+            for (int i = 0; i < array.length() && i < MAX_GROUPS; i++) {
+                JSONObject item = array.getJSONObject(i);
+                ArrayList<String> names = new ArrayList<>();
+                JSONArray users = item.getJSONArray("usernames");
+                for (int j = 0; j < users.length(); j++) {
+                    names.add(users.getString(j));
+                }
+                result.add(new Group(item.getString("command"), names));
+            }
+        } catch (Throwable ignore) {
+        }
+        return result;
+    }
+
+    private static void save(ArrayList<Group> groups) {
+        JSONArray array = new JSONArray();
+        try {
+            for (Group group : groups) {
+                JSONArray users = new JSONArray();
+                for (String name : group.usernames) {
+                    users.put(name);
+                }
+                array.put(new JSONObject().put("command", group.command).put("usernames", users));
+            }
+        } catch (Throwable ignore) {
+        }
+        VoidGram.prefs().edit().putString("mention_groups", array.toString()).apply();
+    }
+
+    /** Adds or replaces a group; false when the command or the list is not valid. */
+    public static boolean put(String oldCommand, String command, String usernames) {
+        command = command == null ? "" : command.trim();
+        ArrayList<String> names = parseUsernames(usernames);
+        if (command.isEmpty() || command.length() > 64 || command.matches(".*\\s.*") || names.isEmpty()) {
+            return false;
+        }
+        ArrayList<Group> groups = list();
+        for (int i = groups.size() - 1; i >= 0; i--) {
+            String existing = groups.get(i).command;
+            if (existing.equalsIgnoreCase(command) || oldCommand != null && existing.equals(oldCommand)) {
+                groups.remove(i);
+            }
+        }
+        if (groups.size() >= MAX_GROUPS) {
+            return false;
+        }
+        groups.add(new Group(command, names));
+        save(groups);
+        return true;
+    }
+
+    public static void remove(String command) {
+        ArrayList<Group> groups = list();
+        for (int i = groups.size() - 1; i >= 0; i--) {
+            if (groups.get(i).command.equals(command)) {
+                groups.remove(i);
+            }
+        }
+        save(groups);
+    }
+
+    private static boolean isWord(char c) {
+        return Character.isLetterOrDigit(c) || c == '_';
+    }
+
+    /** The text with every command replaced; the same text when nothing matched. */
+    public static String expanded(String text, long dialogId) {
+        ArrayList<Group> groups = list();
+        if (text == null || groups.isEmpty() || text.length() > 4096) {
+            return text;
+        }
+        groups.sort((a, b) -> b.command.length() - a.command.length());
+        StringBuilder pattern = new StringBuilder();
+        for (Group group : groups) {
+            if (pattern.length() > 0) {
+                pattern.append('|');
+            }
+            char first = group.command.charAt(0);
+            char last = group.command.charAt(group.command.length() - 1);
+            pattern.append(isWord(first) ? "(?<![\\w@])" : "(?<![\\w" + Pattern.quote(String.valueOf(first)) + "])");
+            pattern.append(Pattern.quote(group.command));
+            pattern.append(isWord(last) ? "(?!\\w)" : "(?![\\w" + Pattern.quote(String.valueOf(last)) + "])");
+        }
+        Pattern regex;
+        try {
+            regex = Pattern.compile(pattern.toString(), caseSensitive() ? 0 : Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE);
+        } catch (Throwable e) {
+            return text;
+        }
+        Matcher matcher = regex.matcher(text);
+        StringBuilder output = new StringBuilder();
+        int cursor = 0;
+        boolean changed = false;
+        long now = System.currentTimeMillis();
+        while (matcher.find()) {
+            String token = matcher.group();
+            Group match = null;
+            for (Group group : groups) {
+                if (caseSensitive() ? group.command.equals(token) : group.command.equalsIgnoreCase(token)) {
+                    match = group;
+                    break;
+                }
+            }
+            if (match == null) {
+                continue;
+            }
+            String key = dialogId + ":" + match.command.toLowerCase(Locale.ROOT);
+            Long previous = cooldown.get(key);
+            if (previous != null && now - previous < 60_000) {
+                continue;
+            }
+            cooldown.put(key, now);
+            output.append(text, cursor, matcher.start());
+            for (int i = 0; i < match.usernames.size(); i++) {
+                if (i > 0) {
+                    output.append(' ');
+                }
+                output.append('@').append(match.usernames.get(i));
+            }
+            cursor = matcher.end();
+            changed = true;
+        }
+        if (!changed) {
+            return text;
+        }
+        output.append(text.substring(cursor));
+        return output.length() <= 4096 ? output.toString() : text;
+    }
+
+    /** SendMessagesHelper: plain text only; formatting is dropped when the text changes. */
+    public static void applyToOutgoing(SendMessagesHelper.SendMessageParams params) {
+        if (params == null || params.message == null || params.document != null || params.photo != null || VoidGramDecoy.isActive()) {
+            return;
+        }
+        boolean user = params.peer > 0 && !DialogObject.isEncryptedDialog(params.peer);
+        if (user ? !enabledPrivate() : !enabledGroups()) {
+            return;
+        }
+        String result = expanded(params.message, params.peer);
+        if (result != null && !result.equals(params.message)) {
+            params.message = result;
+            if (params.entities != null) {
+                params.entities.clear();
+            }
+        }
+    }
+}
