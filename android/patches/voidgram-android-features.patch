@@ -0,0 +1,157 @@
+package org.telegram.messenger.voidgram;
+
+import androidx.biometric.BiometricManager;
+import androidx.biometric.BiometricPrompt;
+import androidx.core.content.ContextCompat;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.LaunchActivity;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+
+/**
+ * Hidden chats, as on iOS: chats taken out of the chat list (and the share and forward lists);
+ * the list of them opens only after fingerprint, face or the device screen lock.
+ */
+public final class VoidGramHiddenChats {
+    private VoidGramHiddenChats() {
+    }
+
+    private static HashSet<Long> cache;
+    private static int cacheAccount = -1;
+    private static boolean unlocked;
+
+    private static String key(int account) {
+        return "hidden_chats_" + account;
+    }
+
+    private static HashSet<Long> load(int account) {
+        if (cache != null && cacheAccount == account) {
+            return cache;
+        }
+        HashSet<Long> result = new HashSet<>();
+        String value = VoidGram.prefs().getString(key(account), "");
+        for (String part : value.split(",")) {
+            try {
+                if (!part.isEmpty()) {
+                    result.add(Long.parseLong(part));
+                }
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        cache = result;
+        cacheAccount = account;
+        return result;
+    }
+
+    private static void save(int account, HashSet<Long> ids) {
+        StringBuilder builder = new StringBuilder();
+        for (Long id : ids) {
+            if (builder.length() > 0) {
+                builder.append(',');
+            }
+            builder.append(id);
+        }
+        VoidGram.prefs().edit().putString(key(account), builder.toString()).apply();
+        cache = ids;
+        cacheAccount = account;
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload);
+    }
+
+    public static ArrayList<Long> list(int account) {
+        return new ArrayList<>(load(account));
+    }
+
+    public static boolean isHidden(int account, long dialogId) {
+        return load(account).contains(dialogId);
+    }
+
+    public static void setHidden(int account, long dialogId, boolean hidden) {
+        HashSet<Long> ids = new HashSet<>(load(account));
+        if (hidden) {
+            ids.add(dialogId);
+        } else {
+            ids.remove(dialogId);
+        }
+        save(account, ids);
+    }
+
+    /** DialogsActivity: the list without hidden chats (the same list when nothing is hidden). */
+    public static ArrayList<TLRPC.Dialog> filter(int account, ArrayList<TLRPC.Dialog> dialogs) {
+        if (dialogs == null || dialogs.isEmpty()) {
+            return dialogs;
+        }
+        HashSet<Long> hidden = load(account);
+        if (hidden.isEmpty()) {
+            return dialogs;
+        }
+        boolean any = false;
+        for (int i = 0, n = dialogs.size(); i < n; i++) {
+            TLRPC.Dialog dialog = dialogs.get(i);
+            if (dialog != null && hidden.contains(dialog.id)) {
+                any = true;
+                break;
+            }
+        }
+        if (!any) {
+            return dialogs;
+        }
+        ArrayList<TLRPC.Dialog> result = new ArrayList<>(dialogs.size());
+        for (int i = 0, n = dialogs.size(); i < n; i++) {
+            TLRPC.Dialog dialog = dialogs.get(i);
+            if (dialog == null || !hidden.contains(dialog.id)) {
+                result.add(dialog);
+            }
+        }
+        return result;
+    }
+
+    /** The session lock: hidden chats stay locked again once the app goes to the background. */
+    public static void lock() {
+        unlocked = false;
+    }
+
+    /** Fingerprint, face or the screen lock; without any of them the list opens at once. */
+    public static void authenticate(Runnable onSuccess) {
+        if (unlocked) {
+            onSuccess.run();
+            return;
+        }
+        authenticateFresh(() -> {
+            unlocked = true;
+            onSuccess.run();
+        });
+    }
+
+    /** Always asks, whatever was unlocked before. */
+    public static void authenticateFresh(Runnable onSuccess) {
+        LaunchActivity activity = LaunchActivity.instance;
+        if (activity == null) {
+            return;
+        }
+        int authenticators = BiometricManager.Authenticators.BIOMETRIC_WEAK | BiometricManager.Authenticators.DEVICE_CREDENTIAL;
+        if (BiometricManager.from(activity).canAuthenticate(authenticators) != BiometricManager.BIOMETRIC_SUCCESS) {
+            onSuccess.run();
+            return;
+        }
+        try {
+            BiometricPrompt prompt = new BiometricPrompt(activity, ContextCompat.getMainExecutor(activity), new BiometricPrompt.AuthenticationCallback() {
+                @Override
+                public void onAuthenticationSucceeded(BiometricPrompt.AuthenticationResult result) {
+                    AndroidUtilities.runOnUIThread(onSuccess);
+                }
+            });
+            BiometricPrompt.PromptInfo info = new BiometricPrompt.PromptInfo.Builder()
+                    .setTitle(VoidGram.t("Скрытые чаты", "Hidden chats"))
+                    .setSubtitle(VoidGram.t("Подтвердите, что это вы", "Confirm it's you"))
+                    .setAllowedAuthenticators(authenticators)
+                    .build();
+            prompt.authenticate(info);
+        } catch (Throwable e) {
+            onSuccess.run();
+        }
+    }
+}
