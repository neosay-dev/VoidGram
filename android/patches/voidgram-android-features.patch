+                    while (in != null && (count = in.read(buffer)) > 0) {
+                        out.write(buffer, 0, count);
+                    }
+                }
+                boolean ok = org.telegram.messenger.voidgram.VoidGramBackup.restore(file, password);
+                file.delete();
+                if (ok) {
+                    org.telegram.ui.Components.BulletinFactory.of(this).createSimpleBulletin(R.raw.done, VoidGram.t("Настройки восстановлены", "Settings restored")).show();
