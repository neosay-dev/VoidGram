@@ -0,0 +1,130 @@
+package org.telegram.messenger.voidgram;
+
+import android.text.TextUtils;
+
+import org.telegram.messenger.MessageObject;
+
+import java.util.ArrayList;
+import java.util.regex.Pattern;
+
+/**
+ * VoidGram local regex filtering, as on iOS: incoming messages whose text matches one of the
+ * patterns are not shown. Nothing is deleted or reported; turning the filter off shows them again.
+ */
+public final class VoidGramFilters {
+    private static ArrayList<Pattern> compiled;
+
+    private VoidGramFilters() {
+    }
+
+    public static boolean isEnabled() {
+        return !VoidGramDecoy.isActive() && VoidGram.prefs().getBoolean("filters_enabled", false);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("filters_enabled", value).apply();
+    }
+
+    public static boolean ownMessages() {
+        return VoidGram.prefs().getBoolean("filters_own", false);
+    }
+
+    public static void setOwnMessages(boolean value) {
+        VoidGram.prefs().edit().putBoolean("filters_own", value).apply();
+    }
+
+    public static String source() {
+        return VoidGram.prefs().getString("filters_patterns", "");
+    }
+
+    /** One pattern per line. Returns the first invalid line, or null when all compile. */
+    public static String setSource(String source) {
+        for (String line : source.split("\n")) {
+            String pattern = line.trim();
+            if (pattern.isEmpty()) {
+                continue;
+            }
+            try {
+                Pattern.compile(pattern, Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE);
+            } catch (Throwable e) {
+                return pattern;
+            }
+        }
+        VoidGram.prefs().edit().putString("filters_patterns", source).apply();
+        compiled = null;
+        return null;
+    }
+
+    private static synchronized ArrayList<Pattern> patterns() {
+        if (compiled == null) {
+            ArrayList<Pattern> list = new ArrayList<>();
+            for (String line : source().split("\n")) {
+                String pattern = line.trim();
+                if (pattern.isEmpty()) {
+                    continue;
+                }
+                try {
+                    list.add(Pattern.compile(pattern, Pattern.CASE_INSENSITIVE | Pattern.UNICODE_CASE));
+                } catch (Throwable ignore) {
+                }
+            }
+            compiled = list;
+        }
+        return compiled;
+    }
+
+    public static int count() {
+        return patterns().size();
+    }
+
+    public static boolean isFiltered(MessageObject messageObject) {
+        if (!isEnabled() || messageObject == null || messageObject.messageOwner == null) {
+            return false;
+        }
+        if (messageObject.isOut() && !ownMessages()) {
+            return false;
+        }
+        String text = messageObject.messageOwner.message;
+        if (TextUtils.isEmpty(text)) {
+            return false;
+        }
+        for (Pattern pattern : patterns()) {
+            // Long texts are matched in part: a runaway pattern must not freeze the chat.
+            if (pattern.matcher(text.length() > 8192 ? text.substring(0, 8192) : text).find()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The messages to show. The list never becomes empty, so loading further pages keeps working. */
+    public static ArrayList<MessageObject> filter(ArrayList<MessageObject> messages) {
+        if (messages == null || messages.isEmpty() || !isEnabled() || patterns().isEmpty()) {
+            return messages;
+        }
+        ArrayList<MessageObject> result = new ArrayList<>(messages.size());
+        for (MessageObject message : messages) {
+            if (!isFiltered(message)) {
+                result.add(message);
+            }
+        }
+        if (result.isEmpty()) {
+            result.add(messages.get(messages.size() - 1));
+        }
+        return result.size() == messages.size() ? messages : result;
+    }
+
+    /** New messages to show (may be empty: nothing new appears). */
+    public static ArrayList<MessageObject> filterNew(ArrayList<MessageObject> messages) {
+        if (messages == null || messages.isEmpty() || !isEnabled() || patterns().isEmpty()) {
+            return messages;
+        }
+        ArrayList<MessageObject> result = new ArrayList<>(messages.size());
+        for (MessageObject message : messages) {
+            if (!isFiltered(message)) {
+                result.add(message);
+            }
+        }
+        return result.size() == messages.size() ? messages : result;
+    }
+}
