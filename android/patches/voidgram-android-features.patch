+        return value.isEmpty() ? null : value;
+    }
+
+    public static void setBadge(long dialogId, String value) {
+        String text = value == null ? "" : value.trim();
+        if (text.length() > 16) {
+            text = text.substring(0, 16);
+        }
+        java.util.Set<String> ids = new java.util.HashSet<>(VoidGram.prefs().getStringSet("custom_badge_ids", new java.util.HashSet<>()));
+        if (text.isEmpty()) {
+            ids.remove(String.valueOf(dialogId));
+            VoidGram.prefs().edit().remove("custom_badge_" + dialogId).putStringSet("custom_badge_ids", ids).apply();
+        } else {
+            ids.add(String.valueOf(dialogId));
+            VoidGram.prefs().edit().putString("custom_badge_" + dialogId, text).putStringSet("custom_badge_ids", ids).apply();
+        }
+        badgeCache.clear();
+    }
+
+    public static java.util.ArrayList<Long> badgedDialogs() {
+        java.util.ArrayList<Long> result = new java.util.ArrayList<>();
+        for (String id : VoidGram.prefs().getStringSet("custom_badge_ids", new java.util.HashSet<>())) {
+            try {
+                result.add(Long.parseLong(id));
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        return result;
+    }
+
+    private static final HashMap<Long, String> badgeCache = new HashMap<>();
+
+    /** The name with its badge as a small accent label, or the same name without a badge. */
+    public static CharSequence decorate(CharSequence name, String badge) {
+        if (name == null || badge == null || badge.isEmpty() || VoidGramDecoy.isActive()) {
+            return name;
+        }
+        android.text.SpannableStringBuilder builder = new android.text.SpannableStringBuilder(name);
+        builder.append("  ");
+        int start = builder.length();
+        builder.append(badge);
+        builder.setSpan(new android.text.style.ForegroundColorSpan(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4)), start, builder.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        builder.setSpan(new android.text.style.RelativeSizeSpan(0.78f), start, builder.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        builder.setSpan(new android.text.style.StyleSpan(android.graphics.Typeface.BOLD), start, builder.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return builder;
+    }
+
+    public static CharSequence decorateDialog(long dialogId, CharSequence name) {
+        if (dialogId == 0) {
+            return name;
+        }
+        String badge = badgeCache.get(dialogId);
+        if (badge == null) {
+            badge = badge(dialogId);
+            badgeCache.put(dialogId, badge == null ? "" : badge);
+        }
+        return decorate(name, badge);
+    }
+
+    /** Theme wallpaper: a solid colour or a gradient when the chat background is customized. */
+    public static Drawable wallpaper() {
+        Integer[] c = colors();
+        if (c[5] == null) {
+            return null;
+        }
+        if (wallpaper != null && wallpaperRevision == revision) {
+            return wallpaper;
+        }
+        wallpaper = c[6] != null
+                ? new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM, new int[]{c[5], c[6]})
+                : new ColorDrawable(c[5]);
+        wallpaperRevision = revision;
+        return wallpaper;
+    }
+}
