+        items.add(UItem.asCheck(ID_BLACK_HOLE, VoidGram.t("«Чёрная дыра» при очистке чата", "\"Black hole\" when clearing a chat")).setChecked(VoidGramBlackHole.isEnabled()));
+        items.add(UItem.asShadow(VoidGram.t("Упоминание в начале сообщения вставляется как «@ник, ». Вкладка «Контакты» скрывается после перезапуска; «Звонки» скрываются в настройках Telegram.", "A mention at the start of a message is inserted as \"@name, \". The Contacts tab hides after a restart; Calls hides in Telegram's own settings.")));
+        items.add(UItem.asHeader(VoidGram.t("Эффекты", "Effects")));
+        String effect = VoidGramOverlayEffects.effect();
+        items.add(UItem.asButton(ID_EFFECT, VoidGram.t("Эффект поверх Telegram", "Effect over Telegram"), VoidGramOverlayEffects.title(effect)));
+        if ("snow".equals(effect)) {
+            items.add(UItem.asButton(ID_SNOW, VoidGram.t("Вид снега", "Snow look"), VoidGramOverlayEffects.title(VoidGramOverlayEffects.snowShape())));
+        }
+        if (!"none".equals(effect)) {
+            items.add(UItem.asButton(ID_AMOUNT, VoidGram.t("Количество", "Amount"), VoidGramOverlayEffects.amount() + "×"));
+            items.add(UItem.asButton(ID_SPEED, VoidGram.t("Скорость", "Speed"), VoidGramOverlayEffects.speed() + "×"));
+        }
+        items.add(UItem.asShadow(VoidGram.t("Снег, листья, дождь, звёзды или конфетти поверх приложения; нажатиям не мешают. Если анимации в системе выключены, эффекты не показываются.", "Snow, leaves, rain, stars or confetti over the app; they never block taps. With system animations off, effects are hidden.")));
+        items.add(UItem.asHeader(VoidGram.t("Приватность", "Privacy")));
+        check(items, 5, VoidGram.t("Скрыть мой номер в Настройках", "Hide my number in Settings"));
+        check(items, 6, VoidGram.t("Открывать ссылки без вопроса", "Open links without asking"));
+        check(items, 7, VoidGram.t("Чистить ссылки от слежки", "Remove tracking from links"));
+        items.add(UItem.asCheck(ID_NAME_GUARD, VoidGram.t("Предупреждать о подозрительных именах", "Warn about suspicious names")).setChecked(org.telegram.messenger.voidgram.VoidGramExtras.nameGuardEnabled()));
+        items.add(UItem.asCheck(ID_STREAMER, VoidGram.t("Режим стримера", "Streamer mode")).setChecked(org.telegram.messenger.voidgram.VoidGramExtras.streamerMode()));
+        items.add(UItem.asShadow(VoidGram.t("Режим стримера убирает VoidGram из скриншотов, записи и трансляции экрана — вы видите всё как обычно. Предупреждение показывается один раз, если незнакомец смешивает алфавиты в имени или выдаёт себя за поддержку.", "Streamer mode keeps VoidGram out of screenshots, recordings and screen sharing; you still see everything. The warning shows once when a stranger mixes alphabets in the name or poses as support.")));
