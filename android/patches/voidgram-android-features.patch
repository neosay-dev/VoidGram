+    public static void ask(BaseFragment fragment, String title, String instructions, String prompt) {
+        String key = aiKey();
+        if (key.isEmpty()) {
+            missingKey(fragment, title);
+            return;
+        }
+        String endpoint = aiEndpoint();
+        if (!endpoint.toLowerCase(Locale.ROOT).startsWith("https://")) {
+            present(fragment, title, VoidGram.t("Адрес ИИ должен начинаться с https://", "The AI address must start with https://"));
+            return;
+        }
+        String body;
+        try {
+            JSONObject json = new JSONObject();
+            json.put("model", aiModel());
+            json.put("max_tokens", 300);
+            JSONArray messages = new JSONArray();
+            messages.put(new JSONObject().put("role", "system").put("content", instructions));
+            messages.put(new JSONObject().put("role", "user").put("content", prompt.length() > 12000 ? prompt.substring(0, 12000) : prompt));
+            json.put("messages", messages);
+            body = json.toString();
+        } catch (Throwable e) {
+            return;
+        }
+        HashMap<String, String> headers = new HashMap<>();
+        headers.put("Content-Type", "application/json");
+        headers.put("Authorization", "Bearer " + key);
+        AlertDialog progress = fragment.getParentActivity() != null ? new AlertDialog(fragment.getParentActivity(), AlertDialog.ALERT_TYPE_SPINNER) : null;
+        if (progress != null) {
+            progress.show();
+        }
+        http("POST", endpoint, headers, body, (status, response) -> {
+            if (progress != null) {
+                try {
+                    progress.dismiss();
+                } catch (Throwable ignore) {
+                }
+            }
+            String result = null;
+            if (status == 200 && response != null) {
+                try {
+                    result = new JSONObject(response).getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content").trim();
+                } catch (Throwable ignore) {
+                }
+            }
+            present(fragment, title, result != null ? result : status == 401 ? VoidGram.t("Неверный ключ API.", "Invalid API key.") : VoidGram.t("ИИ не ответил (код ", "The AI did not answer (code ") + status + ").");
+        });
+    }
