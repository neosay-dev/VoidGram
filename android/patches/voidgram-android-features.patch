+/**
+ * VoidGram decoy mode (second space), as on iOS. A double tap on the launch splash opens the
+ * decoy: a second, real account when one is chosen, otherwise a built-in stand-in Telegram. While
+ * the decoy is active every VoidGram feature is off and VoidGram is absent from the settings. The
+ * next cold start asks for a code: the real code returns to the real account; the fake code shows
+ * "VoidGram no longer works" and wipes the app's data.
+ */
+public final class VoidGramDecoy {
+    private static boolean splashShownThisProcess;
+    private static Dialog standIn;
+
+    private VoidGramDecoy() {
+    }
+
+    // The decoy state lives apart from the other VoidGram preferences, so a wipe can tell it apart.
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("voidgram_decoy", Context.MODE_PRIVATE);
+    }
+
+    public static boolean isEnabled() {
+        return prefs().getBoolean("enabled", false);
+    }
+
+    public static void setEnabled(boolean value) {
+        prefs().edit().putBoolean("enabled", value).apply();
+    }
+
+    public static boolean hasCodes() {
+        return !prefs().getString("real", "").isEmpty() && !prefs().getString("fake", "").isEmpty();
+    }
+
+    public static boolean isConfigured() {
+        return isEnabled() && hasCodes();
+    }
+
+    /** The decoy is showing now: VoidGram features are off. */
+    public static boolean isActive() {
+        return prefs().getBoolean("active", false);
+    }
+
+    private static boolean codeRequired() {
+        return prefs().getBoolean("code_required", false);
+    }
+
+    /** The account shown as the decoy, or -1 for the built-in stand-in. */
+    public static int decoyAccount() {
+        return prefs().getInt("account", -1);
+    }
+
+    public static void setDecoyAccount(int account) {
+        prefs().edit().putInt("account", account).apply();
+    }
+
+    private static String hash(String code) {
+        String salt = prefs().getString("salt", "");
+        if (salt.isEmpty()) {
+            salt = UUID.randomUUID().toString();
+            prefs().edit().putString("salt", salt).apply();
+        }
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            return Utilities.bytesToHex(digest.digest((salt + ":" + code).getBytes("UTF-8")));
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    /** Both codes at once; they must differ and be at least 4 characters. */
+    public static boolean setCodes(String real, String fake) {
+        if (real == null || fake == null || real.length() < 4 || fake.length() < 4 || real.equals(fake)) {
+            return false;
+        }
+        prefs().edit().putString("real", hash(real)).putString("fake", hash(fake)).apply();
+        return true;
+    }
+
+    // MARK: launch
+
+    /** Called when the main activity is ready: splash (double tap = decoy) or the code lock. */
+    public static void onLaunch(LaunchActivity activity) {
+        if (activity == null) {
+            return;
+        }
+        if (prefs().getBoolean("broken", false)) {
+            showBroken(activity);
+            return;
+        }
+        if (codeRequired() && isConfigured()) {
+            showLock(activity);
+            return;
+        }
+        if (isActive() && decoyAccount() < 0) {
+            showStandIn(activity);
+            return;
+        }
+        if (isConfigured() && !isActive() && !splashShownThisProcess) {
+            splashShownThisProcess = true;
+            showSplash(activity);
+        }
+    }
+
+    private static Dialog fullscreen(Activity activity, View content, int color, boolean cancelable) {
+        Dialog dialog = new Dialog(activity, android.R.style.Theme_DeviceDefault_NoActionBar);
+        dialog.setCancelable(cancelable);
+        dialog.setContentView(content);
+        Window window = dialog.getWindow();
+        if (window != null) {
+            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+            window.setBackgroundDrawable(new ColorDrawable(color));
+            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
+            window.setStatusBarColor(color);
+            window.setNavigationBarColor(color);
+        }
+        return dialog;
+    }
+
+    private static void showSplash(LaunchActivity activity) {
+        FrameLayout root = new FrameLayout(activity);
+        LinearLayout column = new LinearLayout(activity);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER_HORIZONTAL);
+        ImageView icon = new ImageView(activity);
+        icon.setImageResource(R.mipmap.ic_launcher);
+        column.addView(icon, new LinearLayout.LayoutParams(AndroidUtilities.dp(116), AndroidUtilities.dp(116)));
