+        title.setText("VoidGram");
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22);
+        title.setTypeface(AndroidUtilities.bold());
+        LinearLayout.LayoutParams titleParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        titleParams.topMargin = AndroidUtilities.dp(16);
+        column.addView(title, titleParams);
+        root.addView(column, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+        final Dialog dialog = fullscreen(activity, root, 0xFF111114, false);
+        final long[] lastTap = {0};
+        root.setOnClickListener(v -> {
+            long now = System.currentTimeMillis();
+            if (now - lastTap[0] < 350) {
+                try {
+                    dialog.dismiss();
+                } catch (Throwable ignore) {
+                }
+                enter(activity);
+            }
+            lastTap[0] = now;
+        });
+        icon.setAlpha(0f);
+        icon.setScaleX(0.55f);
+        icon.setScaleY(0.55f);
+        icon.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(450).start();
+        try {
+            dialog.show();
+        } catch (Throwable ignore) {
+            return;
+        }
+        AndroidUtilities.runOnUIThread(() -> {
+            try {
+                if (dialog.isShowing()) {
+                    dialog.dismiss();
+                }
+            } catch (Throwable ignore) {
+            }
+        }, 1250);
+    }
+
+    public static void enter(LaunchActivity activity) {
+        if (!isConfigured()) {
+            return;
+        }
+        prefs().edit().putBoolean("active", true).putBoolean("code_required", true).putInt("main", UserConfig.selectedAccount).apply();
+        int account = decoyAccount();
+        if (account >= 0 && account != UserConfig.selectedAccount && UserConfig.getInstance(account).isClientActivated()) {
+            activity.switchToAccount(account, true);
+        } else {
+            showStandIn(activity);
+        }
+    }
+
+    private static void leave(LaunchActivity activity) {
+        boolean standInShown = standIn != null;
+        prefs().edit().putBoolean("active", false).putBoolean("code_required", false).apply();
+        if (standInShown) {
+            try {
+                standIn.dismiss();
+            } catch (Throwable ignore) {
+            }
+            standIn = null;
+        }
+        int main = prefs().getInt("main", -1);
+        if (main >= 0 && main != UserConfig.selectedAccount && UserConfig.getInstance(main).isClientActivated()) {
+            activity.switchToAccount(main, true);
+        }
+    }
+
+    private static void showStandIn(LaunchActivity activity) {
+        if (standIn != null && standIn.isShowing()) {
+            return;
+        }
+        standIn = VoidGramStandIn.create(activity);
+        try {
+            standIn.show();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    // MARK: code lock
+
+    private static void showLock(LaunchActivity activity) {
+        LinearLayout root = new LinearLayout(activity);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER_HORIZONTAL);
+        root.setPadding(AndroidUtilities.dp(32), AndroidUtilities.dp(120), AndroidUtilities.dp(32), 0);
+        TextView title = new TextView(activity);
+        title.setText(VoidGram.t("Введите код-пароль", "Enter passcode"));
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20);
+        title.setGravity(Gravity.CENTER);
+        root.addView(title);
+        final EditText field = new EditText(activity);
+        field.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        field.setTextColor(Color.WHITE);
+        field.setGravity(Gravity.CENTER);
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 24);
+        LinearLayout.LayoutParams fieldParams = new LinearLayout.LayoutParams(AndroidUtilities.dp(200), ViewGroup.LayoutParams.WRAP_CONTENT);
+        fieldParams.topMargin = AndroidUtilities.dp(24);
+        root.addView(field, fieldParams);
+        TextView done = new TextView(activity);
+        done.setText(VoidGram.t("Готово", "Done"));
+        done.setTextColor(Color.WHITE);
+        done.setTypeface(AndroidUtilities.bold());
+        done.setGravity(Gravity.CENTER);
+        GradientDrawable background = new GradientDrawable();
+        background.setColor(0x33FFFFFF);
+        background.setCornerRadius(AndroidUtilities.dp(12));
+        done.setBackground(background);
+        LinearLayout.LayoutParams doneParams = new LinearLayout.LayoutParams(AndroidUtilities.dp(200), AndroidUtilities.dp(46));
+        doneParams.topMargin = AndroidUtilities.dp(24);
+        root.addView(done, doneParams);
+        final Dialog dialog = fullscreen(activity, root, 0xFF000000, false);
+        done.setOnClickListener(v -> {
+            String code = field.getText().toString();
+            if (code.isEmpty()) {
+                return;
+            }
+            String value = hash(code);
+            if (value.equals(prefs().getString("real", null))) {
+                dialog.dismiss();
+                leave(activity);
+            } else if (value.equals(prefs().getString("fake", null))) {
+                dialog.dismiss();
+                prefs().edit().putBoolean("broken", true).apply();
+                showBroken(activity);
+                wipe(activity);
+            } else {
+                field.setText("");
+                field.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP);
+                field.animate().translationX(AndroidUtilities.dp(12)).setDuration(60).withEndAction(() -> field.animate().translationX(0).setDuration(120).start()).start();
+            }
+        });
+        try {
+            dialog.show();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static void showBroken(Activity activity) {
+        LinearLayout root = new LinearLayout(activity);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER);
+        root.setPadding(AndroidUtilities.dp(32), 0, AndroidUtilities.dp(32), 0);
+        TextView title = new TextView(activity);
+        title.setText("Извините, VoidGram больше не работает");
+        title.setTextColor(Color.WHITE);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 21);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setGravity(Gravity.CENTER);
+        root.addView(title);
+        TextView text = new TextView(activity);
+        text.setText("Данные приложения повреждены. Чтобы исправить, полностью удалите VoidGram и установите его заново.");
+        text.setTextColor(0x99FFFFFF);
+        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        text.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        params.topMargin = AndroidUtilities.dp(14);
+        root.addView(text, params);
+        Dialog dialog = fullscreen(activity, root, 0xFF000000, false);
+        try {
+            dialog.show();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    /** Deletes every account's local data (the system clears the app's storage and closes it). */
+    private static void wipe(Activity activity) {
+        AndroidUtilities.runOnUIThread(() -> {
+            try {
+                ActivityManager manager = (ActivityManager) activity.getSystemService(Context.ACTIVITY_SERVICE);
+                if (manager != null) {
+                    manager.clearApplicationUserData();
+                }
+            } catch (Throwable ignore) {
+            }
+        }, 1500);
+    }
+}
