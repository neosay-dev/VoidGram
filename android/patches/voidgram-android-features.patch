@@ -0,0 +1,183 @@
+package org.telegram.messenger.voidgram;
+
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * Local Premium and display options, as on iOS (VoidGram → Tools).
+ * Local Premium treats this account as Premium in this app only: the server and other apps are not
+ * affected. Custom emoji that the server would strip from a non-Premium sender go out as
+ * tg://emoji?id= links, which VoidGram and AyuGram show again as custom emoji.
+ */
+public final class VoidGramPremium {
+    public static final String EMOJI_URL_PREFIX = "tg://emoji?id=";
+
+    private VoidGramPremium() {
+    }
+
+    public static boolean isLocal() {
+        return VoidGram.prefs().getBoolean("local_premium", false);
+    }
+
+    public static void setLocal(boolean value) {
+        VoidGram.prefs().edit().putBoolean("local_premium", value).apply();
+    }
+
+    public static boolean revealSpoilers() {
+        return VoidGram.prefs().getBoolean("reveal_spoilers", false);
+    }
+
+    public static void setRevealSpoilers(boolean value) {
+        VoidGram.prefs().edit().putBoolean("reveal_spoilers", value).apply();
+    }
+
+    public static boolean fullNumbers() {
+        return VoidGram.prefs().getBoolean("full_numbers", false);
+    }
+
+    public static void setFullNumbers(boolean value) {
+        VoidGram.prefs().edit().putBoolean("full_numbers", value).apply();
+    }
+
+    /** UserConfig.isPremium(): the server flag, or local Premium (not in decoy mode). */
+    public static boolean isPremium(TLRPC.User user) {
+        if (user == null) {
+            return false;
+        }
+        return user.premium || isLocal() && !VoidGramDecoy.isActive();
+    }
+
+    private static boolean rewrites(int account) {
+        if (!isLocal()) {
+            return false;
+        }
+        try {
+            TLRPC.User self = UserConfig.getInstance(account).getCurrentUser();
+            return self != null && !self.premium;
+        } catch (Throwable e) {
+            return false;
+        }
+    }
+
+    /** Outgoing requests: custom emoji become links while local Premium hides a missing subscription. */
+    public static void rewriteOutgoing(int account, TLObject object) {
+        if (object == null || !rewrites(account)) {
+            return;
+        }
+        try {
+            if (object instanceof TLRPC.TL_messages_sendMessage) {
+                TLRPC.TL_messages_sendMessage req = (TLRPC.TL_messages_sendMessage) object;
+                rewrite(req.peer, req.entities);
+            } else if (object instanceof TLRPC.TL_messages_sendMedia) {
+                TLRPC.TL_messages_sendMedia req = (TLRPC.TL_messages_sendMedia) object;
+                rewrite(req.peer, req.entities);
+            } else if (object instanceof TLRPC.TL_messages_editMessage) {
+                TLRPC.TL_messages_editMessage req = (TLRPC.TL_messages_editMessage) object;
+                rewrite(req.peer, req.entities);
+            } else if (object instanceof TLRPC.TL_messages_sendMultiMedia) {
+                TLRPC.TL_messages_sendMultiMedia req = (TLRPC.TL_messages_sendMultiMedia) object;
+                if (req.multi_media != null) {
+                    for (TLRPC.TL_inputSingleMedia media : req.multi_media) {
+                        if (media != null) {
+                            rewrite(req.peer, media.entities);
+                        }
+                    }
+                }
+            }
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static void rewrite(TLRPC.InputPeer peer, ArrayList<TLRPC.MessageEntity> entities) {
+        // Saved Messages accept custom emoji without a subscription.
+        if (peer instanceof TLRPC.TL_inputPeerSelf || entities == null) {
+            return;
+        }
+        for (int i = 0; i < entities.size(); i++) {
+            TLRPC.MessageEntity entity = entities.get(i);
+            if (entity instanceof TLRPC.TL_messageEntityCustomEmoji) {
+                TLRPC.TL_messageEntityTextUrl link = new TLRPC.TL_messageEntityTextUrl();
+                link.offset = entity.offset;
+                link.length = entity.length;
+                link.url = EMOJI_URL_PREFIX + ((TLRPC.TL_messageEntityCustomEmoji) entity).document_id;
+                entities.set(i, link);
+            }
+        }
+    }
+
+    public static long emojiId(String url) {
+        if (url == null || !url.startsWith(EMOJI_URL_PREFIX)) {
+            return 0;
+        }
+        String digits = url.substring(EMOJI_URL_PREFIX.length());
+        if (digits.isEmpty() || digits.length() > 19) {
+            return 0;
+        }
+        for (int i = 0; i < digits.length(); i++) {
+            char c = digits.charAt(i);
+            if (c < '0' || c > '9') {
+                return 0;
+            }
+        }
+        try {
+            long id = Long.parseLong(digits);
+            return id > 0 ? id : 0;
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /** Display only: a tg://emoji?id= link over one emoji is shown as that custom emoji. */
+    public static ArrayList<TLRPC.MessageEntity> displayEntities(CharSequence text, ArrayList<TLRPC.MessageEntity> entities) {
+        if (entities == null || entities.isEmpty() || text == null) {
+            return entities;
+        }
+        ArrayList<TLRPC.MessageEntity> result = null;
+        for (int i = 0; i < entities.size(); i++) {
+            TLRPC.MessageEntity entity = entities.get(i);
+            if (!(entity instanceof TLRPC.TL_messageEntityTextUrl)) {
+                continue;
+            }
+            long id = emojiId(entity.url);
+            if (id == 0 || entity.offset < 0 || entity.length <= 0 || entity.offset + entity.length > text.length()) {
+                continue;
+            }
+            if (!isSingleEmoji(text.subSequence(entity.offset, entity.offset + entity.length).toString())) {
+                continue;
+            }
+            if (result == null) {
+                result = new ArrayList<>(entities);
+            }
+            TLRPC.TL_messageEntityCustomEmoji emoji = new TLRPC.TL_messageEntityCustomEmoji();
+            emoji.offset = entity.offset;
+            emoji.length = entity.length;
+            emoji.document_id = id;
+            result.set(i, emoji);
+        }
+        return result != null ? result : entities;
+    }
+
+    private static boolean isSingleEmoji(String string) {
+        if (string.isEmpty() || string.length() > 16) {
+            return false;
+        }
+        int first = string.codePointAt(0);
+        // Letters, digits and punctuation are not emoji; everything here must be one symbol.
+        if (Character.isLetterOrDigit(first) || first < 0x2000 && first != 0x00A9 && first != 0x00AE && first != 0x0023 && first != 0x002A) {
+            return false;
+        }
+        java.text.BreakIterator iterator = java.text.BreakIterator.getCharacterInstance();
+        iterator.setText(string);
+        iterator.first();
+        int next = iterator.next();
+        return next == string.length() || next == java.text.BreakIterator.DONE;
+    }
+
+    /** LocaleController.formatShortNumber with "full numbers" on. */
+    public static String fullNumber(int number) {
+        return String.format(java.util.Locale.getDefault(), "%,d", number);
+    }
+}
