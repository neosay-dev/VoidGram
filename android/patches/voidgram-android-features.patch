@@ -0,0 +1,423 @@
+package org.telegram.messenger.voidgram;
+
+import android.util.JsonWriter;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserObject;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.OutputStreamWriter;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Chat export, as on iOS: the history is read page by page from the server and written to a ZIP
+ * with result.json (Telegram Desktop layout), messages.html and the media already on the device.
+ * Protected chats and self-destructing messages are not exported.
+ */
+public final class VoidGramChatExport {
+    private VoidGramChatExport() {
+    }
+
+    public interface Listener {
+        void onProgress(int messages, long mediaBytes);
+
+        /** file != null on success; error is a readable reason otherwise. */
+        void onDone(File file, String error);
+    }
+
+    public static final long MEDIA_BUDGET = 1_000_000_000L;
+    public static final int MAX_MESSAGES = 100_000;
+
+    private static final class Row {
+        int id;
+        int date;
+        String from;
+        String fromId;
+        String text;
+        boolean service;
+        int replyTo;
+        String photo;
+        String file;
+        String fileName;
+        String mediaStatus;
+    }
+
+    /** Whether this chat may be exported at all. */
+    public static boolean canExport(int account, long dialogId) {
+        if (DialogObject.isEncryptedDialog(dialogId) || VoidGramDecoy.isActive()) {
+            return false;
+        }
+        MessagesController controller = MessagesController.getInstance(account);
+        if (dialogId < 0) {
+            TLRPC.Chat chat = controller.getChat(-dialogId);
+            return chat != null && !chat.noforwards;
+        }
+        TLRPC.User user = controller.getUser(dialogId);
+        return user != null;
+    }
+
+    /** Starts the export; the returned Runnable cancels it. */
+    public static Runnable start(int account, long dialogId, boolean includeMedia, Listener listener) {
+        final boolean[] cancelled = new boolean[1];
+        final Job job = new Job(account, dialogId, includeMedia, listener, cancelled);
+        Utilities.globalQueue.postRunnable(job::begin);
+        return () -> {
+            cancelled[0] = true;
+            Utilities.globalQueue.postRunnable(job::discard);
+        };
+    }
+
+    private static final class Job {
+        final int account;
+        final long dialogId;
+        final boolean includeMedia;
+        final Listener listener;
+        final boolean[] cancelled;
+        final ArrayList<Row> rows = new ArrayList<>();
+        final HashMap<Long, String> names = new HashMap<>();
+        final HashSet<String> usedNames = new HashSet<>();
+        TLRPC.InputPeer peer;
+        String title = "Chat";
+        File zipFile;
+        ZipOutputStream zip;
+        long mediaBytes;
+        int offsetId;
+        boolean finished;
+
+        Job(int account, long dialogId, boolean includeMedia, Listener listener, boolean[] cancelled) {
+            this.account = account;
+            this.dialogId = dialogId;
+            this.includeMedia = includeMedia;
+            this.listener = listener;
+            this.cancelled = cancelled;
+        }
+
+        void begin() {
+            try {
+                MessagesController controller = MessagesController.getInstance(account);
+                peer = controller.getInputPeer(dialogId);
+                if (dialogId < 0) {
+                    TLRPC.Chat chat = controller.getChat(-dialogId);
+                    if (chat == null || chat.noforwards) {
+                        fail(VoidGram.t("Этот чат защищён от копирования", "This chat is protected from copying"));
+                        return;
+                    }
+                    title = chat.title;
+                } else {
+                    TLRPC.User user = controller.getUser(dialogId);
+                    if (user == null) {
+                        fail(VoidGram.t("Чат не найден", "Chat not found"));
+                        return;
+                    }
+                    title = UserObject.getUserName(user);
+                }
+                File dir = new File(new File(ApplicationLoader.applicationContext.getFilesDir(), "cache"), "voidgram_export");
+                dir.mkdirs();
+                String safe = title.replaceAll("[\\\\/:*?\"<>|\\n\\r]", "_");
+                if (safe.length() > 40) {
+                    safe = safe.substring(0, 40);
+                }
+                zipFile = new File(dir, "VoidGram-" + safe + "-" + new SimpleDateFormat("yyyy-MM-dd_HH-mm", Locale.US).format(new Date()) + ".zip");
+                zip = new ZipOutputStream(new FileOutputStream(zipFile));
+                nextPage();
+            } catch (Throwable e) {
+                fail(VoidGram.t("Не удалось создать файл", "The file could not be created"));
+            }
+        }
+
+        void nextPage() {
+            if (cancelled[0]) {
+                return;
+            }
+            TLRPC.TL_messages_getHistory req = new TLRPC.TL_messages_getHistory();
+            req.peer = peer;
+            req.offset_id = offsetId;
+            req.limit = 100;
+            ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> Utilities.globalQueue.postRunnable(() -> {
+                if (cancelled[0]) {
+                    return;
+                }
+                if (error != null) {
+                    if (error.text != null && error.text.startsWith("FLOOD_WAIT_")) {
+                        int seconds = Utilities.parseInt(error.text);
+                        Utilities.globalQueue.postRunnable(this::nextPage, Math.max(1, Math.min(seconds, 300)) * 1000L);
+                    } else {
+                        fail(VoidGram.t("Ошибка сети: ", "Network error: ") + error.text);
+                    }
+                    return;
+                }
+                if (!(response instanceof TLRPC.messages_Messages)) {
+                    fail(VoidGram.t("Сервер не ответил", "The server did not answer"));
+                    return;
+                }
+                page((TLRPC.messages_Messages) response);
+            }));
+        }
+
+        void page(TLRPC.messages_Messages result) {
+            for (TLRPC.User user : result.users) {
+                names.put(user.id, UserObject.getUserName(user));
+            }
+            for (TLRPC.Chat chat : result.chats) {
+                names.put(-chat.id, chat.title);
+                if (chat.id == -dialogId && chat.noforwards) {
+                    fail(VoidGram.t("Этот чат защищён от копирования", "This chat is protected from copying"));
+                    return;
+                }
+            }
+            if (result.messages.isEmpty()) {
+                complete();
+                return;
+            }
+            int next = Integer.MAX_VALUE;
+            for (TLRPC.Message message : result.messages) {
+                if (message.id > 0) {
+                    next = Math.min(next, message.id);
+                }
+            }
+            if (next == Integer.MAX_VALUE || offsetId != 0 && next >= offsetId) {
+                complete();
+                return;
+            }
+            int oldOffset = offsetId;
+            offsetId = next;
+            try {
+                for (TLRPC.Message message : result.messages) {
+                    if (message instanceof TLRPC.TL_messageEmpty || oldOffset != 0 && message.id >= oldOffset) {
+                        continue;
+                    }
+                    if (rows.size() >= MAX_MESSAGES) {
+                        break;
+                    }
+                    rows.add(row(message));
+                }
+            } catch (Throwable e) {
+                fail(VoidGram.t("Не удалось записать файл", "The file could not be written"));
+                return;
+            }
+            final int count = rows.size();
+            final long bytes = mediaBytes;
+            AndroidUtilities.runOnUIThread(() -> listener.onProgress(count, bytes));
+            if (rows.size() >= MAX_MESSAGES) {
+                complete();
+            } else {
+                nextPage();
+            }
+        }
+
+        Row row(TLRPC.Message message) throws Exception {
+            Row row = new Row();
+            row.id = message.id;
+            row.date = message.date;
+            row.service = message instanceof TLRPC.TL_messageService;
+            long fromId = MessageObjectHelper.fromId(message, dialogId);
+            row.from = names.get(fromId);
+            row.fromId = fromId == 0 ? null : (fromId > 0 ? "user" + fromId : "channel" + -fromId);
+            if (message.reply_to != null) {
+                row.replyTo = message.reply_to.reply_to_msg_id;
+            }
+            boolean expiring = message.ttl > 0 || message.media != null && message.media.ttl_seconds > 0 || message.noforwards;
+            row.text = expiring ? "" : (row.service ? MessageObjectHelper.serviceText(message) : message.message != null ? message.message : "");
+            if (expiring) {
+                row.mediaStatus = "Protected or expiring content omitted";
+            } else if (message.media != null && !(message.media instanceof TLRPC.TL_messageMediaEmpty) && !(message.media instanceof TLRPC.TL_messageMediaWebPage)) {
+                boolean photo = message.media instanceof TLRPC.TL_messageMediaPhoto;
+                boolean document = message.media instanceof TLRPC.TL_messageMediaDocument;
+                if ((photo || document) && includeMedia) {
+                    File source = FileLoader.getInstance(account).getPathToMessage(message);
+                    if (source != null && source.exists() && source.length() > 0 && mediaBytes + source.length() <= MEDIA_BUDGET) {
+                        String name = photo ? "photo.jpg" : FileLoader.getDocumentFileName(message.media.document);
+                        if (name == null || name.isEmpty()) {
+                            name = source.getName();
+                        }
+                        String path = "media/" + message.id + "_" + name.replaceAll("[\\\\/:*?\"<>|]", "_");
+                        if (usedNames.add(path)) {
+                            zip.putNextEntry(new ZipEntry(path));
+                            try (FileInputStream in = new FileInputStream(source)) {
+                                byte[] buffer = new byte[65536];
+                                int read;
+                                while ((read = in.read(buffer)) > 0) {
+                                    zip.write(buffer, 0, read);
+                                }
+                            }
+                            zip.closeEntry();
+                            mediaBytes += source.length();
+                        }
+                        if (photo) {
+                            row.photo = path;
+                        } else {
+                            row.file = path;
+                        }
+                        row.fileName = name;
+                    } else {
+                        row.mediaStatus = "Media not cached or exceeds export budget";
+                    }
+                } else if (photo || document) {
+                    row.mediaStatus = "Media excluded by export settings";
+                } else {
+                    row.mediaStatus = "Additional media type; no local file exported";
+                }
+            }
+            return row;
+        }
+
+        void complete() {
+            if (finished || cancelled[0]) {
+                return;
+            }
+            try {
+                java.util.Collections.sort(rows, (a, b) -> Integer.compare(a.id, b.id));
+                zip.putNextEntry(new ZipEntry("result.json"));
+                JsonWriter json = new JsonWriter(new OutputStreamWriter(new NonClosing(zip), "UTF-8"));
+                json.setIndent(" ");
+                json.beginObject();
+                json.name("name").value(title);
+                json.name("type").value(dialogId > 0 ? "personal_chat" : "public_supergroup");
+                json.name("id").value(Math.abs(dialogId));
+                json.name("exported_by").value("VoidGram");
+                json.name("messages").beginArray();
+                SimpleDateFormat iso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", Locale.US);
+                for (Row row : rows) {
+                    json.beginObject();
+                    json.name("id").value(row.id);
+                    json.name("type").value(row.service ? "service" : "message");
+                    json.name("date").value(iso.format(new Date(row.date * 1000L)));
+                    json.name("date_unixtime").value(String.valueOf(row.date));
+                    if (row.from != null) json.name("from").value(row.from);
+                    if (row.fromId != null) json.name("from_id").value(row.fromId);
+                    if (row.replyTo != 0) json.name("reply_to_message_id").value(row.replyTo);
+                    if (row.photo != null) json.name("photo").value(row.photo);
+                    if (row.file != null) json.name("file").value(row.file);
+                    if (row.fileName != null) json.name("file_name").value(row.fileName);
+                    if (row.mediaStatus != null) json.name("media_status").value(row.mediaStatus);
+                    json.name("text").value(row.text);
+                    json.endObject();
+                }
+                json.endArray();
+                json.endObject();
+                json.flush();
+                zip.closeEntry();
+
+                zip.putNextEntry(new ZipEntry("messages.html"));
+                OutputStreamWriter html = new OutputStreamWriter(new NonClosing(zip), "UTF-8");
+                html.write("<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><title>");
+                html.write(escape(title));
+                html.write("</title><style>body{font:15px system-ui,sans-serif;background:#0e1116;color:#e6e6e6;margin:0;padding:16px}"
+                        + ".m{max-width:720px;margin:6px auto;padding:8px 12px;border-radius:12px;background:#1b2028}"
+                        + ".s{text-align:center;color:#8a93a0;background:none}.f{color:#8ab4ff;font-weight:600}"
+                        + ".d{color:#8a93a0;font-size:12px;float:right}.t{white-space:pre-wrap;word-wrap:break-word}"
+                        + "img{max-width:100%;border-radius:8px;margin-top:6px}a{color:#8ab4ff}.n{color:#8a93a0;font-size:12px}"
+                        + "@media(prefers-color-scheme:light){body{background:#f3f4f6;color:#111}.m{background:#fff}}</style></head><body>");
+                html.write("<h2 style=\"text-align:center\">" + escape(title) + "</h2>");
+                SimpleDateFormat human = new SimpleDateFormat("dd.MM.yyyy HH:mm", Locale.US);
+                for (Row row : rows) {
+                    html.write("<div class=\"m" + (row.service ? " s" : "") + "\" id=\"m" + row.id + "\">");
+                    if (!row.service) {
+                        html.write("<span class=\"d\">" + human.format(new Date(row.date * 1000L)) + "</span>");
+                        if (row.from != null) html.write("<div class=\"f\">" + escape(row.from) + "</div>");
+                        if (row.replyTo != 0) html.write("<div class=\"n\"><a href=\"#m" + row.replyTo + "\">↩ #" + row.replyTo + "</a></div>");
+                    }
+                    if (row.photo != null) html.write("<img src=\"" + escape(row.photo) + "\" loading=\"lazy\">");
+                    if (row.file != null) html.write("<div><a href=\"" + escape(row.file) + "\">📎 " + escape(row.fileName != null ? row.fileName : row.file) + "</a></div>");
+                    if (row.text != null && !row.text.isEmpty()) html.write("<div class=\"t\">" + escape(row.text) + "</div>");
+                    if (row.mediaStatus != null && row.photo == null && row.file == null) html.write("<div class=\"n\">" + escape(row.mediaStatus) + "</div>");
+                    html.write("</div>");
+                }
+                html.write("</body></html>");
+                html.flush();
+                zip.closeEntry();
+                zip.close();
+                finished = true;
+                final File file = zipFile;
+                AndroidUtilities.runOnUIThread(() -> listener.onDone(file, null));
+            } catch (Throwable e) {
+                fail(VoidGram.t("Не удалось записать файл", "The file could not be written"));
+            }
+        }
+
+        void fail(String reason) {
+            if (finished) {
+                return;
+            }
+            finished = true;
+            discard();
+            AndroidUtilities.runOnUIThread(() -> listener.onDone(null, reason));
+        }
+
+        void discard() {
+            try {
+                if (zip != null) {
+                    zip.close();
+                }
+            } catch (Throwable ignore) {
+            }
+            if (zipFile != null && (!finished || cancelled[0])) {
+                zipFile.delete();
+            }
+        }
+    }
+
+    private static String escape(String text) {
+        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;");
+    }
+
+    /** Writers on a zip entry must not close the whole archive. */
+    private static final class NonClosing extends java.io.FilterOutputStream {
+        NonClosing(java.io.OutputStream out) {
+            super(out);
+        }
+
+        @Override
+        public void write(byte[] b, int off, int len) throws java.io.IOException {
+            out.write(b, off, len);
+        }
+
+        @Override
+        public void close() throws java.io.IOException {
+            flush();
+        }
+    }
+
+    private static final class MessageObjectHelper {
+        static long fromId(TLRPC.Message message, long dialogId) {
+            if (message.from_id instanceof TLRPC.TL_peerUser) {
+                return message.from_id.user_id;
+            } else if (message.from_id instanceof TLRPC.TL_peerChannel) {
+                return -message.from_id.channel_id;
+            } else if (message.from_id instanceof TLRPC.TL_peerChat) {
+                return -message.from_id.chat_id;
+            }
+            return dialogId;
+        }
+
+        static String serviceText(TLRPC.Message message) {
+            if (message.action == null) {
+                return "";
+            }
+            String name = message.action.getClass().getSimpleName();
+            if (name.startsWith("TL_messageAction")) {
+                name = name.substring("TL_messageAction".length());
+            }
+            if (message.action.title != null && !message.action.title.isEmpty()) {
+                return name + ": " + message.action.title;
+            }
+            return name;
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramChatNotice.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramChatNotice.java
new file mode 100644
index 0000000..5c73fef
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramChatNotice.java
@@ -0,0 +1,208 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ChatObject;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.UserObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * The VoidGram privacy notice, as on iOS: before a person's first own message in a private chat or a
+ * group, VoidGram sends this text on their behalf (private chats: pinned for both sides, silently).
+ * The sender cannot delete or unpin it in VoidGram; only the other side can delete it.
+ */
+public final class VoidGramChatNotice implements NotificationCenter.NotificationCenterDelegate {
+    public static final String TEXT_RU = "⚠️ Я использую VoidGram. Наша переписка не защищена, поэтому мы (разработчики VoidGram) настоятельно не советуем отправлять этому пользователю какие-либо личные данные, интимные фотографии и так далее. Секретные чаты и одноразовые сообщения не помогут.";
+    public static final String TEXT_EN = "⚠️ I use VoidGram. Our conversation is not protected, so we (the VoidGram developers) strongly advise against sending this user any personal data, intimate photos and so on. Secret chats and view-once messages will not help.";
+
+    private static final VoidGramChatNotice[] instances = new VoidGramChatNotice[UserConfig.MAX_ACCOUNT_COUNT];
+    private static final Set<String> repinCheckedThisSession = new HashSet<>();
+    private static boolean sending;
+
+    private final int account;
+
+    private VoidGramChatNotice(int account) {
+        this.account = account;
+    }
+
+    private static synchronized VoidGramChatNotice get(int account) {
+        if (instances[account] == null) {
+            instances[account] = new VoidGramChatNotice(account);
+            final VoidGramChatNotice instance = instances[account];
+            AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).addObserver(instance, NotificationCenter.messageReceivedByServer));
+        }
+        return instances[account];
+    }
+
+    public static boolean isNoticeText(CharSequence text) {
+        if (text == null) {
+            return false;
+        }
+        String trimmed = text.toString().trim();
+        return TEXT_RU.equals(trimmed) || TEXT_EN.equals(trimmed);
+    }
+
+    /** The account's own notice: it may not be deleted or unpinned from this app. */
+    public static boolean isProtected(TLRPC.Message message) {
+        return message != null && message.out && (message.media == null || message.media instanceof TLRPC.TL_messageMediaEmpty) && isNoticeText(message.message);
+    }
+
+    public static boolean isProtected(MessageObject messageObject) {
+        return messageObject != null && isProtected(messageObject.messageOwner);
+    }
+
+    private SharedPreferences store() {
+        return VoidGram.prefs();
+    }
+
+    private String sentKey(long dialogId) {
+        return "notice_sent_" + account + "_" + dialogId;
+    }
+
+    private String pinnedKey(long dialogId) {
+        return "notice_pinned_" + account + "_" + dialogId;
+    }
+
+    public static int pinnedNoticeId(int account, long dialogId) {
+        return VoidGram.prefs().getInt("notice_pinned_" + account + "_" + dialogId, 0);
+    }
+
+    /** Called before the user's own message is queued; queues the notice first when the chat has none yet. */
+    public static void beforeSend(int account, SendMessagesHelper.SendMessageParams params) {
+        if (sending || VoidGramDecoy.isActive() || params == null || params.scheduleDate != 0 || params.quick_reply_shortcut != null || params.quick_reply_shortcut_id != 0) {
+            return;
+        }
+        if (params.retryMessageObject != null || isNoticeText(params.message)) {
+            return;
+        }
+        final long peer = params.peer;
+        final MessagesController controller = MessagesController.getInstance(account);
+        if (peer == 0 || DialogObject.isEncryptedDialog(peer) || peer == UserConfig.getInstance(account).getClientUserId()) {
+            return;
+        }
+        boolean privateChat;
+        if (DialogObject.isUserDialog(peer)) {
+            TLRPC.User user = controller.getUser(peer);
+            if (user == null || UserObject.isBot(user) || UserObject.isDeleted(user) || user.support || user.id == 777000 || user.id == 42777 || user.id == 489000 || user.id == 333000) {
+                return;
+            }
+            privateChat = true;
+        } else if (DialogObject.isChatDialog(peer)) {
+            TLRPC.Chat chat = controller.getChat(-peer);
+            if (chat == null || ChatObject.isChannelAndNotMegaGroup(chat)) {
+                return;
+            }
+            privateChat = false;
+        } else {
+            return;
+        }
+        VoidGramChatNotice instance = get(account);
+        SharedPreferences store = instance.store();
+        if (store.getBoolean(instance.sentKey(peer), false)) {
+            if (privateChat) {
+                ensurePinned(account, peer);
+            }
+            return;
+        }
+        store.edit().putBoolean(instance.sentKey(peer), true).apply();
+        String text = VoidGram.russian() ? TEXT_RU : TEXT_EN;
+        SendMessagesHelper.SendMessageParams notice = SendMessagesHelper.SendMessageParams.of(text, peer, null, params.replyToTopMsg, null, false, null, null, null, true, 0, 0, null, false);
+        sending = true;
+        try {
+            SendMessagesHelper.getInstance(account).sendMessage(notice);
+        } finally {
+            sending = false;
+        }
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id != NotificationCenter.messageReceivedByServer || args.length < 4) {
+            return;
+        }
+        if (!(args[2] instanceof TLRPC.Message)) {
+            return;
+        }
+        TLRPC.Message message = (TLRPC.Message) args[2];
+        long dialogId = (Long) args[3];
+        int newId = (Integer) args[1];
+        if (!isProtected(message) || !DialogObject.isUserDialog(dialogId)) {
+            return;
+        }
+        if (store().getInt(pinnedKey(dialogId), 0) != 0) {
+            return;
+        }
+        store().edit().putInt(pinnedKey(dialogId), newId).apply();
+        pin(this.account, dialogId, newId);
+    }
+
+    private static void pin(int account, long dialogId, int messageId) {
+        TLRPC.User user = MessagesController.getInstance(account).getUser(dialogId);
+        if (user != null && messageId > 0) {
+            MessagesController.getInstance(account).pinMessage(null, user, messageId, false, false, false);
+        }
+    }
+
+    /** Puts the notice back on top once a session, in case its pin was removed (another app, "Unpin all"). */
+    public static void ensurePinned(int account, long dialogId) {
+        int id = pinnedNoticeId(account, dialogId);
+        if (id == 0 || !repinCheckedThisSession.add(account + "_" + dialogId)) {
+            return;
+        }
+        pin(account, dialogId, id);
+    }
+
+    /** Re-pins after "Unpin all" in a private chat. */
+    public static void afterUnpinAll(int account, long dialogId) {
+        int id = pinnedNoticeId(account, dialogId);
+        if (id != 0) {
+            AndroidUtilities.runOnUIThread(() -> pin(account, dialogId, id), 1000);
+        }
+    }
+
+    /** True when unpinning `messageId` in `dialogId` must be refused. */
+    public static boolean refusesUnpin(int account, long dialogId, int messageId) {
+        if (messageId != 0 && pinnedNoticeId(account, dialogId) == messageId) {
+            return true;
+        }
+        MessageObject object = MessagesController.getInstance(account).dialogMessagesByIds.get(messageId);
+        return object != null && object.getDialogId() == dialogId && isProtected(object);
+    }
+
+    /** Drops the notice from a deletion request. */
+    public static void filterDeletion(int account, long dialogId, ArrayList<Integer> messages) {
+        if (messages == null || messages.isEmpty()) {
+            return;
+        }
+        int pinned = dialogId != 0 ? pinnedNoticeId(account, dialogId) : 0;
+        for (int i = messages.size() - 1; i >= 0; i--) {
+            Integer id = messages.get(i);
+            if (id == null) {
+                continue;
+            }
+            if (pinned != 0 && id == pinned) {
+                messages.remove(i);
+                continue;
+            }
+            MessageObject object = MessagesController.getInstance(account).dialogMessagesByIds.get(id);
+            if (object != null && (dialogId == 0 || object.getDialogId() == dialogId) && isProtected(object)) {
+                messages.remove(i);
+            }
+        }
+    }
+
+    public static String refusalText() {
+        return VoidGram.t("Предупреждение VoidGram нельзя удалить или открепить. Удалить его может только собеседник.", "The VoidGram notice cannot be deleted or unpinned. Only the other person can delete it.");
+    }
+}
