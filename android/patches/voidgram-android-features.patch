+    private static String top(Map<String, Integer> counts, int limit, String separator) {
+        ArrayList<Map.Entry<String, Integer>> entries = new ArrayList<>(counts.entrySet());
+        Collections.sort(entries, (a, b) -> Integer.compare(b.getValue(), a.getValue()));
+        StringBuilder builder = new StringBuilder();
+        for (int i = 0; i < Math.min(limit, entries.size()); i++) {
+            if (builder.length() > 0) {
+                builder.append('\n');
+            }
+            builder.append(entries.get(i).getKey()).append(separator).append(entries.get(i).getValue());
+        }
+        return builder.toString();
+    }
