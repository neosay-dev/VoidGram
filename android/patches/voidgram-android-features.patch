+
+    private void editMention(org.telegram.messenger.voidgram.VoidGramGroupMentions.Group existing) {
+        Context context = getContext();
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(AndroidUtilities.dp(20), AndroidUtilities.dp(4), AndroidUtilities.dp(20), 0);
+        StringBuilder names = new StringBuilder();
+        if (existing != null) {
+            for (String name : existing.usernames) {
+                if (names.length() > 0) names.append(' ');
+                names.append('@').append(name);
+            }
+        }
+        EditText command = field(context, VoidGram.t("@команда", "@team"), existing != null ? existing.command : "", false);
+        EditText users = field(context, VoidGram.t("@ник1 @ник2 …", "@name1 @name2 …"), names.toString(), true);
+        layout.addView(command);
+        layout.addView(users);
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(VoidGram.t("Групповое упоминание", "Group mention"));
+        builder.setView(layout);
+        builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (d, w) -> {
+            if (!org.telegram.messenger.voidgram.VoidGramGroupMentions.put(existing != null ? existing.command : null, command.getText().toString(), users.getText().toString())) {
+                org.telegram.ui.Components.BulletinFactory.of(this).createErrorBulletin(VoidGram.t("Нужна команда без пробелов и хотя бы один ник", "A command without spaces and at least one username are needed")).show();
+            }
+            update();
+        });
+        if (existing != null) {
+            builder.setNeutralButton(VoidGram.t("Удалить", "Delete"), (d, w) -> {
+                org.telegram.messenger.voidgram.VoidGramGroupMentions.remove(existing.command);
+                update();
+            });
+        }
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_MENTION_PRIVATE) {
+            org.telegram.messenger.voidgram.VoidGramGroupMentions.setEnabledPrivate(!org.telegram.messenger.voidgram.VoidGramGroupMentions.enabledPrivate());
+            update();
+            return;
+        } else if (item.id == ID_MENTION_GROUPS) {
+            org.telegram.messenger.voidgram.VoidGramGroupMentions.setEnabledGroups(!org.telegram.messenger.voidgram.VoidGramGroupMentions.enabledGroups());
+            update();
+            return;
+        } else if (item.id == ID_MENTION_CASE) {
+            org.telegram.messenger.voidgram.VoidGramGroupMentions.setCaseSensitive(!org.telegram.messenger.voidgram.VoidGramGroupMentions.caseSensitive());
+            update();
+            return;
+        } else if (item.id == ID_MENTION_ADD) {
+            editMention(null);
+            return;
+        } else if (item.id >= ID_MENTION_BASE && item.id - ID_MENTION_BASE < mentions.size()) {
+            editMention(mentions.get(item.id - ID_MENTION_BASE));
+            return;
+        }
+        if (item.id == ID_VARIABLES) {
+            VoidGramShortcuts.setVariablesEnabled(!VoidGramShortcuts.variablesEnabled());
+            update();
+        } else if (item.id == ID_ADD) {
+            edit(null);
+        } else if (item.id >= ID_ITEM_BASE && item.id - ID_ITEM_BASE < items.size()) {
+            edit(items.get(item.id - ID_ITEM_BASE));
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
