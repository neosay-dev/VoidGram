+
+import java.util.ArrayList;
+
+/** VoidGram → Decoy mode (second space). */
+public class VoidGramDecoyActivity extends UniversalFragment {
+    private static final int ID_ENABLED = 1;
+    private static final int ID_CODES = 2;
+    private static final int ID_STAND_IN = 3;
+    private static final int ID_ACCOUNT_BASE = 100;
+
+    @Override
+    protected CharSequence getTitle() {
+        return VoidGram.t("Фейк-режим", "Decoy mode");
+    }
+
+    private void refresh() {
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asHeader(VoidGram.t("Фейк-режим", "Decoy mode")));
+        items.add(UItem.asCheck(ID_ENABLED, VoidGram.t("Фейк-режим (двойной тап по заставке)", "Decoy mode (double tap the splash)")).setChecked(VoidGramDecoy.isEnabled()));
+        items.add(UItem.asButton(ID_CODES, VoidGram.t("Настоящий и фейковый код", "Real and fake code"), VoidGramDecoy.hasCodes() ? VoidGram.t("заданы", "set") : VoidGram.t("не заданы", "not set")));
+        items.add(UItem.asShadow(VoidGram.t("Работает, когда включено и заданы оба кода.", "Works when it is on and both codes are set.")));
+        items.add(UItem.asHeader(VoidGram.t("Что показывать", "What to show")));
+        int decoy = VoidGramDecoy.decoyAccount();
+        items.add(UItem.asRadio(ID_STAND_IN, VoidGram.t("Встроенный (липовый)", "Built-in stand-in")).setChecked(decoy < 0));
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (a == currentAccount || !UserConfig.getInstance(a).isClientActivated()) {
+                continue;
+            }
+            TLRPC.User user = UserConfig.getInstance(a).getCurrentUser();
+            items.add(UItem.asRadio(ID_ACCOUNT_BASE + a, user != null ? UserObject.getUserName(user) : VoidGram.t("Аккаунт ", "Account ") + (a + 1)).setChecked(decoy == a));
+        }
+        items.add(UItem.asShadow(VoidGram.t("Второй аккаунт: основной полностью скрыт. Встроенный: обычный на вид Telegram с готовыми чатами.", "A second account hides the main one. The built-in one is an ordinary-looking Telegram with ready-made chats.")));
+        items.add(UItem.asHeader(VoidGram.t("Как это работает", "How it works")));
+        items.add(UItem.asShadow(VoidGram.t("При запуске появляется иконка VoidGram. Два быстрых нажатия по ней — и открывается фейк: второй аккаунт или встроенный липовый Telegram. В фейке нет раздела VoidGram, все функции VoidGram выключены.\n\nПосле полного закрытия приложения VoidGram спросит код. Настоящий код вернёт ваш аккаунт. Фейковый код покажет «VoidGram больше не работает» и сотрёт все данные приложения.", "At launch the VoidGram icon appears. Two quick taps on it open the decoy: a second account or a built-in stand-in Telegram. The decoy has no VoidGram section and every VoidGram feature is off.\n\nAfter the app is fully closed, VoidGram asks for a code. The real code brings your account back. The fake code shows \"VoidGram no longer works\" and wipes all the app's data.")));
+    }
+
+    private void editCodes() {
+        LinearLayout layout = new LinearLayout(getContext());
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(AndroidUtilities.dp(20), 0, AndroidUtilities.dp(20), 0);
+        EditText real = new EditText(getContext());
+        real.setHint(VoidGram.t("Настоящий код", "Real code"));
+        real.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        real.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        EditText fake = new EditText(getContext());
+        fake.setHint(VoidGram.t("Фейковый код", "Fake code"));
+        fake.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        fake.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        layout.addView(real);
+        layout.addView(fake);
+        AlertDialog.Builder builder = new AlertDialog.Builder(getContext());
+        builder.setTitle(VoidGram.t("Коды", "Codes"));
+        builder.setMessage(VoidGram.t("Настоящий код возвращает в ваш аккаунт. Фейковый показывает «VoidGram больше не работает» и стирает все данные. Минимум 4 символа, коды должны различаться.", "The real code returns to your account. The fake code shows \"VoidGram no longer works\" and wipes all data. At least 4 characters; the codes must differ."));
+        builder.setView(layout);
+        builder.setPositiveButton(VoidGram.t("Сохранить", "Save"), (dialog, which) -> {
+            if (!VoidGramDecoy.setCodes(real.getText().toString(), fake.getText().toString())) {
+                BulletinFactory.of(this).createErrorBulletin(VoidGram.t("Коды не сохранены: минимум 4 символа, и они должны различаться.", "Codes not saved: at least 4 characters, and they must differ.")).show();
+            }
+            refresh();
+        });
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        int id = item.id;
+        if (id == ID_ENABLED) {
+            VoidGramDecoy.setEnabled(!VoidGramDecoy.isEnabled());
+        } else if (id == ID_CODES) {
+            editCodes();
+            return;
+        } else if (id == ID_STAND_IN) {
+            VoidGramDecoy.setDecoyAccount(-1);
+        } else if (id >= ID_ACCOUNT_BASE && id < ID_ACCOUNT_BASE + UserConfig.MAX_ACCOUNT_COUNT) {
+            VoidGramDecoy.setDecoyAccount(id - ID_ACCOUNT_BASE);
+        } else {
+            return;
+        }
+        refresh();
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
