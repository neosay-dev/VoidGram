@@ -0,0 +1,100 @@
+package org.telegram.ui.voidgram;
+
+import android.media.MediaMetadataRetriever;
+
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.VideoEditedInfo;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.io.File;
+
+/**
+ * "Video → circle", as on iOS: a video is cropped to its centre square (480×480, up to 60 s) by
+ * Telegram's own converter and sent to this chat as a round video message.
+ */
+public final class VoidGramVideoCircle {
+    private VoidGramVideoCircle() {
+    }
+
+    private static final int SIDE = 480;
+    private static final long MAX_MS = 60_000;
+
+    public static boolean canConvert(MessageObject message) {
+        return message != null && message.isVideo() && !message.isRoundVideo() && !message.needDrawBluredPreview();
+    }
+
+    public static void send(ChatActivity chat, MessageObject message) {
+        File file = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+        if (file == null || !file.exists()) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Сначала загрузите видео.", "Download the video first.")).show();
+            return;
+        }
+        int width;
+        int height;
+        int rotation;
+        long durationMs;
+        MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+        try {
+            retriever.setDataSource(file.getAbsolutePath());
+            width = Integer.parseInt(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH));
+            height = Integer.parseInt(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT));
+            String rotationValue = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION);
+            rotation = rotationValue != null ? Integer.parseInt(rotationValue) : 0;
+            durationMs = Long.parseLong(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION));
+        } catch (Throwable e) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Не удалось прочитать видео.", "The video could not be read.")).show();
+            return;
+        } finally {
+            try {
+                retriever.release();
+            } catch (Throwable ignore) {
+            }
+        }
+        if (width <= 0 || height <= 0 || durationMs <= 0) {
+            return;
+        }
+        boolean rotated = rotation == 90 || rotation == 270;
+        int displayWidth = rotated ? height : width;
+        int displayHeight = rotated ? width : height;
+        int side = Math.min(displayWidth, displayHeight);
+
+        VideoEditedInfo info = new VideoEditedInfo();
+        info.originalPath = file.getAbsolutePath();
+        info.originalWidth = width;
+        info.originalHeight = height;
+        info.rotationValue = rotation;
+        info.resultWidth = SIDE;
+        info.resultHeight = SIDE;
+        info.roundVideo = true;
+        info.framerate = 30;
+        info.bitrate = 1_000_000;
+        info.originalDuration = durationMs * 1000;
+        long kept = Math.min(durationMs, MAX_MS);
+        info.estimatedDuration = kept;
+        info.startTime = -1;
+        info.endTime = durationMs > MAX_MS ? kept * 1000 : -1;
+        info.estimatedSize = Math.max(1, kept / 1000 * info.bitrate / 8);
+
+        MediaController.CropState crop = new MediaController.CropState();
+        crop.cropPx = 0;
+        crop.cropPy = 0;
+        crop.cropScale = 1;
+        crop.cropRotate = 0;
+        crop.cropPw = side / (float) displayWidth;
+        crop.cropPh = side / (float) displayHeight;
+        crop.transformWidth = SIDE;
+        crop.transformHeight = SIDE;
+        crop.transformRotation = 0;
+        info.cropState = crop;
+
+        SendMessagesHelper.prepareSendingVideo(AccountInstance.getInstance(chat.getCurrentAccount()), file.getAbsolutePath(), info, null, null, chat.getDialogId(), null, null, null, null, null, 0, null, true, 0, 0, false, false, null, null, 0, 0);
+        BulletinFactory.of(chat).createSimpleBulletin(R.raw.done, VoidGram.t("Отправляется кружком", "Sending as a round video")).show();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramVideoDownloader.java b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramVideoDownloader.java
new file mode 100644
index 0000000..a0c45b7
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramVideoDownloader.java
@@ -0,0 +1,363 @@
+package org.telegram.ui.voidgram;
+
+import android.net.Uri;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.Utilities;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * "Download video", as on iOS: a TikTok, YouTube or Instagram link typed in the message field
+ * offers to download the video and save it to the gallery or send it to the chat. TikTok goes
+ * through tikwm.com (free, no key); YouTube and Instagram need a cobalt server set in
+ * VoidGram → Tools; TikTok falls back to it too.
+ */
+public final class VoidGramVideoDownloader {
+    private VoidGramVideoDownloader() {
+    }
+
+    private static final String USER_AGENT = "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Mobile Safari/537.36";
+    private static final Pattern LINK = Pattern.compile("https?://[^\\s<>\"«»]+", Pattern.CASE_INSENSITIVE);
+    private static final HashSet<String> offered = new HashSet<>();
+
+    public static boolean isEnabled() {
+        return VoidGram.prefs().getBoolean("video_downloader", true);
+    }
+
+    public static void setEnabled(boolean value) {
+        VoidGram.prefs().edit().putBoolean("video_downloader", value).apply();
+    }
+
+    public static String cobaltServer() {
+        return VoidGram.prefs().getString("cobalt_server", "");
+    }
+
+    public static void setCobaltServer(String value) {
+        VoidGram.prefs().edit().putString("cobalt_server", value == null ? "" : value.trim()).apply();
+    }
+
+    public static String cobaltKey() {
+        return VoidGram.prefs().getString("cobalt_key", "");
+    }
+
+    public static void setCobaltKey(String value) {
+        VoidGram.prefs().edit().putString("cobalt_key", value == null ? "" : value.trim()).apply();
+    }
+
+    /** "tiktok", "youtube", "instagram" or null. */
+    static String service(String link) {
+        try {
+            Uri uri = Uri.parse(link);
+            String host = uri.getHost() == null ? "" : uri.getHost().toLowerCase(Locale.ROOT);
+            String path = uri.getPath() == null ? "" : uri.getPath().toLowerCase(Locale.ROOT);
+            if (matches(host, "tiktok.com")) {
+                return "tiktok";
+            }
+            if (matches(host, "youtu.be")) {
+                return path.length() > 1 ? "youtube" : null;
+            }
+            if (matches(host, "youtube.com")) {
+                return path.startsWith("/watch") || path.startsWith("/shorts/") || path.startsWith("/live/") ? "youtube" : null;
+            }
+            if (matches(host, "instagram.com")) {
+                return path.startsWith("/reel") || path.startsWith("/p/") || path.startsWith("/tv/") ? "instagram" : null;
+            }
+        } catch (Throwable ignore) {
+        }
+        return null;
+    }
+
+    private static boolean matches(String host, String domain) {
+        return host.equals(domain) || host.endsWith("." + domain);
+    }
+
+    private static String title(String service) {
+        switch (service) {
+            case "tiktok": return "TikTok";
+            case "youtube": return "YouTube";
+            default: return "Instagram";
+        }
+    }
+
+    /** ChatActivity: the message field changed. */
+    public static void onComposerText(ChatActivity chat, CharSequence text) {
+        if (chat == null || text == null || text.length() == 0 || text.length() > 4096 || !isEnabled()) {
+            return;
+        }
+        Matcher matcher = LINK.matcher(text);
+        while (matcher.find()) {
+            String link = matcher.group();
+            String service = service(link);
+            if (service == null) {
+                continue;
+            }
+            if (!offered.add(link)) {
+                return;
+            }
+            BulletinFactory.of(chat).createSimpleBulletin(R.raw.ic_download, VoidGram.t("Видео ", "Video · ") + title(service), VoidGram.t("Скачать", "Download"), () -> presentActions(chat, link, service)).show();
+            return;
+        }
+    }
+
+    private static void presentActions(ChatActivity chat, String link, String service) {
+        if (chat.getParentActivity() == null) {
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(chat.getParentActivity());
+        builder.setTitle(VoidGram.t("Скачать видео · ", "Download video · ") + title(service));
+        builder.setItems(new CharSequence[]{VoidGram.t("Сохранить в галерею", "Save to gallery"), VoidGram.t("Отправить в чат", "Send to the chat")}, (dialog, which) -> run(chat, link, service, which == 1));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        chat.showDialog(builder.create());
+    }
+
+    private static void run(ChatActivity chat, String link, String service, boolean send) {
+        AlertDialog progress = new AlertDialog(chat.getParentActivity(), AlertDialog.ALERT_TYPE_SPINNER);
+        progress.setCanCancel(true);
+        final boolean[] cancelled = new boolean[1];
+        progress.setOnCancelListener(d -> cancelled[0] = true);
+        progress.show();
+        final long dialogId = chat.getDialogId();
+        final int account = chat.getCurrentAccount();
+        Utilities.globalQueue.postRunnable(() -> {
+            String error = null;
+            File file = null;
+            try {
+                String direct = resolve(link, service);
+                if (!cancelled[0]) {
+                    file = download(direct, cancelled);
+                }
+            } catch (DownloadException e) {
+                error = e.getMessage();
+            } catch (Throwable e) {
+                error = VoidGram.t("Не удалось скачать видео. Проверьте интернет и попробуйте ещё раз.", "Couldn't download the video. Check the connection and try again.");
+            }
+            final File result = file;
+            final String failure = error;
+            AndroidUtilities.runOnUIThread(() -> {
+                try {
+                    progress.dismiss();
+                } catch (Throwable ignore) {
+                }
+                if (cancelled[0]) {
+                    if (result != null) {
+                        result.delete();
+                    }
+                    return;
+                }
+                if (result == null) {
+                    BulletinFactory.of(chat).createErrorBulletin(failure != null ? failure : VoidGram.t("Не удалось скачать видео.", "Couldn't download the video.")).show();
+                    return;
+                }
+                if (send) {
+                    SendMessagesHelper.prepareSendingVideo(AccountInstance.getInstance(account), result.getAbsolutePath(), null, null, null, dialogId, null, null, null, null, null, 0, null, true, 0, 0, false, false, null, null, 0, 0);
+                } else {
+                    MediaController.saveFile(result.getAbsolutePath(), chat.getParentActivity(), 1, null, "video/mp4", uri -> {
+                        BulletinFactory.of(chat).createSimpleBulletin(R.raw.done, VoidGram.t("Видео сохранено в галерею", "Video saved to the gallery")).show();
+                    });
+                }
+            });
+        });
+    }
+
+    private static final class DownloadException extends Exception {
+        DownloadException(String message) {
+            super(message);
+        }
+    }
+
+    private static String needsServer() {
+        return VoidGram.t("Для YouTube и Instagram нужен сервер cobalt. Укажите его в VoidGram → Инструменты → Скачивание видео.", "YouTube and Instagram need a cobalt server. Set it in VoidGram → Tools → Video downloads.");
+    }
+
+    private static String resolve(String link, String service) throws Exception {
+        String cobalt = cobaltServer();
+        if ("tiktok".equals(service)) {
+            try {
+                return resolveTikTok(link);
+            } catch (DownloadException e) {
+                if (cobalt.isEmpty() || e.getMessage() != null && e.getMessage().equals(notVideo())) {
+                    throw e;
+                }
+                return resolveCobalt(link, cobalt);
+            }
+        }
+        if (cobalt.isEmpty()) {
+            throw new DownloadException(needsServer());
+        }
+        return resolveCobalt(link, cobalt);
+    }
+
+    private static String notVideo() {
+        return VoidGram.t("По ссылке нет видео (например, это фотографии).", "There's no video at this link (it may be photos).");
+    }
+
+    private static String readAll(InputStream in) throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = in.read(buffer)) > 0) {
+            out.write(buffer, 0, read);
+        }
+        return out.toString("UTF-8");
+    }
+
+    private static String resolveTikTok(String link) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL("https://www.tikwm.com/api/?url=" + URLEncoder.encode(link, "UTF-8") + "&hd=1").openConnection();
+        connection.setConnectTimeout(30000);
+        connection.setReadTimeout(30000);
+        connection.setRequestProperty("User-Agent", USER_AGENT);
+        JSONObject json;
+        try (InputStream in = connection.getInputStream()) {
+            json = new JSONObject(readAll(in));
+        } finally {
+            connection.disconnect();
+        }
+        JSONObject data = json.optJSONObject("data");
+        if (json.optInt("code", -1) != 0 || data == null) {
+            throw new DownloadException(VoidGram.t("Сервис не отдал видео: ", "The service returned no video: ") + json.optString("msg", "tikwm"));
+        }
+        JSONArray images = data.optJSONArray("images");
+        if (images != null && images.length() > 0) {
+            throw new DownloadException(notVideo());
+        }
+        String play = data.optString("hdplay", "");
+        if (play.isEmpty()) {
+            play = data.optString("play", "");
+        }
+        if (play.isEmpty()) {
+            throw new DownloadException(notVideo());
+        }
+        return play.startsWith("http") ? play : "https://www.tikwm.com" + (play.startsWith("/") ? play : "/" + play);
+    }
+
+    /** cobalt API (v10+): POST / with {"url": …}; the answer is a tunnel or redirect URL, or a picker. */
+    private static String resolveCobalt(String link, String server) throws Exception {
+        String base = server.trim();
+        if (!base.toLowerCase(Locale.ROOT).startsWith("http")) {
+            base = "https://" + base;
+        }
+        if (!base.endsWith("/")) {
+            base += "/";
+        }
+        HttpURLConnection connection = (HttpURLConnection) new URL(base).openConnection();
+        connection.setConnectTimeout(30000);
+        connection.setReadTimeout(60000);
+        connection.setRequestMethod("POST");
+        connection.setDoOutput(true);
+        connection.setRequestProperty("Accept", "application/json");
+        connection.setRequestProperty("Content-Type", "application/json");
+        connection.setRequestProperty("User-Agent", USER_AGENT);
+        String key = cobaltKey();
+        if (!key.isEmpty()) {
+            connection.setRequestProperty("Authorization", "Api-Key " + key);
+        }
+        JSONObject body = new JSONObject();
+        body.put("url", link);
+        body.put("videoQuality", "1080");
+        body.put("youtubeVideoCodec", "h264");
+        body.put("filenameStyle", "basic");
+        try (OutputStream out = connection.getOutputStream()) {
+            out.write(body.toString().getBytes("UTF-8"));
+        }
+        JSONObject json;
+        InputStream in = connection.getResponseCode() < 400 ? connection.getInputStream() : connection.getErrorStream();
+        try {
+            json = new JSONObject(readAll(in));
+        } finally {
+            if (in != null) {
+                in.close();
+            }
+            connection.disconnect();
+        }
+        String status = json.optString("status", "");
+        switch (status) {
+            case "tunnel":
+            case "redirect":
+            case "stream": {
+                String url = json.optString("url", "");
+                if (url.isEmpty()) {
+                    throw new DownloadException(notVideo());
+                }
+                return url;
+            }
+            case "picker": {
+                JSONArray picker = json.optJSONArray("picker");
+                if (picker != null) {
+                    for (int i = 0; i < picker.length(); i++) {
+                        JSONObject item = picker.optJSONObject(i);
+                        if (item != null && ("video".equals(item.optString("type")) || "gif".equals(item.optString("type"))) && !item.optString("url", "").isEmpty()) {
+                            return item.optString("url");
+                        }
+                    }
+                }
+                throw new DownloadException(notVideo());
+            }
+            default: {
+                JSONObject error = json.optJSONObject("error");
+                String code = error != null ? error.optString("code", status) : status;
+                throw new DownloadException(VoidGram.t("Сервис не отдал видео: ", "The service returned no video: ") + code);
+            }
+        }
+    }
+
+    private static File download(String url, boolean[] cancelled) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
+        connection.setConnectTimeout(30000);
+        connection.setReadTimeout(60000);
+        connection.setInstanceFollowRedirects(true);
+        connection.setRequestProperty("User-Agent", USER_AGENT);
+        int code = connection.getResponseCode();
+        String type = connection.getContentType() == null ? "" : connection.getContentType().toLowerCase(Locale.ROOT);
+        if (code < 200 || code >= 300) {
+            connection.disconnect();
+            throw new DownloadException(VoidGram.t("Не удалось скачать видео (код ", "Couldn't download the video (code ") + code + ").");
+        }
+        if (type.startsWith("text/") || type.contains("json")) {
+            connection.disconnect();
+            throw new DownloadException(notVideo());
+        }
+        File dir = new File(new File(ApplicationLoader.applicationContext.getFilesDir(), "cache"), "voidgram_video");
+        dir.mkdirs();
+        File file = new File(dir, "voidgram_video_" + System.currentTimeMillis() + ".mp4");
+        try (InputStream in = connection.getInputStream(); FileOutputStream out = new FileOutputStream(file)) {
+            byte[] buffer = new byte[65536];
+            int read;
+            while ((read = in.read(buffer)) > 0) {
+                if (cancelled[0]) {
+                    break;
+                }
+                out.write(buffer, 0, read);
+            }
+        } finally {
+            connection.disconnect();
+        }
+        if (cancelled[0] || file.length() == 0) {
+            file.delete();
+            return null;
+        }
+        return file;
+    }
+}
