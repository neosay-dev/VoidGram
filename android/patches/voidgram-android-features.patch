+import java.util.regex.Pattern;
+
+/**
+ * VirusTotal checks, AI summaries and local chat statistics, as on iOS. Each runs only when the
+ * user taps it, with the user's own API key; files are checked by SHA-256 and never uploaded.
+ */
+public final class VoidGramOnlineTools {
+    private VoidGramOnlineTools() {
+    }
+
+    public static final String DEFAULT_AI_ENDPOINT = "https://api.openai.com/v1/chat/completions";
+    public static final String DEFAULT_AI_MODEL = "gpt-4o-mini";
+    private static final Pattern LINK = Pattern.compile("https?://[^\\s<>\"«»]+", Pattern.CASE_INSENSITIVE);
+
+    public static String virusTotalKey() {
+        return VoidGram.prefs().getString("vt_key", "");
+    }
+
+    public static void setVirusTotalKey(String value) {
+        VoidGram.prefs().edit().putString("vt_key", value == null ? "" : value.trim()).apply();
+    }
+
+    public static String aiKey() {
+        return VoidGram.prefs().getString("ai_key", "");
+    }
+
+    public static void setAiKey(String value) {
+        VoidGram.prefs().edit().putString("ai_key", value == null ? "" : value.trim()).apply();
+    }
+
+    public static String aiEndpoint() {
+        String value = VoidGram.prefs().getString("ai_endpoint", "");
+        return value.isEmpty() ? DEFAULT_AI_ENDPOINT : value;
+    }
+
+    public static void setAiEndpoint(String value) {
+        VoidGram.prefs().edit().putString("ai_endpoint", value == null ? "" : value.trim()).apply();
+    }
+
+    public static String aiModel() {
+        String value = VoidGram.prefs().getString("ai_model", "");
+        return value.isEmpty() ? DEFAULT_AI_MODEL : value;
+    }
+
+    public static void setAiModel(String value) {
+        VoidGram.prefs().edit().putString("ai_model", value == null ? "" : value.trim()).apply();
+    }
+
+    static void present(BaseFragment fragment, String title, String message) {
+        if (fragment == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(title);
+        builder.setMessage(message);
+        builder.setPositiveButton("OK", null);
+        builder.setNeutralButton(VoidGram.t("Копировать", "Copy"), (d, w) -> AndroidUtilities.addToClipboard(message));
+        fragment.showDialog(builder.create());
+    }
+
+    private static void missingKey(BaseFragment fragment, String what) {
+        present(fragment, what, VoidGram.t("Добавьте ключ API в VoidGram → Инструменты → Онлайн-инструменты.", "Add an API key in VoidGram → Tools → Online tools."));
+    }
+
+    public static String firstUrl(CharSequence text) {
+        if (text == null) {
+            return null;
+        }
+        Matcher matcher = LINK.matcher(text);
+        return matcher.find() ? matcher.group() : null;
+    }
+
+    // ---- Message menu ----
+
+    /** Message menu → VoidGram tools. */
+    public static void showMessageTools(BaseFragment fragment, MessageObject message) {
+        if (fragment == null || fragment.getParentActivity() == null || message == null) {
+            return;
+        }
+        ArrayList<CharSequence> titles = new ArrayList<>();
+        ArrayList<Runnable> actions = new ArrayList<>();
+        String url = firstUrl(message.messageOwner != null ? message.messageOwner.message : null);
+        if (url != null) {
+            titles.add(VoidGram.t("Проверить ссылку (VirusTotal)", "Check the link (VirusTotal)"));
+            actions.add(() -> checkUrl(fragment, url));
+        }
+        if (message.getDocument() != null || message.isPhoto()) {
+            titles.add(VoidGram.t("Проверить файл (VirusTotal)", "Check the file (VirusTotal)"));
+            actions.add(() -> {
+                File file = FileLoader.getInstance(message.currentAccount).getPathToMessage(message.messageOwner);
+                if (file == null || !file.exists()) {
+                    present(fragment, "VirusTotal", VoidGram.t("Сначала загрузите файл.", "Download the file first."));
+                } else {
+                    String name = message.getDocument() != null ? FileLoader.getDocumentFileName(message.getDocument()) : "photo.jpg";
+                    checkFile(fragment, file, name == null || name.isEmpty() ? file.getName() : name);
+                }
+            });
+        }
+        if (fragment instanceof org.telegram.ui.ChatActivity && VoidGramVideoCircle.canConvert(message)) {
+            titles.add(VoidGram.t("Отправить кружком", "Send as a round video"));
+            actions.add(() -> VoidGramVideoCircle.send((org.telegram.ui.ChatActivity) fragment, message));
+        }
+        if (fragment instanceof org.telegram.ui.ChatActivity && VoidGramAudioToVoice.canConvert(message)) {
+            titles.add(VoidGram.t("Отправить как голосовое", "Send as a voice message"));
+            actions.add(() -> VoidGramAudioToVoice.send((org.telegram.ui.ChatActivity) fragment, message));
+        }
+        String text = message.messageOwner != null ? message.messageOwner.message : null;
+        if (text != null && text.trim().length() > 80) {
+            titles.add(VoidGram.t("Кратко (ИИ)", "Summary (AI)"));
+            actions.add(() -> ask(fragment, VoidGram.t("Кратко", "Summary"), "Shorten the user's message to one to three sentences. Keep its language, names and numbers. Reply with the shortened text only.", text));
+        }
+        if (titles.isEmpty()) {
+            present(fragment, "VoidGram", VoidGram.t("Для этого сообщения инструментов нет: нет ссылки, файла или длинного текста.", "No tools for this message: it has no link, file or long text."));
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(VoidGram.t("Инструменты VoidGram", "VoidGram tools"));
+        builder.setItems(titles.toArray(new CharSequence[0]), (d, which) -> actions.get(which).run());
+        fragment.showDialog(builder.create());
+    }
+
+    // ---- Chat menu ----
+
+    /** Chat menu → Statistics and AI. */
+    public static void showChatTools(BaseFragment fragment, int account, long dialogId, List<MessageObject> loaded) {
+        if (fragment == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        CharSequence[] titles = {
+                VoidGram.t("Статистика чата", "Chat statistics"),
+                VoidGram.t("Что я пропустил (ИИ)", "What did I miss (AI)"),
+                VoidGram.t("Итоги года", "Year in review")
+        };
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(VoidGram.t("Статистика и ИИ", "Statistics and AI"));
+        builder.setItems(titles, (d, which) -> {
+            ArrayList<MessageObject> newest = new ArrayList<>();
+            if (loaded != null) {
+                for (MessageObject message : loaded) {
+                    if (message != null && message.getId() > 0 && message.messageOwner != null) {
+                        newest.add(message);
+                    }
+                }
+            }
+            if (which == 0) {
+                chatStats(fragment, newest.subList(0, Math.min(100, newest.size())));
+            } else if (which == 1) {
+                whatDidIMiss(fragment, newest.subList(0, Math.min(60, newest.size())));
+            } else {
+                yearInReview(fragment, account, dialogId);
+            }
+        });
+        fragment.showDialog(builder.create());
+    }
+
+    private static String authorName(int account, TLRPC.Message message) {
+        MessagesController controller = MessagesController.getInstance(account);
+        if (message.from_id instanceof TLRPC.TL_peerUser) {
+            TLRPC.User user = controller.getUser(message.from_id.user_id);
+            return user != null ? UserObject.getUserName(user) : "?";
+        }
+        long chatId = message.from_id instanceof TLRPC.TL_peerChannel ? message.from_id.channel_id : message.from_id instanceof TLRPC.TL_peerChat ? message.from_id.chat_id : 0;
+        if (chatId == 0 && message.peer_id != null) {
+            chatId = message.peer_id.channel_id != 0 ? message.peer_id.channel_id : message.peer_id.chat_id;
+        }
+        TLRPC.Chat chat = chatId != 0 ? controller.getChat(chatId) : null;
+        return chat != null ? chat.title : "?";
+    }
+
+    private static void chatStats(BaseFragment fragment, List<MessageObject> messages) {
+        String title = VoidGram.t("Статистика чата", "Chat statistics");
+        if (messages.isEmpty()) {
+            present(fragment, title, VoidGram.t("Нет загруженных сообщений.", "No loaded messages."));
+            return;
+        }
+        HashMap<String, Integer> authors = new HashMap<>();
+        int[] hours = new int[24];
+        int characters = 0;
+        Calendar calendar = Calendar.getInstance();
+        int oldest = Integer.MAX_VALUE;
+        for (MessageObject message : messages) {
+            String name = authorName(message.currentAccount, message.messageOwner);
+            authors.put(name, (authors.containsKey(name) ? authors.get(name) : 0) + 1);
