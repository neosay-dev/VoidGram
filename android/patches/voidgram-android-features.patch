+    }
+
+    public static void clear(int account) {
+        Utilities.globalQueue.postRunnable(() -> {
+            try {
+                db(account).getWritableDatabase().delete("peers", null, null);
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+        });
