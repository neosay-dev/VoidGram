@@ -0,0 +1,72 @@
+package org.telegram.ui.voidgram;
+
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.FilterCreateActivity;
+
+import java.util.ArrayList;
+
+/**
+ * Ready-made "smart" chat folders, as on iOS: built from Telegram's own folder rules, so they
+ * sync to every device and update themselves.
+ */
+public final class VoidGramSmartFolders {
+    private VoidGramSmartFolders() {
+    }
+
+    private static final String[][] TITLES = {
+            {"✅ Непрочитанные", "✅ Unread"},
+            {"⭐ Важное", "⭐ Important"},
+            {"👤 Люди", "👤 People"},
+            {"👥 Группы", "👥 Groups"},
+            {"📢 Каналы", "📢 Channels"},
+            {"🤖 Боты", "🤖 Bots"},
+    };
+
+    private static int flags(int index) {
+        int all = MessagesController.DIALOG_FILTER_FLAG_ALL_CHATS;
+        int archived = MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_ARCHIVED;
+        switch (index) {
+            case 0: return all | MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_READ | archived;
+            case 1: return all | MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_READ | MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_MUTED | archived;
+            case 2: return MessagesController.DIALOG_FILTER_FLAG_CONTACTS | MessagesController.DIALOG_FILTER_FLAG_NON_CONTACTS | archived;
+            case 3: return MessagesController.DIALOG_FILTER_FLAG_GROUPS | archived;
+            case 4: return MessagesController.DIALOG_FILTER_FLAG_CHANNELS | archived;
+            default: return MessagesController.DIALOG_FILTER_FLAG_BOTS | archived;
+        }
+    }
+
+    public static void show(BaseFragment fragment) {
+        if (fragment == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        CharSequence[] titles = new CharSequence[TITLES.length];
+        for (int i = 0; i < TITLES.length; i++) {
+            titles[i] = VoidGram.t(TITLES[i][0], TITLES[i][1]);
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(VoidGram.t("Умные папки", "Smart folders"));
+        builder.setMessage(VoidGram.t("Папка создаётся в Telegram и обновляется сама: например, «Важное» — непрочитанные чаты без звука не попадают.", "The folder is created in Telegram and updates itself: for example, Important shows unread chats that are not muted."));
+        builder.setItems(titles, (d, which) -> create(fragment, which));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        fragment.showDialog(builder.create());
+    }
+
+    private static void create(BaseFragment fragment, int index) {
+        MessagesController controller = fragment.getMessagesController();
+        MessagesController.DialogFilter filter = new MessagesController.DialogFilter();
+        filter.id = 2;
+        while (controller.dialogFiltersById.get(filter.id) != null) {
+            filter.id++;
+        }
+        String name = VoidGram.t(TITLES[index][0], TITLES[index][1]);
+        filter.name = name;
+        FilterCreateActivity.saveFilterToServer(filter, flags(index), name, new ArrayList<>(), false, -1, new ArrayList<>(), new ArrayList<>(), new org.telegram.messenger.support.LongSparseIntArray(), true, false, true, true, true, fragment, () -> {
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.contact_check, VoidGram.t("Папка создана — она вверху списка чатов.", "The folder was created; it is at the top of the chat list.")).show();
+        });
+    }
+}
