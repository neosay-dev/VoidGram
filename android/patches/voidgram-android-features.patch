@@ -0,0 +1,216 @@
+package org.telegram.messenger.voidgram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.Utilities;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.security.MessageDigest;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Last.fm scrobbling for the music player, with the user's own API account
+ * (last.fm/api/account/create), as on iOS. "Now playing" is sent when a track starts; a track
+ * longer than 30 s is scrobbled after half its length or four minutes of real listening.
+ */
+public final class VoidGramLastFm {
+    private static final String ENDPOINT = "https://ws.audioscrobbler.com/2.0/";
+
+    private VoidGramLastFm() {
+    }
+
+    private static final class Track {
+        String title;
+        String artist;
+        double duration;
+        long startedAt;
+        String session;
+        double played;
+        double lastPosition;
+        boolean scrobbled;
+    }
+
+    private static Track current;
+
+    /** Keys and the session stay in a private file of the app, apart from the backup. */
+    private static SharedPreferences secure() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("voidgram_lastfm", Context.MODE_PRIVATE);
+    }
+
+    public static String username() {
+        return secure().getString("username", null);
+    }
+
+    public static boolean isConnected() {
+        return username() != null;
+    }
+
+    private static String md5(String value) {
+        try {
+            byte[] hash = MessageDigest.getInstance("MD5").digest(value.getBytes("UTF-8"));
+            StringBuilder builder = new StringBuilder();
+            for (byte b : hash) {
+                builder.append(String.format("%02x", b & 0xff));
+            }
+            return builder.toString();
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private interface Done {
+        void run(JSONObject json);
+    }
+
+    private static void call(Map<String, String> params, Done done) {
+        String apiKey = secure().getString("api_key", null);
+        String secret = secure().getString("secret", null);
+        if (apiKey == null || secret == null) {
+            if (done != null) {
+                done.run(null);
+            }
+            return;
+        }
+        TreeMap<String, String> sorted = new TreeMap<>(params);
+        sorted.put("api_key", apiKey);
+        StringBuilder base = new StringBuilder();
+        for (Map.Entry<String, String> entry : sorted.entrySet()) {
+            base.append(entry.getKey()).append(entry.getValue());
+        }
+        base.append(secret);
+        sorted.put("api_sig", md5(base.toString()));
+        sorted.put("format", "json");
+        Utilities.globalQueue.postRunnable(() -> {
+            JSONObject json = null;
+            HttpURLConnection connection = null;
+            try {
+                StringBuilder body = new StringBuilder();
+                for (Map.Entry<String, String> entry : sorted.entrySet()) {
+                    if (body.length() > 0) {
+                        body.append('&');
+                    }
+                    body.append(entry.getKey()).append('=').append(URLEncoder.encode(entry.getValue(), "UTF-8"));
+                }
+                connection = (HttpURLConnection) new URL(ENDPOINT).openConnection();
+                connection.setRequestMethod("POST");
+                connection.setConnectTimeout(20000);
+                connection.setReadTimeout(20000);
+                connection.setDoOutput(true);
+                connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+                try (OutputStream out = connection.getOutputStream()) {
+                    out.write(body.toString().getBytes("UTF-8"));
+                }
+                InputStream in = connection.getResponseCode() < 400 ? connection.getInputStream() : connection.getErrorStream();
+                if (in != null) {
+                    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                    byte[] buffer = new byte[8192];
+                    int count;
+                    while ((count = in.read(buffer)) > 0) {
+                        bytes.write(buffer, 0, count);
+                    }
+                    in.close();
+                    json = new JSONObject(bytes.toString("UTF-8"));
+                }
+            } catch (Throwable ignore) {
+            } finally {
+                if (connection != null) {
+                    connection.disconnect();
+                }
+            }
+            final JSONObject result = json;
+            if (done != null) {
+                AndroidUtilities.runOnUIThread(() -> done.run(result));
+            }
+        });
+    }
+
+    /** Signs in once; the password is used for the session key and is not stored. */
+    public static void connect(String apiKey, String secret, String username, String password, Utilities.Callback<String> completion) {
+        secure().edit().putString("api_key", apiKey.trim()).putString("secret", secret.trim()).apply();
+        TreeMap<String, String> params = new TreeMap<>();
+        params.put("method", "auth.getMobileSession");
+        params.put("username", username.trim());
+        params.put("password", password);
+        call(params, json -> {
+            JSONObject session = json != null ? json.optJSONObject("session") : null;
+            String key = session != null ? session.optString("key", null) : null;
+            if (key != null && !key.isEmpty()) {
+                secure().edit().putString("session", key).putString("username", username.trim()).apply();
+                completion.run(null);
+            } else {
+                String message = json != null ? json.optString("message", null) : null;
+                completion.run(message != null ? message : VoidGram.t("Last.fm не ответил", "Last.fm did not answer"));
+            }
+        });
+    }
+
+    public static void disconnect() {
+        secure().edit().clear().apply();
+        current = null;
+    }
+
+    public static void trackChanged(String title, String artist, double duration) {
+        String session = secure().getString("session", null);
+        if (!isConnected() || session == null || VoidGramDecoy.isActive()) {
+            return;
+        }
+        if (title == null || title.isEmpty() || artist == null || artist.isEmpty()) {
+            current = null;
+            return;
+        }
+        if (current != null && title.equals(current.title) && artist.equals(current.artist) && !current.scrobbled && current.played < 1) {
+            return;
+        }
+        Track track = new Track();
+        track.title = title;
+        track.artist = artist;
+        track.duration = duration;
+        track.startedAt = System.currentTimeMillis() / 1000;
+        track.session = session;
+        current = track;
+        TreeMap<String, String> params = new TreeMap<>();
+        params.put("method", "track.updateNowPlaying");
+        params.put("track", title);
+        params.put("artist", artist);
+        params.put("sk", session);
+        if (duration > 0) {
+            params.put("duration", String.valueOf((int) duration));
+        }
+        call(params, null);
+    }
+
+    /** Only real listening counts: seeking forward does not add to the played time. */
+    public static void progress(double position, boolean playing) {
+        Track track = current;
+        if (track == null || track.scrobbled) {
+            return;
+        }
+        double delta = position - track.lastPosition;
+        if (playing && delta > 0 && delta < 3.0) {
+            track.played += delta;
+        }
+        track.lastPosition = position;
+        double needed = Math.min(240.0, track.duration / 2.0);
+        if (track.duration > 30.0 && track.played >= needed) {
+            track.scrobbled = true;
+            TreeMap<String, String> params = new TreeMap<>();
+            params.put("method", "track.scrobble");
+            params.put("track", track.title);
+            params.put("artist", track.artist);
+            params.put("timestamp", String.valueOf(track.startedAt));
+            params.put("sk", track.session);
+            params.put("duration", String.valueOf((int) track.duration));
+            call(params, null);
+        }
+    }
+}
