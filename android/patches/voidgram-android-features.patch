+++ b/TMessagesProj/src/main/java/org/telegram/ui/voidgram/VoidGramBulkDownload.java
@@ -0,0 +1,115 @@
+package org.telegram.ui.voidgram;
+
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.voidgram.VoidGram;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+
+import java.util.ArrayList;
+
+/**
+ * "Download all media" of a chat, as on iOS: photos, videos and files are found on the server
+ * (up to 500) and saved one at a time to the gallery and Downloads, with Telegram's own progress.
+ */
+public final class VoidGramBulkDownload {
+    private VoidGramBulkDownload() {
+    }
+
+    private static final int LIMIT = 500;
+
+    public static void start(ChatActivity chat) {
+        if (chat == null || chat.getParentActivity() == null) {
+            return;
+        }
+        if (chat.isPeerNoForwards()) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Этот чат защищён от сохранения", "This chat is protected from saving")).show();
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(chat.getParentActivity());
+        builder.setTitle(VoidGram.t("Скачать все медиа", "Download all media"));
+        builder.setItems(new CharSequence[]{
+                VoidGram.t("Фото и видео", "Photos and videos"),
+                VoidGram.t("Файлы", "Files"),
+                VoidGram.t("Музыка", "Music")
+        }, (d, which) -> collect(chat, which));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        chat.showDialog(builder.create());
+    }
+
+    private static void collect(ChatActivity chat, int kind) {
+        final int account = chat.getCurrentAccount();
+        final long dialogId = chat.getDialogId();
+        final ArrayList<MessageObject> found = new ArrayList<>();
+        final AlertDialog progress = new AlertDialog(chat.getParentActivity(), AlertDialog.ALERT_TYPE_SPINNER);
+        progress.show();
+        final int[] offset = {0};
+        final Runnable[] page = new Runnable[1];
+        page[0] = () -> {
+            TLRPC.TL_messages_search req = new TLRPC.TL_messages_search();
+            req.peer = MessagesController.getInstance(account).getInputPeer(dialogId);
+            req.q = "";
+            req.limit = 100;
+            req.offset_id = offset[0];
+            req.filter = kind == 0 ? new TLRPC.TL_inputMessagesFilterPhotoVideo() : kind == 1 ? new TLRPC.TL_inputMessagesFilterDocument() : new TLRPC.TL_inputMessagesFilterMusic();
+            ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+                boolean more = false;
+                if (response instanceof TLRPC.messages_Messages) {
+                    TLRPC.messages_Messages result = (TLRPC.messages_Messages) response;
+                    MessagesController.getInstance(account).putUsers(result.users, false);
+                    MessagesController.getInstance(account).putChats(result.chats, false);
+                    int next = Integer.MAX_VALUE;
+                    for (TLRPC.Message message : result.messages) {
+                        next = Math.min(next, message.id);
+                        if (message.noforwards || message.media == null || message.media.ttl_seconds > 0) {
+                            continue;
+                        }
+                        found.add(new MessageObject(account, message, false, false));
+                    }
+                    more = !result.messages.isEmpty() && found.size() < LIMIT && next != Integer.MAX_VALUE && (offset[0] == 0 || next < offset[0]);
+                    if (more) {
+                        offset[0] = next;
+                    }
+                }
+                if (more) {
+                    progress.setMessage(VoidGram.t("Найдено: ", "Found: ") + found.size());
+                    AndroidUtilities.runOnUIThread(page[0], 250);
+                    return;
+                }
+                try {
+                    progress.dismiss();
+                } catch (Throwable ignore) {
+                }
+                confirm(chat, found);
+            }));
+        };
+        page[0].run();
+    }
+
+    private static void confirm(ChatActivity chat, ArrayList<MessageObject> found) {
+        if (found.isEmpty()) {
+            BulletinFactory.of(chat).createErrorBulletin(VoidGram.t("Здесь нечего скачивать", "Nothing to download here")).show();
+            return;
+        }
+        while (found.size() > LIMIT) {
+            found.remove(found.size() - 1);
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(chat.getParentActivity());
+        builder.setTitle(VoidGram.t("Скачать все медиа", "Download all media"));
+        builder.setMessage(VoidGram.t("Найдено файлов: ", "Files found: ") + found.size() + VoidGram.t(". Они скачаются по одному и сохранятся в галерею и «Загрузки».", ". They will download one at a time and be saved to the gallery and Downloads."));
+        builder.setPositiveButton(VoidGram.t("Скачать", "Download"), (d, w) -> MediaController.saveFilesFromMessages(chat.getParentActivity(), AccountInstance.getInstance(chat.getCurrentAccount()), found, count -> {
+            if (count > 0) {
+                BulletinFactory.of(chat).createSimpleBulletin(R.raw.ic_download, VoidGram.t("Сохранено файлов: ", "Files saved: ") + count).show();
+            }
+        }));
+        builder.setNegativeButton(VoidGram.t("Отмена", "Cancel"), null);
+        chat.showDialog(builder.create());
+    }
+}
