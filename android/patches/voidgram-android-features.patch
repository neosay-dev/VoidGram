+package org.telegram.messenger.voidgram;
+
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * VoidGram Time Capsule, wire-compatible with iOS: a message sealed until a moment the sender
+ * picks. A zero-width space at the start of the text carries a text-URL entity whose URL holds the
+ * Unix time. Until then VoidGram shows a countdown line and the text under spoiler dust; other
+ * clients show the text as it is.
+ */
+public final class VoidGramTimeCapsule {
+    public static final String MARKER = "​";
+    private static final String URL_PREFIX = "https://example.com/time-capsule#";
+
+    /** The moment the next outgoing text is sealed until (set by the send menu). */
+    public static int pendingOpenDate;
+
+    private VoidGramTimeCapsule() {
+    }
+
+    public static int openDate(ArrayList<TLRPC.MessageEntity> entities) {
+        if (entities == null) {
+            return 0;
+        }
+        for (TLRPC.MessageEntity entity : entities) {
+            if (entity instanceof TLRPC.TL_messageEntityTextUrl && entity.url != null && entity.url.startsWith(URL_PREFIX)) {
+                try {
+                    return Integer.parseInt(entity.url.substring(URL_PREFIX.length()));
+                } catch (NumberFormatException ignore) {
+                }
+            }
+        }
+        return 0;
+    }
+
+    private static int now() {
+        return (int) (System.currentTimeMillis() / 1000);
+    }
+
+    /** Seals the outgoing text when a capsule was asked for. */
+    public static void applyToOutgoing(SendMessagesHelper.SendMessageParams params) {
+        if (pendingOpenDate == 0 || params == null || params.message == null || params.message.isEmpty()) {
+            return;
+        }
+        int openDate = pendingOpenDate;
+        pendingOpenDate = 0;
+        ArrayList<TLRPC.MessageEntity> entities = new ArrayList<>();
+        TLRPC.TL_messageEntityTextUrl capsule = new TLRPC.TL_messageEntityTextUrl();
+        capsule.offset = 0;
+        capsule.length = MARKER.length();
+        capsule.url = URL_PREFIX + openDate;
+        entities.add(capsule);
+        if (params.entities != null) {
+            for (TLRPC.MessageEntity entity : params.entities) {
+                entity.offset += MARKER.length();
+                entities.add(entity);
+            }
+        }
+        params.message = MARKER + params.message;
+        params.entities = entities;
+        params.searchLinks = false;
+    }
+
+    private static boolean isSealed(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null || VoidGramDecoy.isActive()) {
+            return false;
+        }
+        String text = messageObject.messageOwner.message;
+        if (text == null || !text.startsWith(MARKER)) {
+            return false;
+        }
+        return openDate(messageObject.messageOwner.entities) > now();
+    }
+
+    private static String header(int openDate) {
+        return VoidGram.t("⏳ Откроется ", "⏳ Opens ") + LocaleController.formatDateAudio(openDate, true) + "\n";
+    }
+
+    /** The text to draw: for a sealed capsule, the countdown line and then the text. */
+    public static CharSequence displayText(MessageObject messageObject, CharSequence text) {
+        if (!isSealed(messageObject)) {
+            return text;
+        }
+        String body = messageObject.messageOwner.message.substring(MARKER.length());
+        return header(openDate(messageObject.messageOwner.entities)) + body;
+    }
+
+    /**
+     * The entities to draw. A sealed capsule: the text's own entities moved under the countdown
+     * line, and spoiler dust over the whole text. An open one: without the capsule's own link.
+     */
+    public static ArrayList<TLRPC.MessageEntity> displayEntities(MessageObject messageObject, ArrayList<TLRPC.MessageEntity> entities) {
+        int openDate = openDate(entities);
+        if (openDate == 0 || messageObject == null || messageObject.messageOwner == null || messageObject.messageOwner.message == null || !messageObject.messageOwner.message.startsWith(MARKER)) {
+            return entities;
+        }
+        ArrayList<TLRPC.MessageEntity> result = new ArrayList<>();
+        if (!isSealed(messageObject)) {
+            for (TLRPC.MessageEntity entity : entities) {
+                if (!(entity instanceof TLRPC.TL_messageEntityTextUrl && entity.url != null && entity.url.startsWith(URL_PREFIX))) {
+                    result.add(entity);
+                }
+            }
+            return result;
+        }
+        int headerLength = header(openDate).length();
+        int shift = headerLength - MARKER.length();
+        for (TLRPC.MessageEntity entity : entities) {
+            if (entity instanceof TLRPC.TL_messageEntityTextUrl && entity.url != null && entity.url.startsWith(URL_PREFIX)) {
+                continue;
+            }
+            if (entity instanceof TLRPC.TL_messageEntitySpoiler) {
+                continue;
+            }
+            TLRPC.MessageEntity copy;
+            try {
+                copy = entity.getClass().newInstance();
+            } catch (Throwable e) {
+                continue;
+            }
+            copy.offset = entity.offset + shift;
+            copy.length = entity.length;
+            copy.url = entity.url;
+            copy.language = entity.language;
+            if (entity instanceof TLRPC.TL_messageEntityCustomEmoji) {
+                ((TLRPC.TL_messageEntityCustomEmoji) copy).document_id = ((TLRPC.TL_messageEntityCustomEmoji) entity).document_id;
+                ((TLRPC.TL_messageEntityCustomEmoji) copy).document = ((TLRPC.TL_messageEntityCustomEmoji) entity).document;
+            }
+            result.add(copy);
+        }
+        TLRPC.TL_messageEntitySpoiler spoiler = new TLRPC.TL_messageEntitySpoiler();
+        spoiler.offset = headerLength;
+        spoiler.length = messageObject.messageOwner.message.length() - MARKER.length();
+        result.add(spoiler);
+        TLRPC.TL_messageEntityItalic italic = new TLRPC.TL_messageEntityItalic();
+        italic.offset = 0;
+        italic.length = headerLength - 1;
+        result.add(italic);
+        return result;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramTrackTags.java b/TMessagesProj/src/main/java/org/telegram/messenger/voidgram/VoidGramTrackTags.java
