+        "scrubY1": 0.05,
+        "scrubX2": 0.9,
+        "scrubY2": 0.95,
+        "scrubCut": 1.0,
+        "pullCut": 0.8,
+        "ctlScale": 0.9,
+        "shift": -0.5,
+        "unparkNext": 0.0,
+        "flipX2": 0.35,
+        "swapGap": 0.25,
+        "pullRing": 0.47,
+        "pullSlop": 15.0,
+        "scrubSlop": 10.0,
+        "pullCut2": 0.8,
+        "listScrollAt": -0.1,
+        "listScrollDur": 1.5,
+        "listTapAt": -1.0,
+        "ctlDamp": 22.0,
+        "flipDelay": 0.0,
+        "rowLock": 1.0,
+        "pullX2": 0.5,
+        "pull": 265.0,
+        "listBounce": 0.4,
+        "outlineGlyph": 0.0,
+        "glyphSize": 0.0,
+        "rowFling": 0.15,
+        "settleDur": 0.45,
+        "flipY1": 0.4,
+        "swapX1": 0.0,
+        "swapY1": 0.4,
+        "swapX2": 0.0,
+        "swapY2": 1.0,
+        "scrubEase": 1.0,
+        "scrubBounce": 0.0,
+        "settleSlope": 5.0,
+        "settleX1": 0.18,
+        "flipRasterOld": 0.0,
+        "flipLinkLead": 0.013,
+        "y": 485.0,
+        "morphDelay": 0.017,
