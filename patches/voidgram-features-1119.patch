         "fuck", "shit", "bitch", "cunt", "dick", "asshole", "motherf", "bastard", "whore", "slut"
     ]
 
+    private static let prefixes: [String] = ["", "на", "по", "о", "об", "объ", "за", "вы", "от", "отъ", "у", "до", "раз", "рас", "с", "съ", "при", "под", "пере", "ни", "ох", "до"]
+
     public static func isProfanity(_ word: String) -> Bool {
         // Apple's recognizer masks the swear words it hears ("х**", "f***"), so a masked word is one.
         if word.contains("*") {
             return true
         }
-        let lowered = word.lowercased().trimmingCharacters(in: .punctuationCharacters)
-        return roots.contains(where: { lowered.hasPrefix($0) || (lowered.count > 4 && $0.count >= 4 && lowered.contains($0)) })
+        let lowered = word.lowercased().replacingOccurrences(of: "ё", with: "е").trimmingCharacters(in: .punctuationCharacters)
+        // A root behind a prefix ("нахуй", "похуй", "охуеть", "заебал"): short roots used to count only at the start.
+        for prefix in prefixes where lowered.hasPrefix(prefix) {
+            let rest = lowered.dropFirst(prefix.count)
+            if roots.contains(where: { rest.hasPrefix($0.replacingOccurrences(of: "ё", with: "е")) }) {
+                return true
+            }
+        }
+        return roots.contains(where: { lowered.count > 4 && $0.count >= 4 && lowered.contains($0) })
     }
 
     /// Time ranges (seconds) of swear words in 16 kHz mono samples.
