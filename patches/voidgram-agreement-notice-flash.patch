+import Foundation
+import UIKit
+import Display
+
+/// VoidGram's user agreement. It covers the phone number screen until the user scrolls the text
+/// to the very end and taps "I agree"; an account that was already signed in before this screen
+/// existed sees it once over the app (AppDelegate). The text mirrors USER_AGREEMENT.md.
+public final class AyuAgreementView: UIView, UIScrollViewDelegate {
+    private static let acceptedKey = "voidgram.agreement.accepted.v2"
+
+    public static var isAccepted: Bool {
+        return UserDefaults.standard.bool(forKey: acceptedKey)
+    }
+
+    /// Covers `container` with the agreement unless it was accepted. `accepted` runs after the tap.
+    @discardableResult
+    public static func presentIfNeeded(in container: UIView, accepted: (() -> Void)? = nil) -> AyuAgreementView? {
+        if isAccepted {
+            return nil
+        }
+        if let existing = container.subviews.first(where: { $0 is AyuAgreementView }) as? AyuAgreementView {
+            container.bringSubviewToFront(existing)
+            return existing
+        }
+        let view = AyuAgreementView(frame: container.bounds)
+        view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        view.accepted = accepted
+        container.addSubview(view)
+        return view
+    }
+
+    private let ru: Bool
+    private let titleLabel = UILabel()
+    private let scrollView = UIScrollView()
+    private let textLabel = UILabel()
+    private let hintLabel = UILabel()
+    private let button = UIButton(type: .custom)
+    private var reachedEnd = false
+    private var accepted: (() -> Void)?
+
+    override init(frame: CGRect) {
+        self.ru = Locale.preferredLanguages.first?.hasPrefix("ru") ?? false
+        super.init(frame: frame)
+
+        self.backgroundColor = .black
+
+        self.titleLabel.text = self.ru ? "Пользовательское соглашение" : "User Agreement"
+        self.titleLabel.font = Font.semibold(22.0)
+        self.titleLabel.textColor = .white
+        self.titleLabel.textAlignment = .center
+        self.titleLabel.numberOfLines = 0
+        self.addSubview(self.titleLabel)
+
+        self.scrollView.delegate = self
+        self.scrollView.indicatorStyle = .white
+        self.scrollView.alwaysBounceVertical = true
+        self.addSubview(self.scrollView)
+
+        self.textLabel.numberOfLines = 0
+        self.textLabel.attributedText = AyuAgreementView.attributedText(ru: self.ru)
+        self.scrollView.addSubview(self.textLabel)
+
+        self.hintLabel.text = self.ru ? "Долистайте соглашение до конца, чтобы принять его" : "Scroll the agreement to the end to accept it"
+        self.hintLabel.font = Font.regular(13.0)
+        self.hintLabel.textColor = UIColor(white: 1.0, alpha: 0.55)
+        self.hintLabel.textAlignment = .center
+        self.hintLabel.numberOfLines = 0
+        self.addSubview(self.hintLabel)
+
+        self.button.setTitle(self.ru ? "Согласиться" : "I agree", for: .normal)
+        self.button.titleLabel?.font = Font.semibold(17.0)
+        self.button.setTitleColor(.black, for: .normal)
+        self.button.backgroundColor = .white
+        self.button.layer.cornerRadius = 14.0
+        self.button.addTarget(self, action: #selector(self.acceptPressed), for: .touchUpInside)
+        self.addSubview(self.button)
+        self.updateButton()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private static func attributedText(ru: Bool) -> NSAttributedString {
+        let result = NSMutableAttributedString()
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.lineSpacing = 3.0
+        paragraph.paragraphSpacing = 10.0
+        let body: [NSAttributedString.Key: Any] = [.font: Font.regular(15.0), .foregroundColor: UIColor(white: 1.0, alpha: 0.86), .paragraphStyle: paragraph]
+        let bold: [NSAttributedString.Key: Any] = [.font: Font.semibold(15.0), .foregroundColor: UIColor.white, .paragraphStyle: paragraph]
+        for (index, block) in agreementBlocks(ru: ru).enumerated() {
+            if index != 0 {
+                result.append(NSAttributedString(string: "\n", attributes: body))
+            }
+            result.append(NSAttributedString(string: block.0, attributes: block.1 ? bold : body))
+        }
+        return result
+    }
+
