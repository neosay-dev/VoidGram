diff --git a/submodules/TelegramCore/Sources/AyuGram/AyuVoidGramNotice.swift b/submodules/TelegramCore/Sources/AyuGram/AyuVoidGramNotice.swift
new file mode 100644
index 00000000..315c13d2
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuVoidGramNotice.swift
@@ -0,0 +1,149 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// The "I use VoidGram" notice: sent once and pinned in every private chat with a person
+/// (TelegramUI/AyuVoidGramNoticeSender.swift). While VoidGram runs, the notice cannot be
+/// deleted or unpinned from this client: `_internal_deleteMessagesInteractively` drops its id
+/// and `_internal_requestUpdatePinnedMessage` refuses to unpin it; "Unpin all" pins it again.
+public enum AyuVoidGramNotice {
+    public static let text = "Я использую VoidGram — я не гарантирую шифрование нашей переписки и не советую кидать интимные фото или что-то ещё.\n\nI use VoidGram — I do not guarantee the encryption of our conversation and do not recommend sending intimate photos or anything else."
+
+    private static let defaultsKey = "voidgram.notice.v1"
+    private static let lock = NSLock()
+    private static var loaded = false
+    /// "account:peer" → cloud message id of the notice in that chat.
+    private static var ids: [String: Int32] = [:]
+    /// "peer:message" for every notice of every account on this device.
+    private static var protected = Set<String>()
+
+    private static func key(_ accountPeerId: PeerId, _ peerId: PeerId) -> String {
+        return "\(accountPeerId.toInt64()):\(peerId.toInt64())"
+    }
+
+    private static func protectedKey(_ id: MessageId) -> String {
+        return "\(id.peerId.toInt64()):\(id.id)"
+    }
+
+    private static func loadIfNeeded() {
+        if loaded {
+            return
+        }
+        loaded = true
+        if let stored = UserDefaults.standard.dictionary(forKey: defaultsKey) {
+            for (key, value) in stored {
+                if let number = value as? NSNumber {
+                    ids[key] = number.int32Value
+                }
+            }
+        }
+        rebuildProtected()
+    }
+
+    private static func rebuildProtected() {
+        protected = Set(ids.compactMap { key, messageId -> String? in
+            guard let peer = key.split(separator: ":").last else {
+                return nil
+            }
+            return "\(peer):\(messageId)"
+        })
+    }
+
+    private static func save() {
+        UserDefaults.standard.set(ids.mapValues { NSNumber(value: $0) }, forKey: defaultsKey)
+    }
+
+    public static func isNoticeText(_ text: String) -> Bool {
+        return text == AyuVoidGramNotice.text
+    }
+
+    public static func noticeMessageId(accountPeerId: PeerId, peerId: PeerId) -> MessageId? {
+        lock.lock()
+        defer { lock.unlock() }
+        loadIfNeeded()
+        guard let id = ids[key(accountPeerId, peerId)] else {
+            return nil
+        }
+        return MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id)
+    }
+
+    public static func setNoticeMessageId(_ id: MessageId, accountPeerId: PeerId) {
+        lock.lock()
+        defer { lock.unlock() }
+        loadIfNeeded()
+        ids[key(accountPeerId, id.peerId)] = id.id
+        rebuildProtected()
+        save()
+    }
+
+    /// The notice was deleted on the server (by the other person or another client).
+    public static func forgetNotice(accountPeerId: PeerId, peerId: PeerId) {
+        lock.lock()
+        defer { lock.unlock() }
+        loadIfNeeded()
+        ids.removeValue(forKey: key(accountPeerId, peerId))
+        rebuildProtected()
+        save()
+    }
+
+    public static func isProtected(_ id: MessageId) -> Bool {
+        guard id.namespace == Namespaces.Message.Cloud, id.peerId.namespace == Namespaces.Peer.CloudUser else {
+            return false
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        loadIfNeeded()
+        return protected.contains(protectedKey(id))
+    }
+
+    public static func removingProtected(_ messageIds: [MessageId]) -> [MessageId] {
+        return messageIds.filter { !isProtected($0) }
+    }
+
+    public enum Plan {
+        case skip
+        case repin(MessageId)
+        case adopt(MessageId)
+        case send
+    }
+
+    private static func isEligible(peer: Peer?, accountPeerId: PeerId) -> Bool {
+        guard let user = peer as? TelegramUser, user.id.namespace == Namespaces.Peer.CloudUser else {
+            return false
+        }
+        if user.id == accountPeerId || user.botInfo != nil || user.flags.contains(.isSupport) || user.isDeleted {
+            return false
+        }
+        // Telegram's service notifications account.
+        if user.id.id._internalGetInt64Value() == 777000 {
+            return false
+        }
+        return true
+    }
+
+    /// What the chat with `peerId` needs: nothing, the notice pinned again, an existing notice
+    /// remembered (after a reinstall), or a new notice (only when `allowSend`).
+    public static func plan(account: Account, peerId: PeerId, allowSend: Bool) -> Signal<Plan, NoError> {
+        let accountPeerId = account.peerId
+        return account.postbox.transaction { transaction -> Plan in
+            guard AyuVoidGramNotice.isEligible(peer: transaction.getPeer(peerId), accountPeerId: accountPeerId) else {
+                return .skip
+            }
+            let cachedData = transaction.getPeerCachedData(peerId: peerId) as? CachedUserData
+            if let noticeId = AyuVoidGramNotice.noticeMessageId(accountPeerId: accountPeerId, peerId: peerId) {
+                if let message = transaction.getMessage(noticeId) {
+                    return message.tags.contains(.pinned) ? .skip : .repin(noticeId)
+                }
+                if cachedData?.pinnedMessageId == noticeId {
+                    return .skip
+                }
+                // Deleted on the server (by the other person or another client).
+                AyuVoidGramNotice.forgetNotice(accountPeerId: accountPeerId, peerId: peerId)
+            }
+            if let pinnedId = cachedData?.pinnedMessageId, let message = transaction.getMessage(pinnedId), !message.flags.contains(.Incoming), AyuVoidGramNotice.isNoticeText(message.text) {
+                return .adopt(pinnedId)
+            }
+            return allowSend ? .send : .skip
+        }
+    }
+}
