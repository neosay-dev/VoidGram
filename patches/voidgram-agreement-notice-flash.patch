diff --git a/submodules/TelegramUI/Sources/AyuVoidGramNoticeSender.swift b/submodules/TelegramUI/Sources/AyuVoidGramNoticeSender.swift
new file mode 100644
index 00000000..b110cef4
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuVoidGramNoticeSender.swift
@@ -0,0 +1,106 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Sends and pins the "I use VoidGram" notice (TelegramCore/AyuVoidGramNotice.swift) in private
+/// chats with people: once per chat, the first time the user sends something there from
+/// VoidGram, so old and new chats are covered without a mass mailing. Bots, Saved Messages,
+/// Telegram's service account, deleted accounts, secret chats, groups and channels are skipped.
+/// Opening a chat pins the notice again if it was unpinned elsewhere.
+enum AyuVoidGramNoticeSender {
+    private static var inFlight = Set<String>()
+
+    private static func key(_ context: AccountContext, _ peerId: EnginePeer.Id) -> String {
+        return "\(context.account.peerId.toInt64()):\(peerId.toInt64())"
+    }
+
+    private static func pin(context: AccountContext, id: EngineMessage.Id) {
+        let _ = context.engine.messages.requestUpdatePinnedMessage(peerId: id.peerId, update: .pin(id: id, silent: true, forThisPeerOnlyIfPossible: false)).startStandalone()
+    }
+
+    /// Called by the chat before the user's own messages are enqueued. `proceed` runs on the
+    /// main queue after the notice (if any) is queued, so the notice goes out first.
+    static func beforeSending(context: AccountContext, peerId: EnginePeer.Id, messages: [EnqueueMessage], proceed: @escaping () -> Void) {
+        let isScheduled = messages.contains(where: { message in
+            if case let .message(_, attributes, _, _, _, _, _, _, _, _) = message {
+                return attributes.contains(where: { $0 is OutgoingScheduleInfoMessageAttribute })
+            }
+            return false
+        })
+        let key = AyuVoidGramNoticeSender.key(context, peerId)
+        if peerId.namespace != Namespaces.Peer.CloudUser || isScheduled || AyuVoidGramNoticeSender.inFlight.contains(key) {
+            proceed()
+            return
+        }
+        AyuVoidGramNoticeSender.inFlight.insert(key)
+        let _ = (AyuVoidGramNotice.plan(account: context.account, peerId: peerId, allowSend: true)
+        |> deliverOnMainQueue).startStandalone(next: { plan in
+            switch plan {
+            case .skip:
+                AyuVoidGramNoticeSender.inFlight.remove(key)
+            case let .repin(id):
+                AyuVoidGramNoticeSender.inFlight.remove(key)
+                AyuVoidGramNoticeSender.pin(context: context, id: id)
+            case let .adopt(id):
+                AyuVoidGramNoticeSender.inFlight.remove(key)
+                AyuVoidGramNotice.setNoticeMessageId(id, accountPeerId: context.account.peerId)
+            case .send:
+                AyuVoidGramNoticeSender.send(context: context, peerId: peerId, key: key)
+            }
+            proceed()
+        })
+    }
+
+    /// Opening a chat: pin the notice again if it was unpinned. Never sends a new one.
+    static func chatOpened(context: AccountContext, peerId: EnginePeer.Id) {
+        guard peerId.namespace == Namespaces.Peer.CloudUser, !AyuVoidGramNoticeSender.inFlight.contains(AyuVoidGramNoticeSender.key(context, peerId)) else {
+            return
+        }
+        let _ = (AyuVoidGramNotice.plan(account: context.account, peerId: peerId, allowSend: false)
+        |> deliverOnMainQueue).startStandalone(next: { plan in
+            switch plan {
+            case let .repin(id):
+                AyuVoidGramNoticeSender.pin(context: context, id: id)
+            case let .adopt(id):
+                AyuVoidGramNotice.setNoticeMessageId(id, accountPeerId: context.account.peerId)
+            case .skip, .send:
+                break
+            }
+        })
+    }
+
+    private static func send(context: AccountContext, peerId: EnginePeer.Id, key: String) {
+        let correlationId = Int64.random(in: 1 ... Int64.max)
+        let delivered = context.account.pendingMessageManager.deliveredMessageEvents(peerId: peerId)
+        |> mapToSignal { _ -> Signal<EngineMessage.Id, NoError> in
+            if let id = context.engine.messages.synchronouslyLookupCorrelationId(correlationId: correlationId) {
+                return .single(id)
+            }
+            return .complete()
+        }
+        |> take(1)
+        |> timeout(300.0, queue: .mainQueue(), alternate: .complete())
+        |> deliverOnMainQueue
+
+        // Subscribe before enqueueing, so the delivery event cannot be missed.
+        let _ = delivered.startStandalone(next: { id in
+            AyuVoidGramNotice.setNoticeMessageId(id, accountPeerId: context.account.peerId)
+            AyuVoidGramNoticeSender.pin(context: context, id: id)
+        }, completed: {
+            AyuVoidGramNoticeSender.inFlight.remove(key)
+        })
+
+        let _ = enqueueMessages(account: context.account, peerId: peerId, messages: [
+            .message(text: AyuVoidGramNotice.text, attributes: [], inlineStickers: [:], mediaReference: nil, threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: correlationId, bubbleUpEmojiOrStickersets: [])
+        ]).startStandalone()
+    }
+
+    static func isLocked(_ id: EngineMessage.Id) -> Bool {
+        return AyuVoidGramNotice.isProtected(id)
+    }
+
+    static func lockedText(ru: Bool) -> String {
+        return ru ? "Сообщение «Я использую VoidGram» нельзя удалить или открепить, пока вы пользуетесь VoidGram." : "The \"I use VoidGram\" message cannot be deleted or unpinned while you use VoidGram."
+    }
+}
