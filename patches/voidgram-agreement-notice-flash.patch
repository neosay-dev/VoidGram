@@ -0,0 +1,39 @@
+import Foundation
+
+/// Colour of the screen flash used by the front camera while recording a round video message
+/// (VideoMessageCameraScreen). Chosen in Settings → VoidGram → Sending Options.
+public enum AyuVideoNoteFlash {
+    public struct Option: Equatable {
+        public let id: String
+        public let rgb: UInt32
+        public let titleRu: String
+        public let titleEn: String
+
+        public func title(ru: Bool) -> String {
+            return ru ? self.titleRu : self.titleEn
+        }
+    }
+
