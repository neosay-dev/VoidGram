+
+    private func updateButton() {
+        self.button.isEnabled = self.reachedEnd
+        self.button.alpha = self.reachedEnd ? 1.0 : 0.35
+        self.hintLabel.alpha = self.reachedEnd ? 0.0 : 1.0
+    }
+
+    private func checkReachedEnd() {
+        if self.reachedEnd || self.scrollView.bounds.height <= 0.0 {
+            return
+        }
+        let bottom = self.scrollView.contentOffset.y + self.scrollView.bounds.height - self.scrollView.adjustedContentInset.bottom
+        if bottom >= self.scrollView.contentSize.height - 4.0 {
+            self.reachedEnd = true
+            UIView.animate(withDuration: 0.2, animations: {
+                self.updateButton()
+            })
+        }
+    }
+
+    public func scrollViewDidScroll(_ scrollView: UIScrollView) {
+        self.checkReachedEnd()
+    }
+
+    @objc private func acceptPressed() {
+        guard self.reachedEnd else {
+            return
+        }
+        UserDefaults.standard.set(true, forKey: AyuAgreementView.acceptedKey)
+        let accepted = self.accepted
+        UIView.animate(withDuration: 0.25, animations: {
+            self.alpha = 0.0
+        }, completion: { _ in
+            self.removeFromSuperview()
+            accepted?()
+        })
+    }
+
+    override public func layoutSubviews() {
+        super.layoutSubviews()
+
+        let insets = self.safeAreaInsets
+        let side: CGFloat = 20.0
+        let width = self.bounds.width - side * 2.0 - insets.left - insets.right
+        let left = side + insets.left
+
+        let titleSize = self.titleLabel.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+        self.titleLabel.frame = CGRect(x: left, y: insets.top + 16.0, width: width, height: ceil(titleSize.height))
+
+        let buttonHeight: CGFloat = 50.0
+        let buttonY = self.bounds.height - max(insets.bottom, 16.0) - 8.0 - buttonHeight
+        self.button.frame = CGRect(x: left, y: buttonY, width: width, height: buttonHeight)
+
+        let hintSize = self.hintLabel.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+        self.hintLabel.frame = CGRect(x: left, y: buttonY - 8.0 - ceil(hintSize.height), width: width, height: ceil(hintSize.height))
+
+        let scrollTop = self.titleLabel.frame.maxY + 14.0
+        let scrollBottom = self.hintLabel.frame.minY - 10.0
+        self.scrollView.frame = CGRect(x: left, y: scrollTop, width: width, height: max(0.0, scrollBottom - scrollTop))
+        let textSize = self.textLabel.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+        self.textLabel.frame = CGRect(x: 0.0, y: 0.0, width: width, height: ceil(textSize.height))
+        self.scrollView.contentSize = CGSize(width: width, height: ceil(textSize.height) + 8.0)
+
+        // On a large screen the whole text may fit: then there is nothing to scroll.
+        self.checkReachedEnd()
+    }
+}
