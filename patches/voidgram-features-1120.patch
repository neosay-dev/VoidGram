index 00000000..e338c5b9
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuGram/AyuChatNotice.swift
@@ -0,0 +1,84 @@
+import Foundation
+import Postbox
+
+/// The VoidGram privacy notice: before a person's first own message in a private chat or a group,
+/// VoidGram sends this text on their behalf (private chats: pinned for both sides). The sender
+/// cannot delete or unpin it in VoidGram; only the other side can delete it. The user agreement
+/// (AyuLicenseAgreement) tells the user about it before they sign in.
+public enum AyuChatNotice {
+    public static let textRu = "⚠️ Я использую VoidGram. Наша переписка не защищена, поэтому мы (разработчики VoidGram) настоятельно не советуем отправлять этому пользователю какие-либо личные данные, интимные фотографии и так далее. Секретные чаты и одноразовые сообщения не помогут."
+    public static let textEn = "⚠️ I use VoidGram. Our conversation is not protected, so we (the VoidGram developers) strongly advise against sending this user any personal data, intimate photos and so on. Secret chats and view-once messages will not help."
+
+    public static func text(russian: Bool) -> String {
+        return russian ? textRu : textEn
+    }
+
+    public static func isNoticeText(_ text: String) -> Bool {
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        return trimmed == textRu || trimmed == textEn
+    }
+
+    /// The account's own notice: it may not be deleted or unpinned from this app.
+    public static func isProtected(_ message: Message, accountPeerId: PeerId) -> Bool {
+        guard message.media.isEmpty, isNoticeText(message.text) else { return false }
+        if let author = message.author {
+            return author.id == accountPeerId
+        }
+        return !message.flags.contains(.Incoming)
+    }
+
+    // MARK: Sent chats
+
+    private static func sentKey(_ accountPeerId: PeerId) -> String {
+        return "ayu.notice.sent.\(accountPeerId.toInt64())"
+    }
+
+    private static func pinnedKey(_ accountPeerId: PeerId) -> String {
+        return "ayu.notice.pinned.\(accountPeerId.toInt64())"
+    }
+
+    private static let lock = NSLock()
+
+    public static func wasSent(accountPeerId: PeerId, peerId: PeerId) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        let sent = UserDefaults.standard.stringArray(forKey: sentKey(accountPeerId)) ?? []
+        return sent.contains("\(peerId.toInt64())")
+    }
+
+    /// Marks the chat before the notice is even queued, so two quick sends cannot both add one.
+    /// Returns false when it was already marked.
+    public static func markSent(accountPeerId: PeerId, peerId: PeerId) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        var sent = UserDefaults.standard.stringArray(forKey: sentKey(accountPeerId)) ?? []
+        let value = "\(peerId.toInt64())"
+        if sent.contains(value) {
+            return false
+        }
+        sent.append(value)
+        UserDefaults.standard.set(sent, forKey: sentKey(accountPeerId))
+        return true
+    }
+
+    /// The cloud id of the pinned notice in a private chat, kept so the pin can be restored.
+    public static func pinnedNoticeId(accountPeerId: PeerId, peerId: PeerId) -> MessageId? {
+        lock.lock()
+        defer { lock.unlock() }
+        let map = UserDefaults.standard.dictionary(forKey: pinnedKey(accountPeerId)) as? [String: NSNumber] ?? [:]
+        guard let id = map["\(peerId.toInt64())"] else { return nil }
+        return MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id.int32Value)
+    }
+
+    public static func setPinnedNoticeId(accountPeerId: PeerId, id: MessageId?, peerId: PeerId) {
+        lock.lock()
+        defer { lock.unlock() }
+        var map = UserDefaults.standard.dictionary(forKey: pinnedKey(accountPeerId)) as? [String: NSNumber] ?? [:]
+        if let id {
+            map["\(peerId.toInt64())"] = NSNumber(value: id.id)
+        } else {
+            map.removeValue(forKey: "\(peerId.toInt64())")
+        }
+        UserDefaults.standard.set(map, forKey: pinnedKey(accountPeerId))
+    }
+}
