diff --git a/submodules/TelegramUI/Sources/AyuChatNoticeSender.swift b/submodules/TelegramUI/Sources/AyuChatNoticeSender.swift
new file mode 100644
index 00000000..e7fce090
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuChatNoticeSender.swift
@@ -0,0 +1,138 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import PresentationDataUtils
+
+/// Sends the VoidGram privacy notice (AyuChatNotice) before the user's first own message in a
+/// private chat or a group, and keeps it pinned in private chats.
+final class AyuChatNoticePins {
+    static let shared = AyuChatNoticePins()
+
+    private var waiting: [Int64: Disposable] = [:]
+
+    /// Waits until the notice with `correlationId` reaches the server, then pins it for both sides.
+    func pinWhenSent(context: AccountContext, peerId: EnginePeer.Id, correlationId: Int64) {
+        let engine = context.engine
+        let accountPeerId = context.account.peerId
+        let lookup: Signal<EngineMessage.Id?, NoError> = Signal<Void, NoError>.single(Void())
+        |> then(context.account.pendingMessageManager.deliveredMessageEvents(peerId: peerId) |> map { _ -> Void in return Void() })
+        |> map { _ -> EngineMessage.Id? in
+            return engine.messages.synchronouslyLookupCorrelationId(correlationId: correlationId)
+        }
+        let signal: Signal<EngineMessage.Id, NoError> = lookup
+        |> mapToSignal { id -> Signal<EngineMessage.Id, NoError> in
+            if let id {
+                return .single(id)
+            } else {
+                return .complete()
+            }
+        }
+        |> take(1)
+        |> timeout(30.0 * 60.0, queue: Queue.mainQueue(), alternate: Signal<EngineMessage.Id, NoError>.complete())
+        |> deliverOnMainQueue
+
+        self.waiting[correlationId]?.dispose()
+        self.waiting[correlationId] = signal.startStandalone(next: { id in
+            AyuChatNotice.setPinnedNoticeId(accountPeerId: accountPeerId, id: id, peerId: peerId)
+            AyuChatNoticePins.pin(engine: engine, peerId: peerId, id: id)
+        }, completed: { [weak self] in
+            Queue.mainQueue().async {
+                self?.waiting.removeValue(forKey: correlationId)
+            }
+        })
+    }
+
+    static func pin(engine: TelegramEngine, peerId: EnginePeer.Id, id: EngineMessage.Id) {
+        let _ = (engine.messages.requestUpdatePinnedMessage(peerId: peerId, update: .pin(id: id, silent: true, forThisPeerOnlyIfPossible: false))
+        |> `catch` { _ -> Signal<Void, NoError> in
+            return .complete()
+        }).startStandalone()
+    }
+
+    /// Restores the pin when it was removed (for example by "Unpin all" or from another app). When the
+    /// other side deleted the notice, nothing is sent again: deleting it is their right.
+    static func ensurePinned(context: AccountContext, peerId: EnginePeer.Id) {
+        let accountPeerId = context.account.peerId
+        guard !AyuDecoyState.isActive, let id = AyuChatNotice.pinnedNoticeId(accountPeerId: accountPeerId, peerId: peerId) else { return }
+        let engine = context.engine
+        let _ = (engine.data.get(TelegramEngine.EngineData.Item.Messages.Message(id: id))
+        |> deliverOnMainQueue).startStandalone(next: { message in
+            guard let message else {
+                AyuChatNotice.setPinnedNoticeId(accountPeerId: accountPeerId, id: nil, peerId: peerId)
+                return
+            }
+            if AyuChatNotice.isProtected(message._asMessage(), accountPeerId: accountPeerId) && !message.tags.contains(.pinned) {
+                AyuChatNoticePins.pin(engine: engine, peerId: peerId, id: id)
+            }
+        })
+    }
+}
+
+extension ChatControllerImpl {
+    private enum AyuNoticeChatKind {
+        case privateChat
+        case group
+    }
+
+    private func ayuNoticeChatKind(peerId: EnginePeer.Id) -> AyuNoticeChatKind? {
+        guard peerId != self.context.account.peerId, peerId.namespace != Namespaces.Peer.SecretChat else { return nil }
+        guard let peer = self.presentationInterfaceState.renderedPeer?.chatMainPeer, peer.id == peerId else { return nil }
+        if let user = peer as? TelegramUser {
+            // No notice for bots, Telegram's service accounts and deleted accounts.
+            let serviceIds: Set<Int64> = [777000, 333000, 42777, 489000]
+            if user.botInfo != nil || user.flags.contains(.isSupport) || serviceIds.contains(peerId.id._internalGetInt64Value()) || (user.firstName == nil && user.lastName == nil) {
+                return nil
+            }
+            return .privateChat
+        } else if peer is TelegramGroup {
+            return .group
+        } else if let channel = peer as? TelegramChannel, case .group = channel.info {
+            return .group
+        } else {
+            return nil
+        }
+    }
+
+    /// Called right before the user's own messages are queued. Queues the notice first when this
+    /// chat has not had one from this account yet.
+    func ayuSendChatNoticeIfNeeded(peerId: EnginePeer.Id) {
+        guard !AyuDecoyState.isActive, self.subject == nil else { return }
+        guard let kind = self.ayuNoticeChatKind(peerId: peerId) else { return }
+        let accountPeerId = self.context.account.peerId
+        guard AyuChatNotice.markSent(accountPeerId: accountPeerId, peerId: peerId) else {
+            if case .privateChat = kind {
+                AyuChatNoticePins.ensurePinned(context: self.context, peerId: peerId)
+            }
+            return
+        }
+        let code = self.presentationData.strings.baseLanguageCode
+        let russian = ["ru", "uk", "be", "kk"].contains(where: { code.hasPrefix($0) })
+        let correlationId = Int64.random(in: 1 ..< Int64.max)
+        let notice = EnqueueMessage.message(text: AyuChatNotice.text(russian: russian), attributes: [], inlineStickers: [:], mediaReference: nil, threadId: self.chatLocation.threadId, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: correlationId, bubbleUpEmojiOrStickersets: [])
+        let context = self.context
+        let _ = (enqueueMessages(account: context.account, peerId: peerId, messages: [notice])
+        |> deliverOnMainQueue).startStandalone(next: { _ in
+            if case .privateChat = kind {
+                AyuChatNoticePins.shared.pinWhenSent(context: context, peerId: peerId, correlationId: correlationId)
+            }
+        })
+    }
+
+    /// The own notice in this chat stays pinned: unpinning it from VoidGram is refused.
+    func ayuRefusesUnpin(_ id: EngineMessage.Id) -> Bool {
+        let accountPeerId = self.context.account.peerId
+        var isNotice = AyuChatNotice.pinnedNoticeId(accountPeerId: accountPeerId, peerId: id.peerId) == id
+        if !isNotice, let message = self.chatDisplayNode.historyNode.messageInCurrentHistoryView(id) {
+            isNotice = AyuChatNotice.isProtected(message._asMessage(), accountPeerId: accountPeerId)
+        }
+        guard isNotice else { return false }
+        let code = self.presentationData.strings.baseLanguageCode
+        let russian = ["ru", "uk", "be", "kk"].contains(where: { code.hasPrefix($0) })
+        let alert = textAlertController(context: self.context, title: nil, text: russian ? "Предупреждение VoidGram остаётся закреплённым. Удалить его может только собеседник." : "The VoidGram notice stays pinned. Only the other person can delete it.", actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})])
+        self.present(alert, in: .window(.root))
+        return true
+    }
+}
