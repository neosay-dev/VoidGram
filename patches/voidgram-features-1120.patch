index 00000000..11353e89
--- /dev/null
+++ b/submodules/TelegramUIPreferences/Sources/AyuPlayerNightLook.swift
@@ -0,0 +1,151 @@
+import Foundation
+import UIKit
+
+/// The music player's night look (Settings → VoidGram → Media → Player night look, or the player's
+/// lyrics menu): a darker, optionally warm backdrop and less glare from the white text. It can run
+/// on a schedule, always, or be switched off completely.
+public enum AyuPlayerNightLook: Int, CaseIterable {
+    case automatic = 0
+    case always = 1
+    case never = 2
+
+    public enum Strength: Int, CaseIterable {
+        case soft = 0
+        case medium = 1
+        case strong = 2
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .soft: return russian ? "Слабо" : "Soft"
+            case .medium: return russian ? "Средне" : "Medium"
+            case .strong: return russian ? "Сильно" : "Strong"
+            }
+        }
+    }
+
+    private static let modeKey = "ayu.player.night"
+    private static let startKey = "ayu.player.night.start"
+    private static let endKey = "ayu.player.night.end"
+    private static let strengthKey = "ayu.player.night.strength"
+    private static let warmKey = "ayu.player.night.warm"
+
+    public static let didChangeNotification = Notification.Name("VoidGram.PlayerNightLookChanged")
+
+    private static func changed() {
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    /// `.never` switches the night look off completely.
+    public static var current: AyuPlayerNightLook {
+        get { return AyuPlayerNightLook(rawValue: UserDefaults.standard.integer(forKey: modeKey)) ?? .automatic }
+        set {
+            UserDefaults.standard.set(newValue.rawValue, forKey: modeKey)
+            changed()
+        }
+    }
+
+    /// The hour the automatic night look starts (0…23), 22 by default.
+    public static var startHour: Int {
+        get { return min(23, max(0, UserDefaults.standard.object(forKey: startKey) as? Int ?? 22)) }
+        set {
+            UserDefaults.standard.set(min(23, max(0, newValue)), forKey: startKey)
+            changed()
+        }
+    }
+
+    /// The hour the automatic night look ends (0…23), 7 by default.
+    public static var endHour: Int {
+        get { return min(23, max(0, UserDefaults.standard.object(forKey: endKey) as? Int ?? 7)) }
+        set {
+            UserDefaults.standard.set(min(23, max(0, newValue)), forKey: endKey)
+            changed()
+        }
+    }
+
+    public static var strength: Strength {
+        get { return Strength(rawValue: UserDefaults.standard.object(forKey: strengthKey) as? Int ?? 1) ?? .medium }
+        set {
+            UserDefaults.standard.set(newValue.rawValue, forKey: strengthKey)
+            changed()
+        }
+    }
+
+    /// Warm (amber) tint; off gives a neutral dark one.
+    public static var isWarm: Bool {
+        get { return UserDefaults.standard.object(forKey: warmKey) as? Bool ?? true }
+        set {
+            UserDefaults.standard.set(newValue, forKey: warmKey)
+            changed()
+        }
+    }
+
+    public static func resetSettings() {
+        for key in [startKey, endKey, strengthKey, warmKey] {
+            UserDefaults.standard.removeObject(forKey: key)
+        }
+        changed()
+    }
+
+    /// Whether `hour` falls in the schedule. A window may cross midnight (22 → 7); equal hours
+    /// mean the whole day.
+    public static func isNightHour(_ hour: Int, start: Int = AyuPlayerNightLook.startHour, end: Int = AyuPlayerNightLook.endHour) -> Bool {
+        if start == end {
+            return true
+        } else if start < end {
+            return hour >= start && hour < end
+        } else {
+            return hour >= start || hour < end
+        }
+    }
+
+    public static var isActiveNow: Bool {
+        switch current {
+        case .always:
+            return true
+        case .never:
+            return false
+        case .automatic:
+            return isNightHour(Calendar.current.component(.hour, from: Date()))
+        }
+    }
+
+    /// Opacity of the tint over the backdrop.
+    public static var tintAlpha: CGFloat {
+        switch strength {
+        case .soft: return 0.25
+        case .medium: return 0.42
+        case .strong: return 0.6
+        }
+    }
+
+    /// Opacity of the glare filter over the whole player (text and controls).
+    public static var glareAlpha: CGFloat {
+        switch strength {
+        case .soft: return 0.12
+        case .medium: return 0.22
+        case .strong: return 0.34
+        }
+    }
+
+    public static var tintColor: UIColor {
+        return isWarm ? UIColor(red: 0.16, green: 0.08, blue: 0.02, alpha: 1.0) : UIColor(red: 0.02, green: 0.03, blue: 0.06, alpha: 1.0)
+    }
+
+    public static var glareColor: UIColor {
+        return isWarm ? UIColor(red: 0.04, green: 0.02, blue: 0.0, alpha: 1.0) : UIColor.black
+    }
+
+    public static func hourText(_ hour: Int) -> String {
+        return String(format: "%02d:00", hour)
+    }
+
+    public func title(_ russian: Bool) -> String {
+        switch self {
+        case .automatic:
+            let window = AyuPlayerNightLook.hourText(AyuPlayerNightLook.startHour) + "–" + AyuPlayerNightLook.hourText(AyuPlayerNightLook.endHour)
+            return (russian ? "По расписанию " : "Scheduled ") + window
+        case .always: return russian ? "Всегда" : "Always"
+        case .never: return russian ? "Выключен полностью" : "Off completely"
+        }
+    }
+}
