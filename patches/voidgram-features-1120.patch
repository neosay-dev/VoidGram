new file mode 100644
index 00000000..7b1bfda1
--- /dev/null
+++ b/submodules/AccountContext/Sources/AyuMiniLyrics.swift
@@ -0,0 +1,96 @@
+import Foundation
+import SwiftSignalKit
+
+/// The current lyrics line for the minimized music player (the bar under the navigation bar):
+/// while a track with timed lyrics plays, the bar shows the line being sung in place of the
+/// track title. TelegramUI installs `fetch` (the same lookup as the full player, custom texts
+/// included) and pushes texts the user edits; the bar only reads.
+public final class AyuMiniLyrics {
+    public static let shared = AyuMiniLyrics()
+
+    public struct Line: Equatable {
+        public let time: Double
+        public let endTime: Double
+        public let text: String
+
+        public init(time: Double, endTime: Double, text: String) {
+            self.time = time
+            self.endTime = endTime
+            self.text = text
+        }
+    }
+
+    private static let enabledKey = "ayu.player.miniLyrics"
+    public static let didUpdateNotification = Notification.Name("VoidGram.MiniLyricsUpdated")
+
+    /// On by default; Player → lyrics options → "Lyrics in the mini player".
+    public static var isEnabled: Bool {
+        get { return UserDefaults.standard.object(forKey: enabledKey) as? Bool ?? true }
+        set {
+            UserDefaults.standard.set(newValue, forKey: enabledKey)
+            NotificationCenter.default.post(name: didUpdateNotification, object: nil)
+        }
+    }
+
+    /// Timed lines for a track (title, artist, duration), or nil when it has none.
+    public var fetch: ((String, String?, Double) -> Signal<[Line]?, NoError>)?
+
+    private var key: String?
+    private var lines: [Line] = []
+    private let disposable = MetaDisposable()
+
+    private init() {
+    }
+
+    private static func key(title: String, artist: String?) -> String {
+        return title.lowercased() + "\u{0}" + (artist ?? "").lowercased()
+    }
+
+    /// The per-track timing adjustment the full player saves (Lyrics 0.5 s earlier / later).
+    public static func offset(accountPeerId: Int64, title: String, artist: String?, duration: Double) -> Double {
+        let identity = "\(accountPeerId)|\(title)|\(artist ?? "")|\(Int(duration))"
+        return UserDefaults.standard.double(forKey: "ayu.lyrics." + Data(identity.utf8).base64EncodedString())
+    }
+
+    /// Starts a lookup for this track unless one is loaded or running. Main thread.
+    public func request(title: String, artist: String?, duration: Double) {
+        let key = AyuMiniLyrics.key(title: title, artist: artist)
+        guard AyuMiniLyrics.isEnabled, self.key != key, let fetch = self.fetch, duration > 0.0 else { return }
+        self.key = key
+        self.lines = []
+        self.disposable.set((fetch(title, artist, duration)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] lines in
+            guard let self, self.key == key else { return }
+            self.lines = lines ?? []
+            NotificationCenter.default.post(name: AyuMiniLyrics.didUpdateNotification, object: nil)
+        }))
+    }
+
+    /// The full player loaded or the user edited this track's text: use it at once.
+    public func update(title: String, artist: String?, lines: [Line]?) {
+        let key = AyuMiniLyrics.key(title: title, artist: artist)
+        self.disposable.set(nil)
+        self.key = key
+        self.lines = lines ?? []
+        NotificationCenter.default.post(name: AyuMiniLyrics.didUpdateNotification, object: nil)
+    }
+
+    /// The line being sung at `timestamp`, or nil (no timed lyrics, before the first line, or an
+    /// instrumental gap).
+    public func line(title: String, artist: String?, at timestamp: Double) -> String? {
+        guard AyuMiniLyrics.isEnabled, self.key == AyuMiniLyrics.key(title: title, artist: artist), !self.lines.isEmpty, timestamp.isFinite else { return nil }
+        var low = 0
+        var high = self.lines.count
+        while low < high {
+            let middle = (low + high) / 2
+            if self.lines[middle].time <= timestamp { low = middle + 1 } else { high = middle }
+        }
+        guard low > 0 else { return nil }
+        let line = self.lines[low - 1]
+        let text = line.text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if text.isEmpty || (line.endTime > line.time && timestamp > line.endTime + 1.5) {
+            return nil
+        }
+        return text
+    }
+}
