+import Foundation
+import UIKit
+import Display
+import TelegramPresentationData
+
+/// The VoidGram user agreement. It is shown before the sign-in screen (and once to people who were
+/// already signed in when it appeared), over everything else in the window. "Accept" works only
+/// after the text has been scrolled to its very end.
+enum AyuLicenseAgreement {
+    /// Bump when the text changes in substance: everyone accepts it again.
+    static let version = 1
+    private static let key = "ayu.license.acceptedVersion"
+
+    static var isAccepted: Bool {
+        return UserDefaults.standard.integer(forKey: key) >= version
+    }
+
+    private static weak var shownView: AyuLicenseAgreementView?
+
+    /// Shows the agreement over `window` unless it is accepted or already showing.
+    static func presentIfNeeded(in window: UIWindow?, presentationData: PresentationData) {
+        guard !isAccepted, shownView == nil, let window else { return }
+        let code = presentationData.strings.baseLanguageCode
+        let preferred = Locale.preferredLanguages.first ?? ""
+        let russian = ["ru", "uk", "be", "kk"].contains(where: { code.hasPrefix($0) || preferred.hasPrefix($0) })
+        let view = AyuLicenseAgreementView(frame: window.bounds, russian: russian, accentColor: presentationData.theme.list.itemAccentColor)
+        view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        view.accepted = { [weak view] in
+            UserDefaults.standard.set(version, forKey: key)
+            UIView.animate(withDuration: 0.25, animations: {
+                view?.alpha = 0.0
+            }, completion: { _ in
+                view?.removeFromSuperview()
+            })
+        }
+        window.endEditing(true)
+        window.addSubview(view)
+        shownView = view
+    }
+
+    static func text(russian: Bool) -> String {
+        if russian {
+            return """
+            Пользовательское соглашение VoidGram
+
+            Пожалуйста, внимательно прочитайте это соглашение до конца. Кнопка «Принимаю» станет доступна только после того, как вы долистаете текст до самого низа. Нажимая «Принимаю», вы подтверждаете, что прочитали, поняли и полностью согласны со всеми условиями ниже. Если вы не согласны — не пользуйтесь VoidGram и удалите приложение.
+
+            1. Неофициальный клиент
+            VoidGram — неофициальный клиент Telegram. Он не связан с Telegram FZ-LLC, Telegram Messenger Inc. и их партнёрами, не одобрен и не поддерживается ими. Названия и товарные знаки Telegram принадлежат их владельцам.
+
+            2. «Как есть», без гарантий
+            VoidGram предоставляется «как есть» и «как доступно», без каких-либо гарантий — явных или подразумеваемых, включая гарантии работоспособности, безопасности, точности, совместимости, пригодности для определённой цели и отсутствия ошибок. Приложение может работать нестабильно, терять данные или перестать работать в любой момент.
+
+            3. Отказ от ответственности
+            Разработчики, участники проекта и распространители VoidGram не несут НИКАКОЙ ответственности за любой прямой, косвенный, случайный, особый или последующий ущерб, связанный с использованием или невозможностью использования приложения. В том числе, но не только, за:
+            • блокировку, ограничение, заморозку или удаление вашего аккаунта Telegram;
+            • потерю, повреждение, утечку или раскрытие переписки, медиа, контактов и любых других данных;
+            • действия других пользователей, ботов, плагинов и третьих лиц;
+            • финансовые потери, включая звёзды, подарки, NFT и подписки;
+            • последствия нарушения правил Telegram, законов вашей страны или прав третьих лиц.
+            Вся ответственность за использование VoidGram лежит только на вас.
+
+            4. Правила Telegram
+            Некоторые функции VoidGram (например, режим призрака, сохранение удалённых и изменённых сообщений, сохранение одноразовых медиа) могут противоречить Условиям использования Telegram API и Условиям обслуживания Telegram. Включая такие функции, вы делаете это на свой страх и риск и понимаете, что Telegram может ограничить ваш аккаунт.
+
+            5. Конфиденциальность переписки
+            VoidGram может сохранять на устройстве удалённые и изменённые сообщения, одноразовые фото, видео и голосовые сообщения, а также позволяет делать снимки экрана там, где обычный Telegram их запрещает. Поэтому переписку с пользователем VoidGram нельзя считать защищённой — ни в обычных, ни в секретных чатах, ни через одноразовые сообщения.
+
+            6. Автоматическое предупреждение собеседников
+            Чтобы ваши собеседники знали об этом, VoidGram автоматически отправляет от вашего имени предупреждающее сообщение:
+            • в каждый личный чат — один раз, и закрепляет его. Вы не можете удалить или открепить это сообщение в VoidGram; удалить его может только ваш собеседник;
+            • в каждую группу, где вы пишете, — один раз, без закрепления.
+            Сообщение отправляется перед вашим первым сообщением в этом чате. Принимая соглашение, вы соглашаетесь на эту отправку.
+
+            7. Плагины и сторонний код
+            Плагины, темы и скрипты пишут третьи лица. Разработчики VoidGram их не проверяют полностью и не отвечают за их работу, безопасность и последствия использования. Устанавливайте только то, чему доверяете.
+
+            8. Данные
+            Настройки, история и архивы VoidGram хранятся локально на вашем устройстве. Для значков и некоторых функций приложение обращается к серверу VoidGram. Разработчики не обязаны хранить, восстанавливать или передавать ваши данные.
