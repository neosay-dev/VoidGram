+        self.acceptButton.layer.cornerRadius = 12.0
+        self.acceptButton.layer.cornerCurve = .continuous
+        self.acceptButton.addTarget(self, action: #selector(self.acceptPressed), for: .touchUpInside)
+
+        self.declineButton.setTitle(russian ? "Не принимаю" : "Decline", for: .normal)
+        self.declineButton.titleLabel?.font = UIFont.systemFont(ofSize: 15.0)
+        self.declineButton.setTitleColor(UIColor.secondaryLabel, for: .normal)
+        self.declineButton.addTarget(self, action: #selector(self.declinePressed), for: .touchUpInside)
