+++ b/submodules/SettingsUI/Sources/AyuPlayerNightLookController.swift
@@ -0,0 +1,135 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import AccountContext
+
+// Settings → VoidGram → Media → Player night look.
+
+private enum AyuNightRow {
+    static let modeHeader: Int32 = 0
+    static let mode: Int32 = 1
+    static let off: Int32 = 2
+    static let modeInfo: Int32 = 3
+    static let startHeader: Int32 = 10
+    static let start: Int32 = 11
+    static let endHeader: Int32 = 12
+    static let end: Int32 = 13
+    static let scheduleInfo: Int32 = 14
+    static let lookHeader: Int32 = 20
+    static let strength: Int32 = 21
+    static let warm: Int32 = 22
+    static let reset: Int32 = 30
+}
+
+public func ayuPlayerNightLookController(context: AccountContext) -> ViewController {
+    let changed = Signal<Void, NoError> { subscriber in
+        subscriber.putNext(Void())
+        let observer = NotificationCenter.default.addObserver(forName: AyuPlayerNightLook.didChangeNotification, object: nil, queue: .main, using: { _ in subscriber.putNext(Void()) })
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+
+    func present(_ sheet: UIAlertController) {
+        if let popover = sheet.popoverPresentationController, let view = context.sharedContext.mainWindow?.viewController?.view {
+            popover.sourceView = view
+            popover.sourceRect = CGRect(x: view.bounds.midX, y: view.bounds.midY, width: 1.0, height: 1.0)
+            popover.permittedArrowDirections = []
+        }
+        context.sharedContext.applicationBindings.presentNativeController(sheet)
+    }
+
+    var arguments = AyuSectionedArguments(open: { id in
+        let ru = ayuIsRussian(context)
+        switch id {
+        case AyuNightRow.mode:
+            let sheet = UIAlertController(title: ru ? "Когда включать" : "When to turn on", message: nil, preferredStyle: .actionSheet)
+            for mode in AyuPlayerNightLook.allCases {
+                sheet.addAction(UIAlertAction(title: mode.title(ru) + (mode == AyuPlayerNightLook.current ? " ✓" : ""), style: mode == .never ? .destructive : .default, handler: { _ in
+                    AyuPlayerNightLook.current = mode
+                }))
+            }
+            sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            present(sheet)
+        case AyuNightRow.strength:
+            let sheet = UIAlertController(title: ru ? "Сила затемнения" : "Dimming", message: nil, preferredStyle: .actionSheet)
+            for strength in AyuPlayerNightLook.Strength.allCases {
+                sheet.addAction(UIAlertAction(title: strength.title(ru) + (strength == AyuPlayerNightLook.strength ? " ✓" : ""), style: .default, handler: { _ in
+                    AyuPlayerNightLook.strength = strength
+                }))
+            }
+            sheet.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+            present(sheet)
+        case AyuNightRow.reset:
+            AyuPlayerNightLook.resetSettings()
+        default:
+            break
+        }
+    }, toggle: { id, value in
+        switch id {
+        case AyuNightRow.off:
+            // "Night look" switch: off is the complete shutdown; on returns to the schedule.
+            AyuPlayerNightLook.current = value ? .automatic : .never
+        case AyuNightRow.warm:
+            AyuPlayerNightLook.isWarm = value
+        default:
+            break
+        }
+    })
+    arguments.slider = { id, value in
+        switch id {
+        case AyuNightRow.start:
+            AyuPlayerNightLook.startHour = Int(value)
+        case AyuNightRow.end:
+            AyuPlayerNightLook.endHour = Int(value)
+        default:
+            break
+        }
+    }
+    let finalArguments = arguments
+
+    let signal = combineLatest(context.sharedContext.presentationData, changed)
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let mode = AyuPlayerNightLook.current
+        let enabled = mode != .never
+        let status: String
+        if !enabled {
+            status = ru ? "Ночной режим выключен полностью: плеер всегда выглядит как днём." : "The night look is off completely: the player always looks as in the daytime."
+        } else {
+            status = AyuPlayerNightLook.isActiveNow ? (ru ? "Сейчас ночной режим включён." : "The night look is on now.") : (ru ? "Сейчас ночной режим не действует." : "The night look is not active now.")
+        }
+
+        var entries: [AyuSectionedEntry] = [
+            .header(1, AyuNightRow.modeHeader, ru ? "НОЧНОЙ РЕЖИМ ПЛЕЕРА" : "PLAYER NIGHT LOOK"),
+            .toggle(1, AyuNightRow.off, AyuSettingsIcons.symbol("moon.stars.fill", color: UIColor(rgb: 0x5856D6)), ru ? "Ночной режим" : "Night look", nil, enabled)
+        ]
+        if enabled {
+            entries.append(.link(1, AyuNightRow.mode, AyuSettingsIcons.symbol("clock.fill", color: UIColor(rgb: 0xFF9500)), ru ? "Когда включать" : "When to turn on", mode == .always ? mode.title(ru) : (ru ? "По расписанию" : "Scheduled")))
+        }
+        entries.append(.info(1, AyuNightRow.modeInfo, status))
+
+        if enabled {
+            if mode == .automatic {
+                entries.append(.header(2, AyuNightRow.startHeader, (ru ? "НАЧАЛО: " : "STARTS: ") + AyuPlayerNightLook.hourText(AyuPlayerNightLook.startHour)))
+                entries.append(.slider(2, AyuNightRow.start, Int32(AyuPlayerNightLook.startHour), 0, 23))
+                entries.append(.header(2, AyuNightRow.endHeader, (ru ? "КОНЕЦ: " : "ENDS: ") + AyuPlayerNightLook.hourText(AyuPlayerNightLook.endHour)))
+                entries.append(.slider(2, AyuNightRow.end, Int32(AyuPlayerNightLook.endHour), 0, 23))
+                entries.append(.info(2, AyuNightRow.scheduleInfo, ru ? "Время по часам устройства. Окно может переходить через полночь (22:00–07:00). Одинаковые часы — весь день." : "Device clock time. The window may cross midnight (22:00–07:00). Equal hours mean the whole day."))
+            }
+            entries.append(.header(3, AyuNightRow.lookHeader, ru ? "ВИД" : "LOOK"))
+            entries.append(.link(3, AyuNightRow.strength, AyuSettingsIcons.symbol("circle.lefthalf.filled", color: UIColor(rgb: 0x8E8E93)), ru ? "Сила затемнения" : "Dimming", AyuPlayerNightLook.strength.title(ru)))
+            entries.append(.toggle(3, AyuNightRow.warm, AyuSettingsIcons.symbol("flame.fill", color: UIColor(rgb: 0xFF9500)), ru ? "Тёплый оттенок" : "Warm tint", ru ? "Выключите для нейтрального тёмного" : "Off for a neutral dark one", AyuPlayerNightLook.isWarm))
+            entries.append(.link(4, AyuNightRow.reset, AyuSettingsIcons.symbol("arrow.counterclockwise", color: UIColor(rgb: 0xFF3B30)), ru ? "Сбросить настройки вида и времени" : "Reset look and schedule", ""))
+        }
+
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(ru ? "Ночной режим плеера" : "Player night look"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: true), finalArguments))
+    }
+    return ItemListController(context: context, state: signal)
+}
