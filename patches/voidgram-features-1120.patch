diff --git a/submodules/TelegramUI/Sources/AyuUserLyrics.swift b/submodules/TelegramUI/Sources/AyuUserLyrics.swift
new file mode 100644
index 00000000..2860701c
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuUserLyrics.swift
@@ -0,0 +1,195 @@
+import Foundation
+import UIKit
+import CryptoKit
+import SwiftSignalKit
+import AccountContext
+
+/// Lyrics the user typed or corrected in the player. They live in Application Support (not the
+/// cache, so the system never drops them), one file per song (title + artist), and win over every
+/// online source. LRC timestamps make them timed; anything else is plain text.
+enum AyuUserLyrics {
+    private struct Entry: Codable {
+        let updated: Date
+        let title: String
+        let artist: String?
+        let source: String
+    }
+
+    private static var directory: URL? {
+        return FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?.appendingPathComponent("ayu-user-lyrics-v1", isDirectory: true)
+    }
+
+    private static func key(title: String, artist: String?) -> String {
+        let identity = title.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() + "\u{0}" + (artist ?? "").trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        return SHA256.hash(data: Data(identity.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func source(title: String, artist: String?) -> String? {
+        guard let directory, let data = try? Data(contentsOf: directory.appendingPathComponent(key(title: title, artist: artist) + ".json")), data.count <= 1_048_576, let entry = try? JSONDecoder().decode(Entry.self, from: data) else { return nil }
+        return entry.source
+    }
+
+    static func has(title: String, artist: String?) -> Bool {
+        return source(title: title, artist: artist) != nil
+    }
+
+    /// The saved text as lyrics for a track of `duration` seconds.
+    static func load(title: String, artist: String?, duration: Double) -> AyuLyrics? {
+        guard let source = source(title: title, artist: artist) else { return nil }
+        return parse(source, duration: duration)
+    }
+
+    static func parse(_ source: String, duration: Double) -> AyuLyrics? {
+        let trimmed = source.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return nil }
+        var lines = ayuParseLyricsfile(trimmed, duration: duration > 0.0 ? duration : nil)
+        if lines.isEmpty {
+            lines = ayuParseLrc(trimmed, duration: duration > 0.0 ? duration : nil)
+        }
+        if !lines.isEmpty {
+            return .synced(lines)
+        }
+        return .plain(trimmed)
+    }
+
+    /// Saves `source`; an empty text removes the saved one. Returns false when it cannot be written.
+    @discardableResult
+    static func save(_ source: String, title: String, artist: String?) -> Bool {
+        let trimmed = source.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let directory else { return false }
+        let url = directory.appendingPathComponent(key(title: title, artist: artist) + ".json")
+        if trimmed.isEmpty {
+            try? FileManager.default.removeItem(at: url)
+            return true
+        }
+        guard trimmed.utf8.count <= 512 * 1024, let data = try? JSONEncoder().encode(Entry(updated: Date(), title: title, artist: artist, source: trimmed)) else { return false }
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            try data.write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            return true
+        } catch {
+            return false
+        }
+    }
+
+    static func remove(title: String, artist: String?) {
+        guard let directory else { return }
+        try? FileManager.default.removeItem(at: directory.appendingPathComponent(key(title: title, artist: artist) + ".json"))
+    }
+
+    /// Editable text for lyrics on screen: timed lines become LRC ("[01:02.35] text"), so the
+    /// timing survives an edit; plain text stays as it is.
+    static func editableText(_ lyrics: AyuLyrics?) -> String {
+        guard let lyrics else { return "" }
+        switch lyrics {
+        case let .synced(lines):
+            return lines.map { line in
+                let time = max(0.0, line.time)
+                let minutes = Int(time) / 60
+                let seconds = time - Double(minutes * 60)
+                return String(format: "[%02d:%05.2f] ", minutes, seconds) + line.text
+            }.joined(separator: "\n")
+        case let .plain(text):
+            return text
+        case .instrumental, .notFound:
+            return ""
+        }
+    }
+}
+
+/// Timed lines for the mini player, from the same lookup as the full player.
+func ayuInstallMiniLyrics() {
+    AyuMiniLyrics.shared.fetch = { title, artist, duration in
+        return ayuFetchLyrics(title: title, artist: artist, duration: duration)
+        |> deliverOn(Queue.concurrentDefaultQueue())
+        |> map { lyrics -> [AyuMiniLyrics.Line]? in
+            if case let .synced(lines) = ayuApplyLyricsPlugins(lyrics) {
+                return lines.map { AyuMiniLyrics.Line(time: $0.time, endTime: $0.endTime, text: $0.text) }
+            }
+            return nil
+        }
+    }
+}
+
+/// A full-screen text editor for the player's lyrics.
+final class AyuLyricsEditorController: UIViewController, UITextViewDelegate {
+    private let russian: Bool
+    private let initialText: String
+    private let songTitle: String
+    private let completion: (String?) -> Void
+    private let textView = UITextView()
+    private let hintLabel = UILabel()
+
+    /// `completion(nil)`: cancelled; otherwise the text to save (empty: remove the custom text).
+    init(title: String, text: String, russian: Bool, completion: @escaping (String?) -> Void) {
+        self.songTitle = title
+        self.initialText = text
+        self.russian = russian
+        self.completion = completion
+        super.init(nibName: nil, bundle: nil)
+        self.modalPresentationStyle = .formSheet
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = UIColor.systemBackground
+        self.navigationItem.title = self.songTitle
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(barButtonSystemItem: .cancel, target: self, action: #selector(self.cancelPressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: self.russian ? "Сохранить" : "Save", style: .done, target: self, action: #selector(self.savePressed))
+
+        self.hintLabel.text = self.russian ? "Каждая строка — отдельная строка песни. Чтобы текст шёл синхронно, оставьте или добавьте время в начале строки: [01:23.45] Текст строки." : "One line per line of the song. To keep the text in sync, keep or add a time at the start of a line: [01:23.45] Line text."
+        self.hintLabel.font = UIFont.preferredFont(forTextStyle: .footnote)
+        self.hintLabel.textColor = UIColor.secondaryLabel
+        self.hintLabel.numberOfLines = 0
+        self.hintLabel.adjustsFontForContentSizeCategory = true
+
+        self.textView.text = self.initialText
+        self.textView.font = UIFont.preferredFont(forTextStyle: .body)
+        self.textView.adjustsFontForContentSizeCategory = true
+        self.textView.autocorrectionType = .no
+        self.textView.smartQuotesType = .no
+        self.textView.smartDashesType = .no
+        self.textView.alwaysBounceVertical = true
+        self.textView.keyboardDismissMode = .interactive
+        self.textView.backgroundColor = UIColor.secondarySystemBackground
+        self.textView.layer.cornerRadius = 12.0
+        self.textView.layer.cornerCurve = .continuous
+        self.textView.textContainerInset = UIEdgeInsets(top: 12.0, left: 8.0, bottom: 12.0, right: 8.0)
+        self.textView.delegate = self
+
+        for view in [self.hintLabel, self.textView] as [UIView] {
+            view.translatesAutoresizingMaskIntoConstraints = false
+            self.view.addSubview(view)
+        }
+        let guide = self.view.safeAreaLayoutGuide
+        NSLayoutConstraint.activate([
+            self.hintLabel.topAnchor.constraint(equalTo: guide.topAnchor, constant: 12.0),
+            self.hintLabel.leadingAnchor.constraint(equalTo: guide.leadingAnchor, constant: 16.0),
+            self.hintLabel.trailingAnchor.constraint(equalTo: guide.trailingAnchor, constant: -16.0),
+            self.textView.topAnchor.constraint(equalTo: self.hintLabel.bottomAnchor, constant: 12.0),
+            self.textView.leadingAnchor.constraint(equalTo: guide.leadingAnchor, constant: 16.0),
+            self.textView.trailingAnchor.constraint(equalTo: guide.trailingAnchor, constant: -16.0),
+            self.textView.bottomAnchor.constraint(equalTo: self.view.keyboardLayoutGuide.topAnchor, constant: -12.0)
+        ])
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        self.textView.becomeFirstResponder()
+    }
+
+    @objc private func cancelPressed() {
+        self.view.endEditing(true)
+        self.dismiss(animated: true, completion: { [completion] in completion(nil) })
+    }
+
+    @objc private func savePressed() {
+        let text = self.textView.text ?? ""
+        self.view.endEditing(true)
+        self.dismiss(animated: true, completion: { [completion] in completion(text) })
+    }
+}
