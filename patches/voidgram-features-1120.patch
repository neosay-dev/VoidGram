+
+            self.acceptButton.topAnchor.constraint(equalTo: self.hintLabel.bottomAnchor, constant: 12.0),
+            self.acceptButton.leadingAnchor.constraint(equalTo: content.leadingAnchor),
+            self.acceptButton.trailingAnchor.constraint(equalTo: content.trailingAnchor),
+            self.acceptButton.heightAnchor.constraint(equalToConstant: 50.0),
+
+            self.declineButton.topAnchor.constraint(equalTo: self.acceptButton.bottomAnchor, constant: 4.0),
+            self.declineButton.centerXAnchor.constraint(equalTo: content.centerXAnchor),
+            self.declineButton.heightAnchor.constraint(equalToConstant: 40.0),
+            self.declineButton.bottomAnchor.constraint(equalTo: content.bottomAnchor, constant: -8.0)
+        ])
+        self.updateAcceptState()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        // The whole text may fit at once on a large screen: then there is nothing to scroll.
+        self.checkScrollPosition()
+    }
+
+    func scrollViewDidScroll(_ scrollView: UIScrollView) {
+        self.checkScrollPosition()
+    }
+
+    private func checkScrollPosition() {
+        let scrollView = self.textView
+        guard scrollView.bounds.height > 0.0, scrollView.contentSize.height > 0.0 else { return }
+        let visibleBottom = scrollView.contentOffset.y + scrollView.bounds.height - scrollView.adjustedContentInset.bottom
+        let total = scrollView.contentSize.height
+        let maxOffset = max(1.0, total - scrollView.bounds.height + scrollView.adjustedContentInset.bottom)
+        self.progressView.setProgress(Float(min(1.0, max(0.0, scrollView.contentOffset.y / maxOffset))), animated: false)
+        // "The very end": the last line is fully visible (2 pt tolerance for rounding).
+        if !self.reachedEnd && visibleBottom >= total - 2.0 {
+            self.reachedEnd = true
+            self.progressView.setProgress(1.0, animated: true)
+            UISelectionFeedbackGenerator().selectionChanged()
+            UIView.animate(withDuration: 0.2, animations: {
+                self.updateAcceptState()
+            })
+        }
+    }
+
+    private func updateAcceptState() {
+        self.acceptButton.isEnabled = self.reachedEnd
+        self.acceptButton.backgroundColor = self.reachedEnd ? self.accentColor : UIColor.systemGray3
+        self.hintLabel.text = self.reachedEnd ? (self.russian ? "Спасибо, что дочитали" : "Thank you for reading to the end") : (self.russian ? "Долистайте до самого конца, чтобы принять" : "Scroll to the very end to accept")
+    }
+
+    @objc private func acceptPressed() {
+        guard self.reachedEnd else { return }
+        self.accepted?()
+    }
+
+    @objc private func declinePressed() {
+        let alert = UIAlertController(title: self.russian ? "Без согласия нельзя" : "Agreement required", message: self.russian ? "Пользоваться VoidGram можно только после принятия соглашения. Если вы не согласны, удалите приложение." : "VoidGram can be used only after accepting the agreement. If you do not agree, delete the app.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        var presenter = self.window?.rootViewController
+        while let presented = presenter?.presentedViewController {
+            presenter = presented
+        }
+        presenter?.present(alert, animated: true)
+    }
+}
