+++ b/submodules/TelegramUIPreferences/Sources/AyuPowerSaving.swift
@@ -0,0 +1,220 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+
+/// VoidGram power saving (Settings → VoidGram → More → Power saving): one profile per kind of
+/// device, so the same backup can carry a phone, a tablet and a laptop (the app on a Mac). Each
+/// profile chooses when saving turns on (never, below a battery level, always) and extra triggers
+/// (system Low Power Mode, running on battery), and what it turns off. A profile left on "Telegram"
+/// keeps Telegram's own Power Saving screen in charge.
+public enum AyuPowerSaving {
+    public enum DeviceKind: String, CaseIterable {
+        case phone
+        case tablet
+        case laptop
+
+        public static var current: DeviceKind {
+            if ProcessInfo.processInfo.isiOSAppOnMac || ProcessInfo.processInfo.isMacCatalystApp {
+                return .laptop
+            }
+            return UIDevice.current.userInterfaceIdiom == .pad ? .tablet : .phone
+        }
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .phone: return russian ? "Телефон" : "Phone"
+            case .tablet: return russian ? "Планшет" : "Tablet"
+            case .laptop: return russian ? "Ноутбук (Mac)" : "Laptop (Mac)"
+            }
+        }
+    }
+
+    public enum Mode: Int, CaseIterable {
+        /// Telegram's own Power Saving settings decide.
+        case telegram = 0
+        case off = 1
+        case battery = 2
+        case always = 3
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .telegram: return russian ? "Как в Telegram" : "Telegram's setting"
+            case .off: return russian ? "Никогда" : "Never"
+            case .battery: return russian ? "При низком заряде" : "When battery is low"
+            case .always: return russian ? "Всегда" : "Always"
+            }
+        }
+    }
+
+    /// What a profile turns off while it is saving power.
+    public enum Limit: String, CaseIterable {
+        case autoplayVideo
+        case autoplayGif
+        case loopStickers
+        case loopEmoji
+        case translucency
+        case backgroundWork
+        case backgroundDownloads
+
+        public func title(_ russian: Bool) -> String {
+            switch self {
+            case .autoplayVideo: return russian ? "Автовоспроизведение видео" : "Autoplay videos"
+            case .autoplayGif: return russian ? "Автовоспроизведение GIF" : "Autoplay GIFs"
+            case .loopStickers: return russian ? "Анимация стикеров" : "Animated stickers"
+            case .loopEmoji: return russian ? "Анимация эмодзи" : "Animated emoji"
+            case .translucency: return russian ? "Размытие и стекло" : "Blur and glass"
+            case .backgroundWork: return russian ? "Работа в фоне" : "Background work"
+            case .backgroundDownloads: return russian ? "Загрузки в фоне" : "Background downloads"
+            }
+        }
+    }
+
+    public struct Profile: Equatable {
+        public var mode: Mode
+        /// Battery percent at or below which `.battery` saves power (5…95).
+        public var threshold: Int
+        /// Also save power while iOS/macOS Low Power Mode is on.
+        public var followLowPowerMode: Bool
+        /// Save power whenever the device is not charging (useful on a laptop).
+        public var onBatteryOnly: Bool
+        /// Limits that are turned off while saving.
+        public var limits: Set<Limit>
+
+        public static func defaults(for kind: DeviceKind) -> Profile {
+            switch kind {
+            case .phone:
+                return Profile(mode: .telegram, threshold: 20, followLowPowerMode: true, onBatteryOnly: false, limits: Set(Limit.allCases))
+            case .tablet:
+                return Profile(mode: .telegram, threshold: 15, followLowPowerMode: true, onBatteryOnly: false, limits: [.autoplayVideo, .autoplayGif, .loopEmoji, .backgroundWork, .backgroundDownloads])
+            case .laptop:
+                return Profile(mode: .telegram, threshold: 20, followLowPowerMode: true, onBatteryOnly: true, limits: [.autoplayVideo, .loopEmoji, .translucency, .backgroundDownloads])
+            }
+        }
+    }
+
+    public static let didChangeNotification = Notification.Name("VoidGram.PowerSavingChanged")
+
+    private static func key(_ kind: DeviceKind, _ name: String) -> String {
+        return "ayu.power.\(kind.rawValue).\(name)"
+    }
+
+    public static func profile(for kind: DeviceKind) -> Profile {
+        let defaults = UserDefaults.standard
+        var profile = Profile.defaults(for: kind)
+        if let mode = defaults.object(forKey: key(kind, "mode")) as? Int, let value = Mode(rawValue: mode) {
+            profile.mode = value
+        }
+        if let threshold = defaults.object(forKey: key(kind, "threshold")) as? Int {
+            profile.threshold = min(95, max(5, threshold))
+        }
+        if let value = defaults.object(forKey: key(kind, "lowPower")) as? Bool {
+            profile.followLowPowerMode = value
+        }
+        if let value = defaults.object(forKey: key(kind, "onBattery")) as? Bool {
+            profile.onBatteryOnly = value
+        }
+        if let limits = defaults.stringArray(forKey: key(kind, "limits")) {
+            profile.limits = Set(limits.compactMap(Limit.init(rawValue:)))
+        }
+        return profile
+    }
+
+    public static func setProfile(_ profile: Profile, for kind: DeviceKind) {
+        let defaults = UserDefaults.standard
+        defaults.set(profile.mode.rawValue, forKey: key(kind, "mode"))
+        defaults.set(min(95, max(5, profile.threshold)), forKey: key(kind, "threshold"))
+        defaults.set(profile.followLowPowerMode, forKey: key(kind, "lowPower"))
+        defaults.set(profile.onBatteryOnly, forKey: key(kind, "onBattery"))
+        defaults.set(profile.limits.map(\.rawValue).sorted(), forKey: key(kind, "limits"))
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    public static func resetProfile(for kind: DeviceKind) {
+        for name in ["mode", "threshold", "lowPower", "onBattery", "limits"] {
+            UserDefaults.standard.removeObject(forKey: key(kind, name))
+        }
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+
+    // MARK: Evaluation
+
+    /// Whether the profile of this device is saving power right now. Nil: Telegram decides.
+    public static func isSavingNow(_ profile: Profile = AyuPowerSaving.profile(for: .current)) -> Bool? {
+        if profile.mode == .telegram {
+            return nil
+        }
+        let device = UIDevice.current
+        if !device.isBatteryMonitoringEnabled {
+            device.isBatteryMonitoringEnabled = true
+        }
+        if profile.followLowPowerMode && ProcessInfo.processInfo.isLowPowerModeEnabled {
+            return true
+        }
+        let state = device.batteryState
+        if profile.onBatteryOnly && state == .unplugged {
+            return true
+        }
+        switch profile.mode {
+        case .telegram, .off:
+            return false
+        case .always:
+            return true
+        case .battery:
+            let level = device.batteryLevel
+            // Charging, full, or no battery (a desktop Mac reports -1): nothing to save.
+            if level < 0.0 || state == .charging || state == .full {
+                return false
+            }
+            return level <= Float(profile.threshold) / 100.0
+        }
+    }
+
+    /// `base` with this device's profile applied right now. Nil: Telegram decides.
+    public static func effectiveSettingsNow(base: EnergyUsageSettings) -> EnergyUsageSettings? {
+        let profile = self.profile(for: .current)
+        guard let saving = self.isSavingNow(profile) else { return nil }
+        return saving ? self.apply(profile.limits, to: base) : base
+    }
+
+    public static func apply(_ limits: Set<Limit>, to base: EnergyUsageSettings) -> EnergyUsageSettings {
+        var settings = base
+        for limit in limits {
+            switch limit {
+            case .autoplayVideo: settings.autoplayVideo = false
+            case .autoplayGif: settings.autoplayGif = false
+            case .loopStickers: settings.loopStickers = false
+            case .loopEmoji: settings.loopEmoji = false
+            case .translucency: settings.fullTranslucency = false
+            case .backgroundWork: settings.extendBackgroundWork = false
+            case .backgroundDownloads: settings.autodownloadInBackground = false
+            }
+        }
+        return settings
+    }
+
+    /// Re-evaluates on battery level and state changes, Low Power Mode changes, profile changes,
+    /// and once a minute (battery notifications are coarse). Nil: Telegram decides.
+    public static func effectiveSettings(base: EnergyUsageSettings) -> Signal<EnergyUsageSettings?, NoError> {
+        return Signal { subscriber in
+            subscriber.putNext(self.effectiveSettingsNow(base: base))
+            let names: [Notification.Name] = [UIDevice.batteryLevelDidChangeNotification, UIDevice.batteryStateDidChangeNotification, Notification.Name.NSProcessInfoPowerStateDidChange, didChangeNotification]
+            let observers = names.map { name in
+                NotificationCenter.default.addObserver(forName: name, object: nil, queue: OperationQueue.main, using: { _ in
+                    subscriber.putNext(self.effectiveSettingsNow(base: base))
+                })
+            }
+            let timer = SwiftSignalKit.Timer(timeout: 60.0, repeat: true, completion: {
+                subscriber.putNext(self.effectiveSettingsNow(base: base))
+            }, queue: Queue.mainQueue())
+            timer.start()
+            return ActionDisposable {
+                timer.invalidate()
+                for observer in observers {
+                    NotificationCenter.default.removeObserver(observer)
+                }
+            }
+        }
+        |> runOn(Queue.mainQueue())
+        |> distinctUntilChanged
+    }
+}
