@@ -0,0 +1,47 @@
+import Foundation
+
+/// The order of the tab bar's tabs, set in Appearance+ ("Tab order"). Tabs the list doesn't name
+/// (plugin tabs) stay just before Settings.
+public enum AyuTabOrder {
+    public static let defaultOrder: [String] = ["contacts", "calls", "chats", "news", "settings"]
+
+    private static let defaultsKey = "ayu.appearance.tabOrder"
+
+    /// Every known tab once: the saved order first, then any tab it lacks, in the default order.
+    public static var order: [String] {
+        get {
+            var result: [String] = []
+            for id in UserDefaults.standard.stringArray(forKey: defaultsKey) ?? [] where defaultOrder.contains(id) && !result.contains(id) {
+                result.append(id)
+            }
+            for id in defaultOrder where !result.contains(id) {
+                result.append(id)
+            }
+            return result
+        }
+        set {
+            if newValue == defaultOrder {
+                UserDefaults.standard.removeObject(forKey: defaultsKey)
+            } else {
+                UserDefaults.standard.set(newValue, forKey: defaultsKey)
+            }
+            NotificationCenter.default.post(name: AyuAppearancePlus.didChangeNotification, object: nil)
+        }
+    }
+
+    /// `items` in the chosen order; `id` names a tab, or is nil for a tab the list doesn't know.
+    public static func arranged<T>(_ items: [T], id: (T) -> String?) -> [T] {
+        let order = self.order
+        guard order != defaultOrder else {
+            return items
+        }
+        let settingsRank = Double(order.firstIndex(of: "settings") ?? order.count)
+        let ranked = items.enumerated().map { index, item -> (Double, Int, T) in
+            if let name = id(item), let rank = order.firstIndex(of: name) {
+                return (Double(rank), index, item)
+            }
+            return (settingsRank - 0.5, index, item)
+        }
+        return ranked.sorted(by: { $0.0 != $1.0 ? $0.0 < $1.0 : $0.1 < $1.1 }).map { $0.2 }
+    }
+}
