diff --git a/submodules/SettingsUI/Sources/AyuReorderController.swift b/submodules/SettingsUI/Sources/AyuReorderController.swift
new file mode 100644
index 00000000..e1289471
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuReorderController.swift
@@ -0,0 +1,165 @@
+import Foundation
+import UIKit
+import Display
+
+/// A list whose rows are dragged into a new order, with the system's own reordering (the grip at the
+/// right, rows making room as one is carried). A row moves only inside its section.
+final class AyuReorderController: UITableViewController {
+    struct Row {
+        let key: String
+        let title: String
+    }
+    struct Section {
+        let title: String?
+        var rows: [Row]
+    }
+
+    private var sections: [Section]
+    private let initial: [Section]
+    private let russian: Bool
+    private let footer: String?
+    private let changed: ([String]) -> Void
+
+    /// `initial` is the order "Reset" returns to; `changed` gets every row's key, section after section.
+    init(title: String, sections: [Section], initial: [Section], footer: String?, russian: Bool, changed: @escaping ([String]) -> Void) {
+        self.sections = sections
+        self.initial = initial
+        self.footer = footer
+        self.russian = russian
+        self.changed = changed
+        super.init(style: .insetGrouped)
+        self.title = title
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.tableView.register(UITableViewCell.self, forCellReuseIdentifier: "row")
+        self.tableView.isEditing = true
+        self.tableView.allowsSelectionDuringEditing = false
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: self.russian ? "Сбросить" : "Reset", style: .plain, target: self, action: #selector(self.reset))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.done))
+    }
+
+    @objc private func done() {
+        self.dismiss(animated: true)
+    }
+
+    @objc private func reset() {
+        self.sections = self.initial
+        self.tableView.reloadData()
+        self.changed(self.sections.flatMap { $0.rows.map { $0.key } })
+    }
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return self.sections.count
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        return self.sections[section].rows.count
+    }
+
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        return self.sections[section].title
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return section == self.sections.count - 1 ? self.footer : nil
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "row", for: indexPath)
+        cell.textLabel?.text = self.sections[indexPath.section].rows[indexPath.row].title
+        cell.textLabel?.font = .preferredFont(forTextStyle: .body)
+        cell.textLabel?.adjustsFontForContentSizeCategory = true
+        cell.showsReorderControl = true
+        cell.selectionStyle = .none
+        return cell
+    }
+
+    override func tableView(_ tableView: UITableView, editingStyleForRowAt indexPath: IndexPath) -> UITableViewCell.EditingStyle {
+        return .none
+    }
+
+    override func tableView(_ tableView: UITableView, shouldIndentWhileEditingRowAt indexPath: IndexPath) -> Bool {
+        return false
+    }
+
+    override func tableView(_ tableView: UITableView, canMoveRowAt indexPath: IndexPath) -> Bool {
+        return self.sections[indexPath.section].rows.count > 1
+    }
+
+    override func tableView(_ tableView: UITableView, targetIndexPathForMoveFromRowAt sourceIndexPath: IndexPath, toProposedIndexPath proposedDestinationIndexPath: IndexPath) -> IndexPath {
+        if proposedDestinationIndexPath.section == sourceIndexPath.section {
+            return proposedDestinationIndexPath
+        }
+        // Carried past its section's edge: the row stops at that edge.
+        let last = self.sections[sourceIndexPath.section].rows.count - 1
+        return IndexPath(row: proposedDestinationIndexPath.section < sourceIndexPath.section ? 0 : last, section: sourceIndexPath.section)
+    }
+
+    override func tableView(_ tableView: UITableView, moveRowAt sourceIndexPath: IndexPath, to destinationIndexPath: IndexPath) {
+        guard sourceIndexPath.section == destinationIndexPath.section else {
+            return
+        }
+        let row = self.sections[sourceIndexPath.section].rows.remove(at: sourceIndexPath.row)
+        self.sections[sourceIndexPath.section].rows.insert(row, at: destinationIndexPath.row)
+        self.changed(self.sections.flatMap { $0.rows.map { $0.key } })
+    }
+}
+
+/// Appearance+ > Tab order.
+func ayuTabOrderController(russian: Bool) -> UIViewController {
+    let titles: [String: (String, String)] = [
+        "contacts": ("Контакты", "Contacts"), "calls": ("Звонки", "Calls"), "chats": ("Чаты", "Chats"),
+        "news": ("Новости", "News"), "settings": ("Настройки", "Settings")
+    ]
+    let rows: ([String]) -> [AyuReorderController.Row] = { keys in
+        return keys.map { key in
+            AyuReorderController.Row(key: key, title: russian ? (titles[key]?.0 ?? key) : (titles[key]?.1 ?? key))
+        }
+    }
+    return AyuReorderController(
+        title: russian ? "Порядок вкладок" : "Tab order",
+        sections: [AyuReorderController.Section(title: nil, rows: rows(AyuTabOrder.order))],
+        initial: [AyuReorderController.Section(title: nil, rows: rows(AyuTabOrder.defaultOrder))],
+        footer: russian ? "Потяни за ручку справа. Порядок меняется сразу; скрытые вкладки остаются скрытыми, вкладки плагинов стоят перед «Настройками»." : "Drag the grip at the right. The order changes at once; hidden tabs stay hidden, plugin tabs sit before Settings.",
+        russian: russian,
+        changed: { AyuTabOrder.order = $0 }
+    )
+}
+
+/// Appearance+ > Settings rows order: the main Settings page's rows, grouped as the page groups them.
+func ayuSettingsRowsOrderController(russian: Bool) -> UIViewController {
+    let sections: ([String]) -> [AyuReorderController.Section] = { order in
+        var result: [(Int, [AyuSettingsVisibility.Row])] = []
+        for row in AyuSettingsVisibility.rows {
+            if let index = result.firstIndex(where: { $0.0 == row.section }) {
+                result[index].1.append(row)
+            } else {
+                result.append((row.section, [row]))
+            }
+        }
+        return result.map { _, rows in
+            let sorted = rows.enumerated().sorted(by: { lhs, rhs in
+                let left = order.firstIndex(of: lhs.element.key) ?? (order.count + lhs.offset)
+                let right = order.firstIndex(of: rhs.element.key) ?? (order.count + rhs.offset)
+                return left < right
+            }).map { $0.element }
+            return AyuReorderController.Section(title: nil, rows: sorted.map { row in
+                AyuReorderController.Row(key: row.key, title: russian ? row.titleRu : row.titleEn)
+            })
+        }
+    }
+    return AyuReorderController(
+        title: russian ? "Порядок пунктов" : "Rows order",
+        sections: sections(AyuSettingsVisibility.order),
+        initial: sections([]),
+        footer: russian ? "Пункт двигается внутри своей группы, как группы стоят на странице «Настройки»." : "A row moves inside its group, as the groups stand on the Settings page.",
+        russian: russian,
+        changed: { AyuSettingsVisibility.order = $0 }
+    )
+}
