@@ -0,0 +1,260 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_notice.h"
+
+#include "api/api_common.h"
+#include "apiwrap.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "history/history.h"
+#include "history/history_item.h"
+#include "history/view/history_view_element.h"
+#include "main/main_session.h"
+#include "settings.h"
+
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace VoidGram {
+namespace {
+
+// The same text as the iPhone app (AyuVoidGramNotice.swift), so either client recognises it.
+constexpr auto kText = "Я использую VoidGram — я не гарантирую шифрование нашей переписки и не советую кидать интимные фото или что-то ещё.\n\nI use VoidGram — I do not guarantee the encryption of our conversation and do not recommend sending intimate photos or anything else.";
+
+struct State {
+	bool loaded = false;
+	// "account peer:chat peer" -> message id of the notice in that chat.
+	base::flat_map<QString, int64> ids;
+	base::flat_set<QString> inFlight;
+	// Local id of a notice being sent -> its chat, per session.
+	base::flat_map<not_null<Main::Session*>, base::flat_map<MsgId, PeerId>> pending;
+	base::flat_set<not_null<Main::Session*>> watched;
+};
+
+[[nodiscard]] State &Get() {
+	static auto result = State();
+	return result;
+}
+
+[[nodiscard]] QString Text() {
+	return QString::fromUtf8(kText);
+}
+
+[[nodiscard]] QString Path() {
+	return cWorkingDir() + u"tdata/voidgram_notice.json"_q;
+}
+
+[[nodiscard]] QString Key(not_null<Main::Session*> session, PeerId peer) {
+	return QString::number(session->userPeerId().value)
+		+ ':'
+		+ QString::number(peer.value);
+}
+
+void Load() {
+	auto &state = Get();
+	if (state.loaded) {
+		return;
+	}
+	state.loaded = true;
+	auto file = QFile(Path());
+	if (!file.open(QIODevice::ReadOnly)) {
+		return;
+	}
+	const auto object = QJsonDocument::fromJson(file.readAll()).object();
+	for (auto i = object.begin(); i != object.end(); ++i) {
+		state.ids[i.key()] = int64(i.value().toDouble());
+	}
+}
+
+void Save() {
+	auto object = QJsonObject();
+	for (const auto &[key, id] : Get().ids) {
+		object.insert(key, double(id));
+	}
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	auto file = QFile(Path());
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(QJsonDocument(object).toJson(QJsonDocument::Compact));
+	}
+}
+
+[[nodiscard]] MsgId StoredId(not_null<Main::Session*> session, PeerId peer) {
+	Load();
+	const auto &ids = Get().ids;
+	const auto i = ids.find(Key(session, peer));
+	return (i != ids.end()) ? MsgId(i->second) : MsgId();
+}
+
+void Remember(not_null<Main::Session*> session, PeerId peer, MsgId id) {
+	Load();
+	Get().ids[Key(session, peer)] = id.bare;
+	Save();
+}
+
+void Forget(not_null<Main::Session*> session, PeerId peer) {
+	Load();
+	Get().ids.remove(Key(session, peer));
+	Save();
+}
+
+[[nodiscard]] bool Eligible(not_null<PeerData*> peer) {
+	const auto user = peer->asUser();
+	return user
+		&& !user->isSelf()
+		&& !user->isBot()
+		&& !user->isServiceUser()
+		&& !user->isInaccessible();
+}
+
+void Pin(not_null<PeerData*> peer, MsgId id) {
+	const auto session = &peer->session();
+	session->api().request(MTPmessages_UpdatePinnedMessage(
+		MTP_flags(MTPmessages_UpdatePinnedMessage::Flag::f_silent),
+		peer->input(),
+		MTP_int(id)
+	)).done([=](const MTPUpdates &result) {
+		session->api().applyUpdates(result);
+	}).send();
+}
+
+// After a reinstall, or when the other VoidGram client already sent it.
+[[nodiscard]] HistoryItem *FindLoadedNotice(not_null<History*> history) {
+	const auto text = Text();
+	for (const auto &block : history->blocks) {
+		for (const auto &view : block->messages) {
+			const auto item = view->data();
+			if (item->out()
+				&& item->isRegular()
+				&& item->originalText().text == text) {
+				return item;
+			}
+		}
+	}
+	return nullptr;
+}
+
+void Watch(not_null<Main::Session*> session) {
+	auto &state = Get();
+	if (!state.watched.emplace(session).second) {
+		return;
+	}
+	session->data().itemIdChanged(
+	) | rpl::on_next([=](const Data::Session::IdChange &change) {
+		auto &state = Get();
+		auto &pending = state.pending[session];
+		const auto i = pending.find(change.oldId);
+		if (i == pending.end() || i->second != change.newId.peer) {
+			return;
+		}
+		pending.erase(i);
+		const auto peer = session->data().peer(change.newId.peer);
+		Remember(session, peer->id, change.newId.msg);
+		state.inFlight.remove(Key(session, peer->id));
+		Pin(peer, change.newId.msg);
+	}, session->lifetime());
+	session->lifetime().add([=] {
+		auto &state = Get();
+		state.watched.remove(session);
+		state.pending.remove(session);
+	});
+}
+
+// Pins the stored notice again if needed. Returns false when there is none.
+bool EnsurePinned(not_null<History*> history) {
+	const auto peer = history->peer;
+	const auto session = &history->session();
+	const auto id = StoredId(session, peer->id);
+	if (!id) {
+		if (const auto item = FindLoadedNotice(history)) {
+			Remember(session, peer->id, item->id);
+			if (!item->isPinned()) {
+				Pin(peer, item->id);
+			}
+			return true;
+		}
+		return false;
+	}
+	if (const auto item = session->data().message(peer->id, id)) {
+		if (!item->isPinned()) {
+			Pin(peer, id);
+		}
+		return true;
+	}
+	// Not loaded here: ask the server. If it was deleted (by the other person or another
+	// client), forget it and the next message sends a new one.
+	const auto key = Key(session, peer->id);
+	auto &state = Get();
+	if (state.inFlight.contains(key)) {
+		return true;
+	}
+	state.inFlight.emplace(key);
+	session->api().requestMessageData(peer, id, crl::guard(session, [=] {
+		Get().inFlight.remove(key);
+		if (const auto item = session->data().message(peer->id, id)) {
+			if (!item->isPinned()) {
+				Pin(peer, id);
+			}
+		} else {
+			Forget(session, peer->id);
+		}
+	}));
+	return true;
+}
+
+} // namespace
+
+void NoticeBeforeSend(const Api::SendAction &action) {
+	if (action.options.scheduled
+		|| action.options.shortcutId
+		|| action.replaceMediaOf
+		|| action.replyTo.topicRootId) {
+		return;
+	}
+	const auto history = action.history;
+	const auto peer = history->peer;
+	if (!Eligible(peer)) {
+		return;
+	}
+	const auto session = &history->session();
+	const auto key = Key(session, peer->id);
+	auto &state = Get();
+	if (state.inFlight.contains(key) || EnsurePinned(history)) {
+		return;
+	}
+	state.inFlight.emplace(key);
+	Watch(session);
+
+	// Sent before the user's own message (this runs from ApiWrap::sendAction).
+	const auto localId = session->data().nextLocalMessageId();
+	state.pending[session][localId] = peer->id;
+	auto message = Api::MessageToSend(Api::SendAction(history));
+	message.textWithTags = TextWithTags{ Text() };
+	message.action.clearDraft = false;
+	session->api().sendMessage(std::move(message), localId);
+}
+
+void NoticeChatOpened(not_null<History*> history) {
+	const auto peer = history->peer;
+	if (!Eligible(peer)) {
+		return;
+	}
+	const auto key = Key(&history->session(), peer->id);
+	if (!Get().inFlight.contains(key)) {
+		EnsurePinned(history);
+	}
+}
+
+bool IsNoticeItem(not_null<const HistoryItem*> item) {
+	if (!item->isRegular() || !item->history()->peer->isUser()) {
+		return false;
+	}
+	const auto id = StoredId(
+		&item->history()->session(),
+		item->history()->peer->id);
+	return id && (item->id == id);
+}
+
+} // namespace VoidGram
