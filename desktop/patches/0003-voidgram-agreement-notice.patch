+
+[[nodiscard]] TextWithEntities AgreementText() {
+	auto result = TextWithEntities();
+	const auto ru = Russian();
+	const auto append = [&](const Block &block) {
+		if (!result.text.isEmpty()) {
+			result.append(u"\n\n"_q);
+		}
+		const auto text = QString::fromUtf8(block.text);
+		result.append(block.bold
+			? Ui::Text::Bold(text)
+			: TextWithEntities{ text });
+	};
+	if (ru) {
+		for (const auto &block : kRussian) {
+			append(block);
+		}
+	} else {
+		for (const auto &block : kEnglish) {
+			append(block);
+		}
+	}
+	return result;
+}
+
+void MarkAccepted() {
+	QDir().mkpath(cWorkingDir() + u"tdata"_q);
+	auto file = QFile(MarkerPath());
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write("accepted\n");
+	}
+}
+
+void AgreementBox(not_null<Ui::GenericBox*> box) {
+	const auto ru = Russian();
+	box->setTitle(rpl::single(ru
+		? u"Пользовательское соглашение"_q
+		: u"User Agreement"_q));
+	box->setWidth(st::boxWideWidth);
+	box->setCloseByEscape(false);
+	box->setCloseByOutsideClick(false);
+
+	// GenericBox rows are RpWidgets; the scroll area lives inside a fixed-height one.
+	const auto holder = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		style::margins(
+			st::boxRowPadding.left(),
+			0,
+			st::boxRowPadding.right() / 2,
+			0));
+	holder->resize(holder->width(), kTextHeight);
+	const auto scroll = Ui::CreateChild<Ui::ScrollArea>(
+		holder,
+		st::boxScroll);
+	const auto label = scroll->setOwnedWidget(object_ptr<Ui::FlatLabel>(
+		scroll,
+		rpl::single(AgreementText()),
+		st::boxLabel));
+	holder->widthValue() | rpl::on_next([=](int width) {
+		holder->resize(width, kTextHeight);
+		scroll->setGeometry(0, 0, width, kTextHeight);
+		label->resizeToWidth(width - st::boxRowPadding.right() / 2);
+	}, holder->lifetime());
+
+	const auto reached = box->lifetime().make_state<rpl::variable<bool>>(
+		false);
+	const auto check = [=] {
+		if (reached->current() || label->height() <= 0) {
+			return;
+		}
+		if (scroll->scrollTop() >= scroll->scrollTopMax() - 4) {
+			*reached = true;
+		}
+	};
+	rpl::merge(
+		scroll->scrolls(),
+		scroll->innerResizes(),
+		scroll->heightValue() | rpl::to_empty
+	) | rpl::on_next(check, box->lifetime());
+
+	box->addButton(reached->value() | rpl::map([=](bool done) {
+		return done
+			? (ru ? u"Согласиться"_q : u"I agree"_q)
+			: (ru ? u"Долистайте до конца"_q : u"Scroll to the end"_q);
+	}), [=] {
+		if (!reached->current()) {
+			return;
+		}
+		MarkAccepted();
+		box->closeBox();
+	});
+	box->addLeftButton(
+		rpl::single(ru ? u"Выйти"_q : u"Quit"_q),
+		[] { Core::Quit(); });
+}
+
+} // namespace
+
+bool AgreementAccepted() {
+	return QFile::exists(MarkerPath());
+}
+
+void ShowAgreementIfNeeded(not_null<Window::Controller*> window) {
+	// One box at a time, even when several accounts start together.
+	static auto current = base::weak_qptr<Ui::GenericBox>();
+	if (AgreementAccepted() || current) {
+		return;
+	}
+	current = window->show(Box(AgreementBox), Ui::LayerOption::KeepOther);
+}
+
+} // namespace VoidGram
