@@ -0,0 +1,38 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include <QtCore/QPoint>
+#include <QtCore/QRect>
+#include <QtCore/QString>
+#include <QtGui/QColor>
+#include <QtGui/QPainter>
+
+namespace VoidGram {
+
+// The light behind a reaction, in the colour of the reaction itself.
+void PaintReactionGlow(
+	QPainter &p,
+	QRect rect,
+	const QString &emoji,
+	bool chosen);
+
+// A name's glow: `draw` is called with a small shift several times, faintly, in the glow colour
+// (the pen is set to it), and the caller then draws the name itself on top.
+template <typename Draw>
+void PaintNameGlow(QPainter &p, const QColor &color, Draw &&draw) {
+	const auto opacity = p.opacity();
+	p.setPen(color);
+	p.setOpacity(opacity * 0.14);
+	const QPoint shifts[] = {
+		{ -2, 0 }, { 2, 0 }, { 0, -2 }, { 0, 2 },
+		{ -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 },
+		{ -3, 0 }, { 3, 0 }, { 0, -3 }, { 0, 3 },
+	};
+	for (const auto &shift : shifts) {
+		draw(shift);
+	}
+	p.setOpacity(opacity);
+}
+
+} // namespace VoidGram
diff --git a/Telegram/SourceFiles/voidgram/voidgram_liquid_glass.cpp b/Telegram/SourceFiles/voidgram/voidgram_liquid_glass.cpp
new file mode 100644
index 0000000..721b589
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_liquid_glass.cpp
@@ -0,0 +1,228 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_liquid_glass.h"
+
+#ifndef VOIDGRAM_GLASS_STANDALONE // The shader alone, for its visual check (desktop/tools/glass_check.cpp in the VoidGram repository).
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/popup_menu.h"
+#include "styles/style_basic.h"
+#endif
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QPointer>
+#include <QtGui/QPainter>
+#include <QtGui/QPainterPath>
+#include <QtWidgets/QApplication>
+#include <QtWidgets/QWidget>
+
+#include <cmath>
+
+namespace VoidGram {
+namespace {
+
+[[maybe_unused]] // Unused by the standalone check.
+// While a backdrop is being captured, glass is not drawn (a capture must not see glass, or itself).
+bool Capturing = false;
+
+[[nodiscard]] QImage Blurred(const QImage &image) {
+	// An eighth-size round trip: about the preview's blur(20px).
+	const auto small = image.scaled(
+		std::max(1, image.width() / 8),
+		std::max(1, image.height() / 8),
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	return small.scaled(image.size(), Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
+		.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+}
+
+#ifndef VOIDGRAM_GLASS_STANDALONE
+[[nodiscard]] bool Eligible(QWidget *widget) {
+	if (!dynamic_cast<Ui::IconButton*>(widget)) {
+		return false;
+	}
+	// Buttons on a glass capsule (the chat's top bar, the composer) take the capsule's glass, not a circle.
+	if (const auto parent = widget->parentWidget()) {
+		if (parent->property("voidgramGlassCapsules").toBool()) {
+			return false;
+		}
+	}
+	const auto size = widget->size();
+	if (size.width() < 24 || size.height() < 24 || size.width() > 96 || size.height() > 96) {
+		return false;
+	}
+	for (auto parent = widget->parentWidget(); parent; parent = parent->parentWidget()) {
+		if (dynamic_cast<Ui::PopupMenu*>(parent)) {
+			return false; // Menus keep their flat rows.
+		}
+	}
+	return true;
+}
+
+void PaintGlass(QWidget *widget) {
+	const auto parent = widget->parentWidget();
+	if (!parent) {
+		return;
+	}
+	const auto ratio = widget->devicePixelRatioF();
+	const auto inner = widget->rect().marginsRemoved({ 2, 2, 2, 2 });
+	const auto side = std::min(inner.width(), inner.height());
+	const auto capsule = QRect(
+		inner.x() + (inner.width() - side) / 2,
+		inner.y() + (inner.height() - side) / 2,
+		side,
+		side);
+
+	// What the parent paints under the capsule, without its children: the wallpaper or the panel.
+	auto backdrop = QImage(
+		capsule.size() * ratio,
+		QImage::Format_ARGB32_Premultiplied);
+	backdrop.setDevicePixelRatio(ratio);
+	backdrop.fill(st::windowBg->c);
+	Capturing = true;
+	parent->render(
+		&backdrop,
+		QPoint(),
+		QRegion(QRect(widget->mapTo(parent, capsule.topLeft()), capsule.size())),
+		QWidget::DrawWindowBackground);
+	Capturing = false;
+	backdrop.setDevicePixelRatio(1.);
+
+	const auto dark = st::windowBg->c.lightness() < 128;
+	auto glass = RenderLiquidGlass(backdrop, dark);
+	glass.setDevicePixelRatio(ratio);
+	auto p = QPainter(widget);
+	p.drawImage(capsule.topLeft(), glass);
+}
+
+class Filter final : public QObject {
+public:
+	using QObject::QObject;
+
+protected:
+	bool eventFilter(QObject *object, QEvent *event) override {
+		if (event->type() != QEvent::Paint || !object->isWidgetType()) {
+			return false;
+		}
+		const auto widget = static_cast<QWidget*>(object);
+		if (!Eligible(widget)) {
+			return false;
+		}
+		if (Capturing) {
+			return false;
+		}
+		PaintGlass(widget);
+		return false; // The button paints its icon over the glass.
+	}
+
+};
+
+#endif
+
+} // namespace
+
+void PaintGlassCapsule(QPainter &p, const QRect &rect, bool dark) {
+	if (rect.isEmpty()) {
+		return;
+	}
+	const auto radius = rect.height() / 2.;
+	auto path = QPainterPath();
+	path.addRoundedRect(QRectF(rect), radius, radius);
+	p.save();
+	p.setRenderHint(QPainter::Antialiasing);
+	p.setPen(Qt::NoPen);
+	// The preview's .glass: rgba(37,37,39,.68) over the blurred backdrop, one even 1px rim.
+	p.setBrush(dark ? QColor(37, 37, 39, 173) : QColor(255, 255, 255, 173));
+	p.drawPath(path);
+	p.setBrush(Qt::NoBrush);
+	p.setPen(QPen(dark ? QColor(255, 255, 255, 31) : QColor(0, 0, 0, 20), 1.));
+	p.drawRoundedRect(QRectF(rect).adjusted(.5, .5, -.5, -.5), radius - .5, radius - .5);
+	p.restore();
+}
+
+QImage RenderLiquidGlass(const QImage &backdrop, bool dark) {
+	(void)dark; // The tint is PaintGlassCapsule's.
+	const auto w = backdrop.width();
+	const auto h = backdrop.height();
+	auto result = QImage(w, h, QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	if (w < 4 || h < 4) {
+		return result;
+	}
+	const auto blurred = Blurred(backdrop);
+	const auto radius = std::min(w, h) / 2.;
+	const auto bezel = radius * 0.32; // The rim where the glass bends the light.
+	const auto cx = (w - 1) / 2.;
+	const auto cy = (h - 1) / 2.;
+	const auto halfW = w / 2.;
+	const auto halfH = h / 2.;
+
+	// Signed distance to the capsule's edge (negative inside).
+	const auto distance = [&](double x, double y) {
+		const auto qx = std::abs(x - cx) - (halfW - radius);
+		const auto qy = std::abs(y - cy) - (halfH - radius);
+		const auto ox = std::max(qx, 0.);
+		const auto oy = std::max(qy, 0.);
+		return std::sqrt(ox * ox + oy * oy) + std::min(std::max(qx, qy), 0.) - radius;
+	};
+	// Bilinear: a bent line read from the nearest pixel came out in steps.
+	const auto sample = [&](double x, double y) {
+		x = std::clamp(x, 0., w - 1.);
+		y = std::clamp(y, 0., h - 1.);
+		const auto x0 = int(x), y0 = int(y);
+		const auto x1 = std::min(x0 + 1, w - 1), y1 = std::min(y0 + 1, h - 1);
+		const auto fx = x - x0, fy = y - y0;
+		const auto row0 = reinterpret_cast<const QRgb*>(blurred.constScanLine(y0));
+		const auto row1 = reinterpret_cast<const QRgb*>(blurred.constScanLine(y1));
+		const auto mix = [&](auto channel) {
+			const auto top = channel(row0[x0]) * (1. - fx) + channel(row0[x1]) * fx;
+			const auto bottom = channel(row1[x0]) * (1. - fx) + channel(row1[x1]) * fx;
+			return int(std::lround(top * (1. - fy) + bottom * fy));
+		};
+		return qRgba(
+			mix([](QRgb c) { return qRed(c); }),
+			mix([](QRgb c) { return qGreen(c); }),
+			mix([](QRgb c) { return qBlue(c); }),
+			mix([](QRgb c) { return qAlpha(c); }));
+	};
+
+	for (auto y = 0; y != h; ++y) {
+		auto out = reinterpret_cast<QRgb*>(result.scanLine(y));
+		for (auto x = 0; x != w; ++x) {
+			const auto d = distance(x + 0.5, y + 0.5);
+			if (d > 0.5) {
+				continue;
+			}
+			// Refraction: near the rim the sample is pulled toward the centre, as through a lens.
+			const auto depth = std::clamp(-d / bezel, 0., 1.);
+			const auto bend = (1. - depth) * (1. - depth) * 0.28;
+			const auto sx = x + (cx - x) * bend;
+			const auto sy = y + (cy - y) * bend;
+			// The tint and the rim are PaintGlassCapsule's, over this: here only the bent backdrop.
+			const auto c = sample(sx, sy);
+			const auto r = double(qRed(c)), g = double(qGreen(c)), b = double(qBlue(c));
+			// Antialiased edge.
+			const auto coverage = std::clamp(0.5 - d, 0., 1.);
+			out[x] = qRgba(
+				int(r * coverage),
+				int(g * coverage),
+				int(b * coverage),
+				int(255 * coverage));
+		}
+	}
+	return result;
+}
+
+#ifndef VOIDGRAM_GLASS_STANDALONE
+void InstallLiquidGlass() {
+	static auto installed = false;
+	if (installed || !QCoreApplication::instance()) {
+		return;
+	}
+	installed = true;
+	QCoreApplication::instance()->installEventFilter(
+		new Filter(QCoreApplication::instance()));
+}
+
+#endif
+
+} // namespace VoidGram
