+void HistoryWidget::vgPaintComposerGlass(QPainter &p) {
+	// The capsules float over the messages, as on iOS: each one is the messages under it, blurred and
+	// bent by the glass shader, with a rim. `p` paints _vgGlass, which covers the composer strip.
+	const auto dark = st::windowBg->c.lightness() < 128;
+	const auto origin = _vgGlass->pos();
+	auto capsules = _vgComposerUnder ? vgComposerCapsules() : std::vector<QRect>();
+	{
+		// Also beside forum tabs, where no messages are under them: the glass is then over the background.
+		for (const auto &capsule : _topBar->vgCapsules()) {
+			capsules.push_back(capsule.translated(_topBar->pos()));
+		}
+		// The pinned message and translate bars: full-width capsules, as in Telegram iOS.
+		for (const auto child : _topBars->findChildren<QWidget*>(QString(), Qt::FindDirectChildrenOnly)) {
+			if (child->property("voidgramGlassBar").toBool()
+				&& !child->isHidden()
+				&& child->height() > 8) {
+				capsules.push_back(child->geometry().translated(_topBars->pos()).marginsRemoved(
+					QMargins(0, 3, 0, 3)));
+			}
+		}
+	}
+	_vgGrabbing = true;
+	for (const auto &capsule : capsules) {
+		const auto inScroll = capsule.translated(-_scroll->pos());
+		auto backdrop = QImage(
+			capsule.size() * style::DevicePixelRatio(),
+			QImage::Format_ARGB32_Premultiplied);
+		backdrop.setDevicePixelRatio(style::DevicePixelRatio());
+		backdrop.fill(st::windowBg->c);
+		{
+			// The wallpaper, then the messages over it: grab() filled the gaps with Qt's light palette.
+			auto q = QPainter(&backdrop);
+			const auto fromy = controller()->content()->backgroundFromY();
+			q.translate(-capsule.x(), fromy - capsule.y());
+			Window::SectionWidget::PaintBackground(
+				q,
+				controller()->currentChatTheme(),
+				QSize(width(), controller()->content()->height()),
+				capsule.translated(0, -fromy),
+				true);
+			q.resetTransform();
+			_scroll->render(&q, QPoint(), QRegion(inScroll), QWidget::DrawChildren);
+		}
+		const auto local = capsule.translated(-origin);
+		p.drawImage(local, VoidGram::RenderLiquidGlass(backdrop, dark));
+		VoidGram::PaintGlassCapsule(p, local, dark);
+	}
+	_vgGrabbing = false;
+}
