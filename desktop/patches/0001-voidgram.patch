@@ -0,0 +1,29 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include <QtCore/QRect>
+#include <array>
+#include <QtGui/QPainter>
+
+namespace VoidGram {
+
+enum class BubbleSkin {
+	None,
+	Badge, // The grey skin with the VoidGram mark repeated over it.
+	Owner, // The same skin in a gold frame.
+};
+
+// The skin of a sponsor's (or the owner's) message bubbles.
+[[nodiscard]] BubbleSkin BubbleSkinFor(qint64 bareId);
+
+// Paints the skin over a bubble at `geometry`: a gradient, the mark repeated over it, and for the
+// owner a gold frame. `dark` picks the dark or light variant.
+void PaintBubbleSkin(
+	QPainter &p,
+	const QRect &geometry,
+	BubbleSkin skin,
+	bool dark,
+	std::array<double, 4> radii); // top left, top right, bottom right, bottom left.
+
+} // namespace VoidGram
diff --git a/Telegram/SourceFiles/voidgram/voidgram_ton_card.cpp b/Telegram/SourceFiles/voidgram/voidgram_ton_card.cpp
new file mode 100644
index 0000000..3cadf90
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_ton_card.cpp
@@ -0,0 +1,197 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_ton_card.h"
+
+#include "lang/lang_instance.h"
+#include "lang/lang_keys.h"
+#include "ui/painter.h"
+#include "ui/wrap/slide_wrap.h"
+#include "styles/style_basic.h"
+#include "styles/style_widgets.h"
+
+#include <QtGui/QLinearGradient>
+#include <QtGui/QPainterPath>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kCardHeight = 84;
+constexpr auto kRadius = 16;
+
+[[nodiscard]] QString AmountText(qint64 nano) {
+	auto text = QString::number(nano / 1e9, 'f', 4);
+	if (text.contains('.')) {
+		while (text.endsWith('0')) {
+			text.chop(1);
+		}
+		if (text.endsWith('.')) {
+			text.chop(1);
+		}
+	}
+	return text;
+}
+
+[[nodiscard]] QString Caption() {
+	return Lang::Id().startsWith(u"ru"_q)
+		? QString::fromUtf8("Баланс TON")
+		: QString("TON balance");
+}
+
+// The TON mark: a rounded white diamond with a notch down the middle.
+void PaintMark(QPainter &p, QRectF box) {
+	const auto w = box.width();
+	const auto h = box.height();
+	const auto at = [&](double x, double y) {
+		return QPointF(box.left() + x * w, box.top() + y * h);
+	};
+	auto shape = QPainterPath();
+	shape.moveTo(at(0.18, 0.2));
+	shape.lineTo(at(0.82, 0.2));
+	shape.quadTo(at(0.95, 0.2), at(0.89, 0.32));
+	shape.lineTo(at(0.55, 0.88));
+	shape.quadTo(at(0.5, 0.96), at(0.45, 0.88));
+	shape.lineTo(at(0.11, 0.32));
+	shape.quadTo(at(0.05, 0.2), at(0.18, 0.2));
+	p.setPen(Qt::NoPen);
+	p.setBrush(Qt::white);
+	p.drawPath(shape);
+	auto line = QPen(QColor(0, 120, 200), w * 0.08, Qt::SolidLine, Qt::RoundCap);
+	p.setPen(line);
+	p.drawLine(at(0.5, 0.2), at(0.5, 0.74));
+}
+
+class TonCard final : public Ui::RpWidget {
+public:
+	TonCard(QWidget *parent, rpl::producer<qint64> nano)
+	: RpWidget(parent) {
+		resize(width(), kCardHeight);
+		std::move(nano) | rpl::on_next([=](qint64 value) {
+			_nano = value;
+			update();
+		}, lifetime());
+		widthValue() | rpl::on_next([=](int) {
+			update();
+		}, lifetime());
+	}
+
+private:
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		auto hq = PainterHighQualityEnabler(p);
+		const auto outer = rect().marginsRemoved(QMargins(
+			16,
+			6,
+			16,
+			6));
+		auto gradient = QLinearGradient(outer.topLeft(), outer.bottomRight());
+		gradient.setColorAt(0., QColor(0x2A, 0xAB, 0xEE));
+		gradient.setColorAt(1., QColor(0x22, 0x6C, 0xE0));
+		p.setPen(Qt::NoPen);
+		p.setBrush(gradient);
+		p.drawRoundedRect(outer, kRadius, kRadius);
+
+		// A soft light in the corner, so the card does not look flat.
+		p.setBrush(QColor(255, 255, 255, 28));
+		p.drawEllipse(QRectF(
+			outer.right() - outer.height() * 0.9,
+			outer.top() - outer.height() * 0.5,
+			outer.height() * 1.2,
+			outer.height() * 1.2));
+
+		const auto mark = QRectF(
+			outer.left() + 16,
+			outer.top() + (outer.height() - 38) / 2.,
+			38,
+			38);
+		p.setBrush(QColor(255, 255, 255, 46));
+		p.drawEllipse(mark.adjusted(-6, -6, 6, 6));
+		PaintMark(p, mark);
+
+		const auto left = int(mark.right()) + 16;
+		const auto available = outer.right() - 12 - left;
+		p.setPen(QColor(255, 255, 255, 190));
+		p.setFont(st::normalFont);
+		p.drawText(
+			QRect(left, outer.top() + 10, available, 18),
+			Qt::AlignLeft | Qt::AlignVCenter,
+			Caption());
+		p.setPen(Qt::white);
+		auto big = st::semiboldFont->f;
+		big.setPixelSize(26);
+		p.setFont(big);
+		p.drawText(
+			QRect(left, outer.top() + 28, available, 36),
+			Qt::AlignLeft | Qt::AlignVCenter,
+			AmountText(_nano) + u" TON"_q);
+	}
+
+	qint64 _nano = 0;
+
+};
+
+class TonPill final : public Ui::RpWidget {
+public:
+	TonPill(QWidget *parent, rpl::producer<qint64> nano) : RpWidget(parent) {
+		std::move(nano) | rpl::on_next([=](qint64 value) {
+			_nano = value;
+			_text = AmountText(value) + u" TON"_q;
+			resize(kPillHeight + 6 + pillFont()->width(_text) + 12, kPillHeight);
+			// The iPhone shows the pill only from 0.1 TON.
+			setVisible(value >= 100'000'000);
+			update();
+		}, lifetime());
+	}
+
+private:
+	static constexpr auto kPillHeight = 26;
+
+	[[nodiscard]] style::font pillFont() const {
+		return st::semiboldFont;
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		auto hq = PainterHighQualityEnabler(p);
+		p.setPen(Qt::NoPen);
+		p.setBrush(QColor(0x00, 0x98, 0xEA));
+		p.drawRoundedRect(QRectF(rect()), height() / 2., height() / 2.);
+		const auto mark = QRectF(5, 5, height() - 10, height() - 10);
+		p.setBrush(QColor(255, 255, 255, 46));
+		p.drawEllipse(mark);
+		PaintMark(p, mark.adjusted(2, 2, -2, -2));
+		p.setPen(Qt::white);
+		p.setFont(pillFont());
+		p.drawText(
+			QRect(int(mark.right()) + 6, 0, width(), height()),
+			Qt::AlignLeft | Qt::AlignVCenter,
+			_text);
+	}
+
+	qint64 _nano = 0;
+	QString _text;
+
+};
+
+} // namespace
+
+not_null<Ui::RpWidget*> MakeTonPill(
+		not_null<QWidget*> parent,
+		rpl::producer<qint64> nano) {
+	return Ui::CreateChild<TonPill>(parent.get(), std::move(nano));
+}
+
+object_ptr<Ui::RpWidget> MakeTonCard(
+		not_null<QWidget*> parent,
+		rpl::producer<qint64> nano) {
+	auto visible = rpl::duplicate(nano) | rpl::map([](qint64 value) {
+		return value > 0;
+	});
+	auto wrap = object_ptr<Ui::SlideWrap<TonCard>>(
+		parent,
+		object_ptr<TonCard>(parent, std::move(nano)));
+	wrap->toggleOn(std::move(visible));
+	wrap->finishAnimating();
+	return object_ptr<Ui::RpWidget>(std::move(wrap));
+}
+
+} // namespace VoidGram
