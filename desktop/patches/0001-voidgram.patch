+// iOS 26 "Liquid Glass" behind every icon button of the app (the chat's top bar, the composer, boxes):
+// once per process, an application-wide filter paints the glass before the button paints its icon.
+void InstallLiquidGlass();
+
+// A glass capsule (the chat's top bar groups, the composer) where no backdrop is known: a body lighter at
+// the top, a specular rim brighter at the top left, a faint outline. `rect` is in `p`'s coordinates.
+void PaintGlassCapsule(QPainter &p, const QRect &rect, bool dark);
+
