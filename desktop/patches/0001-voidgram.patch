+std::vector<QRect> HistoryWidget::vgComposerCapsules() const {
+	// VoidGram: the composer as Telegram iOS 26 draws it: a capsule around the text field and a circle
+	// behind the attach and the send buttons.
+	auto result = std::vector<QRect>();
+	const auto fieldTop = _field->y() - st::historySendPadding + 4;
+	const auto fieldBottom = _field->y() + fieldHeight() + st::historySendPadding - 4;
+	const auto circle = [&](QWidget *button) {
+		if (!button || button->isHidden()) {
+			return QRect();
+		}
+		const auto g = button->geometry();
+		// As tall as a one-line field, at the bottom while the field grows.
+		const auto side = std::min(g.width(), fieldBottom - fieldTop);
+		const auto r = QRect(g.x() + (g.width() - side) / 2, fieldBottom - side, side, side);
+		result.push_back(r);
+		return r;
+	};
+	// The field capsule runs between the circles: the send button is wider than its circle, so its edge
+	// left the emoji button outside the capsule.
+	const auto attach = circle(_attachToggle.data());
+	const auto send = circle(_send.get());
+	const auto left = !attach.isNull()
+		? (attach.x() + attach.width() + 8)
+		: (_field->x() - st::historySendPadding);
+	const auto right = !send.isNull()
+		? (send.x() - 8)
+		: (_field->x() + _field->width() + st::historySendPadding);
+	if (right > left) {
+		result.push_back(QRect(left, fieldTop, right - left, fieldBottom - fieldTop));
+	}
+	return result;
+}
